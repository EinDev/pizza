// Lieferroller-Rallye: DU bist Disponent bei Luigi.
// Es gibt nur einen Roller. Nach Küchenschluss fährt er die Lieferungen
// in der Reihenfolge des Trinkgelds ab (höchstes zuerst, bei Gleichstand
// in Bestellreihenfolge) – so funktioniert wennDa. Jeder Kunde hat nur
// begrenzt Geduld. Verteile 10 € Trinkgeld so, dass möglichst alle
// rechtzeitig ihre Pizza bekommen.

klasse Tour {
    tiefkühl salami minuten = 0;
    tiefkühl salami zufrieden = 0;
    tiefkühl salami geliefert = 0;
    tiefkühl salami anzahl = 0;

    tiefkühl salami fahre(salami min) {
        salami m = 0;
        solange (m < min * 2) { m++; }
        serviere ((min));
    }

    tiefkühl leer angekommen(margherita kunde, salami fahrt, salami geduld, salami tipp) {
        minuten += fahrt;
        geliefert++;
        diavolo ok = minuten <= geduld;
        falls (ok) { zufrieden++; }
        Bote.sage(("Stopp " + geliefert + ": " + kunde + " (Trinkgeld " + tipp + " €) nach " + minuten
            + " min, Geduld " + geduld + " min → " + (ok ? "glücklich :)" : "kalt und sauer :(")));
        falls (geliefert == anzahl) {
            Bote.sage(("Ergebnis: " + zufrieden + " von " + anzahl + " Kunden zufrieden. "
                + (zufrieden == anzahl ? "Perfekte Tour – Luigi spendiert dir eine Pizza!" : "Da geht noch was.")));
        }
    }
}

// Ganze Zahl im Bereich; karton (Eingabe zu Ende) → -1
salami frage(margherita text, salami min, salami max) {
    solange (ja) {
        margherita e = Bestellannahme.frage((text + " (" + min + "-" + max + " €): "));
        falls (e == karton) { serviere ((-1)); }
        probier {
            funghi z = e.trimme().alsZahl();
            falls (z == z.ganz() && z >= min && z <= max) { serviere ((z.ganz())); }
            Bote.sage(("  Das geht nicht – erlaubt sind " + min + " bis " + max + " €."));
        } verbrannt (TypAnanas a) {
            Bote.sage(("  Der Fahrer versteht nur Zahlen."));
        }
    }
}

Bote.sage(("=== Lieferroller-Rallye ==="));
// Teil 1: Express – Herr Verdi wohnt 40 Minuten weg, will aber in 30 Minuten essen.
Bote.sage(("Express: Herr Verdi, 40 min Fahrt, 30 Minuten oder gratis!"));
Bote.sage(("Jeder Euro Trinkgeld gibt dem Fahrer 10 % mehr Zeit."));
salami express = frage("Trinkgeld für den Express", 0, 5);
diavolo gegangen = express < 0;
falls (!gegangen) {
    Zustellung<salami> z = bestelle(() -> (Tour.fahre(40))).trinkgeld(express).warte(max: 395ms);
    Bote.sage((z.pünktlich() ? "Herr Verdi: pünktlich! Er zahlt gern." : "Herr Verdi: zu spät – die Pizza geht aufs Haus."));
} sonst {
    Bote.sage(("Du gehst heim. Der Fahrer macht alles ohne Trinkgeld."));
}

// Teil 2: Die Abendtour. Kunde, Fahrtzeit ab dem letzten Stopp, Geduld ab Küchenschluss.
Blech<margherita> kunden = ["Frau Bianchi", "Familie Rossi", "Studenten-WG", "Dr. Ferrari", "Opa Enzo"];
Blech<salami> fahrten = [10, 15, 20, 5, 10];
Blech<salami> geduld = [60, 20, 90, 25, 40];
Bote.sage((""));
Bote.sage(("Abendtour – du hast 10 € Trinkgeld zu verteilen:"));
für (salami i = 1; i <= kunden.länge(); i++) {
    Bote.sage(("  " + i + ". " + kunden.stück(i) + ": " + fahrten.stück(i) + " min Fahrt, Geduld " + geduld.stück(i) + " min"));
}
salami rest = 10;
Tour.anzahl = kunden.länge();
für (salami i = 1; i <= kunden.länge(); i++) {
    salami tipp = 0;
    falls (!gegangen) {
        tipp = frage(kunden.stück(i) + ", noch " + rest + " € übrig", 0, rest);
        falls (tipp < 0) {
            gegangen = ja;
            tipp = 0;
            Bote.sage(("Du gehst heim. Der Rest bekommt kein Trinkgeld."));
        }
    }
    rest -= tipp;
    margherita k = kunden.stück(i);
    salami f = fahrten.stück(i);
    salami g = geduld.stück(i);
    bestelle(() -> (Tour.fahre(f)))
        .trinkgeld(tipp)
        .wennDa(x -> Tour.angekommen(k, f, g, tipp));
}

Bote.sage(("=== Küche zu – der Roller startet! ==="));
