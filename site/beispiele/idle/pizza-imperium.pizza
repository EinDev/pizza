// ═══════════════════════════════════════════════════════════════════════
//  🍕 Pizza-Imperium – ein Idle-Game an der Theke
// ═══════════════════════════════════════════════════════════════════════
//  Klick auf „Pizza backen!“, verkaufe jede Pizza zum echten Rezeptpreis,
//  kaufe Handwerkszeug (mehr Pizzen pro Klick) und baue einen Betrieb auf,
//  der von selbst backt (Pizzen pro Sekunde) – auf Dauer ist der Betrieb
//  das Herz des Imperiums, der Klick nur noch die Prise Salz.
//
//  Der Aufstieg hat vier Ebenen, die aufeinander aufbauen:
//    ⭐ Neueröffnung     – Michelin-Sterne, +10 % auf alles je Stern
//    📜 Geheimrezepte    – Nonnas Talentbaum, bezahlt mit Sternen
//    🏅 Herausforderungen – Läufe unter Auflagen mit Belohnung für immer
//    🏢 Franchise        – Kette gründen: Sterne werden zu Filialen
//
//  Der Spielstand liegt in der Vorratskammer: Beim nächsten Start geht es
//  weiter – und der Betrieb hat in der Zwischenzeit gebacken
//  (mit halber Kraft, höchstens 30 Minuten lang).
//
//  Sprache im Einsatz:
//    • Takt              – die Uhr der Backstube (1 Schlag pro Sekunde)
//    • Pizza + Belag     – Nonnas Rezeptbuch legt Beläge auf, preis() zählt
//    • @Kühlschrank      – Upgrade-Kosten werden nur einmal ausgerechnet
//    • ofen(…) roh       – die Sonderschicht backt, bis das Ofen-Budget leer ist
//    • bestelle/trinkgeld – Großbestellungen kommen nur mit Trinkgeld pünktlich
//    • Zufall            – Ereignisse und perfekte Pizzen
//    • Vorratskammer + Uhr.echt() – Speichern und Offline-Fortschritt
//    • kompakt()/euro(kompakt: ja) – „1,23 Mio. €“
//    • Abschnitt, Reiter, Tabelle, Fortschritt, hinweis – die Theke v2
//    • Takt.setzeIntervall – im Minispiel schlägt die Uhr schneller (150/500 ms)
//
//  🎲 Minispiele für zwischendurch (Teig fangen, Bestellung merken, Ofen
//  halten, Lieferroute): optional, ein Sieg bringt ein paar Sekunden
//  Produktion, danach macht Nonna zwei Minuten Pause.
//
//  Aufbau:  Upgrade · Geheimrezept · Herausforderung · Erfolg
//           · Spiel (Regeln, ohne Oberfläche) · Minispiele (Spielecke)
//           · Zeilen der Oberfläche
//           · Oberfläche · Start
// ═══════════════════════════════════════════════════════════════════════

// ─────────────────────────────── Upgrades ───────────────────────────────
// Ein Upgrade kann man mehrfach kaufen; jedes weitere kostet mehr
// (Betrieb +15 %, Handwerk +40 bzw. +60 % – Klick-Werkzeug ist selten und teuer).
// art: "klick"   – feste Pizzen pro Klick
//      "anteil"  – Prozent der Sekundenproduktion pro Klick
//      "betrieb" – Pizzen pro Sekunde
klasse Upgrade {
    margherita schlüssel;
    margherita symbol;
    margherita name;
    margherita art;
    margherita einheit;
    margherita beschreibung;
    funghi basis;
    funghi wirkung;
    funghi faktor;
    salami anzahl = 0;
    funghi preisJetzt = 0;   // Preis des nächsten Stücks
    margherita zeile = "";   // Beschriftung für die Oberfläche

    Upgrade(margherita s, margherita sym, margherita n, funghi b, funghi w, margherita a, margherita text) {
        schlüssel = s; symbol = sym; name = n; basis = b; wirkung = w; art = a; beschreibung = text;
        faktor = 1.4;
        einheit = "% der Pizzen pro Sekunde je Klick";
        falls (art == "klick") { einheit = w == 1 ? "Pizza pro Klick" : "Pizzen pro Klick"; faktor = 1.6; }
        falls (art == "betrieb") { einheit = "Pizzen pro Sekunde"; faktor = 1.15; }
        setzeAnzahl(0);
    }

    @Kühlschrank(haltbar: 1d)
    funghi kostenBei(salami n) {
        serviere (Mathe.runden(basis * Mathe.potenz(faktor, n)));
    }

    // Preis und Beschriftung ändern sich nur hier.
    leer setzeAnzahl(salami n) {
        anzahl = n;
        preisJetzt = kostenBei(n);
        zeile = symbol + " " + name + (anzahl > 0 ? " ×" + anzahl : "") + " – +" + wirkung.kompakt(2) + " " + einheit;
    }

    funghi gesamt() { serviere (wirkung * anzahl); }

    // Kaufmenge: k Stück kosten genau die Summe der (gerundeten) Einzelpreise – wie k Einzelkäufe.
    funghi kostenFür(salami k) {
        funghi summe = 0;
        für (salami i : [0 .. k - 1]) { summe += kostenBei(anzahl + i); }
        serviere (summe);
    }

    // So viele Stück, wie die Kasse hergibt (höchstens 1000).
    salami maxFür(funghi geld) {
        salami k = 0;
        funghi summe = 0;
        solange (k < 1000) {
            funghi nächster = kostenBei(anzahl + k);
            falls (summe + nächster > geld) { serviere (k); }
            summe += nächster;
            k++;
        }
        serviere (k);
    }
}

// ──────────────────── Nonnas Geheimrezepte (Talentbaum) ─────────────────
// Kosten Michelin-Sterne. Ein ausgegebener Stern bringt keine +10 % mehr –
// dafür wirkt das Rezept bis zur nächsten Franchise-Gründung.
klasse Geheimrezept {
    margherita schlüssel;
    margherita symbol;
    margherita name;
    margherita text;
    salami kosten;
    margherita braucht;     // "" = Wurzel des Baums

    Geheimrezept(margherita s, margherita sym, margherita n, salami k, margherita b, margherita t) {
        schlüssel = s; symbol = sym; name = n; kosten = k; braucht = b; text = t;
    }
}

// ─────────────────────────── Herausforderungen ──────────────────────────
// Ein Lauf unter Auflagen: beginnt wie eine Neueröffnung, Ziel ist Umsatz in
// dieser Runde. Geschafft → Belohnung für immer (auch nach Franchise).
klasse Herausforderung {
    margherita schlüssel;
    margherita symbol;
    margherita name;
    margherita regel;
    margherita belohnung;
    funghi ziel;

    Herausforderung(margherita s, margherita sym, margherita n, funghi z, margherita r, margherita b) {
        schlüssel = s; symbol = sym; name = n; ziel = z; regel = r; belohnung = b;
    }
}

// ─────────────────────────────── Erfolge ────────────────────────────────
klasse Erfolg {
    margherita name;
    margherita text;
    Funktion bedingung;     // (Spiel s) -> diavolo

    Erfolg(margherita n, margherita t, Funktion b) { name = n; text = t; bedingung = b; }
    diavolo erreicht(Spiel s) { serviere (bedingung.rufe(s)); }
}

// ─────────────────────────────── Das Spiel ──────────────────────────────
// Kennt keine Oberfläche: rechnet nur und schreibt die letzte Neuigkeit in `nachricht`.
// Zeit zählt in Sekunden (Takt-Schlägen).
klasse Spiel {
    // Kasse & Statistik: diese Runde / seit Eröffnung der ersten Pizzeria
    funghi geld = 0;
    funghi pizzen = 0;
    funghi umsatz = 0;
    funghi umsatzKlick = 0;          // davon durch Klicken (diese Runde)
    funghi pizzenAllzeit = 0;
    funghi umsatzAllzeit = 0;
    funghi umsatzKlickAllzeit = 0;
    funghi umsatzKette = 0;          // seit der letzten Franchise-Gründung (zählt für Sterne)
    salami klicks = 0;
    salami sekunden = 0;
    salami hawaiiBekehrt = 0;
    salami pünktlich = 0;
    salami sonderschichten = 0;
    salami perfekte = 0;
    Blech<margherita> erfolge = [];
    margherita nachricht = "Willkommen in deiner Trattoria! Klick auf „Pizza backen!“.";

    // Aufstieg
    salami sterne = 0;               // aktive Sterne (+10 % je Stern)
    salami sterneVergeben = 0;       // in dieser Kette verliehen, auch die ausgegebenen
    salami sterneAllzeit = 0;
    salami neueröffnungen = 0;
    salami filialen = 0;             // Franchise: +100 % auf alles je Filiale
    salami franchises = 0;
    Blech<margherita> talente = [];  // gelernte Geheimrezepte
    Blech<margherita> geschafft = [];// bestandene Herausforderungen
    margherita modus = "";           // laufende Herausforderung

    // Minispiele (die Regeln stehen in der Spielecke, hier nur Pause, Statistik und Belohnung)
    salami minispielPause = 0;       // Sekunden, bis Nonna wieder mitspielt
    salami minispieleGespielt = 0;
    salami minispieleGewonnen = 0;
    Blech<margherita> minispielSiege = [];   // welche Minispiele schon einmal gewonnen wurden
    funghi umsatzMini = 0;           // durch Minispiele (diese Runde)
    funghi umsatzMiniAllzeit = 0;

    Blech<Upgrade> handwerk = [
        neu Upgrade("teigschaber", "🥄", "Teigschaber", 100, 1, "klick",
            "Kratzt den letzten Rest Teig aus der Schüssel."),
        neu Upgrade("nudelholz", "🪵", "Nudelholz aus Olivenholz", 2_500, 2, "klick",
            "Von Nonnas Olivenbaum. Rollt praktisch von allein."),
        neu Upgrade("kurier", "🚲", "Fahrradkurier", 40_000, 0.05, "anteil",
            "Fährt bei jedem Wetter – und bringt Großbestellungen 1 € Trinkgeld."),
        neu Upgrade("tarantella", "🎵", "Tarantella-Rhythmus", 1_500_000, 0.05, "anteil",
            "Wer im Takt knetet, knetet doppelt."),
        neu Upgrade("roboter", "🦾", "Pizza-Roboter Pietro", 80_000_000, 0.05, "anteil",
            "Pietro wirft den Teig bis an die Decke. Fängt ihn meistens."),
        neu Upgrade("vesuv", "🌋", "Glut vom Vesuv", 5_000_000_000, 0.05, "anteil",
            "Echte Vulkanglut. Der Ofen ist in 90 Sekunden heiß – na ja, in 9.")
    ];
    Blech<Upgrade> betrieb = [
        neu Upgrade("lehrling", "🧑‍🍳", "Pizzaiolo-Lehrling", 50, 0.5, "betrieb",
            "Backt alle zwei Sekunden eine Pizza. Mit Liebe."),
        neu Upgrade("steinofen", "🧱", "Steinofen", 600, 4, "betrieb",
            "Jeder Steinofen macht auch die Sonderschicht 20 °C heißer."),
        neu Upgrade("roller", "🛵", "Lieferroller", 7_000, 18, "betrieb",
            "Liefert bis an die Haustür – und bringt Großbestellungen 1 € Trinkgeld."),
        neu Upgrade("wuppertal", "🏪", "Filiale in Wuppertal", 80_000, 80, "betrieb",
            "Mit Blick auf die Schwebebahn."),
        neu Upgrade("teigfabrik", "🏭", "Teigfabrik", 1_000_000, 360, "betrieb",
            "Zwölf Tonnen Teig am Tag. Nonna ist skeptisch."),
        neu Upgrade("satellit", "🛰️", "Pizza-Satellit", 12_000_000, 1_600, "betrieb",
            "Liefert per Fallschirm. Die Pizza kommt warm an (Wiedereintritt)."),
        neu Upgrade("mond", "🌙", "Pizzeria auf dem Mond", 170_000_000, 7_000, "betrieb",
            "Geringe Schwerkraft – perfekt für luftigen Teig."),
        neu Upgrade("zentrale", "🏢", "Franchise-Zentrale", 2_500_000_000, 30_000, "betrieb",
            "Gibt es erst ab der ersten Franchise-Filiale. Steuert die ganze Kette.")
    ];

    // Fünf Ketten (🔥 Ofen, 🫙 Teig, 🎉 Gäste, 🧦 Nonna, 🎲 Spiel): Jedes Rezept braucht das vorige seiner Kette.
    // Sichtbar sind nur die drei billigsten offenen (Welle), gelernte verschwinden.
    Blech<Geheimrezept> REZEPTE = [
        neu Geheimrezept("holzofen", "🔥", "Holzofen-Glut", 1, "", "Der ganze Betrieb backt +50 %."),
        neu Geheimrezept("sauerteig", "🫙", "Sauerteig von 1890", 1, "", "Jede Pizza bringt 20 % mehr."),
        neu Geheimrezept("stammgäste", "🎉", "Stammgäste", 2, "", "Ereignisse kommen doppelt so oft, Hawaii-Gäste und Großbestellungen bringen doppelt so viel."),
        neu Geheimrezept("sparstrumpf", "🧦", "Nonnas Sparstrumpf", 2, "", "Jede Neueröffnung beginnt mit 10 Lehrlingen und 5 Steinöfen."),
        neu Geheimrezept("gedächtnis", "📖", "Nonnas Gedächtnis", 3, "sauerteig", "Das Rezeptbuch bleibt bei Neueröffnungen aufgeschlagen."),
        neu Geheimrezept("kartenspiel", "🃏", "Nonnas Kartenspiel", 3, "", "Nonna mogelt beim Scopa – die Minispiel-Pause dauert nur 90 statt 120 Sekunden."),
        neu Geheimrezept("lavastein", "🌋", "Lavastein-Ofen", 4, "holzofen", "Die Sonderschicht backt doppelt so lange und kühlt in 45 statt 120 Sekunden ab."),
        neu Geheimrezept("mundpropaganda", "🗣", "Mundpropaganda", 4, "stammgäste", "Die halbe Stadt hilft beim Ausliefern: Großbestellungen kommen immer pünktlich."),
        neu Geheimrezept("erbstück", "💍", "Nonnas Erbstück", 5, "sparstrumpf", "Jede Neueröffnung beginnt zusätzlich mit 10 Lieferrollern und der Filiale in Wuppertal."),
        neu Geheimrezept("langteig", "⏳", "72-Stunden-Teig", 6, "gedächtnis", "Drei Tage Gehzeit: Jede Pizza bringt 30 % mehr."),
        neu Geheimrezept("diplomatie", "🍍", "Hawaii-Diplomatie", 6, "mundpropaganda", "Bekehrte Hawaii-Gäste bestellen dreimal so viel."),
        neu Geheimrezept("glückspilz", "🍀", "Glückspilz", 6, "kartenspiel", "Jede dreiunddreißigste Pizza wird perfekt (3 % statt 2 %)."),
        neu Geheimrezept("vesuvkamin", "🏔", "Vesuv-Kamin", 7, "lavastein", "Der Ofen wird bis 535 °C heiß – die Sonderschicht schafft mehr Ladungen."),
        neu Geheimrezept("familienbetrieb", "👪", "Familienbetrieb", 8, "erbstück", "Die Familie backt mit, während du weg bist: drei Viertel statt halber Kraft (weiterhin höchstens 30 Minuten)."),
        neu Geheimrezept("freitagslegende", "🕺", "Freitags-Legende", 9, "diplomatie", "Der Freitagabend-Ansturm dauert 60 statt 30 Sekunden."),
        neu Geheimrezept("mutterhefe", "🧫", "Mutterhefe aus Neapel", 10, "langteig", "Seit 1890 gefüttert, nie ausgegangen: Jede Pizza bringt 50 % mehr."),
        neu Geheimrezept("abo", "🎟", "Spielecken-Abo", 10, "glückspilz", "Minispiel-Siege bringen 50 % mehr."),
        neu Geheimrezept("ewigeglut", "♨", "Ewige Glut", 11, "vesuvkamin", "Der Ofen kühlt nie richtig ab: Nach der Sonderschicht ist er in 20 Sekunden wieder bereit."),
        neu Geheimrezept("segen", "🙌", "Nonnas Segen", 12, "familienbetrieb", "Jeder aktive Michelin-Stern bringt +12 % statt +10 %."),
        neu Geheimrezept("kultstatus", "🌟", "Kultstatus", 14, "freitagslegende", "Die Pizzeria ist Kult: Alle Ereignis-Boni (Hawaii-Gäste, Großbestellungen) zählen doppelt."),
        neu Geheimrezept("seele", "💛", "Teig mit Seele", 15, "mutterhefe", "Eine perfekte Pizza zählt 25-fach statt 10-fach."),
        neu Geheimrezept("ofenflüsterer", "🔮", "Ofenflüsterer", 16, "ewigeglut", "Du hörst, was der Ofen will: Der ganze Betrieb backt +100 %.")
    ];

    Blech<Herausforderung> HERAUSFORDERUNGEN = [
        neu Herausforderung("neapel", "🔥", "Neapel-Modus", 5_000_000,
            "Nur Holzofen: Im Betrieb backen ausschließlich Lehrlinge und Steinöfen.",
            "Lehrlinge und Steinöfen backen für immer dreifach."),
        neu Herausforderung("hawaii", "🍍", "Hawaii-Verbot verschärft", 1_000_000_000,
            "Nonna traut keinem Belag mehr: Rezeptbuch gesperrt, nur Margherita – und Hawaii-Gäste fliegen raus.",
            "Jede Pizza bringt für immer 25 % mehr."),
        neu Herausforderung("fastenzeit", "🙏", "Fastenzeit", 5_000_000_000,
            "Kein Klicken, keine Sonderschicht, keine Feste, keine Minispiele: Nur der Betrieb backt, Ereignisse fallen aus. 3 Lehrlinge helfen beim Start.",
            "Der ganze Betrieb backt für immer +25 %.")
    ];

    // Nonnas Rezeptbuch: jede Seite legt einen Belag auf die Margherita.
    Pizza rezept = ((Tomate, Mozzarella, Basilikum));
    salami seite = 0;
    Blech<Belag> SEITEN = [Salami, Pilze, Oliven, Parmesan, Rucola, Gorgonzola, Artischocken, Knoblauch];
    Blech<funghi> SEITEN_KOSTEN = [800, 15_000, 250_000, 4_000_000, 60_000_000, 900_000_000, 12_000_000_000, 150_000_000_000];

    // Ereignisse und Ofen (in Sekunden)
    margherita effekt = "";
    salami effektRest = 0;
    funghi freitagPizzen = 0;
    salami bisEreignis = 60;
    salami ofenKühlt = 0;

    // ── Kennzahlen ── zwischengespeichert; neuBerechnen() nach jeder Änderung an
    // Upgrades, Rezept, Sternen, Talenten, Modus oder Effekt. `version` sagt der Oberfläche: alles neu zeichnen.
    funghi klickWert = 1;
    funghi sekundeWert = 0;
    funghi preisWert = 8;
    salami version = 0;

    diavolo kennt(margherita talent) { serviere (talente.enthält(talent)); }
    diavolo bestanden(margherita h) { serviere (geschafft.enthält(h)); }

    salami prozentJeStern() { serviere (kennt("segen") ? 12 : 10); }

    // Alles-Faktor: Sterne × Filialen × Freitagabend
    funghi faktor() {
        serviere ((1 + sterne * prozentJeStern() / 100) * (1 + filialen) * (effekt == "freitag" ? 3 : 1));
    }

    leer neuBerechnen() {
        funghi f = faktor();
        funghi fb = f * (kennt("holzofen") ? 1.5 : 1) * (kennt("ofenflüsterer") ? 2 : 1) * (bestanden("fastenzeit") ? 1.25 : 1);
        funghi s = 0;
        für (Upgrade u : betrieb) {
            diavolo holzofen = u.schlüssel == "lehrling" || u.schlüssel == "steinofen";
            s = s + u.gesamt() * (holzofen && bestanden("neapel") ? 3 : 1);
        }
        sekundeWert = s * fb;
        // Klick: ein paar feste Pizzen (mit Sternen/Filialen) + ein kleiner Anteil der Sekundenproduktion
        funghi fest = 1;
        funghi anteil = 0;
        für (Upgrade u : handwerk) {
            falls (u.art == "klick") { fest = fest + u.gesamt(); } sonst { anteil = anteil + u.gesamt(); }
        }
        klickWert = (fest * f + anteil / 100 * sekundeWert) * (effekt == "fussball" ? 5 : 1);
        preisWert = rezept.preis() * (kennt("sauerteig") ? 1.2 : 1) * (kennt("langteig") ? 1.3 : 1) * (kennt("mutterhefe") ? 1.5 : 1)
            * (bestanden("hawaii") ? 1.25 : 1);
        version++;
    }

    funghi preis() { serviere (preisWert); }
    funghi proKlick() { serviere (klickWert); }
    funghi proSekunde() { serviere (sekundeWert); }

    // Für Boni: eine „Portion“ ist ein Klick oder eine Sekunde Betrieb – was mehr ist.
    funghi portion() { serviere (Mathe.max(proKlick(), proSekunde())); }

    Upgrade finde(margherita schlüssel) {
        für (Upgrade u : handwerk) { falls (u.schlüssel == schlüssel) { serviere (u); } }
        für (Upgrade u : betrieb) { falls (u.schlüssel == schlüssel) { serviere (u); } }
        serviere (karton);
    }

    salami anzahl(margherita schlüssel) { serviere (finde(schlüssel).anzahl); }

    salami trinkgeld() { serviere (anzahl("kurier") + anzahl("roller")); }
    salami ofenTemperatur() { serviere (Mathe.min(kennt("vesuvkamin") ? 535 : 485, 250 + 20 * anzahl("steinofen") + 10 * sterne)); }

    margherita rezeptName() {
        Blech<margherita> b = rezept.beläge();
        falls (b.länge() <= 3) { serviere ("Margherita"); }
        Blech<margherita> extra = [];
        für (salami i : [4 .. b.länge()]) { extra.hinzu(b.stück(i)); }
        serviere ("Margherita mit " + extra.verbinde(", "));
    }

    tiefkühl margherita pizzen(funghi x) {
        serviere (x.kompakt(1) + (x == 1 ? " Pizza" : " Pizzen"));
    }

    // ── Backen & Verkaufen ──
    funghi backe(funghi n) {
        pizzen += n;
        pizzenAllzeit += n;
        funghi erlös = n * preis();
        geld += erlös;
        umsatz += erlös;
        umsatzAllzeit += erlös;
        umsatzKette += erlös;
        falls (effekt == "freitag") { freitagPizzen += n; }
        serviere (erlös);
    }

    leer melde(margherita text) {
        nachricht = text;
        Bote.sage((text));
    }

    diavolo darfKlicken() { serviere (modus != "fastenzeit"); }

    leer klick() {
        falls (!darfKlicken()) { serviere; }
        klicks++;
        funghi n = proKlick();
        // Glückstreffer: jede fünfzigste Pizza wird perfekt – und zählt zehnfach.
        falls (Zufall.wahr(kennt("glückspilz") ? 0.03 : 0.02)) {
            perfekte++;
            n = n * (kennt("seele") ? 25 : 10);
            nachricht = "✨ Perfekte Pizza! Der Rand ist ein Gedicht: " + pizzen(n) + " auf einmal.";
        }
        funghi erlös = backe(n);
        umsatzKlick += erlös;
        umsatzKlickAllzeit += erlös;
    }

    // Takt: n Sekunden sind vergangen (n > 1, wenn der Renderer nachholt).
    leer vergehe(salami n) {
        sekunden += n;
        falls (minispielPause > 0) { minispielPause = Mathe.max(0, minispielPause - n); }
        salami rest = n;
        // Ein laufender Effekt gilt nur für seine Restdauer.
        falls (effekt != "" && effektRest < rest) {
            backe(proSekunde() * effektRest);
            rest = rest - effektRest;
            ticke(effektRest);
        }
        backe(proSekunde() * rest);
        ticke(rest);
    }

    leer ticke(salami n) {
        falls (ofenKühlt > 0) { ofenKühlt = Mathe.max(0, ofenKühlt - n); }
        falls (effekt != "") {
            effektRest = effektRest - n;
            falls (effektRest <= 0) { beendeEffekt(); }
            serviere;
        }
        bisEreignis = bisEreignis - n;
        falls (bisEreignis <= 0) {
            falls (modus != "fastenzeit") { ereignis(); }   // Fastenzeit: keine Feste
            bisEreignis = kennt("stammgäste") ? Zufall.zahl(30, 75) : Zufall.zahl(60, 150);
        }
    }

    // ── Ereignisse ──
    leer ereignis() {
        margherita welches = Zufall.wähle(["freitag", "fussball", "hawaii", "großbestellung"]);
        falls (welches == "freitag") {
            effekt = "freitag"; effektRest = kennt("freitagslegende") ? 60 : 30; freitagPizzen = 0;
            melde(("🎉 Freitagabend-Ansturm! " + effektRest + " Sekunden lang backt alles dreifach."));
        } sonst falls (welches == "fussball") {
            effekt = "fussball"; effektRest = 20;
            melde(("⚽ Fußballabend! 20 Sekunden lang backt jeder Klick fünfmal so viel."));
        } sonst falls (welches == "hawaii") {
            hawaii();
        } sonst {
            großbestellung();
        }
        neuBerechnen();
    }

    leer beendeEffekt() {
        falls (effekt == "freitag") {
            melde(("Der Freitagabend ist vorbei: " + pizzen(freitagPizzen) + " in der Rushhour."));
        } sonst {
            melde(("Abpfiff. Die Fans gehen satt nach Hause."));
        }
        effekt = "";
        effektRest = 0;
        neuBerechnen();
    }

    salami gästeFaktor() { serviere ((kennt("stammgäste") ? 2 : 1) * (kennt("kultstatus") ? 2 : 1)); }

    leer hawaii() {
        falls (modus == "hawaii") {
            melde(("🍍 Hawaii-Verbot verschärft: Luigi zeigt dem Gast freundlich, aber bestimmt die Tür. Nonna nickt."));
            serviere;
        }
        hawaiiBekehrt++;
        funghi bonus = portion() * 5 * gästeFaktor() * (kennt("diplomatie") ? 3 : 1);
        backe(bonus);
        melde(("🍍 Ein Gast bestellt Pizza Hawaii. Luigi lächelt, schweigt und serviert eine Margherita aufs Haus. "
            + "Der Gast ist bekehrt und bestellt " + pizzen(bonus) + "!"));
    }

    // Lieferung mit Trinkgeld: Mehr Kuriere/Roller → mehr Trinkgeld → größeres Budget → pünktlich.
    leer großbestellung() {
        salami bleche = Zufall.zahl(10, 40);
        salami tg = trinkgeld();
        Lieferung<salami> l = bestelle(() -> {
            salami fertig = 0;
            für (salami i : [1 .. bleche]) { fertig++; }
            serviere (fertig);
        });
        l.trinkgeld(tg);
        Zustellung<salami> z = l.warte(max: 40ms);
        falls (z.pünktlich() || kennt("mundpropaganda")) {
            pünktlich++;
            funghi bonus = bleche * portion() * gästeFaktor();
            backe(bonus);
            margherita wie = kennt("mundpropaganda") ? "dank Mundpropaganda" : (tg == 0 ? "auch ohne Trinkgeld" : "dank " + tg + " € Trinkgeld");
            melde(("📦 Großbestellung über " + bleche + " Bleche – " + wie + " pünktlich geliefert: +"
                + (bonus * preis()).euro(kompakt: ja) + "."));
        } sonst {
            melde(("📦 Großbestellung über " + bleche + " Bleche – leider zu spät, die Pizza ist kalt. "
                + "Mehr Kuriere und Roller bringen mehr Trinkgeld."));
        }
    }

    // Minispiel gewonnen: so viele Pizzen, wie in `sek` Sekunden gebacken werden (bzw. ein Klick, wenn der mehr bringt).
    funghi minispielGewinn(salami sek) {
        funghi n = portion() * sek * (kennt("abo") ? 1.5 : 1);
        funghi erlös = backe(n);
        umsatzMini += erlös;
        umsatzMiniAllzeit += erlös;
        serviere (n);
    }

    // ── Aktionen der Spielerin ──
    diavolo erlaubt(Upgrade u) {
        falls (u.schlüssel == "zentrale" && filialen <= 0) { serviere (nein); }
        falls (modus == "neapel" && u.art == "betrieb") { serviere (u.schlüssel == "lehrling" || u.schlüssel == "steinofen"); }
        serviere (ja);
    }

    // k Stück auf einmal (Kaufmenge 1×/10×/100×/Max) – nur ganz oder gar nicht.
    diavolo kaufe(Upgrade u, salami k) {
        falls (k < 1 || !erlaubt(u)) { serviere (nein); }
        funghi summe = u.kostenFür(k);
        falls (geld < summe) { serviere (nein); }
        geld -= summe;
        u.setzeAnzahl(u.anzahl + k);
        nachricht = u.symbol + " " + u.name + (k > 1 ? " ×" + k : "") + " gekauft (jetzt " + u.anzahl + ").";
        neuBerechnen();
        serviere (ja);
    }

    diavolo rezeptFertig() { serviere (seite >= SEITEN.länge()); }
    diavolo rezeptGesperrt() { serviere (modus == "hawaii"); }
    funghi seitenKosten() { serviere (rezeptFertig() ? 0 : SEITEN_KOSTEN.stück(seite + 1)); }

    diavolo blättere() {
        falls (rezeptGesperrt() || rezeptFertig() || geld < seitenKosten()) { serviere (nein); }
        geld -= seitenKosten();
        seite++;
        Belag b = SEITEN.stück(seite);
        rezept = rezept + b;
        neuBerechnen();
        melde(("📖 Nonna verrät Seite " + seite + ": " + b + "! Eine Pizza kostet jetzt " + preis().euro() + "."
            + (rezeptFertig() ? " Das Rezeptbuch ist ausgelesen – Nonna legt es zurück in die Schublade. Grazie, Nonna!" : "")));
        serviere (ja);
    }

    diavolo ofenBereit() { serviere (ofenKühlt <= 0 && modus != "fastenzeit"); }

    // Sonderschicht: Der Ofen backt Ladung um Ladung, bis sein Zeitbudget aufgebraucht ist.
    // Heißer (mehr Steinöfen, mehr Sterne) = größeres Budget = mehr Ladungen.
    leer sonderschicht() {
        falls (!ofenBereit()) { serviere; }
        salami grad = ofenTemperatur();
        salami ladungen = ofen(temperatur: grad, zeit: 100ms * (kennt("lavastein") ? 2 : 1)) {
            salami n = 0;
            solange (ja) { n++; zwischenstand((n)); }
        } roh (r) {
            serviere (r.teilergebnis());
        };
        sonderschichten++;
        ofenKühlt = kennt("ewigeglut") ? 20 : (kennt("lavastein") ? 45 : 120);
        funghi bonus = ladungen * portion();
        backe(bonus);
        melde(("🔥 Sonderschicht bei " + grad + " °C: " + ladungen + " Ofenladungen, " + pizzen(bonus) + "."));
    }

    // ── Ebene 1: Neueröffnung (Michelin-Sterne) ──
    salami sterneVerdient() { serviere (Mathe.boden(Mathe.wurzel(umsatzKette / 1_000_000))); }
    salami neueSterne() { serviere (Mathe.max(0, sterneVerdient() - sterneVergeben)); }
    funghi sternSchwelle(salami n) { serviere (n * n * 1_000_000); }
    funghi nächsterStern() { serviere (sternSchwelle(sterneVerdient() + 1)); }
    // Anteil des Wegs vom letzten zum nächsten Stern (für den Balken)
    funghi sternFortschritt() {
        funghi von = sternSchwelle(sterneVerdient());
        serviere (Mathe.min(1, (umsatzKette - von) / (nächsterStern() - von)));
    }

    salami vergebeSterne() {
        salami n = neueSterne();
        sterne += n; sterneVergeben += n; sterneAllzeit += n;
        serviere (n);
    }

    leer setzeRundeZurück() {
        geld = 0; pizzen = 0; umsatz = 0; umsatzKlick = 0; umsatzMini = 0;
        für (Upgrade u : handwerk) { u.setzeAnzahl(0); }
        für (Upgrade u : betrieb) { u.setzeAnzahl(0); }
        falls (kennt("sparstrumpf")) {
            finde("lehrling").setzeAnzahl(10);
            finde("steinofen").setzeAnzahl(5);
        }
        falls (kennt("erbstück")) {
            finde("roller").setzeAnzahl(10);
            finde("wuppertal").setzeAnzahl(1);
        }
        falls (!kennt("gedächtnis")) {
            rezept = ((Tomate, Mozzarella, Basilikum));
            seite = 0;
        }
        modus = "";
        effekt = ""; effektRest = 0; freitagPizzen = 0; ofenKühlt = 0; bisEreignis = 60;
    }

    diavolo neueröffnung() {
        falls (neueSterne() <= 0) { serviere (nein); }
        margherita abbruch = modus != "" ? " Die Herausforderung ist damit beendet." : "";
        salami neu_ = vergebeSterne();
        neueröffnungen++;
        setzeRundeZurück();
        neuBerechnen();
        melde(("⭐ Neueröffnung! Der Guide Michelin vergibt " + neu_ + (neu_ == 1 ? " Stern" : " Sterne")
            + " – jetzt " + sterne + " aktiv, also +" + (sterne * prozentJeStern()) + " % auf alles." + abbruch));
        serviere (ja);
    }

    // ── Ebene 2: Geheimrezepte ──
    diavolo rezepteOffen() { serviere (sterneAllzeit >= 1); }
    diavolo lernbar(Geheimrezept r) {
        serviere (rezepteOffen() && sterne >= r.kosten && offeneRezepte().enthält(r));
    }
    Geheimrezept rezeptNamens(margherita s) {
        für (Geheimrezept r : REZEPTE) { falls (r.schlüssel == s) { serviere (r); } }
        serviere (karton);
    }

    // Welle: höchstens WELLE_REZEPTE offene Rezepte (Voraussetzung erfüllt, noch nicht gelernt) – die billigsten zuerst.
    // Gelernte verschwinden, das nächste Glied rückt nach.
    salami WELLE_REZEPTE = 3;
    Blech<Geheimrezept> offeneRezepte() {
        Blech<Geheimrezept> offen = REZEPTE.filtere((r) -> (!kennt(r.schlüssel) && (r.braucht == "" || kennt(r.braucht))))
            .sortiere((a, b) -> (a.kosten - b.kosten));
        Blech<Geheimrezept> welle = [];
        für (Geheimrezept r : offen) { falls (welle.länge() < WELLE_REZEPTE) { welle.hinzu(r); } }
        serviere (welle);
    }

    diavolo lerne(Geheimrezept r) {
        falls (!lernbar(r)) { serviere (nein); }
        sterne -= r.kosten;
        talente.hinzu(r.schlüssel);
        neuBerechnen();
        melde(("📜 Nonna flüstert dir ein Geheimnis zu: " + r.symbol + " " + r.name + ". " + r.text));
        serviere (ja);
    }

    // ── Ebene 3: Herausforderungen ──
    diavolo herausforderungenOffen() { serviere (sterneAllzeit >= 3); }
    Herausforderung herausforderung(margherita s) {
        für (Herausforderung h : HERAUSFORDERUNGEN) { falls (h.schlüssel == s) { serviere (h); } }
        serviere (karton);
    }

    diavolo startbar(Herausforderung h) {
        serviere (herausforderungenOffen() && modus == "" && !bestanden(h.schlüssel));
    }

    diavolo starte(Herausforderung h) {
        falls (!startbar(h)) { serviere (nein); }
        salami neu_ = vergebeSterne();
        falls (neu_ > 0) { neueröffnungen++; }
        setzeRundeZurück();
        modus = h.schlüssel;
        falls (modus == "neapel") {      // nur Holzofen – Nonnas Erbstück bleibt im Keller
            für (Upgrade u : betrieb) { falls (!erlaubt(u)) { u.setzeAnzahl(0); } }
        }
        falls (modus == "hawaii") {      // nur Margherita – auch mit Nonnas Gedächtnis
            rezept = ((Tomate, Mozzarella, Basilikum));
            seite = 0;
        }
        falls (modus == "fastenzeit") {
            Upgrade l = finde("lehrling");
            l.setzeAnzahl(Mathe.max(l.anzahl, 3));
        }
        neuBerechnen();
        melde((h.symbol + " Herausforderung „" + h.name + "“ beginnt" + (neu_ > 0 ? " (+" + neu_ + " ⭐)" : "") + ": " + h.regel
            + " Ziel: " + h.ziel.euro(kompakt: ja) + " Umsatz."));
        serviere (ja);
    }

    leer gibAuf() {
        falls (modus == "") { serviere; }
        Herausforderung h = herausforderung(modus);
        modus = "";
        neuBerechnen();
        melde(("🏳 " + h.name + " aufgegeben. Die Runde geht ohne Auflagen weiter."));
    }

    funghi zielFortschritt() {
        falls (modus == "") { serviere (0); }
        serviere (Mathe.min(1, umsatz / herausforderung(modus).ziel));
    }

    leer prüfeZiel() {
        falls (modus == "") { serviere; }
        Herausforderung h = herausforderung(modus);
        falls (umsatz < h.ziel) { serviere; }
        geschafft.hinzu(h.schlüssel);
        modus = "";
        neuBerechnen();
        melde(("🏅 Herausforderung „" + h.name + "“ geschafft! Belohnung für immer: " + h.belohnung));
    }

    // ── Ebene 4: Franchise ──
    // Filialen insgesamt = ⌊√(Sterne insgesamt ÷ 2,5)⌋: 25 Sterne → 3, 40 → 4, 63 → 5, 90 → 6 …
    // Gründen geht erst ab 25 Sternen in der laufenden Kette und nur, wenn es mindestens eine neue Filiale gibt.
    salami sterneKette() { serviere (sterneVergeben + neueSterne()); }
    salami filialenFür(salami s) { serviere (Mathe.boden(Mathe.wurzel(s / 2.5))); }
    salami neueFilialen() {
        falls (sterneKette() < 25) { serviere (0); }
        serviere (Mathe.max(0, filialenFür(sterneAllzeit + neueSterne()) - filialen));
    }
    // Sterne insgesamt, ab denen es die nächste Filiale gibt
    salami sterneFürFiliale(salami f) { serviere (Mathe.decke(f * f * 2.5)); }

    diavolo franchise() {
        falls (neueFilialen() <= 0) { serviere (nein); }
        salami n = neueFilialen();
        vergebeSterne();
        filialen += n; franchises++;
        sterne = 0; sterneVergeben = 0; umsatzKette = 0;
        talente = [];
        setzeRundeZurück();
        neuBerechnen();
        melde(("🏢 Die Kette ist gegründet! " + n + " neue Filialen – jetzt " + filialen + ", also +" + (filialen * 100)
            + " % auf alles. Sterne und Geheimrezepte fangen von vorn an, die Franchise-Zentrale ist freigeschaltet."));
        serviere (ja);
    }

    // Alles auf Anfang – auch Sterne, Filialen, Erfolge und Statistik.
    leer allesZurück() {
        talente = [];
        setzeRundeZurück();
        pizzenAllzeit = 0; umsatzAllzeit = 0; umsatzKlickAllzeit = 0; umsatzKette = 0; klicks = 0; sekunden = 0;
        sterne = 0; sterneVergeben = 0; sterneAllzeit = 0; neueröffnungen = 0; filialen = 0; franchises = 0;
        hawaiiBekehrt = 0; pünktlich = 0; sonderschichten = 0; perfekte = 0;
        minispielPause = 0; minispieleGespielt = 0; minispieleGewonnen = 0; minispielSiege = []; umsatzMiniAllzeit = 0;
        erfolge = []; geschafft = [];
        neuBerechnen();
        nachricht = "Frischer Teig, leere Kasse – auf ein Neues!";
    }

    // ── Spielstand (für die Vorratskammer) ──
    Speisekarte<margherita, Vorrat> alsSpeisekarte() {
        Speisekarte<margherita, Vorrat> s = neu Speisekarte<margherita, Vorrat>();
        s.lege("version", 4).lege("zeit", Uhr.echt().inMs());
        s.lege("geld", geld).lege("pizzen", pizzen).lege("umsatz", umsatz).lege("umsatzKlick", umsatzKlick);
        s.lege("pizzenAllzeit", pizzenAllzeit).lege("umsatzAllzeit", umsatzAllzeit);
        s.lege("umsatzKlickAllzeit", umsatzKlickAllzeit).lege("umsatzKette", umsatzKette);
        s.lege("klicks", klicks).lege("sekunden", sekunden).lege("sterne", sterne).lege("neueröffnungen", neueröffnungen);
        s.lege("sterneVergeben", sterneVergeben).lege("sterneAllzeit", sterneAllzeit);
        s.lege("filialen", filialen).lege("franchises", franchises);
        s.lege("talente", talente).lege("geschafft", geschafft).lege("modus", modus);
        s.lege("hawaiiBekehrt", hawaiiBekehrt).lege("pünktlich", pünktlich).lege("sonderschichten", sonderschichten);
        s.lege("perfekte", perfekte).lege("seite", seite).lege("erfolge", erfolge);
        s.lege("minispielPause", minispielPause).lege("minispieleGespielt", minispieleGespielt);
        s.lege("minispieleGewonnen", minispieleGewonnen).lege("minispielSiege", minispielSiege);
        s.lege("umsatzMini", umsatzMini).lege("umsatzMiniAllzeit", umsatzMiniAllzeit);
        Speisekarte<margherita, salami> stück = neu Speisekarte<margherita, salami>();
        für (Upgrade u : handwerk) { stück.lege(u.schlüssel, u.anzahl); }
        für (Upgrade u : betrieb) { stück.lege(u.schlüssel, u.anzahl); }
        s.lege("upgrades", stück);
        serviere (s);
    }

    // Ältere Spielstände (version 2 bis 4) kennen manche Felder nicht – hole(k, ersatz) liefert dann den Standardwert.
    leer ladeAus(Speisekarte<margherita, Vorrat> s) {
        geld = s.hole("geld", 0); pizzen = s.hole("pizzen", 0); umsatz = s.hole("umsatz", 0);
        umsatzKlick = s.hole("umsatzKlick", 0);
        pizzenAllzeit = s.hole("pizzenAllzeit", 0); umsatzAllzeit = s.hole("umsatzAllzeit", 0);
        umsatzKlickAllzeit = s.hole("umsatzKlickAllzeit", 0);
        umsatzKette = s.hole("umsatzKette", umsatzAllzeit);
        klicks = s.hole("klicks", 0); sekunden = s.hole("sekunden", 0);
        sterne = s.hole("sterne", 0); neueröffnungen = s.hole("neueröffnungen", 0);
        sterneVergeben = s.hole("sterneVergeben", sterne); sterneAllzeit = s.hole("sterneAllzeit", sterne);
        filialen = s.hole("filialen", 0); franchises = s.hole("franchises", 0);
        talente = s.hole("talente", []); geschafft = s.hole("geschafft", []);
        modus = s.hole("modus", "");
        hawaiiBekehrt = s.hole("hawaiiBekehrt", 0); pünktlich = s.hole("pünktlich", 0);
        sonderschichten = s.hole("sonderschichten", 0); perfekte = s.hole("perfekte", 0);
        erfolge = s.hole("erfolge", []);
        minispielPause = s.hole("minispielPause", 0); minispieleGespielt = s.hole("minispieleGespielt", 0);
        minispieleGewonnen = s.hole("minispieleGewonnen", 0); minispielSiege = s.hole("minispielSiege", []);
        umsatzMini = s.hole("umsatzMini", 0); umsatzMiniAllzeit = s.hole("umsatzMiniAllzeit", 0);
        Speisekarte<margherita, salami> stück = s.hole("upgrades", neu Speisekarte<margherita, salami>());
        für (Upgrade u : handwerk) { u.setzeAnzahl(stück.hole(u.schlüssel, 0)); }
        für (Upgrade u : betrieb) { u.setzeAnzahl(stück.hole(u.schlüssel, 0)); }
        rezept = ((Tomate, Mozzarella, Basilikum));
        seite = 0;
        salami ziel = Mathe.min(s.hole("seite", 0), SEITEN.länge());
        solange (seite < ziel) { seite++; rezept = rezept + SEITEN.stück(seite); }
        neuBerechnen();
        nachricht = "Willkommen zurück! Dein Imperium hat auf dich gewartet.";

        // Offline-Fortschritt: Der Betrieb backt weiter – mit halber Kraft (Familienbetrieb: drei Viertel), höchstens 30 Minuten lang.
        salami weg = Mathe.boden((Uhr.echt().inMs() - s.hole("zeit", Uhr.echt().inMs())) / 1000);
        salami gezählt = Mathe.min(weg, 30 * 60);
        minispielPause = Mathe.max(0, minispielPause - Mathe.max(0, weg));   // Nonnas Pause läuft auch offline ab
        diavolo familie = kennt("familienbetrieb");
        funghi nachts = proSekunde() * gezählt * (familie ? 0.75 : 0.5);
        falls (gezählt >= 60 && nachts > 0) {
            backe(nachts);
            melde(("🌙 Während du weg warst (" + (1min * Mathe.boden(weg / 60)) + (weg > gezählt ? " – gezählt werden höchstens 30min" : "")
                + "), hat dein Betrieb mit " + (familie ? "drei Vierteln" : "halber") + " Kraft " + pizzen(nachts) + " gebacken: +" + (nachts * preis()).euro(kompakt: ja) + "."));
        }
    }
}

// ─────────────────────────────── Minispiele ─────────────────────────────
// Kurz und freiwillig: Ein Sieg bringt so viele Pizzen, wie der Betrieb in ein
// paar Sekunden backt. Danach macht Nonna zwei Minuten Pause (für alle Spiele
// gemeinsam) – so bleibt der Betrieb das Herz des Imperiums.
klasse Minispiel {
    margherita schlüssel;
    margherita symbol;
    margherita name;
    margherita regel;
    salami belohnung;       // Sekunden Produktion
    Dauer schlag;           // so schnell schlägt die Uhr während des Spiels

    Minispiel(margherita s, margherita sym, margherita n, salami b, Dauer d, margherita r) {
        schlüssel = s; symbol = sym; name = n; belohnung = b; schlag = d; regel = r;
    }
}

// Die Spielecke kennt keine Oberfläche: Sie rechnet, schreibt `status` und meldet
// Sieg oder Niederlage über das Spiel. Die Spieluhr ruft tick(n).
klasse Spielecke {
    Spiel s;
    salami PAUSE = 120;
    Blech<Minispiel> SPIELE = [
        neu Minispiel("teig", "🫓", "Teig fangen", 8, 150ms,
            "Luigi wirft den Teig in die Luft – fang ihn, wenn 🫓 über dem grünen Feld ▬▬▬ schwebt."),
        neu Minispiel("bestellung", "🧾", "Bestellung merken", 10, 500ms,
            "Ein Gast diktiert vier Beläge. Merk sie dir drei Sekunden lang und klick sie in der richtigen Reihenfolge nach."),
        neu Minispiel("ofen", "🌡", "Ofen halten", 10, 500ms,
            "Der Ofen kühlt ständig ab. Halte ihn 10 Sekunden zwischen 380 und 440 °C – mindestens 7 Sekunden müssen sitzen."),
        neu Minispiel("route", "🛵", "Lieferroute", 8, 500ms,
            "Drei Wege zum Kunden: Wähle binnen 10 Sekunden den schnellsten. Fahrzeit: 2 min je km, 1 min je Ampel, 4 min je Staustufe.")
    ];
    Blech<margherita> BELÄGE = ["🍅 Tomate", "🧀 Mozzarella", "🍄 Pilze", "🫒 Oliven", "🍕 Salami", "🌿 Basilikum"];
    Blech<margherita> STRASSEN = ["Via Roma", "Lungomare", "Corso Garibaldi", "Vicolo Stretto", "Ponte Vecchio", "Piazza Dante"];
    Blech<margherita> STAU = ["🟢 frei", "🟡 zäh", "🔴 Stau"];

    margherita läuft = "";      // Schlüssel des laufenden Spiels ("" = keins)
    margherita status = "";
    salami ticks = 0;
    // Teig fangen: der Zeiger pendelt über 21 Felder, das Ziel ist 3 Felder breit
    salami zone = 0;
    // Bestellung merken
    Blech<margherita> folge = [];
    salami geraten = 0;
    diavolo zeigt = nein;
    // Ofen halten
    salami grad = 0;
    salami imZiel = 0;
    // Lieferroute (Fahrzeit in Zehntelminuten – ganzzahlig, damit Gleichstand exakt ist)
    Blech<margherita> wege = [];
    Blech<margherita> routen = [];
    Blech<salami> fahrzeit = [];

    Spielecke(Spiel sp) { s = sp; }

    Minispiel spielNamens(margherita k) {
        für (Minispiel m : SPIELE) { falls (m.schlüssel == k) { serviere (m); } }
        serviere (karton);
    }
    diavolo erlaubt() { serviere (s.modus != "fastenzeit"); }
    diavolo bereit() { serviere (läuft == "" && s.minispielPause <= 0 && erlaubt()); }
    Dauer intervall() { serviere (läuft == "" ? 500ms : spielNamens(läuft).schlag); }

    diavolo starte(margherita k) {
        falls (!bereit()) { serviere (nein); }
        läuft = k;
        ticks = 0;
        falls (k == "teig") {
            zone = Zufall.zahl(6, 15);
            status = "Klick auf „Fangen!“, wenn 🫓 über dem grünen Feld ▬▬▬ schwebt.";
        } sonst falls (k == "bestellung") {
            folge = [];
            für (salami i : [1 .. 4]) { folge.hinzu(Zufall.wähle(BELÄGE)); }
            geraten = 0;
            zeigt = ja;
            status = "Merk dir die Bestellung – gleich ist sie weg!";
        } sonst falls (k == "ofen") {
            grad = 410;
            imZiel = 0;
            status = "Ziel: 380 bis 440 °C. Holz nachlegen heizt um 25 °C, Klappe auf kühlt um 25 °C.";
        } sonst {
            Blech<margherita> namen = Zufall.mische(STRASSEN);
            wege = []; routen = []; fahrzeit = [];
            für (salami i : [1 .. 3]) {
                salami zehntel = Zufall.zahl(15, 60);   // 1,5 bis 6 km
                salami ampeln = Zufall.zahl(0, 6);
                salami stau = Zufall.zahl(0, 2);
                wege.hinzu(namen.stück(i));
                fahrzeit.hinzu(zehntel * 2 + ampeln * 10 + stau * 40);
                routen.hinzu(namen.stück(i) + ": " + (zehntel / 10).kompakt(1) + " km · " + ampeln + " 🚦 · " + STAU.stück(stau + 1));
            }
            status = "Fahrzeit: 2 min je km, 1 min je Ampel, 4 min je Staustufe (🟡 1, 🔴 2).";
        }
        serviere (ja);
    }

    // ── Teig fangen ──
    salami zeiger() {
        salami p = ticks % 40;
        serviere (p <= 20 ? p : 40 - p);
    }
    diavolo imZiel(salami i) { serviere (i >= zone && i <= zone + 2); }
    diavolo imFeld() { serviere (imZiel(zeiger())); }
    // Was auf Feld i (0…20) der Bahn zu sehen ist
    margherita feld(salami i) { serviere (i == zeiger() ? "🫓" : (imZiel(i) ? "▬" : "·")); }
    leer fange() {
        falls (läuft != "teig") { serviere; }
        falls (imFeld()) { gewinne("Gefangen! Luigi applaudiert, der Boden wird hauchdünn."); }
        sonst { verliere("Daneben – der Teig klebt an der Decke."); }
    }

    // ── Bestellung merken ──
    leer tippe(margherita b) {
        falls (läuft != "bestellung" || zeigt) { serviere; }
        falls (folge.stück(geraten + 1) != b) {
            verliere("Falsch – der Gast wollte " + folge.verbinde(", ") + ".");
            serviere;
        }
        geraten++;
        falls (geraten >= folge.länge()) { gewinne("Genau so bestellt! Der Gast ist begeistert."); }
        sonst { status = "Richtig! Noch " + (folge.länge() - geraten) + " Beläge."; }
    }
    margherita bestellungText() {
        falls (zeigt) { serviere (folge.verbinde(" → ")); }
        Blech<margherita> teile = [];
        für (salami i : [1 .. folge.länge()]) { teile.hinzu(i <= geraten ? folge.stück(i) : "❓"); }
        serviere (teile.verbinde(" → "));
    }

    // ── Ofen halten ──
    leer heize(salami d) {
        falls (läuft != "ofen") { serviere; }
        grad = Mathe.max(250, Mathe.min(485, grad + d));
    }
    diavolo ofenImZiel() { serviere (grad >= 380 && grad <= 440); }

    // ── Lieferroute ──
    leer nimmRoute(salami i) {
        falls (läuft != "route") { serviere; }
        salami beste = Mathe.min(fahrzeit.stück(1), fahrzeit.stück(2), fahrzeit.stück(3));
        margherita weg = wege.stück(i);
        falls (fahrzeit.stück(i) <= beste) {
            gewinne("Über " + weg + " in " + (fahrzeit.stück(i) / 10).kompakt(1) + " min – schneller geht's nicht!");
        } sonst {
            verliere("Über " + weg + " dauert es " + (fahrzeit.stück(i) / 10).kompakt(1) + " min, der schnellste Weg nur "
                + (beste / 10).kompakt(1) + " min.");
        }
    }

    // Die Spieluhr: n Schläge sind vergangen (n > 1, wenn der Renderer nachholt).
    leer tick(salami n) {
        falls (läuft == "") { serviere; }
        falls (!erlaubt()) {
            läuft = "";
            status = "";
            s.melde(("🎲 Fastenzeit – Nonna räumt die Spiele weg."));
            serviere;
        }
        falls (läuft == "teig") {
            ticks += n;
            falls (ticks >= 80) { verliere("Zu spät – der Teig ist auf dem Boden gelandet."); }
        } sonst falls (läuft == "bestellung") {
            ticks += n;
            falls (zeigt && ticks >= 6) {
                zeigt = nein;
                ticks = 0;
                status = "Jetzt du: Klick die Beläge in der richtigen Reihenfolge.";
            } sonst falls (!zeigt && ticks >= 30) {
                verliere("Zu langsam – der Gast hat sich eine Calzone bestellt.");
            }
        } sonst falls (läuft == "ofen") {
            salami k = Mathe.min(n, 20 - ticks);
            solange (k > 0) {
                k--;
                ticks++;
                grad = Mathe.max(250, Mathe.min(485, grad + Zufall.zahl(-16, 6)));
                falls (ofenImZiel() && ticks % 2 == 0) { imZiel++; }   // gezählt wird jede volle Sekunde
            }
            falls (ticks >= 20) {
                falls (imZiel >= 7) { gewinne("Sauber gehalten – " + imZiel + " von 10 Sekunden im Ziel."); }
                sonst { verliere("Nur " + imZiel + " von 10 Sekunden im Ziel – die Pizza ist ungleichmäßig."); }
            }
        } sonst {
            ticks += n;
            falls (ticks >= 20) { verliere("Zu lange überlegt – der Kunde hat abgesagt."); }
        }
    }

    // Wert für den Balken (0…1)
    funghi balken() {
        falls (läuft == "teig") { serviere (zeiger() / 20); }
        falls (läuft == "bestellung") { serviere (zeigt ? 1 - ticks / 6 : 1 - ticks / 30); }
        falls (läuft == "ofen") { serviere ((grad - 250) / 235); }
        falls (läuft == "route") { serviere (1 - ticks / 20); }
        serviere (0);
    }

    leer gewinne(margherita text) {
        Minispiel m = spielNamens(läuft);
        funghi n = s.minispielGewinn(m.belohnung);
        s.minispieleGewonnen++;
        falls (!s.minispielSiege.enthält(m.schlüssel)) { s.minispielSiege.hinzu(m.schlüssel); }
        beende();
        s.melde((m.symbol + " " + m.name + ": " + text + " +" + Spiel.pizzen(n) + " (" + (n * s.preis()).euro(kompakt: ja) + ")."));
    }

    leer verliere(margherita text) {
        Minispiel m = spielNamens(läuft);
        beende();
        s.melde((m.symbol + " " + m.name + ": " + text + " Diesmal kein Bonus."));
    }

    leer beende() {
        s.minispieleGespielt++;
        s.minispielPause = s.kennt("kartenspiel") ? 90 : PAUSE;
        läuft = "";
        status = "";
    }
}

// ═══════════════════════════════ Spielstart ═════════════════════════════
Spiel spiel = neu Spiel();
Spielecke ecke = neu Spielecke(spiel);

Blech<Erfolg> ERFOLGE = [
    neu Erfolg("Erste Margherita", "Backe deine erste Pizza.", (s) -> (s.pizzenAllzeit >= 1)),
    neu Erfolg("Ein Blech voll", "Backe 100 Pizzen.", (s) -> (s.pizzenAllzeit >= 100)),
    neu Erfolg("Tausendsassa", "Backe 1.000 Pizzen.", (s) -> (s.pizzenAllzeit >= 1000)),
    neu Erfolg("Pizzamillionär", "Backe 1 Million Pizzen.", (s) -> (s.pizzenAllzeit >= 1_000_000)),
    neu Erfolg("Fleißige Hände", "Klicke 100-mal.", (s) -> (s.klicks >= 100)),
    neu Erfolg("Sehnenscheide aus Stahl", "Klicke 1.000-mal.", (s) -> (s.klicks >= 1000)),
    neu Erfolg("Perfektionist", "Backe drei perfekte Pizzen.", (s) -> (s.perfekte >= 3)),
    neu Erfolg("412 Pizzen an einem Freitag", "Backe 412 Pizzen in einem einzigen Freitagabend-Ansturm.",
        (s) -> (s.freitagPizzen >= 412)),   // freitagPizzen zählt nur während des Ansturms
    neu Erfolg("Standhaft", "Bekehre drei Hawaii-Gäste zur Margherita.", (s) -> (s.hawaiiBekehrt >= 3)),
    neu Erfolg("Pünktlich wie die Post", "Liefere drei Großbestellungen pünktlich.", (s) -> (s.pünktlich >= 3)),
    neu Erfolg("Heiße Nächte", "Fahre fünf Sonderschichten.", (s) -> (s.sonderschichten >= 5)),
    neu Erfolg("Nonnas Spielkamerad", "Gewinne jedes der vier Minispiele einmal.", (s) -> (s.minispielSiege.länge() >= 4)),
    neu Erfolg("Stammspieler", "Spiele 25 Minispiele.", (s) -> (s.minispieleGespielt >= 25)),
    neu Erfolg("Nonnas Liebling", "Lies Nonnas Rezeptbuch bis zur letzten Seite.", (s) -> (s.rezeptFertig())),
    neu Erfolg("Wuppertal ruft", "Eröffne eine Filiale in Wuppertal.", (s) -> (s.anzahl("wuppertal") >= 1)),
    neu Erfolg("Erste Million", "Mache 1 Mio. € Umsatz.", (s) -> (s.umsatzAllzeit >= 1_000_000)),
    neu Erfolg("Sternekoch", "Eröffne neu und hol dir einen Michelin-Stern.", (s) -> (s.sterneAllzeit >= 1)),
    neu Erfolg("Firmament", "Sammle zehn Michelin-Sterne.", (s) -> (s.sterneAllzeit >= 10)),
    neu Erfolg("Nonnas Vertraute", "Lerne ein Geheimrezept.", (s) -> (!s.talente.istLeer())),
    neu Erfolg("Fastenbrecher", "Schaffe die Fastenzeit – ganz ohne Klicken.", (s) -> (s.bestanden("fastenzeit"))),
    neu Erfolg("Prüfungsmeister", "Schaffe alle drei Herausforderungen.", (s) -> (s.geschafft.länge() >= 3)),
    neu Erfolg("Kettenreaktion", "Gründe deine erste Franchise-Kette.", (s) -> (s.filialen >= 1))
];

// Vorratskammer: Spielstand laden (Playground: Browser-Speicher, EXE: Datei im Nutzerverzeichnis).
Vorratskammer kammer = neu Vorratskammer("pizza-imperium");
falls (kammer.hat("spielstand")) { spiel.ladeAus(kammer.hole("spielstand")); }
salami seitSpeichern = 0;

leer speichere() {
    kammer.lege("spielstand", spiel.alsSpeisekarte());
    seitSpeichern = 0;
}

// ═══════════════════════════════ Oberfläche ═════════════════════════════
leer setzeText(Schild s, margherita t) { falls (s.text() != t) { s.setzeText((t)); } }

// Rückfrage vor jedem Neustart: Der erste Klick fragt, der zweite (binnen 10 Sekunden) bestätigt.
margherita frageId = "";
salami frageRest = 0;

diavolo bestätigt(Knopf k, margherita frage) {
    falls (frageId == k.id()) { frageId = ""; serviere (ja); }
    frageId = k.id();
    frageRest = 10;
    k.setzeText((frage));
    spiel.version++;      // andere offene Rückfrage zurücksetzen
    serviere (nein);
}

leer setzeKnopf(Knopf k, margherita t, diavolo an) {
    falls (k.id() == frageId) { falls (!k.aktiv()) { k.aktiv(ja); } serviere; }   // Rückfrage steht noch
    falls (k.text() != t) { k.setzeText((t)); }
    falls (k.aktiv() != an) { k.aktiv(an); }
}

// Eine Zeile im Laden: Beschriftung, Fortschrittsbalken bis zum Kauf, Kauf-Knopf mit Hinweis.
klasse UpgradeZeile {
    Upgrade u;
    Schild info;
    Fortschritt balken;
    Knopf knopf;
    Reihe reihe;
    salami stufe = -1;     // zuletzt gezeigte Balkenstufe (0…20), spart Nachrichten
    diavolo erlaubt = ja;
    salami summeMenge = -1; // für diese Kaufmenge und Stückzahl ist `summe` ausgerechnet
    salami summeAnzahl = -1;
    funghi summe = 0;

    UpgradeZeile(Upgrade upgrade, Funktion beiKauf) {
        u = upgrade;
        info = neu Schild("", id: "info-" + u.schlüssel);
        info.stil("schrift", "klein");
        balken = neu Fortschritt(id: "balken-" + u.schlüssel);
        balken.stil("farbe", "basilikum");
        Stapel links = neu Stapel([info, balken]);
        links.stil("breite", 340).stil("abstand", 2);
        knopf = neu Knopf("", beiKauf, id: "kauf-" + u.schlüssel);
        knopf.stil("breite", 130).hinweis(u.beschreibung);
        reihe = neu Reihe([links, knopf], id: "zeile-" + u.schlüssel);
        reihe.stil("abstand", 8);
    }

    leer beschrifte(Spiel s) {
        erlaubt = s.erlaubt(u);
        falls (info.text() != u.zeile) { info.setzeText((u.zeile)); }
        falls (!erlaubt) {
            margherita grund = s.modus == "" ? "🔒 Franchise" : "🚫 " + s.herausforderung(s.modus).name;
            falls (knopf.text() != grund) { knopf.setzeText((grund)); }
        }
        stufe = -1;
    }

    leer zeigeWenn(diavolo an) { falls (reihe.sichtbar() != an) { reihe.sichtbar(an); } }

    // menge: 1, 10, 100 oder 0 (= Max). Der Knopf zeigt den Preis zuerst, dann die Menge.
    leer zeichne(funghi geld, salami menge) {
        falls (!erlaubt) {
            falls (knopf.aktiv()) { knopf.aktiv(nein); }
            falls (stufe != 0) { stufe = 0; balken.setzeWert(0); }
            serviere;
        }
        salami k = menge;
        falls (menge == 0) { k = u.maxFür(geld); }
        salami gerechnet = Mathe.max(k, 1);
        falls (summeMenge != gerechnet || summeAnzahl != u.anzahl) {
            summe = u.kostenFür(gerechnet);
            summeMenge = gerechnet;
            summeAnzahl = u.anzahl;
        }
        margherita text = summe < 1_000_000_000_000_000_000_000 ? summe.euro(kompakt: ja) : "unbezahlbar";
        falls (menge == 0) { text = text + (k > 0 ? " (Max " + k + ")" : " (Max)"); } sonst falls (menge > 1) { text = text + " (×" + menge + ")"; }
        falls (knopf.text() != text) { knopf.setzeText((text)); }
        diavolo leistbar = k >= 1 && geld >= summe;
        salami st = leistbar ? 20 : Mathe.boden(geld / summe * 20);
        falls (st == stufe) { serviere; }
        stufe = st;
        falls (knopf.aktiv() != leistbar) { knopf.aktiv(leistbar); }
        balken.setzeWert(st / 20);
    }
}

// Eine Zeile in Nonnas Geheimrezepten
klasse RezeptZeile {
    Geheimrezept r;
    Schild info;
    Knopf knopf;
    Reihe reihe;

    RezeptZeile(Geheimrezept rezept, Funktion beiKlick) {
        r = rezept;
        info = neu Schild("", id: "geheim-info-" + r.schlüssel);
        info.stil("schrift", "klein").stil("breite", 340);
        knopf = neu Knopf("", beiKlick, id: "geheim-" + r.schlüssel);
        knopf.stil("breite", 130).hinweis(r.text);
        reihe = neu Reihe([info, knopf], id: "geheim-zeile-" + r.schlüssel);
        reihe.stil("abstand", 8);
    }

    leer zeichne(Spiel s) {
        margherita voraus = r.braucht == "" ? "" : " (braucht " + s.rezeptNamens(r.braucht).name + ")";
        setzeText(info, r.symbol + " " + r.name + voraus + " – " + r.text);
        setzeKnopf(knopf, r.kosten + " ⭐ lernen", s.lernbar(r));
    }
}

// Eine Zeile bei den Herausforderungen
klasse HerausforderungZeile {
    Herausforderung h;
    Schild titel;
    Schild info;
    Knopf knopf;
    Reihe reihe;

    HerausforderungZeile(Herausforderung herausforderung, Funktion beiKlick) {
        h = herausforderung;
        titel = neu Schild(h.symbol + " " + h.name + " – Ziel " + h.ziel.euro(kompakt: ja) + " Umsatz in einer Runde", id: "probe-titel-" + h.schlüssel);
        info = neu Schild(h.regel + " Belohnung: " + h.belohnung, id: "probe-info-" + h.schlüssel);
        info.stil("schrift", "klein");
        Stapel links = neu Stapel([titel, info]);
        links.stil("breite", 340).stil("abstand", 2);
        knopf = neu Knopf("", beiKlick, id: "probe-" + h.schlüssel);
        knopf.stil("breite", 130).hinweis("Startet eine Neueröffnung unter Auflagen (wartende Sterne gibt es dazu). Kasse, Upgrades und Rezeptbuch fangen von vorn an.");
        reihe = neu Reihe([links, knopf], id: "probe-zeile-" + h.schlüssel);
        reihe.stil("abstand", 8);
    }

    leer zeichne(Spiel s) {
        falls (s.bestanden(h.schlüssel)) {
            setzeKnopf(knopf, "✅ geschafft", nein);
        } sonst falls (s.modus == h.schlüssel) {
            setzeKnopf(knopf, "⏳ läuft", nein);
        } sonst {
            setzeKnopf(knopf, "▶ Starten", s.startbar(h));
        }
    }
}

// Eine Zeile in Nonnas Spielecke
klasse MinispielZeile {
    Minispiel m;
    Schild titel;
    Schild info;
    Knopf knopf;
    Reihe reihe;

    MinispielZeile(Minispiel mini, Funktion beiKlick) {
        m = mini;
        titel = neu Schild(m.symbol + " " + m.name + " – Gewinn: " + m.belohnung + " Sekunden Produktion", id: "mini-titel-" + m.schlüssel);
        info = neu Schild(m.regel, id: "mini-info-" + m.schlüssel);
        info.stil("schrift", "klein");
        Stapel links = neu Stapel([titel, info]);
        links.stil("breite", 340).stil("abstand", 2);
        knopf = neu Knopf("", beiKlick, id: "mini-" + m.schlüssel);
        knopf.stil("breite", 130).hinweis("Ein Sieg bringt so viele Pizzen, wie dein Betrieb in " + m.belohnung
            + " Sekunden backt (oder ein Klick, wenn der mehr bringt). Danach macht Nonna zwei Minuten Pause – für alle Spiele.");
        reihe = neu Reihe([links, knopf], id: "mini-zeile-" + m.schlüssel);
        reihe.stil("abstand", 8);
    }

    leer zeichne(Spielecke e, Spiel s) {
        falls (e.läuft == m.schlüssel) {
            setzeKnopf(knopf, "⏳ läuft", nein);
        } sonst falls (!e.erlaubt()) {
            setzeKnopf(knopf, "🙏 Fastenzeit", nein);
        } sonst falls (s.minispielPause > 0) {
            setzeKnopf(knopf, "☕ noch " + (Mathe.decke(s.minispielPause / 10) * 10) + " s", nein);
        } sonst {
            setzeKnopf(knopf, "▶ Spielen", e.läuft == "");
        }
    }
}

Theke theke = neu Theke("Pizza-Imperium", breite: 660, hoehe: 780);

// ── Kopf: immer sichtbar ──
Schild kasse = neu Schild("", id: "kasse");
kasse.stil("schrift", "riesig").stil("farbe", "basilikum").stil("ausrichtung", "mitte");
Schild kennzahlen = neu Schild("", id: "kennzahlen");
kennzahlen.stil("schrift", "klein").stil("ausrichtung", "mitte");
Schild modusInfo = neu Schild("", id: "modus-info");
modusInfo.stil("schrift", "klein").stil("farbe", "kruste").stil("ausrichtung", "mitte");
modusInfo.sichtbar(nein);

Knopf backen = neu Knopf("", () -> { spiel.klick(); nachVerarbeitung(); }, id: "backen");
backen.stil("schrift", "gross").stil("farbe", "tomate").stil("hoehe", 64).stil("ausrichtung", "mitte");
backen.hinweis("Eine Pizza backen und sofort zum Rezeptpreis verkaufen. Später bringt jeder Klick zusätzlich einen kleinen Anteil der Sekundenproduktion – das große Geld macht der Betrieb.");

Knopf ofenKnopf = neu Knopf("", () -> { spiel.sonderschicht(); nachVerarbeitung(); }, id: "sonderschicht");
ofenKnopf.stil("farbe", "kruste").stil("ausrichtung", "mitte");
ofenKnopf.hinweis("Der Ofen backt Ladung um Ladung, bis sein Zeitbudget leer ist. Heißer = mehr Ladungen.");

Schild meldung = neu Schild("", id: "meldung");
meldung.stil("farbe", "tomate").stil("ausrichtung", "mitte");

// ── Reiter 1: Backstube ──
Blech<UpgradeZeile> zeilen = [];

Abschnitt upgradeAbschnitt(margherita titel, Blech<Upgrade> liste, margherita id) {
    Abschnitt a = neu Abschnitt(titel, [], id: id);
    a.stil("abstand", 6);
    für (Upgrade u : liste) {
        UpgradeZeile z = neu UpgradeZeile(u, () -> {
            falls (spiel.kaufe(u, kaufMenge == 0 ? u.maxFür(spiel.geld) : kaufMenge)) { nachVerarbeitung(); }
        });
        zeilen.hinzu(z);
        a.hinzu(z.reihe);
    }
    serviere (a);
}

Schild rezeptInfo = neu Schild("", id: "rezept-info");
rezeptInfo.stil("schrift", "klein");
Knopf rezeptKnopf = neu Knopf("", () -> {
    falls (spiel.blättere()) { nachVerarbeitung(); }
}, id: "rezept");
rezeptKnopf.hinweis("Jede Seite legt einen Belag auf – die Pizza wird teurer, und jede verkaufte bringt mehr.");
Abschnitt rezeptTeil = neu Abschnitt("📖 Nonnas Rezeptbuch", [rezeptInfo, rezeptKnopf], id: "rezeptbuch");

// ── Kaufmenge 1× · 10× · 100× · Max ── taucht auf, sobald es sich lohnt (10 Stück von irgendwas oder nach der ersten Neueröffnung)
salami kaufMenge = 1;     // 0 = Max
Blech<salami> MENGEN = [1, 10, 100, 0];
Blech<Knopf> mengenKnöpfe = [];
Schild mengeSchild = neu Schild("Kaufmenge:", id: "kaufmenge-text");
mengeSchild.stil("schrift", "klein");
Reihe kaufmengeReihe = neu Reihe([mengeSchild], id: "kaufmenge");
kaufmengeReihe.stil("abstand", 6).stil("ausrichtung", "mitte");
kaufmengeReihe.sichtbar(nein);
für (salami m : MENGEN) {
    Knopf k = neu Knopf(m == 0 ? "Max" : m + "×", () -> {
        kaufMenge = m;
        zeichneKaufmenge();
        zeichne();
    }, id: "menge-" + (m == 0 ? "max" : m.alsText()));
    k.stil("breite", 64).hinweis(m == 0 ? "So viele, wie die Kasse hergibt." : (m == 1 ? "Ein Stück pro Klick." : m + " Stück auf einmal – nur, wenn alle bezahlbar sind."));
    mengenKnöpfe.hinzu(k);
    kaufmengeReihe.hinzu(k);
}

Stapel backstube = neu Stapel([
    rezeptTeil,
    kaufmengeReihe,
    upgradeAbschnitt("🛠 Handwerk – mehr Pizzen pro Klick", spiel.handwerk, "handwerk"),
    upgradeAbschnitt("🏭 Betrieb – Pizzen pro Sekunde", spiel.betrieb, "betrieb")
], id: "backstube");
backstube.stil("abstand", 8);

// ── Reiter 2: Erfolge ──
Schild erfolgeKopf = neu Schild("", id: "erfolge-kopf");
erfolgeKopf.stil("schrift", "klein");
Tabelle erfolgTabelle = neu Tabelle(["", "Erfolg", "Ziel"], [], id: "erfolge");
Stapel erfolgeSeite = neu Stapel([erfolgeKopf, erfolgTabelle], id: "erfolge-seite");

// ── Reiter 3: Imperium (Neueröffnung, Franchise, Statistik) ──
Tabelle aufstieg = neu Tabelle(["Ebene", "Stand", "Wirkung"], [], id: "aufstieg");
Abschnitt aufstiegTeil = neu Abschnitt("🪜 Dein Aufstieg", [aufstieg], id: "aufstieg-teil");

Schild prestigeInfo = neu Schild("", id: "prestige-info");
prestigeInfo.stil("schrift", "klein");
Fortschritt prestigeBalken = neu Fortschritt(id: "prestige-balken");
prestigeBalken.stil("farbe", "kruste");
Knopf prestigeKnopf = neu Knopf("", () -> {
    falls (!bestätigt(prestigeKnopf, "⭐ Wirklich neu eröffnen? Nochmal klicken!")) { zeichne(); serviere; }
    falls (spiel.neueröffnung()) { speichere(); }
    nachVerarbeitung();
}, id: "neueroeffnung");
prestigeKnopf.stil("farbe", "mozzarella");
prestigeKnopf.hinweis("Kasse, Upgrades und Rezeptbuch fangen von vorn an – die Sterne bleiben (bis zur Franchise-Gründung). Eine laufende Herausforderung endet.");
Abschnitt sterneTeil = neu Abschnitt("⭐ Neueröffnung", [prestigeInfo, prestigeBalken, prestigeKnopf], id: "sterne");

Schild franchiseInfo = neu Schild("", id: "franchise-info");
franchiseInfo.stil("schrift", "klein");
Fortschritt franchiseBalken = neu Fortschritt(id: "franchise-balken");
franchiseBalken.stil("farbe", "tomate");
Knopf franchiseKnopf = neu Knopf("", () -> {
    falls (!bestätigt(franchiseKnopf, "🏢 Wirklich? Sterne und Geheimrezepte gehen in die Kette auf – nochmal klicken!")) { zeichne(); serviere; }
    falls (spiel.franchise()) { speichere(); }
    nachVerarbeitung();
}, id: "franchise");
franchiseKnopf.stil("farbe", "mozzarella");
franchiseKnopf.hinweis("Ab 25 Sternen in einer Kette. Filialen insgesamt = ⌊√(Sterne insgesamt ÷ 2,5)⌋ – 25 Sterne → 3, 40 → 4, 63 → 5, 90 → 6; jede Filiale +100 % auf alles, für immer. Sterne, Geheimrezepte und die Runde fangen von vorn an; Herausforderungen und Erfolge bleiben.");
Abschnitt franchiseTeil = neu Abschnitt("🏢 Franchise – Kette gründen", [franchiseInfo, franchiseBalken, franchiseKnopf], id: "franchise-teil");

Tabelle statistik = neu Tabelle(["Kennzahl", "Wert"], [], id: "statistik");
Abschnitt statistikTeil = neu Abschnitt("📊 Statistik", [statistik], id: "statistik-teil");

Knopf neuAnfangen = neu Knopf("🗑 Neu anfangen", () -> {
    falls (!bestätigt(neuAnfangen, "🗑 Wirklich alles löschen – auch Sterne und Filialen? Nochmal klicken!")) { zeichne(); serviere; }
    spiel.allesZurück();
    kammer.leeren();
    sortiereErfolge();
    nachVerarbeitung();
}, id: "neu-anfangen");
neuAnfangen.stil("farbe", "mozzarella").hinweis("Löscht den Spielstand in der Vorratskammer.");

Stapel imperium = neu Stapel([aufstiegTeil, sterneTeil, franchiseTeil, statistikTeil, neuAnfangen], id: "imperium");
imperium.stil("abstand", 8);

// ── Reiter 4: Nonnas Geheimnisse (Geheimrezepte, Herausforderungen) ──
Schild geheimInfo = neu Schild("", id: "geheim-kopf");
geheimInfo.stil("schrift", "klein");
Schild gelerntInfo = neu Schild("", id: "geheim-gelernt");
gelerntInfo.stil("schrift", "klein").stil("farbe", "basilikum");
gelerntInfo.sichtbar(nein);
Abschnitt geheimTeil = neu Abschnitt("📜 Nonnas Geheimrezepte", [geheimInfo, gelerntInfo], id: "geheimrezepte");
geheimTeil.stil("abstand", 6);
Blech<RezeptZeile> rezeptZeilen = [];
für (Geheimrezept r : spiel.REZEPTE) {
    RezeptZeile z = neu RezeptZeile(r, () -> {
        falls (spiel.lerne(r)) { speichere(); nachVerarbeitung(); }
    });
    rezeptZeilen.hinzu(z);
    geheimTeil.hinzu(z.reihe);
}

Schild probeInfo = neu Schild("", id: "probe-kopf");
probeInfo.stil("schrift", "klein");
Fortschritt zielBalken = neu Fortschritt(id: "ziel-balken");
zielBalken.stil("farbe", "basilikum");
Knopf aufgeben = neu Knopf("🏳 Aufgeben", () -> {
    falls (!bestätigt(aufgeben, "🏳 Wirklich aufgeben? Nochmal klicken!")) { zeichne(); serviere; }
    spiel.gibAuf();
    nachVerarbeitung();
}, id: "aufgeben");
aufgeben.stil("farbe", "mozzarella").hinweis("Die Auflagen fallen weg, die Runde läuft normal weiter – ohne Belohnung.");
Stapel laufend = neu Stapel([zielBalken, aufgeben], id: "probe-laufend");
laufend.sichtbar(nein);
Abschnitt probeTeil = neu Abschnitt("🏅 Herausforderungen", [probeInfo, laufend], id: "herausforderungen");
probeTeil.stil("abstand", 6);
Blech<HerausforderungZeile> probeZeilen = [];
für (Herausforderung h : spiel.HERAUSFORDERUNGEN) {
    HerausforderungZeile z = neu HerausforderungZeile(h, () -> {
        Knopf k = probeZeilen.filtere((p) -> (p.h == h)).erstes().knopf;
        falls (!bestätigt(k, "▶ Wirklich? Nochmal!")) { zeichne(); serviere; }
        falls (spiel.starte(h)) { speichere(); }
        nachVerarbeitung();
    });
    probeZeilen.hinzu(z);
    probeTeil.hinzu(z.reihe);
}

Stapel geheimnisse = neu Stapel([geheimTeil, probeTeil], id: "geheimnisse");
geheimnisse.stil("abstand", 8);

// ── Reiter 5: Minispiele (Nonnas Spielecke) ──
Schild miniKopf = neu Schild("", id: "mini-kopf");
miniKopf.stil("schrift", "klein");

// Das Spielfeld ist nur sichtbar, solange ein Spiel läuft; jedes Spiel hat seine eigenen Knöpfe.
Schild spielAnzeige = neu Schild("", id: "spiel-anzeige");
spielAnzeige.stil("schrift", "gross").stil("ausrichtung", "mitte");
Fortschritt spielBalken = neu Fortschritt(id: "spiel-balken");
spielBalken.stil("farbe", "kruste");
Schild spielStatus = neu Schild("", id: "spiel-status");
spielStatus.stil("schrift", "klein").stil("ausrichtung", "mitte");

// Die Bahn des Teigs: 21 Felder, das grüne Ziel ist 3 Felder breit.
Blech<Schild> teigFelder = [];
Reihe teigBahn = neu Reihe([], id: "teig-bahn");
teigBahn.stil("abstand", 0).stil("ausrichtung", "mitte");
für (salami i : [0 .. 20]) {
    Schild f = neu Schild("·", id: "teig-feld-" + i);
    f.stil("breite", 24).stil("ausrichtung", "mitte").stil("schrift", "gross");
    teigFelder.hinzu(f);
    teigBahn.hinzu(f);
}
Knopf fangen = neu Knopf("✋ Fangen!", () -> { ecke.fange(); nachVerarbeitung(); }, id: "teig-fangen");
fangen.stil("farbe", "tomate").stil("ausrichtung", "mitte").hinweis("Genau dann klicken, wenn 🫓 über dem grünen Feld schwebt.");
Stapel teigTeil = neu Stapel([teigBahn, fangen], id: "teig-teil");
teigTeil.stil("abstand", 8);

Blech<Knopf> belagKnöpfe = [];
Reihe belagReihe1 = neu Reihe([], id: "belag-reihe-1");
Reihe belagReihe2 = neu Reihe([], id: "belag-reihe-2");
für (salami i : [1 .. ecke.BELÄGE.länge()]) {
    margherita b = ecke.BELÄGE.stück(i);
    Knopf k = neu Knopf(b, () -> { ecke.tippe(b); nachVerarbeitung(); }, id: "belag-" + i);
    k.stil("breite", 150);
    belagKnöpfe.hinzu(k);
    falls (i <= 3) { belagReihe1.hinzu(k); } sonst { belagReihe2.hinzu(k); }
}
belagReihe1.stil("abstand", 6).stil("ausrichtung", "mitte");
belagReihe2.stil("abstand", 6).stil("ausrichtung", "mitte");
Stapel belagTeil = neu Stapel([belagReihe1, belagReihe2], id: "belag-teil");
belagTeil.stil("abstand", 6);

Knopf heizen = neu Knopf("🪵 Holz nachlegen", () -> { ecke.heize(25); nachVerarbeitung(); }, id: "ofen-heizen");
heizen.stil("farbe", "tomate").stil("breite", 200).hinweis("+25 °C");
Knopf lüften = neu Knopf("💨 Klappe auf", () -> { ecke.heize(-25); nachVerarbeitung(); }, id: "ofen-lueften");
lüften.stil("farbe", "mozzarella").stil("breite", 200).hinweis("−25 °C");
Reihe ofenTeil = neu Reihe([heizen, lüften], id: "ofen-teil");
ofenTeil.stil("abstand", 8).stil("ausrichtung", "mitte");

Blech<Knopf> routenKnöpfe = [];
Stapel routenTeil = neu Stapel([], id: "routen-teil");
routenTeil.stil("abstand", 6);
für (salami i : [1 .. 3]) {
    Knopf k = neu Knopf("", () -> { ecke.nimmRoute(i); nachVerarbeitung(); }, id: "route-" + i);
    routenKnöpfe.hinzu(k);
    routenTeil.hinzu(k);
}

Abschnitt spielfeld = neu Abschnitt("", [spielAnzeige, spielBalken, spielStatus, teigTeil, belagTeil, ofenTeil, routenTeil], id: "spielfeld");
spielfeld.stil("abstand", 8);
spielfeld.sichtbar(nein);

Abschnitt spieleTeil = neu Abschnitt("🎲 Nonnas Spielecke", [miniKopf], id: "spielecke");
spieleTeil.stil("abstand", 6);
Blech<MinispielZeile> miniZeilen = [];
für (Minispiel m : ecke.SPIELE) {
    MinispielZeile z = neu MinispielZeile(m, () -> {
        falls (ecke.starte(m.schlüssel)) { nachVerarbeitung(); }
    });
    miniZeilen.hinzu(z);
    spieleTeil.hinzu(z.reihe);
}

Stapel minispiele = neu Stapel([spielfeld, spieleTeil], id: "minispiele");
minispiele.stil("abstand", 8);

Reiter reiter = neu Reiter(["🍕 Backstube", "🏆 Erfolge", "⭐ Imperium", "📜 Geheimnisse", "🎲 Minispiele"],
    [backstube, erfolgeSeite, imperium, geheimnisse, minispiele], id: "reiter");
reiter.beiAenderung((n) -> { zeichne(); });   // Imperium/Geheimnisse werden nur gezeichnet, wenn man hinschaut

// ── Die Uhr der Backstube ──
// Eine Uhr für alles: Während eines Minispiels schlägt sie schneller (150 bzw. 500 ms); die Backstube
// bekommt die verstrichene Zeit trotzdem in ganzen Sekunden – der Betrieb backt also weiter.
salami taktMs = 1000;
salami msRest = 0;
Takt takt = neu Takt(1s, (n) -> {
    msRest = msRest + n * taktMs;
    salami sek = Mathe.boden(msRest / 1000);
    msRest = msRest - sek * 1000;
    diavolo spielLief = ecke.läuft != "";
    falls (spielLief) { ecke.tick(n); }
    falls (sek > 0) {
        spiel.vergehe(sek);
        falls (frageId != "") {
            frageRest = frageRest - sek;
            falls (frageRest <= 0) { frageId = ""; spiel.version++; }
        }
    }
    falls (sek > 0 || (spielLief && ecke.läuft == "")) { nachVerarbeitung(); } sonst { zeichneSpielfeld(); }
}, id: "takt");

// ─────────────────────────────── Zeichnen ───────────────────────────────
// voll   – nach Käufen, Rezeptseiten, Ereignissen (spiel.version hat sich geändert)
// leicht – bei jedem Klick und Takt: Kasse, Balken, Knöpfe; Imperium/Geheimnisse alle 5 Mal
salami gezeigteVersion = -1;
salami gezeigteErfolge = -1;
salami gezeigterOfen = -1;
salami gezeigterReiter = 1;
salami gemeldeteSterne = 0;
salami gemeldeteFilialen = 0;
salami aufrufe = 0;

Blech<Erfolg> offeneErfolge = [];
leer sortiereErfolge() {
    offeneErfolge = ERFOLGE.filtere((e) -> (!spiel.erfolge.enthält(e.name)));
}

leer prüfeErfolge() {
    Blech<Erfolg> neue = offeneErfolge.filtere((e) -> (e.erreicht(spiel)));
    falls (neue.istLeer()) { serviere; }
    offeneErfolge = offeneErfolge.filtere((e) -> (!neue.enthält(e)));
    für (Erfolg e : neue) {
        spiel.erfolge.hinzu(e.name);
        Bote.sage(("🏆 Erfolg: " + e.name + " – " + e.text));
        spiel.nachricht = "🏆 Erfolg freigeschaltet: " + e.name + "!";
    }
}

leer zeichneErfolge() {
    gezeigteErfolge = spiel.erfolge.länge();
    erfolgeKopf.setzeText(("Freigeschaltet: " + gezeigteErfolge + " von " + ERFOLGE.länge()
        + (gezeigteErfolge == 0 ? " – fang einfach an zu backen!" : "")));
    erfolgTabelle.setzeZeilen((ERFOLGE.belege((e) -> (spiel.erfolge.enthält(e.name)
        ? ["🏆", e.name, e.text]
        : ["🔒", "???", e.text]))));
}

margherita prozent(funghi teil, funghi ganz) {
    serviere ((ganz > 0 ? teil / ganz * 100 : 0).kompakt(1) + " %");
}

leer zeichneVoll() {
    gezeigteVersion = spiel.version;
    margherita zeile = Spiel.pizzen(spiel.proKlick()) + " pro Klick · " + spiel.proSekunde().kompakt(1)
        + " pro Sekunde · " + spiel.preis().euro() + " pro Pizza";
    falls (spiel.sterne > 0) { zeile = zeile + " · " + "⭐".wiederhole(Mathe.min(spiel.sterne, 5)) + (spiel.sterne > 5 ? "×" + spiel.sterne : ""); }
    falls (spiel.filialen > 0) { zeile = zeile + " · 🏢×" + spiel.filialen; }
    setzeText(kennzahlen, zeile);
    falls (spiel.darfKlicken()) {
        setzeKnopf(backen, "🍕 Pizza backen!  +" + spiel.proKlick().kompakt(1), ja);
    } sonst {
        setzeKnopf(backen, "🙏 Fastenzeit – heute wird nicht geknetet", nein);
    }

    falls (!kaufmengeReihe.sichtbar() && kaufmengeLohnt()) { kaufmengeReihe.sichtbar(ja); }

    // Upgrades: in jeder Liste erscheint das nächste, sobald das vorige gekauft ist.
    Upgrade vorher = karton;
    für (UpgradeZeile z : zeilen) {
        diavolo erstes = z.u == spiel.handwerk.erstes() || z.u == spiel.betrieb.erstes();
        diavolo freigeschaltet = z.u.schlüssel != "zentrale" || spiel.filialen > 0;
        z.zeigeWenn(freigeschaltet && (erstes || z.u.anzahl > 0 || vorher.anzahl > 0));
        z.beschrifte(spiel);
        vorher = z.u;
    }

    margherita imOfen = "Heute im Ofen: " + spiel.rezeptName() + " – " + spiel.preis().euro() + " pro Pizza";
    setzeText(rezeptInfo, imOfen);
    falls (kennzahlen.hinweis() != imOfen) { kennzahlen.hinweis((imOfen)); }
    // Ausgelesen: Das Rezeptbuch verschwindet und macht Platz (im Hawaii-Verbot bleibt es mit Schloss sichtbar).
    diavolo buchZeigen = !spiel.rezeptFertig() || spiel.rezeptGesperrt();
    falls (rezeptTeil.sichtbar() != buchZeigen) { rezeptTeil.sichtbar(buchZeigen); }
    falls (spiel.rezeptGesperrt()) {
        setzeKnopf(rezeptKnopf, "📖 Hawaii-Verbot: Nonna hat das Rezeptbuch weggeschlossen.", nein);
    } sonst falls (!spiel.rezeptFertig()) {
        setzeKnopf(rezeptKnopf, "📖 Seite " + (spiel.seite + 1) + " lesen: + " + spiel.SEITEN.stück(spiel.seite + 1)
            + " · " + spiel.seitenKosten().euro(kompakt: ja), spiel.geld >= spiel.seitenKosten());
    }
}

leer zeichneKaufmenge() {
    für (salami i : [1 .. MENGEN.länge()]) {
        Knopf k = mengenKnöpfe.stück(i);
        salami m = MENGEN.stück(i);
        diavolo gewählt = m == kaufMenge;
        k.stil("farbe", gewählt ? "basilikum" : "mozzarella");
        k.setzeText(((gewählt ? "✓ " : "") + (m == 0 ? "Max" : m + "×")));
    }
}

diavolo kaufmengeLohnt() {
    falls (spiel.neueröffnungen > 0 || spiel.franchises > 0) { serviere (ja); }
    für (UpgradeZeile z : zeilen) { falls (z.u.anzahl >= 10) { serviere (ja); } }
    serviere (nein);
}

leer zeichneImperium() {
    salami neu_ = spiel.neueSterne();
    salami ausgegeben = spiel.sterneVergeben - spiel.sterne;
    funghi f = (1 + spiel.sterne * spiel.prozentJeStern() / 100) * (1 + spiel.filialen);
    aufstieg.setzeZeilen(([
        ["⭐ Michelin-Sterne", spiel.sterne + " aktiv" + (ausgegeben > 0 ? " · " + ausgegeben + " ausgegeben" : ""),
            "+" + (spiel.sterne * spiel.prozentJeStern()) + " % auf alles"],
        ["📜 Geheimrezepte", spiel.rezepteOffen() ? spiel.talente.länge() + " von " + spiel.REZEPTE.länge() : "🔒 ab 1 ⭐",
            "gegen Sterne"],
        ["🏅 Herausforderungen", spiel.herausforderungenOffen() ? spiel.geschafft.länge() + " von " + spiel.HERAUSFORDERUNGEN.länge() : "🔒 ab 3 ⭐",
            "Boni für immer"],
        ["🏢 Franchise", (spiel.filialen > 0 ? spiel.filialen + (spiel.filialen == 1 ? " Filiale" : " Filialen") : (spiel.neueFilialen() > 0 ? "bereit" : "🔒 ab 25 ⭐ je Kette"))
            + (spiel.neueFilialen() > 0 ? " (+" + spiel.neueFilialen() + ")" : ""), "+" + (spiel.filialen * 100) + " % auf alles"],
        ["Zusammen", "×" + f.kompakt(2), "Sterne × Filialen"]
    ]));

    falls (neu_ > 0) {
        setzeText(prestigeInfo, "Der Guide Michelin ist begeistert! Neueröffnen bringt " + neu_ + (neu_ == 1 ? " Stern" : " Sterne")
            + " (+" + spiel.prozentJeStern() + " % je Stern), setzt aber Kasse, Upgrades und Rezeptbuch zurück.");
    } sonst {
        setzeText(prestigeInfo, "Nächster Michelin-Stern ab " + spiel.nächsterStern().euro(kompakt: ja) + " Umsatz in dieser Kette (bisher "
            + spiel.umsatzKette.euro(kompakt: ja) + ").");
    }
    prestigeBalken.setzeWert((spiel.sternFortschritt()));
    setzeKnopf(prestigeKnopf, "⭐ Neueröffnung" + (neu_ > 0 ? " (+" + neu_ + ")" : ""), neu_ > 0);

    salami kette = spiel.sterneKette();
    salami gesamt = spiel.sterneAllzeit + neu_;
    salami filialenNeu = spiel.neueFilialen();
    salami ziel = spiel.filialen + filialenNeu + 1;          // die nächste Filiale danach
    margherita nächste = "Die " + ziel + ". Filiale gibt es ab " + spiel.sterneFürFiliale(ziel) + " Sternen insgesamt (bisher " + gesamt + ").";
    falls (filialenNeu > 0) {
        setzeText(franchiseInfo, "Deine Sterne reichen für " + filialenNeu + (filialenNeu == 1 ? " neue Filiale" : " neue Filialen") + " (+"
            + (filialenNeu * 100) + " % auf alles, für immer). Sterne, Geheimrezepte und die Runde fangen dafür von vorn an. " + nächste);
    } sonst falls (kette < 25) {
        setzeText(franchiseInfo, "Eine Kette gründen kannst du ab 25 Sternen in der laufenden Kette (bisher " + kette + "). " + nächste);
    } sonst {
        setzeText(franchiseInfo, "Für eine neue Filiale fehlen noch Sterne. " + nächste);
    }
    salami von = spiel.sterneFürFiliale(ziel - 1);
    franchiseBalken.setzeWert((Mathe.min(kette / 25, (gesamt - von) / (spiel.sterneFürFiliale(ziel) - von))));
    setzeKnopf(franchiseKnopf, "🏢 Kette gründen" + (filialenNeu > 0 ? " (+" + filialenNeu + (filialenNeu == 1 ? " Filiale)" : " Filialen)") : ""), filialenNeu > 0);

    statistik.setzeZeilen(([
        ["Pizzen in dieser Runde", spiel.pizzen.kompakt(1)],
        ["Pizzen insgesamt", spiel.pizzenAllzeit.kompakt(1)],
        ["Umsatz insgesamt", spiel.umsatzAllzeit.euro(kompakt: ja)],
        ["Anteil Klicken am Umsatz", prozent(spiel.umsatzKlick, spiel.umsatz) + " (Runde) · " + prozent(spiel.umsatzKlickAllzeit, spiel.umsatzAllzeit) + " (gesamt)"],
        ["Anteil Minispiele am Umsatz", prozent(spiel.umsatzMini, spiel.umsatz) + " (Runde) · " + prozent(spiel.umsatzMiniAllzeit, spiel.umsatzAllzeit) + " (gesamt)"],
        ["Klicks", spiel.klicks.tausender()],
        ["Spielzeit", (1s * spiel.sekunden).alsText()],
        ["Michelin-Sterne (insgesamt)", spiel.sterneAllzeit.alsText()],
        ["Neueröffnungen", spiel.neueröffnungen.alsText()],
        ["Franchise-Gründungen", spiel.franchises.alsText()],
        ["Perfekte Pizzen", spiel.perfekte.alsText()],
        ["Hawaii-Gäste bekehrt", spiel.hawaiiBekehrt.alsText()],
        ["Großbestellungen pünktlich", spiel.pünktlich.alsText()],
        ["Sonderschichten", spiel.sonderschichten.alsText()],
        ["Minispiele gewonnen", spiel.minispieleGewonnen + " von " + spiel.minispieleGespielt]
    ]));
    setzeKnopf(neuAnfangen, "🗑 Neu anfangen", ja);
}

leer zeichneGeheimnisse() {
    falls (spiel.rezepteOffen()) {
        setzeText(geheimInfo, "Nonna verrät ihre Geheimnisse nur gegen Michelin-Sterne – du hast " + spiel.sterne
            + " ⭐. Ein ausgegebener Stern bringt keine +" + spiel.prozentJeStern() + " % mehr. Die Rezepte wirken bis zur nächsten Franchise-Gründung.");
    } sonst {
        setzeText(geheimInfo, "🔒 Nonna verrät ihre Geheimrezepte nur Sterneköchen. Hol dir mit einer Neueröffnung den ersten Michelin-Stern.");
    }
    // Welle: nur die offenen Rezepte zeigen, Gelerntes klappt in eine Zeile.
    Blech<Geheimrezept> welle = spiel.offeneRezepte();
    für (RezeptZeile z : rezeptZeilen) {
        diavolo zeigen = spiel.rezepteOffen() && welle.enthält(z.r);
        falls (z.reihe.sichtbar() != zeigen) { z.reihe.sichtbar(zeigen); }
        falls (zeigen) { z.zeichne(spiel); }
    }
    Blech<Geheimrezept> gelernt = spiel.REZEPTE.filtere((r) -> (spiel.kennt(r.schlüssel)));
    falls (!gelernt.istLeer()) {
        setzeText(gelerntInfo, "✅ Gelernt: " + gelernt.belege((r) -> (r.symbol + " " + r.name)).verbinde(" · ")
            + (welle.istLeer() ? " – Nonna hat dir alles verraten." : ""));
    }
    falls (gelerntInfo.sichtbar() == gelernt.istLeer()) { gelerntInfo.sichtbar(!gelernt.istLeer()); }

    diavolo offen = spiel.herausforderungenOffen();
    falls (spiel.modus != "") {
        Herausforderung h = spiel.herausforderung(spiel.modus);
        setzeText(probeInfo, h.symbol + " " + h.name + " läuft: " + spiel.umsatz.euro(kompakt: ja) + " von "
            + h.ziel.euro(kompakt: ja) + " Umsatz. " + h.regel);
        zielBalken.setzeWert((spiel.zielFortschritt()));
    } sonst falls (offen) {
        setzeText(probeInfo, "Eine Runde unter Auflagen – schaffst du das Ziel, gilt die Belohnung für immer, auch nach einer Franchise-Gründung.");
    } sonst {
        setzeText(probeInfo, "🔒 Ab 3 Michelin-Sternen fordert Nonna dich heraus. Bisher: " + spiel.sterneAllzeit + " von 3.");
    }
    falls (laufend.sichtbar() != (spiel.modus != "")) { laufend.sichtbar(spiel.modus != ""); }
    setzeKnopf(aufgeben, "🏳 Aufgeben", ja);
    für (HerausforderungZeile z : probeZeilen) {
        falls (z.reihe.sichtbar() != offen) { z.reihe.sichtbar(offen); }
        z.zeichne(spiel);
    }
}

margherita gezeigtesSpiel = "";
margherita ofenFarbe = "";

leer zeichneSpielfeld() {
    margherita l = ecke.läuft;
    falls (l != gezeigtesSpiel) {
        gezeigtesSpiel = l;
        spielfeld.sichtbar(l != "");
        teigTeil.sichtbar(l == "teig");
        belagTeil.sichtbar(l == "bestellung");
        ofenTeil.sichtbar(l == "ofen");
        routenTeil.sichtbar(l == "route");
        falls (l != "") {
            Minispiel m = ecke.spielNamens(l);
            spielfeld.setzeTitel((m.symbol + " " + m.name));
            falls (ofenFarbe != "") { ofenFarbe = ""; spielAnzeige.stil("farbe", "normal"); }
        }
        falls (l == "teig") {
            für (salami i : [0 .. 20]) { teigFelder.stück(i + 1).stil("farbe", ecke.imZiel(i) ? "basilikum" : "normal"); }
        }
        falls (l == "route") {
            für (salami i : [1 .. 3]) { routenKnöpfe.stück(i).setzeText((ecke.routen.stück(i))); }
        }
        // Die Uhr schlägt im Takt des Spiels – bzw. wieder jede Sekunde
        Dauer schlag = l == "" ? 1s : ecke.spielNamens(l).schlag;
        taktMs = Mathe.runden(schlag.inMs());
        takt.setzeIntervall(schlag);
    }
    falls (l == "") { serviere; }

    funghi wert = Mathe.max(0, Mathe.min(1, ecke.balken()));
    falls (spielBalken.wert() != wert) { spielBalken.setzeWert(wert); }
    margherita status = ecke.status;
    falls (l == "teig") {
        setzeText(spielAnzeige, "🫓 Der Teig fliegt …");
        für (salami i : [0 .. 20]) { setzeText(teigFelder.stück(i + 1), ecke.feld(i)); }
    } sonst falls (l == "bestellung") {
        setzeText(spielAnzeige, ecke.bestellungText());
        für (Knopf k : belagKnöpfe) { setzeKnopf(k, k.text(), !ecke.zeigt); }
    } sonst falls (l == "ofen") {
        setzeText(spielAnzeige, "🌡 " + ecke.grad + " °C");
        margherita farbe = ecke.ofenImZiel() ? "basilikum" : "tomate";
        falls (farbe != ofenFarbe) { ofenFarbe = farbe; spielAnzeige.stil("farbe", farbe); }
        status = "Ziel 380–440 °C · im Ziel: " + ecke.imZiel + " von 10 s (7 nötig) · noch " + Mathe.decke((20 - ecke.ticks) / 2) + " s";
    } sonst {
        setzeText(spielAnzeige, "🛵 Welcher Weg ist am schnellsten?");
        status = status + " Noch " + Mathe.decke((20 - ecke.ticks) / 2) + " s.";
    }
    setzeText(spielStatus, status);
}

leer zeichneMinispiele() {
    margherita bilanz = spiel.minispieleGespielt > 0
        ? " Bisher " + spiel.minispieleGewonnen + " von " + spiel.minispieleGespielt + " gewonnen."
        : "";
    falls (!ecke.erlaubt()) {
        setzeText(miniKopf, "🙏 Fastenzeit: Nonna hat die Spiele weggeräumt – nur der Betrieb backt." + bilanz);
    } sonst falls (spiel.minispielPause > 0 && ecke.läuft == "") {
        setzeText(miniKopf, "☕ Nonna macht Pause – in " + (Mathe.decke(spiel.minispielPause / 10) * 10) + " s spielt sie wieder mit." + bilanz);
    } sonst {
        setzeText(miniKopf, "Kurze Spiele für zwischendurch: Ein Sieg bringt Pizzen im Wert von 8 bis 10 Sekunden Produktion, "
            + "danach macht Nonna zwei Minuten Pause." + bilanz);
    }
    für (MinispielZeile z : miniZeilen) { z.zeichne(ecke, spiel); }
}

leer zeichne() {
    diavolo voll = spiel.version != gezeigteVersion;
    falls (voll) { zeichneVoll(); }
    falls (spiel.erfolge.länge() != gezeigteErfolge) { zeichneErfolge(); }
    setzeText(kasse, spiel.geld.euro(kompakt: ja));
    setzeText(meldung, spiel.nachricht);

    falls (spiel.modus != "") {
        Herausforderung h = spiel.herausforderung(spiel.modus);
        setzeText(modusInfo, h.symbol + " " + h.name + ": " + spiel.umsatz.euro(kompakt: ja) + " von " + h.ziel.euro(kompakt: ja)
            + " Umsatz (" + prozent(spiel.umsatz, h.ziel) + ")");
    }
    falls (modusInfo.sichtbar() != (spiel.modus != "")) { modusInfo.sichtbar(spiel.modus != ""); }

    salami ofenAnzeige = Mathe.decke(spiel.ofenKühlt / 10) * 10;   // Countdown in Zehnerschritten
    falls (voll || ofenAnzeige != gezeigterOfen) {
        gezeigterOfen = ofenAnzeige;
        setzeKnopf(ofenKnopf, spiel.ofenBereit()
            ? "🔥 Sonderschicht (" + spiel.ofenTemperatur() + " °C)"
            : (spiel.modus == "fastenzeit" ? "🔥 Fastenzeit – der Ofen bleibt kalt" : "🔥 Ofen kühlt ab … noch " + ofenAnzeige + " s"), spiel.ofenBereit());
    }

    für (UpgradeZeile z : zeilen) { z.zeichne(spiel.geld, kaufMenge); }
    zeichneSpielfeld();
    zeichneMinispiele();
    falls (!spiel.rezeptFertig() && !spiel.rezeptGesperrt()) {
        diavolo leistbar = spiel.geld >= spiel.seitenKosten();
        falls (rezeptKnopf.aktiv() != leistbar) { rezeptKnopf.aktiv(leistbar); }
    }
    // Die Reiter „Imperium“ und „Geheimnisse“ (Tabellen!) nur, wenn sie offen sind – spart große Nachrichten.
    salami r = reiter.gewaehlt();
    diavolo auffrischen = voll || aufrufe % 5 == 0 || gezeigterReiter != r;
    falls (r == 3 && auffrischen) { zeichneImperium(); }
    falls (r == 4 && auffrischen) { zeichneGeheimnisse(); }
    gezeigterReiter = r;
    aufrufe++;
}

leer nachVerarbeitung() {
    spiel.prüfeZiel();
    prüfeErfolge();
    salami neu_ = spiel.neueSterne();
    falls (neu_ > gemeldeteSterne) {
        spiel.melde(("⭐ Der Guide Michelin ist da! Im Reiter „Imperium“ " + (neu_ == 1 ? "wartet ein neuer Stern" : "warten " + neu_ + " neue Sterne") + "."));
    }
    gemeldeteSterne = neu_;
    salami fil = spiel.neueFilialen();
    falls (fil > 0 && gemeldeteFilialen == 0) {
        spiel.melde(("🏢 Investoren klopfen an: Deine Sterne reichen für eine Franchise-Kette (Reiter „Imperium“)."));
    }
    gemeldeteFilialen = fil;
    zeichne();
    seitSpeichern++;
    falls (seitSpeichern >= 30) { speichere(); }
}

// ─────────────────────────────── Aufbauen & los ─────────────────────────
Stapel wurzel = neu Stapel([kasse, kennzahlen, modusInfo, backen, ofenKnopf, meldung, reiter, takt], id: "wurzel");
wurzel.stil("abstand", 10);

sortiereErfolge();
zeichneKaufmenge();
zeichne();
zeichneImperium();     // einmal vorab, damit die (verborgenen) Reiter schon stimmen
zeichneGeheimnisse();
theke.zeige(wurzel);
theke.bediene();

speichere();
Bote.sage(("Feierabend! " + Spiel.pizzen(spiel.pizzenAllzeit) + " gebacken, " + spiel.umsatzAllzeit.euro(kompakt: ja)
    + " Umsatz, " + spiel.erfolge.länge() + " Erfolge."));
