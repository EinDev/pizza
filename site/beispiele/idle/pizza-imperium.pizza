// ═══════════════════════════════════════════════════════════════════════
//  🍕 Pizza-Imperium – ein Idle-Game an der Theke
// ═══════════════════════════════════════════════════════════════════════
//  Klick auf „Pizza backen!“, verkaufe jede Pizza zum echten Rezeptpreis,
//  kaufe Handwerkszeug (mehr Pizzen pro Klick) und baue einen Betrieb auf,
//  der von selbst backt (Pizzen pro Sekunde) – auf Dauer ist der Betrieb
//  das Herz des Imperiums, der Klick nur noch die Prise Salz.
//
//  Der Aufstieg hat vier Ebenen, die aufeinander aufbauen:
//    ⭐ Neueröffnung     – Michelin-Sterne, +10 % auf alles je Stern
//    📜 Geheimrezepte    – Nonnas Talentbaum, bezahlt mit Sternen
//    🏅 Herausforderungen – Läufe unter Auflagen mit Belohnung für immer
//    🏢 Franchise        – Kette gründen: Sterne werden zu Filialen
//
//  Die Breite kommt aus zwölf Bereichen (Zutaten-Garten, Weinkeller, Personal, Lieferzonen, Nonnas Helfer,
//  Marketing, Rezeptlabor, Stammgäste, Nonnas Katze, Pizza-Wettbewerb, Sammelalbum, Banca di Napoli), die man
//  der Reihe nach gegen Euro freischaltet – jeder hat seinen festen Platz auf den Reitern Hof, Stadt und Labor.
//  Auf dem Hof (Paket 2): 🍅 drei Beete machen jede Pizza teurer (zusammen höchstens +50 %), 🍷 vier Getränke bringen
//  im Takt einen Anteil des Pizza-Umsatzes nebenbei (Nebeneinkommen in die Kasse – zählt nicht für Sterne),
//  👩‍🍳 vier Rollen mit Stufe 0…10 (Trinkgeld, Abkühlzeit, Upgrade-Preise, Hawaii-Bonus).
//  In der Stadt und im Labor (Paket 3): 🛵 sechs Stadtviertel als Einmal-Käufe (+5 Punkte Alles-Bonus je Viertel),
//  📣 vier Marketing-Kampagnen als zeitlich begrenzte Boni mit Pause (Preis = 60 s Umsatz), 🤖 Nonnas Helfer – vier
//  dauerhafte Einmal-Käufe, die Klicks automatisieren (Pino zündet die Sonderschicht, Carlo liest das Rezeptbuch, Nonna
//  spielt die Minispiele, der Scout wartet auf den Wettbewerb) und nie weniger bringen als die Hand (R2).
//  Labor und Stadt (Paket 4): 🧪 das Rezeptlabor forscht über Spielzeit – zehn Projekte in fester Reihenfolge, eins zugleich,
//  je 5–30 Minuten (laufen auch offline mit, höchstens 30 min), jedes bringt einen kleinen Bonus für immer (Klick, Abkühlung,
//  Großbestellung, Minispiel-Pause, perfekte Pizza, Ereignisse, Meisterbriefe, Feinkost, Getränke, Garten); 🧑‍🤝‍🧑 vier
//  Stammgäste mit rotierenden Wünschen (Pizzen backen, Gebäude kaufen, Sonderschichten, Minispiel-Sieg, Hawaii-Gast,
//  Großbestellung) – erfüllt → ein Klick holt 10 Portionen und ein Treueherz (dauerhaft, +0,5 Punkte je Herz im Alles-Bonus).
//  Stückkäufe fangen bei jeder Neueröffnung von vorn an, die Freischaltung bleibt; Helfer, Forschung und Herzen bleiben für immer.
//
//  Raster (v6) und R3 „unsichtbar, bis angeboten“ (v7): Das Fenster ist 860 × 640 groß, der Kopf (Kasse, Kennzahlen
//  mit dem Stand der Herausforderung, Backen und Sonderschicht, Meldung) steht fest, darunter Reiter mit festen Titeln
//  in Erscheinensfolge (Backstube · Hof · Spiele · Erfolge · Imperium, dann Stadt · Labor · Nonna, sobald es dort etwas
//  gibt), jede Seite zwei Spalten aus Panels. Sichtbar ist nur, was man kaufen KÖNNTE – das nächste Gebäude nach dem
//  Kauf des vorigen, ein Bereich, sobald sein Vorgänger frei ist, Feinkost mit dem ausgelesenen Buch, Nonna mit dem
//  ersten Stern; keine 🔒-Platzhalter, keine festen Höhen. Neues hängt hinten/unten/rechts an und verschiebt nichts
//  Bestehendes; bewegen darf sich etwas nur durch einen Klick (Kauf, Lernen, Starten, Neueröffnung, Franchise,
//  Freischalten) – was im Takt erscheinen oder verschwinden kann, steht ganz unten in seiner Spalte. Wachsende Listen
//  (Betrieb, Handwerk) stehen als letztes Element ihrer Spalte, Feinkost und Meisterbriefe darüber als je eine feste Zeile.
//
//  Reaktiv (Theke v5): Kein zeichne(), kein aktualisiere() – jede Zutat bindet ihre Eigenschaften einmal beim Aufbau
//  an einen Ausdruck aus dem Modell (binde/bindeStil); Rückrufe (Takt, Klick, Taste, Auswahl) ändern nur den Zustand und
//  setzen Zettel (Taktgeber zTakt, Spiegel der Versionszähler), die Theke rechnet am Synchronisationspunkt nach, was
//  daran hängt, und sendet nur echte Änderungen. Imperium und Nonna rechnen nur bei offenem Reiter (Ja/Nein-Zettel aus
//  dem Reiter-Rückruf); die Reiter tragen Marken (⭐ wartende Sterne, 📜 lernbare Rezepte) statt Zähler im Titel.
//
//  Der Spielstand (Fassung 6) liegt in der Vorratskammer (Namensraum „pizza-imperium“: ein Spielstand für
//  Galerie, App-Link und EXE – jede Fassung des Spiels findet ihn wieder): Beim nächsten Start geht es
//  weiter – und der Betrieb hat in der Zwischenzeit gebacken (mit halber Kraft, höchstens 30 Minuten lang).
//  Ein Stand einer anderen Fassung wird verworfen: frischer Teig, keine Migration.
//
//  Sprache im Einsatz:
//    • Takt              – die Uhr der Backstube (10 Schläge pro Sekunde, Produktion anteilig)
//    • klasse Rezept     – Nonnas Rezeptbuch legt Beläge auf, die Speisekarte zählt den Preis
//    • @Kühlschrank      – Upgrade-Kosten werden nur einmal ausgerechnet
//    • ofen(zeit:) roh   – die Sonderschicht backt, bis das Zeitbudget leer ist (heißer = mehr Budget: Spielregel, K-127)
//    • bestelle/priorität – Großbestellungen: Trinkgeld ist Spielregel (Priorität + Zeitbudget 40 ms · (1 + Trinkgeld/10))
//    • Zufall            – Ereignisse und perfekte Pizzen
//    • Vorratskammer + Uhr.echt() – Speichern und Offline-Fortschritt
//    • kompakt()/währung("€", kompakt: ja) – „1,23 Mio. €“
//    • Abschnitt, Reiter, Tabelle, Fortschritt, hinweis – die Theke v2
//    • Takt.setzeIntervall – im Minispiel schlägt die Uhr im Takt des Spiels (120–500 ms)
//    • Theke v4          – Kaufmenge als Auswahl, Kleinbetriebe/Gelerntes/Geschafftes als klappbare Abschnitte,
//                          Tastatur (Leertaste backt, Tasten in den Minispielen), Stile zeilen/breite/hoehe
//                          für das feste Raster
//    • Theke v5          – Zettel, binde, bindeStil: die Oberfläche folgt dem Zustand (Taktgeber zTakt, Spiegel-Zettel
//                          je Panel, Kaufmenge, Rückfrage und „Reiter offen“ als Wert-Zettel)
//    • Theke v6          – senkrecht oben (Spalten bündig), zeilen an Abschnitt-Titeln und Tabellenzellen,
//                          Innenbreite 820 (breite − 40), marke als Badge am Reiter
//    • Theke v7          – Zettel.aus: ein abgeleiteter Zettel je Upgrade-Platz liefert [Knopftext, aktiv, Balken];
//                          stil("spalten", …): feste Spaltengewichte der Tabellen (Aufstieg, Statistik, Erfolge);
//                          binde("sichtbar", …) an Reihen, Panels und Reiter-Seiten (R3)
//
//  🎲 Minispiele für zwischendurch (Teig fangen, Bestellung merken, Ofen
//  halten, Lieferroute): optional, ein Sieg bringt ein paar Sekunden
//  Produktion, danach macht Nonna zwei Minuten Pause.
//
//  Aufbau:  Upgrade · Geheimrezept · Herausforderung · Erfolg · Bereich
//           · Spiel (Regeln, ohne Oberfläche) · Minispiele (Spielecke)
//           · Oberfläche (Zettel, ein Panel je Karte mit Bindungen beim Aufbau, Plätze aus Klick-Rückrufen) · Start
// ═══════════════════════════════════════════════════════════════════════

// ─────────────────────────────── Upgrades ───────────────────────────────
// Ein Upgrade kann man mehrfach kaufen; jedes weitere kostet mehr
// (Betrieb +15 %, Handwerk +40 bzw. +60 % – Klick-Werkzeug ist selten und teuer).
// art: "klick"   – feste Pizzen pro Klick
//      "anteil"  – Prozent der Sekundenproduktion pro Klick, höchstens ANTEIL_MAX Stück je Upgrade
//                  (die Preise sind fest, das Einkommen wächst mit dem Aufstieg um Größenordnungen – ohne Deckel
//                  kauft man spät 70 Stück und Klicken überholt den Betrieb)
//      "betrieb" – Pizzen pro Sekunde
salami ANTEIL_MAX = 8;

klasse Upgrade {
    margherita schlüssel;
    margherita symbol;
    margherita name;
    margherita art;
    margherita einheit;
    margherita beschreibung;
    funghi basis;
    funghi wirkung;
    funghi faktor;
    salami anzahl = 0;
    salami höchstens = -1;   // mehr Stück gibt es nicht („ausgebaut“); -1 = unbegrenzt
    funghi preisJetzt = 0;   // Preis des nächsten Stücks
    margherita zeile = "";   // Beschriftung für die Oberfläche

    Upgrade(margherita s, margherita sym, margherita n, funghi b, funghi w, margherita a, margherita text) {
        schlüssel = s; symbol = sym; name = n; basis = b; wirkung = w; art = a; beschreibung = text;
        faktor = 1.4;
        einheit = "% der Pizzen pro Sekunde je Klick";
        falls (art == "anteil") { höchstens = ANTEIL_MAX; }
        falls (art == "klick") { einheit = w == 1 ? "Pizza pro Klick" : "Pizzen pro Klick"; faktor = 1.6; }
        falls (art == "betrieb") { einheit = "Pizzen pro Sekunde"; faktor = 1.15; }
        setzeAnzahl(0);
    }

    @Kühlschrank(haltbar: 1d)
    funghi kostenBei(salami n) {
        serviere (Mathe.runden(basis * Mathe.potenz(faktor, n)));
    }

    // Preis und Beschriftung ändern sich nur hier.
    leer setzeAnzahl(salami n) {
        anzahl = n;
        preisJetzt = kostenBei(n);
        zeile = symbol + " " + name + (anzahl > 0 ? " ×" + anzahl : "") + " – +" + wirkung.kompakt(2) + " " + einheit;
    }

    funghi gesamt() { serviere (wirkung * anzahl); }
    diavolo ausgebaut() { serviere (höchstens >= 0 && anzahl >= höchstens); }

    // Kaufmenge: k Stück kosten genau die Summe der (gerundeten) Einzelpreise – wie k Einzelkäufe.
    funghi kostenFür(salami k) {
        funghi summe = 0;
        für (salami i : [0 .. k - 1]) { summe += kostenBei(anzahl + i); }
        serviere (summe);
    }

    // So viele Stück, wie die Kasse hergibt (höchstens 1000).
    salami maxFür(funghi geld) {
        salami k = 0;
        funghi summe = 0;
        solange (k < 1000) {
            funghi nächster = kostenBei(anzahl + k);
            falls (summe + nächster > geld) { serviere (k); }
            summe += nächster;
            k++;
        }
        serviere (k);
    }
}

// ──────────────────── Nonnas Geheimrezepte (Talentbaum) ─────────────────
// Kosten Michelin-Sterne. Ein ausgegebener Stern bringt keine +10 % mehr –
// dafür wirkt das Rezept bis zur nächsten Franchise-Gründung.
klasse Geheimrezept {
    margherita schlüssel;
    margherita symbol;
    margherita name;
    margherita text;
    salami kosten;
    margherita braucht;     // "" = Wurzel des Baums

    Geheimrezept(margherita s, margherita sym, margherita n, salami k, margherita b, margherita t) {
        schlüssel = s; symbol = sym; name = n; kosten = k; braucht = b; text = t;
    }
}

// ─────────────────────────── Feinkost-Händler ───────────────────────────
// Nimmt den Platz des ausgelesenen Rezeptbuchs ein: Einmal-Käufe gegen Euro, jede Zutat macht jede Pizza teurer.
// Bei jeder Neueröffnung ist das Lager wieder leer.
klasse Feinkost {
    margherita schlüssel;
    margherita symbol;
    margherita name;
    salami plus;
    funghi preis;
    margherita text;

    Feinkost(margherita s, margherita sym, margherita n, salami p, funghi pr, margherita t) {
        schlüssel = s; symbol = sym; name = n; plus = p; preis = pr; text = t;
    }
}

// ─────────────────────────── Nonnas Rezeptbuch ──────────────────────────
// Die Pizza im Ofen: Belagnamen von unten nach oben und der Preis nach Nonnas Speisekarte –
// 5 € für Teig und Ofen, jeder Belag kommt obendrauf (auf den Cent gerundet).
klasse Rezept {
    Blech<margherita> beläge = [];
    funghi preis = 5;
    Speisekarte<margherita, funghi> KARTE = neu Speisekarte<margherita, funghi>()
        .lege("Tomate", 1).lege("Mozzarella", 1.5).lege("Basilikum", 0.5)
        .lege("Salami", 1.5).lege("Pilze", 1).lege("Oliven", 1).lege("Parmesan", 1.2)
        .lege("Rucola", 1).lege("Gorgonzola", 1.5).lege("Artischocken", 1.5).lege("Knoblauch", 0.3);

    // Jedes Rezept beginnt als Margherita.
    Rezept() { belegeMit("Tomate"); belegeMit("Mozzarella"); belegeMit("Basilikum"); }

    leer belegeMit(margherita name) {
        beläge.hinzu(name);
        preis = Mathe.runden((preis + KARTE.hole(name, 1)) * 100) / 100;
    }
}

// ─────────────────────────────── Meisterbriefe ──────────────────────────
// Einmal-Käufe gegen Euro: Hat man 10, 25, 50 bzw. 100 Stück eines Gebäudes, gibt es dafür einen
// Meisterbrief – das Gebäude backt dann ×1,25 (je Brief). Bei jeder Neueröffnung verfallen sie.
klasse Meisterbrief {
    margherita schlüssel;   // z. B. "lehrling-25"
    margherita gebäude;
    salami stufe;
    margherita symbol;
    margherita name;
    funghi preis;

    Meisterbrief(Upgrade u, salami st, margherita n) {
        gebäude = u.schlüssel; stufe = st; name = n; symbol = u.symbol;
        schlüssel = u.schlüssel + "-" + st;
        // 35-mal so viel wie das Stück, mit dem man die Stufe erreicht (Paket 4b: vorher 25 – mit zwei statt drei offenen Briefen
        // stiegen die Sterne nach 4 h, Bot Saat 42 / 7: 2.533 / 2.610 > 2.250; mit 35: 1.751 / 1.760)
        preis = u.kostenBei(st - 1) * 35;
    }
}

// ─────────────────────────── Herausforderungen ──────────────────────────
// Ein Lauf unter Auflagen: beginnt wie eine Neueröffnung, Ziel ist Umsatz in
// dieser Runde. Geschafft → Belohnung für immer (auch nach Franchise).
klasse Herausforderung {
    margherita schlüssel;
    margherita symbol;
    margherita name;
    margherita regel;
    margherita belohnung;
    funghi ziel;
    salami abFilialen = 0;   // zweite Staffel: erst mit einer Franchise-Kette

    Herausforderung(margherita s, margherita sym, margherita n, funghi z, margherita r, margherita b) {
        schlüssel = s; symbol = sym; name = n; ziel = z; regel = r; belohnung = b;
    }

    Herausforderung abKette() { abFilialen = 1; serviere (dies); }
}

// ─────────────────────────────── Erfolge ────────────────────────────────
klasse Erfolg {
    margherita name;
    margherita text;
    Funktion bedingung;     // (Spiel s) -> diavolo

    Erfolg(margherita n, margherita t, Funktion b) { name = n; text = t; bedingung = b; }
    diavolo erreicht(Spiel s) { serviere (bedingung.rufe(s)); }
}

// ─────────────────────────────── Bereiche ───────────────────────────────
// Zwölf Bereiche in der Breite: Jeder hat ein festes Panel auf seinem Reiter und wird gegen Euro freigeschaltet –
// der Reihe nach (`nach` = Vorgänger in der Kette; erst wenn der frei ist, zeigt das Panel seinen Preis).
// Freischaltungen sind dauerhaft (überleben Neueröffnung und Franchise). Der Inhalt der Bereiche kommt Paket für Paket
// (Hof: Garten, Weinkeller, Personal – siehe `Posten`; Stadt: Lieferzonen (`Posten`), Marketing (`Kampagne`), Stammgäste
// (`Gast`); Labor: Nonnas Helfer (`Helfer`), Rezeptlabor (`Projekt`); Paket 5: Katze, Wettbewerb, Sammelalbum, Banca).
klasse Bereich {
    margherita schlüssel;
    margherita symbol;
    margherita name;
    funghi preis;
    margherita reiter;      // "hof", "stadt", "labor"
    margherita teaser;
    margherita nach = "";   // Schlüssel des Vorgängers ("" = Anfang der Kette)

    Bereich(margherita s, margherita sym, margherita n, funghi p, margherita r, margherita t) {
        schlüssel = s; symbol = sym; name = n; preis = p; reiter = r; teaser = t;
    }
    margherita titel() { serviere (symbol + " " + name); }
}

// Ein Posten in einem Bereich (ein Beet, ein Getränk, eine Rolle): Stückkäufe mit wachsendem Preis (basis · faktor^n),
// höchstens `höchstens` Stück. `wirkung` ist je Bereich anders gemeint (Garten: % Preis je Stück · Weinkeller: % des
// Pizza-Umsatzes je Stück · Personal: Rollenfaktor im Preis). Die Stückzahlen liegen im Spiel (Speisekarte je Bereich).
klasse Posten {
    margherita schlüssel;
    margherita symbol;
    margherita name;
    funghi basis;
    funghi faktor;
    funghi wirkung;
    salami höchstens;
    margherita text;

    Posten(margherita s, margherita sym, margherita n, funghi b, funghi f, funghi w, salami h, margherita t) {
        schlüssel = s; symbol = sym; name = n; basis = b; faktor = f; wirkung = w; höchstens = h; text = t;
    }
    funghi preisBei(salami n) { serviere (Mathe.runden(basis * Mathe.potenz(faktor, n))); }
}

// Eine Marketing-Kampagne: zeitlich begrenzter Bonus (`dauer` Sekunden) mit Abkühlzeit (`pause` Sekunden danach).
// art: "betrieb" (Pizzen pro Sekunde), "preis" (je Pizza) oder "alles" (wie der Freitagabend auf den Alles-Faktor).
klasse Kampagne {
    margherita schlüssel;
    margherita symbol;
    margherita name;
    salami dauer;
    salami pause;
    margherita art;
    funghi faktor;
    margherita text;

    Kampagne(margherita s, margherita sym, margherita n, salami d, salami p, margherita a, funghi f, margherita t) {
        schlüssel = s; symbol = sym; name = n; dauer = d; pause = p; art = a; faktor = f; text = t;
    }
    margherita wirkung() {
        falls (art == "preis") { serviere (dauer + " s Preis je Pizza ×" + faktor.kompakt(2) + ", danach " + pause + " s Pause"); }
        serviere (dauer + " s +" + ((faktor - 1) * 100).kompakt(0) + " % auf alles, danach " + pause + " s Pause");
    }
}

// Einer von Nonnas Helfern: Einmal-Kauf, dauerhaft (überlebt Neueröffnung und Franchise) – automatisiert einen Klick,
// bringt nie weniger als die Hand (R2, Bot-Beleg).
klasse Helfer {
    margherita schlüssel;
    margherita symbol;
    margherita name;
    funghi preis;
    margherita wirkung;
    margherita text;

    Helfer(margherita s, margherita sym, margherita n, funghi p, margherita w, margherita t) {
        schlüssel = s; symbol = sym; name = n; preis = p; wirkung = w; text = t;
    }
}

// Ein Forschungsprojekt im Rezeptlabor: kostet einmal `preis`, läuft `dauer` Spielsekunden und bringt danach seinen Bonus für
// immer (überlebt Neueröffnung und Franchise – nur Neu anfangen löscht die Forschung). Die Wirkung steht direkt an ihrer Stelle
// im Spiel (`hatForschung(schlüssel)`), hier nur ihr Text.
klasse Projekt {
    margherita schlüssel;
    margherita symbol;
    margherita name;
    salami dauer;
    funghi preis;
    margherita wirkung;
    margherita text;

    Projekt(margherita s, margherita sym, margherita n, salami d, funghi p, margherita w, margherita t) {
        schlüssel = s; symbol = sym; name = n; dauer = d; preis = p; wirkung = w; text = t;
    }
    margherita minuten() { serviere ((dauer / 60).kompakt(0) + " min"); }
}

// Ein Stammgast: fester Name, eine eigene Reihenfolge der Wunscharten (rotiert für immer) und je Wunschart ein Satz, wie er
// seinen Wunsch vorträgt. Der n-te Wunsch (ab 0) hat die Art `wunschArt(n)`.
klasse Gast {
    margherita schlüssel;
    margherita symbol;
    margherita name;
    Blech<margherita> wünsche;
    Blech<margherita> sätze;

    Gast(margherita s, margherita sym, margherita n, Blech<margherita> w, Blech<margherita> sz) {
        schlüssel = s; symbol = sym; name = n; wünsche = w; sätze = sz;
    }
    margherita wunschArt(salami n) { serviere (wünsche.stück(n % wünsche.länge() + 1)); }
    margherita satz(salami n) { serviere (sätze.stück(n % sätze.länge() + 1)); }
}

// ── P5 Katze ── (Modell; Bereich #9, Hof)
// 🐱 Nonnas Katze Mozzarella: Laune 0…5. Füttern +2 (kostet 10 s Pizza-Umsatz, danach 180 s satt), Streicheln +1 (danach
// 60 s Pause). Nach jeder Hebung hält die Laune 600 s Spielzeit, dann sinkt sie um 1 (im Takt – ändert nur Zahlen und Texte,
// R1). Wirkung über Spiel.katzePunkte(): KATZE_PUNKTE_JE_LAUNE Prozentpunkte je Laune im Alles-Bonus (wie Sterne). Die Katze
// ist keine Runde: Laune, Pausen und Zähler überleben Neueröffnung, Herausforderung und Franchise (nur „Neu anfangen“ setzt
// sie zurück); offline laufen Pausen und Laune-Uhr ab. Sie ist passiv und wirkt immer (auch in der Fastenzeit). Kein Zufall:
// die Katzenweisheit wechselt reihum mit jedem Klick. Kennt keine Oberfläche; `version` zählt jede Änderung.
klasse Katze {
    salami HÖCHSTENS = 5;
    salami LAUNE_DAUER = 600;          // Sekunden je Laune-Stufe
    salami FUTTER_LAUNE = 2;
    salami FUTTER_PAUSE = 180;
    salami FUTTER_SEKUNDEN = 10;       // Preis = so viele Sekunden Pizza-Umsatz
    salami FUTTER_MINDESTPREIS = 10_000;
    salami STREICHEL_LAUNE = 1;
    salami STREICHEL_PAUSE = 60;
    Blech<margherita> LAUNEN = ["schmollt unter dem Ofen", "beäugt dich misstrauisch", "duldet dich", "ist zufrieden", "schnurrt", "thront schnurrend auf dem Mehlsack"];
    Blech<margherita> WEISHEITEN = [
        "Mozzarella ignoriert dich. Das ist ein gutes Zeichen.",
        "Mozzarella sitzt im Brotkorb. Der Brotkorb gehört jetzt ihr.",
        "Eine Katze auf dem Pizzaofen ist kein Hygienemangel, sondern Tradition. Sagt Nonna.",
        "Mozzarella hat Luigi heute zweimal angesehen. Er arbeitet seitdem doppelt so schnell.",
        "Mozzarella frisst keinen Mozzarella. Aus Prinzip.",
        "Ein Schnurren am Morgen – drei Sterne am Abend.",
        "Mozzarella schläft auf der Speisekarte. Heute gibt es, was sie freilässt.",
        "Wer den Teig knetet, darf auch die Katze kneten. Kurz. Mit Abstand."
    ];

    salami laune = 0;
    salami bisMürrisch = 0;            // Sekunden, bis die Laune um 1 sinkt (läuft nur bei Laune > 0)
    salami futterPause = 0;
    salami streichelPause = 0;
    salami gefüttert = 0;              // Zähler (insgesamt)
    salami gestreichelt = 0;
    salami version = 0;                // zählt bei jeder Änderung hoch (Klick, Laune sinkt, Pause endet) – Quelle des Panels

    margherita launeText() { serviere (LAUNEN.stück(laune + 1)); }
    margherita weisheit() { serviere (WEISHEITEN.stück((gefüttert + gestreichelt) % WEISHEITEN.länge() + 1)); }
    funghi futterPreis(Spiel s) { serviere (Mathe.max(FUTTER_MINDESTPREIS, Mathe.runden(s.proSekunde() * s.preis() * FUTTER_SEKUNDEN))); }
    leer hebeLaune(salami plus) {
        laune = Mathe.min(HÖCHSTENS, laune + plus);
        bisMürrisch = LAUNE_DAUER;
    }

    // Nur aus Klick-Rückrufen.
    diavolo füttere(Spiel s) {
        funghi preis_ = futterPreis(s);
        falls (!s.istFrei("katze") || futterPause > 0 || s.geld < preis_) { serviere (nein); }
        s.geld -= preis_;
        hebeLaune(FUTTER_LAUNE);
        futterPause = FUTTER_PAUSE;
        gefüttert++;
        version++;
        s.neuBerechnen();
        s.melde(("🐟 Mozzarella frisst (" + preis_.währung("€", kompakt: ja) + ") und " + launeText() + " – Laune " + laune + "/" + HÖCHSTENS
            + ", +" + s.katzePunkte() + " % auf alles. " + weisheit()));
        serviere (ja);
    }
    diavolo streichle(Spiel s) {
        falls (!s.istFrei("katze") || streichelPause > 0) { serviere (nein); }
        hebeLaune(STREICHEL_LAUNE);
        streichelPause = STREICHEL_PAUSE;
        gestreichelt++;
        version++;
        s.neuBerechnen();
        s.melde(("🫳 Mozzarella lässt sich streicheln und " + launeText() + " – Laune " + laune + "/" + HÖCHSTENS + ", +" + s.katzePunkte() + " % auf alles. " + weisheit()));
        serviere (ja);
    }

    // Im Takt (ganze Sekunden): Pausen laufen ab, die Laune sinkt alle LAUNE_DAUER Sekunden um 1 – nur Zahlen und Texte.
    leer takt(Spiel s, salami n) {
        falls (futterPause > 0) {
            futterPause = Mathe.max(0, futterPause - n);
            falls (futterPause == 0) { version++; }
        }
        falls (streichelPause > 0) {
            streichelPause = Mathe.max(0, streichelPause - n);
            falls (streichelPause == 0) { version++; }
        }
        falls (laune <= 0) { serviere; }
        bisMürrisch = bisMürrisch - n;
        falls (bisMürrisch > 0) { serviere; }
        laune--;
        bisMürrisch = laune > 0 ? LAUNE_DAUER : 0;
        version++;
        s.neuBerechnen();
        s.melde(("🐱 Mozzarella " + launeText() + " – Laune " + laune + "/" + HÖCHSTENS + (laune > 0 ? "." : ". Ein Fischlein wirkt Wunder.")));
    }

    // Offline: `weg` Sekunden sind vergangen (ohne Meldung)
    leer offline(salami weg) {
        futterPause = Mathe.max(0, futterPause - weg);
        streichelPause = Mathe.max(0, streichelPause - weg);
        salami rest = weg;
        solange (laune > 0 && rest >= bisMürrisch) {
            rest = rest - bisMürrisch;
            laune--;
            bisMürrisch = laune > 0 ? LAUNE_DAUER : 0;
        }
        falls (laune > 0) { bisMürrisch = bisMürrisch - rest; }
        version++;
    }

    leer zurück() {
        laune = 0; bisMürrisch = 0; futterPause = 0; streichelPause = 0; gefüttert = 0; gestreichelt = 0;
        version++;
    }

    Speisekarte<margherita, Vorrat> alsSpeisekarte() {
        Speisekarte<margherita, Vorrat> k = neu Speisekarte<margherita, Vorrat>();
        k.lege("laune", laune).lege("bisMürrisch", bisMürrisch).lege("futterPause", futterPause).lege("streichelPause", streichelPause);
        k.lege("gefüttert", gefüttert).lege("gestreichelt", gestreichelt);
        serviere (k);
    }
    // Fehlende Felder = Vorgabe, alles geklemmt (ein Stand vor Paket 5 hat gar keine)
    leer lade(Speisekarte<margherita, Vorrat> k) {
        laune = Mathe.max(0, Mathe.min(HÖCHSTENS, k.hole("laune", 0)));
        bisMürrisch = Mathe.max(0, Mathe.min(LAUNE_DAUER, k.hole("bisMürrisch", 0)));
        falls (laune > 0 && bisMürrisch <= 0) { bisMürrisch = LAUNE_DAUER; }
        falls (laune <= 0) { bisMürrisch = 0; }
        futterPause = Mathe.max(0, Mathe.min(FUTTER_PAUSE, k.hole("futterPause", 0)));
        streichelPause = Mathe.max(0, Mathe.min(STREICHEL_PAUSE, k.hole("streichelPause", 0)));
        gefüttert = Mathe.max(0, k.hole("gefüttert", 0));
        gestreichelt = Mathe.max(0, k.hole("gestreichelt", 0));
        version++;
    }
}
// ── Ende P5 Katze (Modell) ──

// ── P5 Wettbewerb ── (Modell; Bereich #10, Stadt)
// 🏆 Pizza-Wettbewerb: Alle ABSTAND Spielsekunden (600) ein Wettbewerb, davon die letzten OFFEN_SEKUNDEN (120) zur Anmeldung offen; die
// Namen rotieren. Teilnehmen kostet STARTGELD_SEKUNDEN (30) Sekunden Umsatz und wird SOFORT ausgewertet (Klick oder Scout,
// höchstens einmal je Wettbewerb): Qualität q = Rezeptseiten + Feinkost + min(Sterne, 10); Gold 10 % + 2 % · q (höchstens 50 %),
// Silber 30 %, sonst Bronze – ein Zug aus `Zufall`, nur hier. Pokale sind eine Sammlung (überleben Neueröffnung und Franchise,
// nur „Neu anfangen“ leert sie); jeder Pokalpunkt (🥇3 🥈2 🥉1) ist POKAL_PUNKTE Prozentpunkt(e) im Alles-Bonus wie Sterne und
// Viertel (Spiel.bonusPunkte), zusammen höchstens POKAL_HÖCHSTENS. Die Uhr ist eine Uhr, kein Kauf: Sie läuft nur, solange der
// Bereich frei ist, in Spielsekunden (offline steht sie), und läuft über Neueröffnung und Franchise weiter – sonst ließe sich
// mit einer Neueröffnung der nächste Wettbewerb herbeizaubern. Kennt keine Oberfläche; `version` zählt jede Änderung.
klasse Wettbewerb {
    Blech<margherita> NAMEN = ["Stadtmeisterschaft", "Regionale", "Italienische Meisterschaft", "Weltmeisterschaft"];
    Blech<margherita> NAMEN_DATIV = ["Stadtmeisterschaft", "Regionalen", "Italienischen Meisterschaft", "Weltmeisterschaft"];   // „bei der …“
    salami ABSTAND = 600;            // Sekunden von Wettbewerb zu Wettbewerb
    salami OFFEN_SEKUNDEN = 120;     // davon offen zur Anmeldung (am Ende des Abstands)
    salami ERSTER = 60;              // nach der Freischaltung öffnet der erste nach 60 s
    salami STARTGELD_SEKUNDEN = 30;
    salami STARTGELD_MINDESTENS = 10_000;
    salami GOLD_GRUND = 10;          // Gold-Chance in Prozent: GOLD_GRUND + GOLD_JE_QUALITÄT · q, höchstens GOLD_HÖCHSTENS
    salami GOLD_JE_QUALITÄT = 2;
    salami GOLD_HÖCHSTENS = 50;
    salami SILBER_PROZENT = 30;      // Silber-Chance in Prozent, Rest Bronze
    salami POKAL_PUNKTE = 1;         // Prozentpunkte im Alles-Bonus je Pokalpunkt (🥇3 🥈2 🥉1) – Hebel für Paket 6
    salami POKAL_HÖCHSTENS = 100;    // höchstens so viele Prozentpunkte insgesamt

    salami bis = 60;                 // Sekunden, bis der nächste öffnet (solange keiner offen ist; = ERSTER)
    salami offenRest = 0;            // Sekunden, die der laufende noch offen ist (0 = keiner offen)
    salami nummer = 0;               // so viele Wettbewerbe sind schon vorbei (Name = NAMEN[nummer mod 4])
    diavolo dabei = nein;            // am laufenden schon teilgenommen
    salami gold = 0;
    salami silber = 0;
    salami bronze = 0;
    salami teilnahmen = 0;
    salami scoutTeilnahmen = 0;
    margherita letztes = "";         // Ergebnis der letzten Teilnahme ("" = noch keine)
    salami version = 0;

    margherita name() { serviere (NAMEN.stück(nummer % NAMEN.länge() + 1)); }
    margherita nameDativ() { serviere (NAMEN_DATIV.stück(nummer % NAMEN.länge() + 1)); }
    diavolo offen() { serviere (offenRest > 0); }
    salami qualität(Spiel s) { serviere (s.seite + s.feinkost.länge() + Mathe.min(s.sterne, 10)); }
    salami goldProzent(Spiel s) { serviere (Mathe.min(GOLD_HÖCHSTENS, GOLD_GRUND + GOLD_JE_QUALITÄT * qualität(s))); }
    funghi startgeld(Spiel s) { serviere (Mathe.max(STARTGELD_MINDESTENS, Mathe.runden(s.proSekunde() * s.preis() * STARTGELD_SEKUNDEN))); }
    salami pokalPunkte() { serviere (3 * gold + 2 * silber + bronze); }
    salami bonusPunkte() { serviere (Mathe.min(POKAL_HÖCHSTENS, POKAL_PUNKTE * pokalPunkte())); }
    margherita pokaleText() { serviere ("🥇" + gold + " 🥈" + silber + " 🥉" + bronze); }
    // Fastenzeit (Herausforderung): keine Feste – auch kein Wettbewerb (wie Ereignisse); die Uhr läuft weiter, nur die Anmeldung ist zu.
    diavolo gesperrt(Spiel s) { serviere (s.modus == "fastenzeit"); }
    diavolo kannTeilnehmen(Spiel s) { serviere (s.istFrei("wettbewerb") && !gesperrt(s) && offen() && !dabei && s.geld >= startgeld(s)); }

    // Teilnehmen (Klick: scout = nein; Wettbewerbs-Scout im Helfer-Takt: scout = ja) – gleiche Rechnung, gleicher Ertrag (R2).
    diavolo teilnehmen(Spiel s, diavolo scout) {
        falls (!kannTeilnehmen(s)) { serviere (nein); }
        funghi preis_ = startgeld(s);
        s.geld -= preis_;
        dabei = ja;
        teilnahmen++;
        falls (scout) { scoutTeilnahmen++; }
        salami q = qualität(s);
        salami g = goldProzent(s);
        salami wurf = Zufall.zahl(1, 100);
        margherita medaille = "";
        falls (wurf <= g) { gold++; medaille = "🥇 Gold"; }
        sonst falls (wurf <= g + SILBER_PROZENT) { silber++; medaille = "🥈 Silber"; }
        sonst { bronze++; medaille = "🥉 Bronze"; }
        letztes = "Zuletzt: " + medaille + " bei der " + nameDativ() + " (Qualität " + q + ", Gold-Chance " + g + " %).";
        version++;
        s.neuBerechnen();            // der Bonus hat sich geändert
        s.melde(((scout ? "🔭 Der Scout meldet: " : "🏆 ") + medaille + " bei der " + nameDativ() + " (Startgeld " + preis_.währung("€", kompakt: ja)
            + ")! Pokale " + pokaleText() + " – +" + bonusPunkte() + " % auf alles, für immer."));
        s.fundChance("wettbewerb");   // 📒 Sammelalbum (P5) – nach der Meldung: der Fund kommt davor in die Meldungszeile
        serviere (ja);
    }

    // Im Takt (ganze Spielsekunden), nur wenn der Bereich frei ist: öffnet und schließt – ändert nur Zahlen und Texte.
    leer takt(Spiel s, salami n) {
        falls (!s.istFrei("wettbewerb")) { serviere; }
        falls (offenRest > 0) {
            offenRest = offenRest - n;
            falls (offenRest <= 0) {
                offenRest = 0;
                nummer++;
                dabei = nein;
                bis = ABSTAND - OFFEN_SEKUNDEN;
                version++;
            }
            serviere;
        }
        bis = bis - n;
        falls (bis <= 0) {
            bis = 0;
            offenRest = OFFEN_SEKUNDEN;
            dabei = nein;
            version++;
            falls (gesperrt(s)) { serviere; }   // Fastenzeit: keine Einladung
            s.melde(("🏆 Die " + name() + " ist eröffnet – " + OFFEN_SEKUNDEN + " s Anmeldung, Startgeld " + startgeld(s).währung("€", kompakt: ja)
                + " (Stadt › Pizza-Wettbewerb)."));
        }
    }

    // „Neu anfangen“: alles auf Anfang (auch die Pokale); version zählt weiter, damit die Oberfläche es merkt.
    leer allesZurück() {
        bis = ERSTER; offenRest = 0; nummer = 0; dabei = nein;
        gold = 0; silber = 0; bronze = 0; teilnahmen = 0; scoutTeilnahmen = 0; letztes = "";
        version++;
    }

    Speisekarte<margherita, Vorrat> alsSpeisekarte() {
        Speisekarte<margherita, Vorrat> k = neu Speisekarte<margherita, Vorrat>();
        k.lege("bis", bis).lege("offenRest", offenRest).lege("nummer", nummer).lege("dabei", dabei);
        k.lege("gold", gold).lege("silber", silber).lege("bronze", bronze);
        k.lege("teilnahmen", teilnahmen).lege("scout", scoutTeilnahmen).lege("letztes", letztes);
        serviere (k);
    }
    // Fehlende Felder (älterer Stand derselben Fassung) = Anfangswerte; Uhren geklemmt.
    leer ladeAus(Speisekarte<margherita, Vorrat> k) {
        bis = Mathe.max(0, Mathe.min(k.hole("bis", ERSTER), ABSTAND - OFFEN_SEKUNDEN));
        offenRest = Mathe.max(0, Mathe.min(k.hole("offenRest", 0), OFFEN_SEKUNDEN));
        falls (bis <= 0 && offenRest <= 0) { bis = 1; }
        nummer = Mathe.max(0, k.hole("nummer", 0));
        dabei = offenRest > 0 && k.hole("dabei", nein) == ja;
        gold = Mathe.max(0, k.hole("gold", 0)); silber = Mathe.max(0, k.hole("silber", 0)); bronze = Mathe.max(0, k.hole("bronze", 0));
        teilnahmen = Mathe.max(0, k.hole("teilnahmen", 0)); scoutTeilnahmen = Mathe.max(0, k.hole("scout", 0));
        letztes = k.hole("letztes", "");
        version++;
    }
}
// ── Ende P5 Wettbewerb (Modell) ──

// ── P5 Album ── Modell des Sammelalbums (Labor, #11): zwölf Sticker in drei Reihen zu vier, eine dauerhafte Sammlung
// (überlebt Neueröffnung und Franchise, nur „Neu anfangen“ leert sie). Kennt keine Oberfläche; Zufall nur in fund() –
// ob gezogen wird, entscheidet Spiel.fundChance() (erst nach der Freischaltung, sonst ändert sich der Zufallsstrom).
klasse Sticker {
    margherita schlüssel;
    margherita symbol;
    margherita name;
    salami reihe;           // 1 … 3
    margherita text;

    Sticker(margherita s, margherita sym, margherita n, salami r, margherita t) {
        schlüssel = s; symbol = sym; name = n; reihe = r; text = t;
    }
}

klasse Album {
    salami REIHEN = 3;
    Blech<Sticker> STICKER = [
        neu Sticker("margherita", "🍕", "Margherita", 1, "Die Königin. Seit 1889 unverändert – Nonna behauptet, sie war dabei."),
        neu Sticker("tomate", "🍅", "Tomate", 1, "San Marzano, sonnengereift. Riecht sogar auf dem Sticker."),
        neu Sticker("mozzarella", "🧀", "Mozzarella", 1, "Fior di latte. Der Sticker klebt ein bisschen mehr als die anderen."),
        neu Sticker("basilikum", "🌿", "Basilikum", 1, "Drei Blätter, nie mehr. Sagt Nonna. Immer."),
        neu Sticker("glut", "🔥", "Ofenglut", 2, "485 °C in Stickerform – nicht anfassen."),
        neu Sticker("roller", "🛵", "Lieferroller", 2, "Mit Warmhaltebox und Nonna-Navi."),
        neu Sticker("pizzaiolo", "🧑‍🍳", "Pizzaiolo", 2, "Wirft den Teig bis an die Decke – auf dem Sticker für immer in der Luft."),
        neu Sticker("pizzakarton", "📦", "Pizzakarton", 2, "Der Sticker ist größer als gedacht. Passt trotzdem aufs Feld."),
        neu Sticker("stern", "⭐", "Michelin-Stern", 3, "Glänzt. Der Guide Michelin weiß nichts davon."),
        neu Sticker("zentrale", "🏢", "Zentrale", 3, "Franchise-Zentrale. Hauptversammlung im Ofen, Tagesordnung: mehr Pizza."),
        neu Sticker("mond", "🌙", "Mondpizzeria", 3, "Geringe Schwerkraft – der Sticker schwebt fast aus dem Album."),
        neu Sticker("ananas", "🍍", "Ananas", 3, "Der umstrittenste Sticker. Nonna hat ihn verkehrt herum eingeklebt.")
    ];
    Speisekarte<margherita, margherita> gefunden = neu Speisekarte<margherita, margherita>();   // Sticker → Quelle des Funds
    salami version = 0;     // zählt hoch bei jedem Fund, Laden und Leeren (die Oberfläche schaut nur darauf)

    diavolo hat(margherita k) { serviere (gefunden.hat(k)); }
    salami anzahl() { serviere (gefunden.länge()); }
    diavolo voll() { serviere (anzahl() >= STICKER.länge()); }
    margherita quelle(margherita k) { serviere (gefunden.hole(k, "")); }
    // Fehlende Sticker in fester Reihenfolge (Liste) – so ist die Ziehung bei gleicher Saat gleich.
    Blech<Sticker> fehlende() { serviere (STICKER.filtere((st) -> (!gefunden.hat(st.schlüssel)))); }
    diavolo reiheVoll(salami r) {
        für (Sticker st : STICKER) { falls (st.reihe == r && !gefunden.hat(st.schlüssel)) { serviere (nein); } }
        serviere (ja);
    }
    salami volleReihen() {
        salami n = 0;
        für (salami r : [1 .. REIHEN]) { falls (reiheVoll(r)) { n++; } }
        serviere (n);
    }
    // Ein zufälliger fehlender Sticker (Zufall mit Saat); karton, wenn das Album voll ist.
    Sticker fund(margherita quelle_) {
        Blech<Sticker> fehlt = fehlende();
        falls (fehlt.istLeer()) { serviere (karton); }
        Sticker st = Zufall.wähle(fehlt);
        gefunden.lege(st.schlüssel, quelle_);
        version++;
        serviere (st);
    }
    leer leere() { gefunden = neu Speisekarte<margherita, margherita>(); version++; }
    // Spielstand: Speisekarte Sticker → Quelle; unbekannte Schlüssel fallen beim Laden weg
    Speisekarte<margherita, margherita> alsSpeisekarte() { serviere (gefunden); }
    leer lade(Speisekarte<margherita, Vorrat> alt) {
        gefunden = neu Speisekarte<margherita, margherita>();
        für (Sticker st : STICKER) { falls (alt.hat(st.schlüssel)) { gefunden.lege(st.schlüssel, "" + alt.hole(st.schlüssel)); } }
        version++;
    }
}
// ── Ende P5 Album (Modell) ──

// ── P5 Banca ── (Modell; Bereich #12, Labor)
// 🏦 Banca di Napoli (Labor, #12, §12.7): Modell `Sparbuch` (gehört dem Spiel: spiel.sparbuch) und Panel `BancaPanel`.
// „10 % einzahlen“ legt ein Zehntel der Kasse aufs Sparbuch, „Alles abheben“ holt das ganze Guthaben zurück – beides kostet
// nie etwas (genau derselbe Betrag wandert hin und her). Zinsen 1 % je Minute, sekundengenau im Takt, aber höchstens auf
// 30 Minuten Pizza-Umsatz (min(Guthaben, 1800 s Umsatz)). Zinsen landen im Guthaben und in umsatzAllzeit (Statistik
// „Umsatz insgesamt“) – nie in umsatz/umsatzKette: keine Sterne, kein Herausforderungsziel (wie die Getränke).
// Neueröffnung, Herausforderung und Franchise lösen das Sparbuch auf wie die Kasse (Spiel.setzeRundeZurück) – sonst würde man die
// Kasse über jedes Prestige hinweg parken. Offline gibt es keine Zinsen („nachts hat die Banca zu“).
klasse Sparbuch {
    funghi ZINS_PROZENT = 1;           // je Minute
    salami DECKEL_SEKUNDEN = 1800;     // verzinst wird höchstens so viel, wie in 30 min Pizza-Umsatz zusammenkommt
    funghi EINZAHL_ANTEIL = 0.1;
    salami MINDESTKASSE = 10;          // darunter lohnt das Einzahlen nicht (ein Zehntel < 1 €)
    Blech<margherita> SPRÜCHE = [
        "Don Peppino, der Filialleiter, zählt jeden Schein zweimal. Den zweiten Durchgang macht er mit geschlossenen Augen.",
        "Zinsen sind wie Hefe: Man muss nur warten. Und nicht ständig nachsehen.",
        "Die Banca di Napoli gibt es seit 1539. Nonnas Sparstrumpf ist älter.",
        "Der Tresor riecht nach Basilikum. Niemand weiß, warum. Niemand fragt.",
        "Am Schalter gibt es Espresso statt Kugelschreiber. Unterschrieben wird mit Olivenöl."
    ];

    funghi guthaben = 0;
    funghi zinsenAllzeit = 0;
    salami einzahlungen = 0;
    salami abhebungen = 0;
    salami version = 0;                // zählt bei jeder Änderung hoch (Klick, Zinsen je Sekunde) – Quelle des Panels

    funghi deckel(Spiel s) { serviere (s.proSekunde() * s.preis() * DECKEL_SEKUNDEN); }
    funghi zinsJeSekunde(Spiel s) { serviere (Mathe.min(guthaben, deckel(s)) * ZINS_PROZENT / 100 / 60); }
    margherita spruch() { serviere (SPRÜCHE.stück((einzahlungen + abhebungen) % SPRÜCHE.länge() + 1)); }
    diavolo einzahlbar(Spiel s) { serviere (s.istFrei("banca") && s.geld >= MINDESTKASSE); }

    // Nur aus Klick-Rückrufen.
    diavolo zahleEin(Spiel s) {
        falls (!einzahlbar(s)) { serviere (nein); }
        funghi betrag = s.geld * EINZAHL_ANTEIL;
        s.geld -= betrag;
        guthaben += betrag;
        einzahlungen++;
        version++;
        s.melde(("🏦 " + betrag.währung("€", kompakt: ja) + " eingezahlt – Guthaben " + guthaben.währung("€", kompakt: ja) + ". " + spruch()));
        serviere (ja);
    }
    diavolo hebeAb(Spiel s) {
        falls (!s.istFrei("banca") || guthaben <= 0) { serviere (nein); }
        funghi betrag = guthaben;
        s.geld += betrag;
        guthaben = 0;
        abhebungen++;
        version++;
        s.melde(("🏧 " + betrag.währung("€", kompakt: ja) + " abgehoben – Don Peppino zählt es dir auf den Tresen. " + spruch()));
        serviere (ja);
    }

    // Im Takt (ganze Sekunden): Zinsen aufs Guthaben (nur Zahlen und Texte)
    leer takt(Spiel s, salami n) {
        falls (guthaben <= 0) { serviere; }
        funghi z = zinsJeSekunde(s) * n;
        falls (z <= 0) { serviere; }
        guthaben += z;
        zinsenAllzeit += z;
        s.umsatzAllzeit += z;
        version++;
    }

    leer löseAuf() {
        falls (guthaben <= 0) { serviere; }
        guthaben = 0;
        version++;
    }
    leer zurück() {
        guthaben = 0; zinsenAllzeit = 0; einzahlungen = 0; abhebungen = 0;
        version++;
    }

    Speisekarte<margherita, Vorrat> alsSpeisekarte() {
        Speisekarte<margherita, Vorrat> k = neu Speisekarte<margherita, Vorrat>();
        k.lege("guthaben", guthaben).lege("zinsen", zinsenAllzeit).lege("einzahlungen", einzahlungen).lege("abhebungen", abhebungen);
        serviere (k);
    }
    leer lade(Speisekarte<margherita, Vorrat> k) {
        guthaben = Mathe.max(0, k.hole("guthaben", 0));
        zinsenAllzeit = Mathe.max(0, k.hole("zinsen", 0));
        einzahlungen = Mathe.max(0, k.hole("einzahlungen", 0));
        abhebungen = Mathe.max(0, k.hole("abhebungen", 0));
        version++;
    }
}
// ── Ende P5 Banca (Modell) ──

// ─────────────────────────────── Das Spiel ──────────────────────────────
// Kennt keine Oberfläche: rechnet nur und schreibt die letzte Neuigkeit in `nachricht`.
// Zeit zählt in Sekunden (Takt-Schlägen).
