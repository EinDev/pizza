// ── Reiter 1: Backstube ──
Blech<UpgradeZeile> zeilen = [];

Abschnitt upgradeAbschnitt(margherita titel, Blech<Upgrade> liste, margherita id, Blech<Zutat> vorne) {
    Abschnitt a = neu Abschnitt(titel, vorne, id: id);
    a.stil("abstand", 6);
    für (Upgrade u : liste) {
        UpgradeZeile z = neu UpgradeZeile(u, () -> {
            salami k = kaufMenge == 0 ? u.maxFür(spiel.geld / spiel.preisFaktor()) : kaufMenge;
            falls (spiel.kaufe(u, Mathe.min(k, spiel.kaufGrenze(u)))) { nachVerarbeitung(); }
        });
        zeilen.hinzu(z);
        a.hinzu(z.reihe);
    }
    serviere (a);
}

Schild rezeptInfo = neu Schild("", id: "rezept-info");
rezeptInfo.stil("schrift", "klein");
Knopf rezeptKnopf = neu Knopf("", () -> {
    falls (spiel.blättere()) { nachVerarbeitung(); }
}, id: "rezept");
rezeptKnopf.hinweis("Jede Seite legt einen Belag auf – die Pizza wird teurer, und jede verkaufte bringt mehr.");
Abschnitt rezeptTeil = neu Abschnitt("📖 Nonnas Rezeptbuch", [rezeptInfo, rezeptKnopf], id: "rezeptbuch");

// ── Feinkost-Händler: zwei feste Plätze an der Stelle des ausgelesenen Rezeptbuchs ──
Blech<Feinkost> feinkostPlatz = [karton, karton];
Blech<Schild> feinkostInfos = [];
Blech<Knopf> feinkostKnöpfe = [];
Schild lagerInfo = neu Schild("", id: "feinkost-lager");
lagerInfo.stil("schrift", "klein").stil("farbe", "basilikum");
Abschnitt feinkostTeil = neu Abschnitt("🧀 Feinkost-Händler", [lagerInfo], id: "feinkost");
feinkostTeil.stil("abstand", 6);
feinkostTeil.sichtbar(nein);
für (salami i : [1 .. 2]) {
    Schild info = neu Schild("", id: "feinkost-info-" + i);
    info.stil("schrift", "klein").stil("breite", 340).stil("hoehe", 34);
    Knopf k = neu Knopf("", () -> {
        falls (spiel.kaufeFeinkost(feinkostPlatz.stück(i))) { speichere(); nachVerarbeitung(); }
    }, id: "feinkost-kauf-" + i);
    k.stil("breite", 130).hinweis("Einmal kaufen – wirkt bis zur nächsten Neueröffnung.");
    Reihe r = neu Reihe([info, k], id: "feinkost-" + i);
    r.stil("abstand", 8);
    feinkostInfos.hinzu(info);
    feinkostKnöpfe.hinzu(k);
    feinkostTeil.hinzu(r);
}

leer zeichneFeinkost() {
    diavolo offen = spiel.feinkostOffen();
    falls (feinkostTeil.sichtbar() != offen) { feinkostTeil.sichtbar(offen); }
    falls (!offen) { serviere; }
    Blech<Feinkost> welle = spiel.feinkostAngebot();
    für (salami i : [1 .. 2]) {
        Feinkost k = feinkostPlatz.stück(i);
        falls (k != karton && !welle.enthält(k)) { feinkostPlatz.setze(i, karton); }
    }
    für (Feinkost k : welle) {
        falls (!feinkostPlatz.enthält(k)) {
            falls (feinkostPlatz.stück(1) == karton) { feinkostPlatz.setze(1, k); } sonst falls (feinkostPlatz.stück(2) == karton) { feinkostPlatz.setze(2, k); }
        }
    }
    für (salami i : [1 .. 2]) {
        Feinkost k = feinkostPlatz.stück(i);
        falls (k != karton) {
            setzeText(feinkostInfos.stück(i), k.symbol + " " + k.name + " – jede Pizza +" + k.plus + " %. " + k.text);
            setzeKnopf(feinkostKnöpfe.stück(i), k.preis.euro(kompakt: ja), spiel.geld >= k.preis);
        } sonst {
            setzeText(feinkostInfos.stück(i), "— Der Händler hat alles verkauft, was er hatte. Grazie!");
            setzeKnopf(feinkostKnöpfe.stück(i), "—", nein);
        }
    }
    Blech<Feinkost> lager = spiel.HÄNDLER_WAREN.filtere((k) -> (spiel.feinkost.enthält(k.schlüssel)));
    setzeText(lagerInfo, lager.istLeer() ? "Nonnas Rezeptbuch ist ausgelesen – jetzt geht es um die Zutaten. Das Lager ist noch leer."
        : "✅ Im Lager: " + lager.belege((k) -> (k.symbol + " " + k.name)).verbinde(" · "));
}

// ── Meisterbriefe: drei Plätze, die offenen Briefe rücken nach ──
Blech<Meisterbrief> briefPlatz = [karton, karton, karton];
Blech<Schild> briefInfos = [];
Blech<Knopf> briefKnöpfe = [];
Blech<Reihe> briefReihen = [];
Schild briefKopf = neu Schild("", id: "briefe-kopf");
briefKopf.stil("schrift", "klein").stil("farbe", "basilikum");
briefKopf.sichtbar(nein);
Abschnitt briefTeil = neu Abschnitt("🎓 Meisterbriefe", [briefKopf], id: "meisterbriefe");
briefTeil.stil("abstand", 6);
briefTeil.sichtbar(nein);
für (salami i : [1 .. 3]) {
    Schild info = neu Schild("", id: "brief-info-" + i);
    info.stil("schrift", "klein").stil("breite", 340);
    Knopf k = neu Knopf("", () -> {
        falls (spiel.kaufeBrief(briefPlatz.stück(i))) { nachVerarbeitung(); }
    }, id: "brief-kauf-" + i);
    k.stil("breite", 130).hinweis("Einmal kaufen, wirkt bis zur nächsten Neueröffnung.");
    Reihe r = neu Reihe([info, k], id: "brief-" + i);
    r.stil("abstand", 8);
    r.sichtbar(nein);
    briefReihen.hinzu(r);
    briefInfos.hinzu(info);
    briefKnöpfe.hinzu(k);
    briefTeil.hinzu(r);
}

leer zeichneBriefe() {
    Blech<Meisterbrief> welle = spiel.offeneBriefe();
    // Feste Plätze: Wer noch offen ist, bleibt, wo er ist; freie Plätze bekommen den nächsten aus der Welle.
    für (salami i : [1 .. 3]) {
        Meisterbrief b = briefPlatz.stück(i);
        falls (b != karton && !welle.enthält(b)) { briefPlatz.setze(i, karton); }
    }
    für (Meisterbrief b : welle) {
        falls (!briefPlatz.enthält(b)) {
            salami frei = 0;
            für (salami i : [1 .. 3]) { falls (frei == 0 && briefPlatz.stück(i) == karton) { frei = i; } }
            falls (frei > 0) { briefPlatz.setze(frei, b); }
        }
    }
    für (salami i : [1 .. 3]) {
        Meisterbrief b = briefPlatz.stück(i);
        falls (b != karton) {
            setzeText(briefInfos.stück(i), b.symbol + " " + b.name + " – " + spiel.finde(b.gebäude).name + " ×1,25 (ab " + b.stufe + " Stück)");
            setzeKnopf(briefKnöpfe.stück(i), b.preis.euro(kompakt: ja), spiel.geld >= b.preis);
        } sonst {
            setzeText(briefInfos.stück(i), "— Der nächste Meisterbrief kommt, sobald ein Gebäude 10, 25, 50 oder 100 Stück erreicht.");
            setzeKnopf(briefKnöpfe.stück(i), "—", nein);
        }
        Reihe r = briefReihen.stück(i);
        falls (!r.sichtbar()) { r.sichtbar(ja); }
    }
    salami n = spiel.briefe.länge();
    setzeText(briefKopf, n > 0 ? "✅ " + n + (n == 1 ? " Meisterbrief" : " Meisterbriefe") + " an der Wand – sie verfallen bei der nächsten Neueröffnung."
        : "Noch hängt kein Meisterbrief an der Wand.");
    falls (!briefKopf.sichtbar()) { briefKopf.sichtbar(ja); }
    diavolo zeigen = n > 0 || !welle.istLeer();
    falls (briefTeil.sichtbar() != zeigen) { briefTeil.sichtbar(zeigen); }
}

// ── Kaufmenge 1× · 10× · 100× · Max ── taucht auf, sobald es sich lohnt (10 Stück von irgendwas oder nach der ersten Neueröffnung)
salami kaufMenge = 1;     // 0 = Max
Blech<salami> MENGEN = [1, 10, 100, 0];
Blech<Knopf> mengenKnöpfe = [];
Schild mengeSchild = neu Schild("Kaufmenge:", id: "kaufmenge-text");
mengeSchild.stil("schrift", "klein");
