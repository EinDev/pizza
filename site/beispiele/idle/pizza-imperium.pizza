    // 👩‍🍳 Personal: vier Rollen mit Stufe 0…10 (Preis 4 Mio · 2^Stufe · Rollenfaktor 1 / 1,5 / 2 / 3).
    // Rosa nur 2 % je Stufe: Die Sonderschicht ist spät die größte Einnahme (77 Ladungen je 45 s mit Lavastein ≈ ×1,7 des
    // Betriebs) – 5 % je Stufe hätte sie verdoppelt. Enzo nur 0,5 % je Stufe (stapelt multiplikativ mit der Inflations-Belohnung).
    Blech<Posten> ROLLEN = [
        neu Posten("luigi", "👨‍🍳", "Kellner Luigi", 4_000_000, 2, 1, 10, "Trinkgeld +1 je Stufe – Großbestellungen kommen pünktlicher. Luigi merkt sich jeden Gast. Und jede Ananas."),
        neu Posten("rosa", "🧽", "Spülkraft Rosa", 6_000_000, 2, 1.5, 10, "Der Ofen kühlt 2 % je Stufe schneller ab. Rosa scheuert auch die Glut. Niemand weiß, wie."),
        neu Posten("enzo", "🧮", "Buchhalter Enzo", 8_000_000, 2, 2, 10, "Upgrades 0,5 % je Stufe billiger. Enzo rechnet mit dem Abakus – schneller als die Kasse."),
        neu Posten("bruno", "🕴", "Türsteher Bruno", 12_000_000, 2, 3, 10, "Hawaii-Gäste bestellen nach der Bekehrung +20 % je Stufe mehr. Bruno lächelt nie. Außer bei Margherita.")
    ];
    // ── Inhalt der Bereiche (Paket 3: Stadt und Labor) ──
    // 🛵 Lieferzonen: sechs Stadtviertel als Einmal-Käufe (Posten mit höchstens 1 Stück, fester Preis), Reihenfolge frei;
    // jedes Viertel +5 Punkte (zusammen höchstens +30; §12.7 sah +8 % vor – mit +8 lag Saat 42 nach 2 h über der Grenze) – wie Sterne und Filialen ZUSAMMEN im Alles-Bonus, nicht mal genommen
    // (BONUS_ADDITIV): Als eigener Faktor ×1,48 hätte der Bot die Sternekurve nach 4 h vervierfacht (Schneeball über die
    // Franchise-Kaskade); so wirken die Viertel früh voll und verblassen, wenn Sterne und Filialen den Bonus tragen.
    // Wie Upgrades: bei jeder Neueröffnung wieder zu haben.
    salami VIERTEL_PROZENT = 5;
    Blech<Posten> VIERTEL = [
        neu Posten("altstadt", "🏛", "Altstadt", 10_000_000, 1, 5, 1, "Enge Gassen, breite Vespas. Der Roller passt, die Pizza bleibt heiß."),
        neu Posten("hafen", "⚓", "Hafen", 40_000_000, 1, 5, 1, "Die Fischer bezahlen in Sardinen. Nonna akzeptiert – zum Tageskurs."),
        neu Posten("uni", "🎓", "Uni-Viertel", 160_000_000, 1, 5, 1, "Bestellt um drei Uhr nachts und zitiert dabei Dante."),
        neu Posten("bahnhof", "🚉", "Bahnhof", 640_000_000, 1, 5, 1, "Gleis 7, zweite Bank links – der Zug hat sowieso Verspätung."),
        neu Posten("villen", "🏡", "Villenviertel", 2_500_000_000, 1, 5, 1, "Hier gibt man Trinkgeld in Olivenhainen. Luigi parkt extra leise."),
        neu Posten("industrie", "🏭", "Industriegebiet", 10_000_000_000, 1, 5, 1, "Dort bestellt man Pizza zum Frühstück. Und zum zweiten Frühstück.")
    ];
    // 📣 Marketing: vier Kampagnen, jede ein zeitlich begrenzter Bonus mit Pause; mehrere dürfen zugleich laufen.
    // Preis = 60 Sekunden Pizza-Umsatz (mindestens 10 Tsd. €) – relativ zum Betrieb, bleibt also immer bezahlbar.
    // Betrieb/alles-Kampagnen zählen wie die Viertel als Punkte im Alles-Bonus (Flyer +25, Radio +50, TV +100), die Plakatwand
    // wirkt als Faktor auf den Preis je Pizza (dort gibt es keinen Bonus, in den sie sich einreihen könnte).
    Blech<Kampagne> KAMPAGNEN = [
        neu Kampagne("flyer", "📄", "Flyer", 120, 300, "betrieb", 1.25, "Luigi verteilt sie an der Piazza. Die Hälfte landet als Papierflieger im Brunnen."),
        neu Kampagne("radio", "📻", "Lokalradio", 180, 600, "betrieb", 1.5, "„Radio Vesuvio“ spielt den Jingle zwischen zwei Tarantellas. Nonna singt mit."),
        neu Kampagne("plakat", "🪧", "Plakatwand", 300, 900, "preis", 1.3, "Vier Meter Margherita an der Stadtautobahn. Drei Auffahrunfälle, kein Verletzter."),
        neu Kampagne("tv", "📺", "Fernsehspot", 120, 1800, "alles", 2, "Prime Time, 30 Sekunden, Nonna schaut streng in die Kamera. Ganz Neapel bestellt.")
    ];
    salami KAMPAGNE_MINDESTPREIS = 10_000;
    // 🤖 Nonnas Helfer: vier Einmal-Käufe, dauerhaft. Preise halbiert gegenüber dem Plan (60/300 Mio, 2/50 Mrd), weil die Kette
    // selbst billiger wurde (§12.3 nachjustiert).
    Blech<Helfer> ALLE_HELFER = [
        neu Helfer("pino", "🧑‍🚒", "Ofenwächter Pino", 30_000_000, "zündet die Sonderschicht, sobald der Ofen bereit ist",
            "Sitzt mit der Glutzange vor dem Ofen und wartet. Er wartet sehr gut."),
        neu Helfer("carlo", "👓", "Vorleser Carlo", 150_000_000, "liest die nächste Rezeptseite, sobald sie bezahlbar ist",
            "Liest Nonnas Rezeptbuch laut vor – auch die Fußnoten. Vor allem die Fußnoten."),
        neu Helfer("nonna", "👵", "Spielpartnerin Nonna", 1_000_000_000, "gewinnt 20 s nach dem Ende ihrer Pause selbst ein Minispiel, falls niemand spielt",
            "Spielt gegen sich selbst und gewinnt trotzdem. Wer selbst spielt, bekommt genauso viel."),
        neu Helfer("scout", "🔭", "Wettbewerbs-Scout", 25_000_000_000, "nimmt am Pizza-Wettbewerb teil, sobald einer offen ist",
            "Steht mit Fernglas und Startgeld am Stadtrand. Wartet auf den ersten Wettbewerb.")
    ];
    salami NONNA_WARTET = 20;        // Sekunden nach dem Ende der Minispiel-Pause, bis Nonna selbst spielt (§12.7: 60 – damit spielte sie 23 % seltener als die Hand, R2-Beleg −6 %; 20 s ≈ Hand-Tempo)
    Speisekarte<margherita, salami> garten = neu Speisekarte<margherita, salami>();       // Stück je Beet (Schlüssel) – diese Runde
    Speisekarte<margherita, salami> weinkeller = neu Speisekarte<margherita, salami>();   // Stück je Getränk
    Speisekarte<margherita, salami> personal = neu Speisekarte<margherita, salami>();     // Stufe je Rolle
    Speisekarte<margherita, salami> lieferzonen = neu Speisekarte<margherita, salami>(); // 1 je gekauftem Viertel – diese Runde
    Speisekarte<margherita, salami> kampagneRest = neu Speisekarte<margherita, salami>();  // Restsekunden je laufender Kampagne
    Speisekarte<margherita, salami> kampagnePause = neu Speisekarte<margherita, salami>(); // Pausensekunden je Kampagne (nach dem Ende)
    Blech<margherita> helfer = [];   // angestellte Helfer (Schlüssel) – dauerhaft
    salami kampagnenGestartet = 0;            // gestartete Kampagnen (insgesamt, Statistik)
    salami helferEinsätze = 0;       // Einsätze aller Helfer (insgesamt, Statistik)
    salami versionGarten = 0;        // zählen hoch, wenn sich am Inhalt eines Bereichs etwas ändert (Kauf, Rundenreset)
    salami versionWeinkeller = 0;
    salami versionPersonal = 0;
    salami versionLieferzonen = 0;
    salami versionMarketing = 0;     // Kampagne gestartet oder abgelaufen
    salami versionHelfer = 0;        // Helfer angestellt, Einsatz gezählt
    // ── Inhalt der Bereiche (Paket 4: Labor und Stadt) ──
    // 🧪 Rezeptlabor: zehn Projekte in fester Reihenfolge, nur eins zugleich; die Forschung läuft in Spielsekunden (offline mit,
    // Deckel FORSCHUNG_OFFLINE wie der Betrieb). Ergebnisse sind dauerhaft. Die Wirkungen sitzen an den bestehenden Stellen:
    // Teigruhe klickWert ×1,1 · Schamott-Wärme Abkühlung ×(1 − 10/120) (§12.7 „−10 s“ – absolut gerechnet hätte Ewige Glut
    // 20 → 10 s die Sonderschicht verdoppelt, und die ist spät ≈ 63 % der Einnahmen; anteilig: 120 → 110, 45 → 41, 20 → 18 s) ·
    // Kartonfaltung +5 Bleche · Pausenbrot Pause −15 s · Goldener Rand perfekte Pizza +0,5 Punkte · Nachbarschaftsblatt
    // Ereignis-Abstand ÷ 1,1 · Meisterrabatt briefPreis ×0,9 · Einkaufsgemeinschaft feinkostPreis ×0,9 · Sommelier Getränke ×1,25 ·
    // Gewächshaus Garten ×1,25 (nach dem Deckel: höchstens +62,5 %).
    Blech<Projekt> PROJEKTE = [
        neu Projekt("teigruhe", "🫓", "Teigruhe", 300, 100_000_000, "Klick +10 %", "24 Stunden Ruhe für den Teig. Nonna ruht nie."),
        neu Projekt("schamott", "🧱", "Schamott-Wärme", 480, 300_000_000, "Abkühlung −10 s", "Die Steine speichern die Glut. Und Nonnas Geheimnisse."),
        neu Projekt("karton", "📦", "Kartonfaltung", 600, 1_000_000_000, "Großbestellung +5 Bleche", "Origami-Kurs für Luigi: Jetzt passen fünf Bleche mehr auf den Roller."),
        neu Projekt("pausenbrot", "🥖", "Pausenbrot", 720, 3_000_000_000, "Minispiel-Pause −15 s", "Nonna isst schneller, wenn es Ciabatta gibt."),
        neu Projekt("goldrand", "✨", "Goldener Rand", 900, 10_000_000_000, "perfekte Pizza +0,5 %", "Der Rand ist ein Gedicht – jetzt öfter in Goldschnitt."),
        neu Projekt("nachbarschaft", "📰", "Nachbarschaftsblatt", 1080, 30_000_000_000, "Ereignisse 10 % öfter", "Seite 3: „Pizzeria an der Ecke – ein Erlebnisbericht“. Ganz Neapel liest mit."),
        neu Projekt("meisterrabatt", "🎓", "Meisterrabatt", 1200, 100_000_000_000, "Meisterbriefe −10 %", "Die Handwerkskammer schickt Gutscheine. Nonna rahmt sie ein."),
        neu Projekt("einkauf", "🧺", "Einkaufsgemeinschaft", 1320, 300_000_000_000, "Feinkost −10 %", "Zwölf Pizzerien bestellen zusammen. Der Händler weint vor Freude."),
        neu Projekt("sommelier", "🍷", "Sommelier", 1500, 1_000_000_000_000, "Getränke +25 %", "Luigi schwenkt das Glas, riecht, nickt. Er hat keine Ahnung, es funktioniert."),
        neu Projekt("gewächshaus", "🏡", "Gewächshaus", 1800, 3_000_000_000_000, "Garten +25 %", "Glas, Wärme, Vesuv-Erde. Die Tomaten schreiben Postkarten.")
    ];
    salami FORSCHUNG_OFFLINE = 1800;          // höchstens so viele Sekunden zählt die Forschung offline (wie der Betrieb)
    salami SCHAMOTT_SEKUNDEN = 10;            // Schamott-Wärme: 10 von 120 s Abkühlung, anteilig
    Blech<margherita> forschung = [];         // erforschte Projekte (Schlüssel) – dauerhaft
    margherita forschungLäuft = "";           // Schlüssel des laufenden Projekts ("" = keins)
    salami forschungRest = 0;                 // Restsekunden des laufenden Projekts
    salami versionLabor = 0;                  // Forschung gestartet oder fertig
    // 🧑‍🤝‍🧑 Stammgäste: vier feste Gäste mit je einem Wunsch; die Wunscharten rotieren je Gast in fester Reihenfolge. Der Zähler
    // läuft ab Wunschbeginn (Startwert im Spielstand) über Allzeit-Zähler – Neueröffnung und Franchise setzen nichts zurück (es
    // sind keine Käufe). Belohnung (Klick, R1): BELOHNUNG_PORTIONEN Portionen als Betrieb + ein Treueherz (dauerhaft; HERZ_PUNKTE
    // Punkte je Herz im Alles-Bonus wie Sterne und Viertel, höchstens HERZEN_HÖCHSTENS) – dann der nächste Wunsch.
    // Wunscharten: pizzen (300 Portionen zum Wunschbeginn) · gebäude (3) · sonderschicht (2) · minispiel (1 Sieg) · hawaii (1 Gast) ·
    // großbestellung (1 angenommen – pünktlich oder nicht; Paket 5: „pünktlich“ hing nach einer Neueröffnung ohne Trinkgeld fest).
    Blech<Gast> GÄSTE = [
        neu Gast("rossi", "👩", "Signora Rossi", ["pizzen", "hawaii", "gebäude", "sonderschicht", "großbestellung", "minispiel"],
            ["Für die ganze Verwandtschaft – und die kommt zahlreich.", "Wer Ananas bestellt, kriegt von mir einen Vortrag.",
             "Mein Neffe sucht Arbeit. Bau was, wo er reinpasst.", "Ich will den Ofen glühen sehen wie zu Weihnachten.",
             "Die Nachbarn sollen neidisch sein – pünktlich geliefert!", "Spiel mit Nonna, sie langweilt sich sonst."]),
        neu Gast("timo", "🎓", "Student Timo", ["minispiel", "pizzen", "großbestellung", "gebäude", "hawaii", "sonderschicht"],
            ["Ich hab eine Theorie zum Teigfangen. Beweis sie.", "Hausarbeit bis morgen – ich brauche Pizzen, viele.",
             "Die WG bestellt. Alle zwölf. Pünktlich wäre neu für uns.", "Du expandierst? Gibt es da Praktikumsplätze?",
             "Mein Mitbewohner isst Hawaii. Bekehr ihn, bitte.", "Nachtschicht in der Bibliothek – du auch, Ofen an!"]),
        neu Gast("brunetti", "🕵", "Kommissar Brunetti", ["großbestellung", "hawaii", "sonderschicht", "minispiel", "pizzen", "gebäude"],
            ["Die ganze Wache hat Hunger. Ermittlungen laufen pünktlich.", "Ananas im Lokal? Ich beobachte den Verdächtigen.",
             "Nächtliche Ofenaktivität – ich notiere das. Zweimal.", "Ein Minispiel-Sieg als Alibi, bitte.",
             "Der Fall ist groß. Die Bestellung auch.", "Neue Gebäude? Ich prüfe die Baugenehmigung. Bei einer Margherita."]),
        neu Gast("gianni", "👴", "Opa Gianni", ["sonderschicht", "gebäude", "minispiel", "pizzen", "großbestellung", "hawaii"],
            ["1962 war der Ofen heißer. Beweis mir das Gegenteil.", "Bau was Solides. Nicht so ein Internetz.",
             "Scopa hab ich erfunden. Zeig, was du kannst.", "Nonna hat früher mehr gebacken. Sag ich nur.",
             "Eine Lieferung, pünktlich – wie die Straßenbahn früher.", "Ananas? Zu meiner Zeit gab es dafür Hausverbot."])
    ];
    // Belohnung je erfülltem Wunsch (Portionen, als Betrieb gebacken). §12.7 sah 30 vor – damit holte der Bot ≈ alle 90 s eine
    // Belohnung (Gebäude- und Sonderschicht-Wünsche sind schnell erfüllt), +≈ 33 % Produktion; die Sterne nach 4 h lagen bei
    // 2.597 (Saat 7) bzw. 2.443 (Saat 99) über der Grenze 2.250. Mit 10: Saat 42 / 7 / 99 = 1.780 / 2.053 / 2.028.
    salami BELOHNUNG_PORTIONEN = 10;
    funghi HERZ_PUNKTE = 0.5;                 // Prozentpunkte je Treueherz im Alles-Bonus
    salami HERZEN_HÖCHSTENS = 100;
    salami PIZZEN_WUNSCH_PORTIONEN = 300;     // Pizzen-Wunsch: so viele Portionen zum Zeitpunkt des Wunschs
    Speisekarte<margherita, salami> gastWunsch = neu Speisekarte<margherita, salami>();   // erfüllte Wünsche je Gast (→ Wunschart)
    Speisekarte<margherita, funghi> gastStart = neu Speisekarte<margherita, funghi>();    // Zählerstand bei Wunschbeginn
    Speisekarte<margherita, funghi> gastZiel = neu Speisekarte<margherita, funghi>();     // Ziel des laufenden Wunschs
    salami herzen = 0;                        // Treueherzen – dauerhaft
    funghi gebäudeGekauft = 0;                // gekaufte Gebäude insgesamt (Allzeit-Zähler für den Gebäude-Wunsch)
    funghi großbestellungen = 0;              // angenommene Großbestellungen insgesamt (Allzeit-Zähler für den Großbestellungs-Wunsch)
    salami versionStammgäste = 0;             // Belohnung abgeholt, Wünsche gestartet
    funghi umsatzGetränke = 0;       // Getränkeumsatz diese Runde (nur Kasse und Statistik – zählt nicht zu umsatz/umsatzKette)
    funghi umsatzGetränkeAllzeit = 0;
    funghi getränkeWert = 0;         // Getränke-€/s, in neuBerechnen() ausgerechnet

    // Nonnas Rezeptbuch: jede Seite legt einen Belag auf die Margherita.
    Rezept rezept = neu Rezept();
    salami seite = 0;
    Blech<margherita> SEITEN = ["Salami", "Pilze", "Oliven", "Parmesan", "Rucola", "Gorgonzola", "Artischocken", "Knoblauch"];
    Blech<funghi> SEITEN_KOSTEN = [800, 15_000, 250_000, 4_000_000, 60_000_000, 900_000_000, 12_000_000_000, 150_000_000_000];

    // Ereignisse und Ofen (in Sekunden)
    margherita effekt = "";
    salami effektRest = 0;
    funghi freitagPizzen = 0;
    salami bisEreignis = 60;
    salami ofenKühlt = 0;

    // ── Kennzahlen ── zwischengespeichert; neuBerechnen() nach jeder Änderung an
    // Upgrades, Rezept, Sternen, Talenten, Modus oder Effekt. `version` sagt der Oberfläche: Kopf und Backstube neu beschriften.
    // Weitere Versionszähler je Bereich der Oberfläche – jedes Panel schaut nur auf seinen:
    //   versionGeheim   – Sterne, Talente, Herausforderungen (Nonna-Reiter)
    //   versionErfolge  – ein Erfolg ist dazugekommen
    //   versionBereiche – eine Freischaltung (oben)
    //   versionSpiele   – ein Minispiel beginnt oder endet (Spielecke, von der Spielecke erhöht)
    funghi klickWert = 1;
    funghi sekundeWert = 0;
    funghi preisWert = 8;
    salami version = 0;
    salami versionGeheim = 0;
    salami versionErfolge = 0;
    salami versionSpiele = 0;

    // ── Bereiche freischalten ──
    Bereich bereich(margherita s) {
        für (Bereich b : BEREICHE) { falls (b.schlüssel == s) { serviere (b); } }
        serviere (karton);
    }
    diavolo istFrei(margherita s) { serviere (frei.enthält(s)); }
    // Der Vorgänger in der Kette muss frei sein (der erste hat keinen); frei ist nicht noch einmal freischaltbar.
    diavolo freischaltbar(margherita s) {
        Bereich b = bereich(s);
        falls (b == karton || istFrei(s)) { serviere (nein); }
        serviere (b.nach == "" || istFrei(b.nach));
    }
    diavolo schalteFrei(margherita s) {
        Bereich b = bereich(s);
        falls (!freischaltbar(s) || geld < b.preis) { serviere (nein); }
        geld -= b.preis;
        frei.hinzu(s);
        versionBereiche++;
        falls (s == "stammgaeste") { starteWünsche(); }   // die vier Gäste tragen im selben Rückruf ihren ersten Wunsch vor
        margherita wo = b.reiter == "hof" ? "auf dem Hof" : (b.reiter == "stadt" ? "in der Stadt" : "im Labor");
        melde((b.symbol + " " + b.name + " freigeschaltet (" + b.preis.währung("€", kompakt: ja) + ")! "
            + (hatInhalt(s) ? "Nonna bindet sich die Schürze um – " + wo + " geht es los." : "Nonna räumt schon den Platz frei – der Inhalt kommt mit dem nächsten Paket.")));
        serviere (ja);
    }

    // ── Inhalt der Bereiche: Posten kaufen, Wirkung ──
    // Bereiche mit Posten (Garten, Weinkeller, Personal, Lieferzonen) haben eine Liste Posten und eine Speisekarte
    // Schlüssel → Stück; Marketing und Helfer haben eigene Listen (KAMPAGNEN, ALLE_HELFER) und eigene Kauf-Methoden.
    diavolo hatInhalt(margherita s) {
        serviere (s == "garten" || s == "weinkeller" || s == "personal" || s == "lieferzonen" || s == "marketing" || s == "helfer"
            || s == "labor" || s == "stammgaeste" || s == "katze" || s == "wettbewerb" || s == "album" || s == "banca");
    }
    Blech<Posten> postenVon(margherita s) {
        falls (s == "garten") { serviere (BEETE); }
        falls (s == "weinkeller") { serviere (GETRÄNKE); }
        falls (s == "personal") { serviere (ROLLEN); }
        falls (s == "lieferzonen") { serviere (VIERTEL); }
        serviere ([]);
    }
    Speisekarte<margherita, salami> stückVon(margherita s) {
        falls (s == "garten") { serviere (garten); }
        falls (s == "weinkeller") { serviere (weinkeller); }
        falls (s == "lieferzonen") { serviere (lieferzonen); }
        serviere (personal);
    }
    salami versionInhalt(margherita s) {
        falls (s == "garten") { serviere (versionGarten); }
        falls (s == "weinkeller") { serviere (versionWeinkeller); }
        falls (s == "lieferzonen") { serviere (versionLieferzonen); }
        falls (s == "marketing") { serviere (versionMarketing); }
        falls (s == "helfer") { serviere (versionHelfer); }
        falls (s == "labor") { serviere (versionLabor); }
        falls (s == "stammgaeste") { serviere (versionStammgäste); }
        serviere (versionPersonal);
    }
    salami stück(margherita s, Posten p) { serviere (stückVon(s).hole(p.schlüssel, 0)); }
    salami stufe(margherita rolle) { serviere (istFrei("personal") ? personal.hole(rolle, 0) : 0); }
    diavolo postenVoll(margherita s, Posten p) { serviere (stück(s, p) >= p.höchstens); }
    funghi postenPreis(margherita s, Posten p) { serviere (p.preisBei(stück(s, p))); }

    // Garten: Summe der Stück-Wirkungen in Prozent, höchstens +50 %.
    salami GARTEN_HÖCHSTENS = 50;
    funghi gartenProzent() {
        falls (!istFrei("garten")) { serviere (0); }
        funghi p = 0;
        für (Posten b : BEETE) { p = p + stück("garten", b) * b.wirkung; }
        serviere (Mathe.min(GARTEN_HÖCHSTENS, p) * (hatForschung("gewächshaus") ? 1.25 : 1));   // Gewächshaus: +25 % auf die Ernte
    }
    // Weinkeller: Anteil des Pizza-Umsatzes pro Sekunde in Prozent (0,05 / 0,125 / 0,25 / 0,5 % je Stück).
    funghi getränkeProzent() {
        falls (!istFrei("weinkeller")) { serviere (0); }
        funghi p = 0;
        für (Posten g : GETRÄNKE) { p = p + stück("weinkeller", g) * g.wirkung; }
        serviere (p);
    }
    // €/s eines Getränks mit seiner aktuellen Stückzahl
    funghi getränkWert(Posten g) { serviere (proSekunde() * preis() * stück("weinkeller", g) * g.wirkung / 100); }
    // Was eine Rolle auf ihrer Stufe bewirkt (für Zeile und Meldung); Rosa und Enzo in Prozent je Stufe
    salami ROSA_PROZENT = 2;
    funghi ENZO_PROZENT = 0.5;
    margherita rollenWirkung(Posten r, salami st) {
        falls (r.schlüssel == "luigi") { serviere ("Trinkgeld +" + st); }
        falls (r.schlüssel == "rosa") { serviere ("Ofen kühlt " + (ROSA_PROZENT * st) + " % schneller"); }
        falls (r.schlüssel == "enzo") { serviere ("Upgrades " + (ENZO_PROZENT * st).kompakt(1) + " % billiger"); }
        serviere ("Hawaii-Bonus +" + (20 * st) + " %");
    }

    // Ein Stück kaufen (immer genau eins – die Kaufmenge der Backstube gilt hier nicht). Nur aus Klick-Rückrufen.
    diavolo kaufePosten(margherita s, salami i) {
        Blech<Posten> liste = postenVon(s);
        falls (!istFrei(s) || i < 1 || i > liste.länge()) { serviere (nein); }
        Posten p = liste.stück(i);
        salami n = stück(s, p);
        funghi preis_ = p.preisBei(n);
        falls (n >= p.höchstens || geld < preis_) { serviere (nein); }
        geld -= preis_;
        stückVon(s).lege(p.schlüssel, n + 1);
        falls (s == "garten") {
            versionGarten++;
            neuBerechnen();
            melde((p.symbol + " " + p.name + " gepflanzt (×" + (n + 1) + (n + 1 >= p.höchstens ? ", das Beet ist voll" : "") + "): Die Ernte bringt +"
                + gartenProzent().kompakt(1) + " % je Pizza – jetzt " + preis().währung("€") + "."));
        } sonst falls (s == "weinkeller") {
            versionWeinkeller++;
            neuBerechnen();
            melde((p.symbol + " " + p.name + " ins Regal (×" + (n + 1) + (n + 1 >= p.höchstens ? ", das Regal ist voll" : "") + "): Der Weinkeller bringt jetzt "
                + getränkeWert.währung("€", kompakt: ja) + " pro Sekunde nebenbei."));
        } sonst falls (s == "lieferzonen") {
            versionLieferzonen++;
            neuBerechnen();
            melde(("🛵 " + p.name + " beliefert (" + viertelAnzahl() + "/" + VIERTEL.länge() + " Viertel): +" + viertelProzent() + " % auf alles, gezählt wie Sterne. " + p.text));
        } sonst {
            versionPersonal++;
            neuBerechnen();
            melde((p.symbol + " " + p.name + " befördert – Stufe " + (n + 1) + "/" + p.höchstens + ": " + rollenWirkung(p, n + 1) + "."
                + (n + 1 >= p.höchstens ? " Ab heute Chef. Nonna bleibt trotzdem die Chefin." : "")));
        }
        serviere (ja);
    }

    // 🛵 Lieferzonen: gekaufte Viertel und ihre Punkte im Alles-Bonus (+5 je Viertel, höchstens +30)
    salami viertelAnzahl() {
        falls (!istFrei("lieferzonen")) { serviere (0); }
        salami n = 0;
        für (Posten v : VIERTEL) { n += stück("lieferzonen", v); }
        serviere (n);
    }
    salami viertelProzent() { serviere (VIERTEL_PROZENT * viertelAnzahl()); }

    // 📣 Marketing: Kampagnen starten, Faktoren je Art, Countdown im Takt
    Kampagne kampagne(margherita k) {
        für (Kampagne c : KAMPAGNEN) { falls (c.schlüssel == k) { serviere (c); } }
        serviere (karton);
    }
    salami kampagneRestVon(margherita k) { serviere (kampagneRest.hole(k, 0)); }
    salami kampagnePauseVon(margherita k) { serviere (kampagnePause.hole(k, 0)); }
    diavolo kampagneLäuft(margherita k) { serviere (kampagneRestVon(k) > 0); }
    funghi kampagnePreis() { serviere (Mathe.max(KAMPAGNE_MINDESTPREIS, Mathe.runden(proSekunde() * preis() * 60))); }
    // Produkt der Faktoren aller laufenden Kampagnen einer Art ("betrieb", "preis", "alles")
    funghi marketingFaktor(margherita art) {
        falls (!istFrei("marketing")) { serviere (1); }
        funghi f = 1;
        für (Kampagne c : KAMPAGNEN) { falls (c.art == art && kampagneLäuft(c.schlüssel)) { f = f * c.faktor; } }
        serviere (f);
    }
    // Prozentpunkte aller laufenden Kampagnen auf Betrieb/alles ((faktor − 1) · 100 je Kampagne)
    funghi marketingPunkte() {
        falls (!istFrei("marketing")) { serviere (0); }
        funghi p = 0;
        für (Kampagne c : KAMPAGNEN) { falls (c.art != "preis" && kampagneLäuft(c.schlüssel)) { p = p + (c.faktor - 1) * 100; } }
        serviere (p);
    }
    salami kampagnenLaufend() {
        salami n = 0;
        für (Kampagne c : KAMPAGNEN) { falls (kampagneLäuft(c.schlüssel)) { n++; } }
        serviere (n);
    }
    diavolo kampagneStartbar(Kampagne c) { serviere (istFrei("marketing") && !kampagneLäuft(c.schlüssel) && kampagnePauseVon(c.schlüssel) <= 0); }
    // Nur aus Klick-Rückrufen. Der Preis ist 60 s des laufenden Umsatzes – zum Zeitpunkt des Starts.
    diavolo starteKampagne(salami i) {
        falls (i < 1 || i > KAMPAGNEN.länge()) { serviere (nein); }
        Kampagne c = KAMPAGNEN.stück(i);
        funghi preis_ = kampagnePreis();
        falls (!kampagneStartbar(c) || geld < preis_) { serviere (nein); }
        geld -= preis_;
        kampagneRest.lege(c.schlüssel, c.dauer);
        kampagnePause.lege(c.schlüssel, c.pause);
        kampagnenGestartet++;
        versionMarketing++;
        neuBerechnen();
        melde((c.symbol + " " + c.name + " gestartet (" + preis_.währung("€", kompakt: ja) + "): " + c.wirkung() + ". " + c.text));
        serviere (ja);
    }
    // Im Takt (ganze Sekunden): erst läuft die Kampagne ab, dann die Pause. Das Ende ändert nur Zahlen (neuBerechnen), kein Layout.
    leer kampagnenTakt(salami n) {
        falls (kampagneRest.istLeer() && kampagnePause.istLeer()) { serviere; }
        für (Kampagne c : KAMPAGNEN) {
            margherita k = c.schlüssel;
            salami rest = kampagneRestVon(k);
            falls (rest > 0) {
                rest = rest - n;
                falls (rest > 0) { kampagneRest.lege(k, rest); }
                sonst {
                    kampagneRest.entferne(k);
                    versionMarketing++;
                    neuBerechnen();
                    melde((c.symbol + " " + c.name + " ist vorbei – " + (kampagnenLaufend() > 0 ? "andere Kampagnen laufen weiter." : "Nonna zählt die Kasse nach.")
                        + " Wieder startbar in " + kampagnePauseVon(k) + " s."));
                }
            } sonst falls (kampagnePauseVon(k) > 0) {
                salami pause = kampagnePauseVon(k) - n;
                falls (pause > 0) { kampagnePause.lege(k, pause); } sonst { kampagnePause.entferne(k); versionMarketing++; }
            }
        }
    }

    // Offline: `weg` Sekunden sind vergangen – erst der Rest der Kampagne, der Überhang geht von der Pause ab (ohne Meldung).
    leer kampagnenOffline(salami weg) {
        für (Kampagne c : KAMPAGNEN) {
            margherita k = c.schlüssel;
            salami rest = kampagneRestVon(k);
            salami pause = kampagnePauseVon(k);
            falls (rest <= 0 && pause <= 0) { weiter; }
            salami übrig = weg;
            falls (rest > 0) {
                falls (rest > übrig) { kampagneRest.lege(k, rest - übrig); übrig = 0; }
                sonst { kampagneRest.entferne(k); übrig = übrig - rest; }
            }
            falls (übrig > 0 && pause > 0) {
                falls (pause > übrig) { kampagnePause.lege(k, pause - übrig); } sonst { kampagnePause.entferne(k); }
            }
        }
        versionMarketing++;
    }

    // 🤖 Nonnas Helfer
    diavolo hatHelfer(margherita k) { serviere (istFrei("helfer") && helfer.enthält(k)); }
    diavolo kaufeHelfer(salami i) {
        falls (!istFrei("helfer") || i < 1 || i > ALLE_HELFER.länge()) { serviere (nein); }
        Helfer h = ALLE_HELFER.stück(i);
        falls (helfer.enthält(h.schlüssel) || geld < h.preis) { serviere (nein); }
        geld -= h.preis;
        helfer.hinzu(h.schlüssel);
        versionHelfer++;
        melde((h.symbol + " " + h.name + " angestellt (" + h.preis.währung("€", kompakt: ja) + ") – " + h.wirkung + ". " + h.text));
        serviere (ja);
    }
    // Im Takt, jede volle Sekunde (vor dem Effekt-Abzweig in ticke): Pino zündet im selben Schlag, in dem der Ofen bereit wird;
    // Carlo liest, sobald die Seite bezahlbar ist (nicht im Hawaii-Verbot – das prüft blättere()). Nonnas Spiel läuft in der
    // Spielecke; der Scout meldet sich an, sobald ein Wettbewerb offen ist und das Startgeld reicht (P5, ersetzt den Klick).
    leer helferTakt() {
        falls (helfer.istLeer() || !istFrei("helfer")) { serviere; }
        falls (hatHelfer("pino") && ofenBereit()) { sonderschicht(); helferEinsätze++; versionHelfer++; }
        falls (hatHelfer("carlo") && blättere()) { helferEinsätze++; versionHelfer++; }
        falls (hatHelfer("scout") && wettbewerb.teilnehmen(dies, ja)) { helferEinsätze++; versionHelfer++; }
    }

    // 🧪 Rezeptlabor
    Projekt projekt(margherita k) {
        für (Projekt p : PROJEKTE) { falls (p.schlüssel == k) { serviere (p); } }
        serviere (karton);
    }
    diavolo hatForschung(margherita k) { serviere (forschung.enthält(k)); }
    Projekt laufendesProjekt() { serviere (forschungLäuft == "" ? karton : projekt(forschungLäuft)); }
    // Noch nicht erforschte Projekte ohne das laufende, in fester Reihenfolge – das erste ist das nächste Angebot
    Blech<Projekt> offeneProjekte() { serviere (PROJEKTE.filtere((p) -> (!forschung.enthält(p.schlüssel) && p.schlüssel != forschungLäuft))); }
    Projekt nächstesProjekt() { Blech<Projekt> o = offeneProjekte(); serviere (o.istLeer() ? karton : o.erstes()); }
    // Das Projekt nach dem aktuellen (läuft eins: das erste offene; sonst das zweite offene) – für die Zeile „nächstes“
    Projekt danachProjekt() { Blech<Projekt> o = offeneProjekte(); salami i = forschungLäuft == "" ? 2 : 1; serviere (o.länge() >= i ? o.stück(i) : karton); }
    diavolo forschungStartbar() { serviere (istFrei("labor") && forschungLäuft == "" && nächstesProjekt() != karton); }
    // Nur aus Klick-Rückrufen: zahlt das nächste Projekt und startet es.
    diavolo starteForschung() {
        falls (!forschungStartbar()) { serviere (nein); }
        Projekt p = nächstesProjekt();
        falls (geld < p.preis) { serviere (nein); }
        geld -= p.preis;
        forschungLäuft = p.schlüssel;
        forschungRest = p.dauer;
        versionLabor++;
        melde(("🔬 " + p.name + " wird erforscht (" + p.preis.währung("€", kompakt: ja) + ", " + p.minuten() + "): danach " + p.wirkung + " – für immer. " + p.text));
        serviere (ja);
    }
    // Das laufende Projekt abschließen: nur Zahlen und Text (neuBerechnen), kein Layout. Liefert das Projekt.
    Projekt schließeForschung() {
        Projekt p = laufendesProjekt();
        forschung.hinzu(p.schlüssel);
        forschungLäuft = "";
        forschungRest = 0;
        versionLabor++;
        neuBerechnen();
        serviere (p);
    }
    // Im Takt, ganze Sekunden – vor dem Effekt-Abzweig in ticke(), sonst stünde die Forschung während eines Fests.
    leer forschungTakt(salami n) {
        falls (forschungLäuft == "") { serviere; }
        forschungRest = forschungRest - n;
        falls (forschungRest > 0) { serviere; }
        Projekt p = schließeForschung();
        melde((p.symbol + " " + p.name + " erforscht (" + forschung.länge() + "/" + PROJEKTE.länge() + "): ab jetzt " + p.wirkung + " – für immer. "
            + (forschung.länge() >= PROJEKTE.länge() ? "Nonna hat jetzt einen Doktortitel in Pizzologie." : "Das nächste Projekt wartet im Labor.")));
    }
    // Offline: höchstens FORSCHUNG_OFFLINE Sekunden zählen; fertig → Projekt (für den Willkommensgruß), sonst karton
    Projekt forschungOffline(salami weg) {
        falls (forschungLäuft == "") { serviere (karton); }
        salami gezählt = Mathe.min(weg, FORSCHUNG_OFFLINE);
        falls (gezählt < forschungRest) { forschungRest -= gezählt; versionLabor++; serviere (karton); }
        serviere (schließeForschung());
    }
    // Preise mit Forschungsrabatt (Meisterrabatt, Einkaufsgemeinschaft)
    funghi briefPreis(Meisterbrief b) { serviere (b.preis * (hatForschung("meisterrabatt") ? 0.9 : 1)); }
    funghi feinkostPreis(Feinkost k) { serviere (k.preis * (hatForschung("einkauf") ? 0.9 : 1)); }

    // 🧑‍🤝‍🧑 Stammgäste
    Gast gast(margherita k) {
        für (Gast g : GÄSTE) { falls (g.schlüssel == k) { serviere (g); } }
        serviere (karton);
    }
    // Allzeit-Zähler je Wunschart (werden bei Neueröffnung/Franchise nicht zurückgesetzt)
    funghi wunschZähler(margherita art) {
        falls (art == "pizzen") { serviere (pizzenAllzeit); }
        falls (art == "gebäude") { serviere (gebäudeGekauft); }
        falls (art == "sonderschicht") { serviere (sonderschichten); }
        falls (art == "minispiel") { serviere (minispieleGewonnen); }
        falls (art == "hawaii") { serviere (hawaiiBekehrt); }
        serviere (großbestellungen);
    }
    // Ziel eines neuen Wunschs (Pizzen: Portionen zum Zeitpunkt des Wunschs, mindestens 1 – nach einer Neueröffnung ist der Betrieb leer)
    funghi wunschZiel(margherita art) {
        falls (art == "pizzen") { serviere (Mathe.max(1, Mathe.runden(portion() * PIZZEN_WUNSCH_PORTIONEN))); }
        falls (art == "gebäude") { serviere (3); }
        falls (art == "sonderschicht") { serviere (2); }
        serviere (1);
    }
    margherita wunschText(margherita art, funghi ziel) {
        falls (art == "pizzen") { serviere (anz(ziel) + " Pizzen backen"); }
        falls (art == "gebäude") { serviere (anz(ziel) + " Gebäude kaufen"); }
        falls (art == "sonderschicht") { serviere (anz(ziel) + " Sonderschichten"); }
        falls (art == "minispiel") { serviere ("1 Minispiel gewinnen"); }
        falls (art == "hawaii") { serviere ("1 Hawaii-Gast bekehren"); }
        serviere ("1 Großbestellung annehmen");
    }
    salami wunschNr(Gast g) { serviere (gastWunsch.hole(g.schlüssel, 0)); }
    margherita gastArt(Gast g) { serviere (g.wunschArt(wunschNr(g))); }
    funghi gastZielVon(Gast g) { serviere (gastZiel.hole(g.schlüssel, wunschZiel(gastArt(g)))); }
    funghi gastFortschritt(Gast g) { serviere (Mathe.min(gastZielVon(g), Mathe.max(0, wunschZähler(gastArt(g)) - gastStart.hole(g.schlüssel, 0)))); }
    diavolo wunschErfüllt(Gast g) { serviere (istFrei("stammgaeste") && gastZiel.hat(g.schlüssel) && gastFortschritt(g) >= gastZielVon(g)); }
    // Neuer Wunsch für einen Gast: Zähler ab jetzt, Ziel fest
    leer neuerWunsch(Gast g) {
        margherita art = gastArt(g);
        gastStart.lege(g.schlüssel, wunschZähler(art));
        gastZiel.lege(g.schlüssel, wunschZiel(art));
    }
    // Jeder Gast ohne laufenden Wunsch bekommt einen (Freischalten; Laden eines Stands aus einem früheren Paket)
    leer starteWünsche() {
        für (Gast g : GÄSTE) { falls (!gastZiel.hat(g.schlüssel)) { neuerWunsch(g); } }
        versionStammgäste++;
    }
    funghi herzPunkte() { serviere (herzen * HERZ_PUNKTE); }
    salami wünscheErfüllt() { salami n = 0; für (Gast g : GÄSTE) { n += wunschNr(g); } serviere (n); }
    // Nur aus Klick-Rückrufen (R1): Belohnung abholen, Treueherz, nächster Wunsch.
    diavolo belohne(salami i) {
        falls (!istFrei("stammgaeste") || i < 1 || i > GÄSTE.länge()) { serviere (nein); }
        Gast g = GÄSTE.stück(i);
        falls (!wunschErfüllt(g)) { serviere (nein); }
        funghi bonus = portion() * BELOHNUNG_PORTIONEN;
        backe(bonus); großeEinnahmen++;
        falls (herzen < HERZEN_HÖCHSTENS) { herzen++; }
        gastWunsch.lege(g.schlüssel, wunschNr(g) + 1);
        neuerWunsch(g);
        versionStammgäste++;
        neuBerechnen();
        melde((g.symbol + " " + g.name + " strahlt: " + pizzen(bonus) + " aufs Haus und ein Treueherz (❤️ " + herzen + " → +" + herzPunkte().kompakt(1)
            + " % auf alles, wie Sterne). Neuer Wunsch: „" + g.satz(wunschNr(g)) + "“"));
        serviere (ja);
    }

    // Getränke verkaufen sich im Takt von selbst: Nebeneinkommen in die Kasse und in die Statistik (Umsatz insgesamt,
    // Getränkeumsatz) – nicht in den Runden-Umsatz (Herausforderungsziele) und nicht in die Kette (Sterne), sonst
    // schaukelt der Weinkeller die Sterne hoch.
    leer verkaufeGetränke(funghi erlös) {
        geld += erlös;
        umsatzAllzeit += erlös;
        umsatzGetränke += erlös;
        umsatzGetränkeAllzeit += erlös;
    }

    // ── P5 Katze (Spiel) ── Mozzarella (klasse Katze) wirkt als Prozentpunkte im Alles-Bonus (bonusPunkte, wie Lieferzonen und
    // Herzen) – kein eigener Faktor, der die Franchise-Kaskade zünden würde (Paket 3). Takt in ticke (vor dem Effekt-Abzweig),
    // „Neu anfangen“ in allesZurück, Spielstand in alsSpeisekarte/ladeAus (offline laufen Pausen und Laune-Uhr ab).
    Katze katze = neu Katze();
    salami KATZE_PUNKTE_JE_LAUNE = 4;          // Laune 0…5 → höchstens +20 Punkte
    salami katzePunkte() { serviere (istFrei("katze") ? KATZE_PUNKTE_JE_LAUNE * katze.laune : 0); }
    // ── Ende P5 Katze (Spiel) ──

    // ── P5 Wettbewerb ── (Spiel-Anteil: Modell, Bonus, Klick)
    // Das Modell steht in `klasse Wettbewerb`; das Spiel hält es, ruft dessen Takt (ticke, vor den Helfern), lässt den Scout
    // teilnehmen (helferTakt), zählt die Pokalpunkte in bonusPunkte(), speichert/lädt es und leert es bei „Neu anfangen“.
    // Offline steht die Uhr (ladeAus ruft nichts nach).
    Wettbewerb wettbewerb = neu Wettbewerb();
    funghi wettbewerbPunkte() { serviere (istFrei("wettbewerb") ? wettbewerb.bonusPunkte() : 0); }
    diavolo nimmAmWettbewerbTeil() { serviere (wettbewerb.teilnehmen(dies, nein)); }   // nur aus dem Klick-Rückruf
    // ── Ende P5 Wettbewerb (Spiel) ──

    // ── P5 Album ── Sammelalbum (Labor, #11): Funde aus Ereignis, Sonderschicht (Klick und Pino), Minispiel-Sieg (Hand und
    // Nonna) und Wettbewerb (ruft fundChance("wettbewerb")). Volle Reihen zählen als Prozentpunkte im Alles-Bonus
    // (bonusPunkte(), wie die Lieferzonen) – kein eigener Faktor, sonst zündet die Franchise-Kaskade (Paket 3).
    Album album = neu Album();
    funghi ALBUM_FUNDCHANCE = 0.012;   // Nutzer: voll erst nach 4–6 h aktiven Spiels – Bot (Saat 42/7/99): 4,5 % füllte es in 81–97 min, 1,2 % ≈ 5 h
    salami ALBUM_PUNKTE_JE_REIHE = 10;
    Blech<margherita> ALBUM_QUELLEN = ["ereignis", "sonderschicht", "minispiel", "wettbewerb"];
    Blech<margherita> ALBUM_QUELLEN_TEXT = ["bei einem Ereignis", "in der Sonderschicht", "beim Minispiel-Sieg", "beim Pizza-Wettbewerb"];
    margherita albumQuelleText(margherita q) {
        für (salami i : [1 .. ALBUM_QUELLEN.länge()]) { falls (ALBUM_QUELLEN.stück(i) == q) { serviere (ALBUM_QUELLEN_TEXT.stück(i)); } }
        serviere (q);
    }
    salami albumPunkte() { serviere (istFrei("album") ? album.volleReihen() * ALBUM_PUNKTE_JE_REIHE : 0); }
    diavolo albumVoll() { serviere (istFrei("album") && album.voll()); }   // für den Erfolg „Alle Sticker“ (Paket 6)
    // ALBUM_FUNDCHANCE (1,2 %) Chance auf einen zufälligen fehlenden Sticker. Gezogen wird erst nach der Freischaltung und nur, solange etwas
    // fehlt – vorher bleibt der Zufallsstrom unberührt. Ändert nur Zahlen und Text (R1): Die Fundmeldung kommt VOR die
    // Meldung des Auslösers in die Meldungszeile. Liefert ja bei einem Fund.
    diavolo fundChance(margherita quelle) {
        falls (!istFrei("album") || album.voll()) { serviere (nein); }
        falls (!Zufall.wahr(ALBUM_FUNDCHANCE)) { serviere (nein); }
        salami reihenVorher = album.volleReihen();
        Sticker st = album.fund(quelle);
        falls (st == karton) { serviere (nein); }
        salami reihen = album.volleReihen();
        falls (reihen != reihenVorher) { neuBerechnen(); }
        margherita text = "📒 Sticker " + albumQuelleText(quelle) + ": " + st.symbol + " " + st.name + " (" + album.anzahl() + "/" + album.STICKER.länge() + ")"
            + (album.voll() ? " – das Album ist voll! Nonna rahmt es ein." : (reihen != reihenVorher ? " – Reihe voll: +" + ALBUM_PUNKTE_JE_REIHE + " % auf alles!" : "."));
        nachricht = text + " " + nachricht;
        Bote.sage((text));
        serviere (ja);
    }
    // ── Ende P5 Album (Spiel) ──

    // ── P5 Banca (Spiel) ── Das Sparbuch (klasse Sparbuch): Zinsen im Takt (ticke, vor dem Effekt-Abzweig) nur ins Guthaben und
    // in umsatzAllzeit – nie in umsatz/umsatzKette (keine Sterne, kein Herausforderungsziel). Neueröffnung, Herausforderung und
    // Franchise lösen es wie die Kasse auf (setzeRundeZurück); offline gibt es keine Zinsen.
    Sparbuch sparbuch = neu Sparbuch();
    // ── Ende P5 Banca (Spiel) ──

    // gelernt: Nonna hat es verraten. kennt: es wirkt (im Urlaub wirkt keins).
    diavolo gelernt(margherita talent) { serviere (talente.enthält(talent)); }
    diavolo kennt(margherita talent) { serviere (modus != "urlaub" && talente.enthält(talent)); }
    diavolo bestanden(margherita h) { serviere (geschafft.enthält(h)); }

    salami prozentJeStern() { serviere (kennt("segen") ? 12 : 10); }

    // Alles-Faktor: (1 + Sterne-Bonus + Filialen-Bonus) × Freitagabend. Sterne und Filialen zählen ZUSAMMEN statt
    // miteinander mal genommen – sonst schaukeln sie sich gegenseitig hoch (Schneeball: Millionen Sterne nach kurzer Zeit).
    salami PROZENT_JE_FILIALE = 200;
    salami FRANCHISE_AB = 100;       // Sterne in der laufenden Kette, ab denen man eine Kette gründen kann
    diavolo BONUS_ADDITIV = ja;      // Lieferzonen und Kampagnen (Betrieb/alles) als Prozentpunkte im Alles-Bonus statt als eigene Faktoren
    funghi faktor() {
        serviere ((1 + sterne * prozentJeStern() / 100 + filialen * PROZENT_JE_FILIALE / 100 + (BONUS_ADDITIV ? bonusPunkte() / 100 : 0)) * (effekt == "freitag" ? 3 : 1));
    }
    // Prozentpunkte der Bereiche auf den Alles-Bonus: Viertel (+5 je Viertel), laufende Kampagnen auf Betrieb/alles (Flyer +25,
    // Radio +50, TV +100) und Treueherzen (+0,5 je Herz, höchstens 100 Herzen)
    funghi bonusPunkte() { serviere (viertelProzent() + marketingPunkte() + herzPunkte() + katzePunkte() + wettbewerbPunkte() + albumPunkte()); }

    leer neuBerechnen() {
        // Alles-Faktor; Fernsehspot (Marketing „alles“) wirkt wie der Freitagabend auf Betrieb und Klick, nicht auf den Preis
        funghi f = faktor() * (BONUS_ADDITIV ? 1 : marketingFaktor("alles"));
        // Betrieb: Belohnungen, Ereignisse, Rezepte – dazu – falls nicht additiv – Lieferzonen und Kampagnen (Flyer, Lokalradio)
        funghi fb = f * (bestanden("minikueche") ? 1.5 : 1) * (effekt == "regen" ? 2 : 1) * (effekt == "influencer" ? 1.5 : 1) * (kennt("holzofen") ? 1.5 : 1) * (kennt("ofenflüsterer") ? 2 : 1) * (bestanden("fastenzeit") ? 1.25 : 1)
            * (BONUS_ADDITIV ? 1 : (1 + viertelProzent() / 100) * marketingFaktor("betrieb"));
        funghi s = 0;
        für (Upgrade u : betrieb) {
            diavolo holzofen = u.schlüssel == "lehrling" || u.schlüssel == "steinofen";
            s = s + u.gesamt() * (holzofen && bestanden("neapel") ? 3 : 1) * briefFaktor(u.schlüssel);
        }
        sekundeWert = s * fb;
        // Klick: ein paar feste Pizzen (mit Sternen/Filialen) + ein kleiner Anteil der Sekundenproduktion
        funghi fest = 1;
        funghi anteil = 0;
        für (Upgrade u : handwerk) {
            falls (u.art == "klick") { fest = fest + u.gesamt(); } sonst { anteil = anteil + u.gesamt(); }
        }
        klickWert = (fest * f + anteil / 100 * sekundeWert) * (effekt == "fussball" ? 5 : 1) * (effekt == "tenor" ? 3 : 1) * (hatForschung("teigruhe") ? 1.1 : 1);
        preisWert = rezept.preis * (kennt("sauerteig") ? 1.2 : 1) * (kennt("langteig") ? 1.3 : 1) * (kennt("mutterhefe") ? 1.5 : 1)
            * (bestanden("hawaii") ? 1.25 : 1) * (effekt == "kritiker" ? 2 : 1) * feinkostFaktor() * (1 + gartenProzent() / 100) * marketingFaktor("preis");
        getränkeWert = sekundeWert * preisWert * getränkeProzent() / 100 * (hatForschung("sommelier") ? 1.25 : 1);
        version++;
    }

    funghi preis() { serviere (preisWert); }
    funghi proKlick() { serviere (klickWert); }
    funghi proSekunde() { serviere (sekundeWert); }

    // Für Boni: eine „Portion“ ist ein Klick oder eine Sekunde Betrieb – was mehr ist.
    funghi portion() { serviere (Mathe.max(proKlick(), proSekunde())); }

    Upgrade finde(margherita schlüssel) {
        für (Upgrade u : handwerk) { falls (u.schlüssel == schlüssel) { serviere (u); } }
        für (Upgrade u : betrieb) { falls (u.schlüssel == schlüssel) { serviere (u); } }
        serviere (karton);
    }

    salami anzahl(margherita schlüssel) { serviere (finde(schlüssel).anzahl); }

    salami trinkgeld() { serviere (anzahl("kurier") + anzahl("roller") + stufe("luigi")); }   // Luigi: +1 je Stufe
    // Mehr als 485 °C verträgt kein Ofen (Spielregel – K-127: die Sprache kennt keine Temperatur mehr) – der Vesuv-Kamin heizt sofort bis an die Grenze.
    salami ofenTemperatur() { serviere (kennt("vesuvkamin") ? 485 : Mathe.min(485, 250 + 20 * anzahl("steinofen") + 10 * sterne)); }

    margherita rezeptName() {
        Blech<margherita> b = rezept.beläge;
        falls (b.länge() <= 3) { serviere ("Margherita"); }
        Blech<margherita> extra = [];
        für (salami i : [4 .. b.länge()]) { extra.hinzu(b.stück(i)); }
        serviere ("Margherita mit " + extra.verbinde(", "));
    }

    // Große Anzahlen lesbar: bis 999.999 mit Tausenderpunkten, darüber kompakt („5,61 Mio.“).
    tiefkühl margherita anz(funghi x) {
        serviere (x < 1_000_000 ? x.tausender() : x.kompakt(2));
    }

    tiefkühl margherita pizzen(funghi x) {
        serviere (x.kompakt(1) + (x == 1 ? " Pizza" : " Pizzen"));
    }

    // ── Backen & Verkaufen ──
    funghi backe(funghi n) {
        pizzen += n;
        pizzenAllzeit += n;
        funghi erlös = n * preis();
        geld += erlös;
        umsatz += erlös;
        umsatzAllzeit += erlös;
        umsatzKette += erlös;
        falls (effekt == "freitag") { freitagPizzen += n; }
        serviere (erlös);
    }

    leer melde(margherita text) {
        nachricht = text;
        Bote.sage((text));
    }

    diavolo darfKlicken() { serviere (modus != "fastenzeit"); }

    leer klick() {
        falls (!darfKlicken()) { serviere; }
        klicks++;
        funghi n = proKlick();
        // Glückstreffer: jede fünfzigste Pizza wird perfekt – und zählt zehnfach (Goldener Rand: +0,5 Punkte).
        falls (Zufall.wahr((kennt("glückspilz") ? 0.03 : 0.02) + (hatForschung("goldrand") ? 0.005 : 0))) {
            perfekte++;
            glückstreffer++;
            n = n * (kennt("seele") ? 25 : 10);
            nachricht = "✨ Perfekte Pizza! Der Rand ist ein Gedicht: " + pizzen(n) + " auf einmal.";
        }
        funghi erlös = backe(n);
        letzterKlick = n;
        umsatzKlick += erlös;
        umsatzKlickAllzeit += erlös;
    }

    // Takt: `ms` Millisekunden sind vergangen (10 Schläge pro Sekunde; mehr, wenn der Renderer nachholt).
    // Der Betrieb backt anteilig (Rate × Zeit, Bruchteile von Pizzen zählen mit – nichts geht durch Runden verloren);
    // die Uhren (Ereignisse, Effekte, Ofen, Nonnas Pause) laufen in ganzen Sekunden. Holt der Renderer viel auf einmal
    // nach, wird Sekunde für Sekunde gerechnet – ein Freitagabend wirkt also genau 30 Sekunden lang.
    salami msInSekunde = 0;          // Bruchteil der laufenden Sekunde
    leer vergehe(salami ms) {
        salami rest = ms;
        solange (rest > 0) {
            salami schritt = Mathe.min(rest, 1000 - msInSekunde);
            backe(proSekunde() * schritt / 1000);
            falls (getränkeWert > 0) { verkaufeGetränke(getränkeWert * schritt / 1000); }   // der Weinkeller läuft mit
            msInSekunde += schritt;
            rest -= schritt;
            falls (msInSekunde >= 1000) {
                msInSekunde = 0;
                sekunden++;
                falls (minispielPause > 0) { minispielPause--; }
                ticke(1);
            }
        }
    }

    leer ticke(salami n) {
        falls (ofenKühlt > 0) { ofenKühlt = Mathe.max(0, ofenKühlt - n); }
        wettbewerb.takt(dies, n);   // P5: öffnet/schließt den Wettbewerb (vor den Helfern: der Scout meldet sich im selben Schlag an)
        helferTakt();          // Pino zündet im selben Schlag, in dem der Ofen bereit wird; Carlo liest
        kampagnenTakt(n);      // Marketing läuft ab – vor dem Effekt-Abzweig, sonst stünde die Uhr während eines Fests
        forschungTakt(n);      // das Rezeptlabor forscht weiter (ebenfalls vor dem Abzweig)
        falls (istFrei("katze")) { katze.takt(dies, n); }   // P5: Laune-Uhr und Pausen der Katze (ebenfalls vor dem Abzweig)
        falls (istFrei("banca")) { sparbuch.takt(dies, n); }   // P5: Zinsen aufs Sparbuch (ebenfalls vor dem Abzweig)
        falls (effekt != "") {
            effektRest = effektRest - n;
            falls (effektRest <= 0) { beendeEffekt(); }
            serviere;
        }
        bisEreignis = bisEreignis - n;
        falls (bisEreignis <= 0) {
            falls (modus != "fastenzeit") { ereignis(); }   // Fastenzeit: keine Feste
            bisEreignis = kennt("stammgäste") ? Zufall.zahl(30, 75) : Zufall.zahl(60, 150);
            falls (hatForschung("nachbarschaft")) { bisEreignis = Mathe.max(1, Mathe.runden(bisEreignis / 1.1)); }   // Ereignisse 10 % öfter
        }
    }

    // ── Ereignisse ──
    // Der Topf wächst: Neue Ereignisse kommen erst dazu, wenn ihre Bedingung erfüllt ist.
    Blech<margherita> ereignisTopf() {
        Blech<margherita> topf = ["freitag", "fussball", "hawaii", "großbestellung"];
        falls (sterneAllzeit >= 1) { topf.hinzu("kritiker"); }
        falls (anzahl("roller") >= 10) { topf.hinzu("regen"); }
        falls (neueröffnungen >= 1) { topf.hinzu("geburtstag"); }
        falls (anzahl("wuppertal") >= 1) { topf.hinzu("influencer"); }
        falls (hawaiiBekehrt >= 3) { topf.hinzu("schmuggler"); }
        falls (anzahl("foodtruck") >= 1) { topf.hinzu("tenor"); }
        serviere (topf);
    }

    leer ereignis() {
        margherita welches = Zufall.wähle(ereignisTopf());
        falls (welches == "kritiker") {
            effekt = "kritiker"; effektRest = 30; kritikerBesuche++;
            melde(("🧐 Ein Restaurantkritiker sitzt an Tisch 4! 30 Sekunden lang bringt jede Pizza das Doppelte – Luigi poliert die Teller."));
        } sonst falls (welches == "regen") {
            effekt = "regen"; effektRest = 45; regentage++;
            melde(("🌧 Regentag! Niemand will raus, alle bestellen Lieferung: 45 Sekunden lang backt der Betrieb doppelt."));
        } sonst falls (welches == "geburtstag") {
            funghi bonus = portion() * 30;
            backe(bonus); großeEinnahmen++;
            melde(("🎂 Nonna hat Geburtstag und lässt es sich nicht nehmen, selbst zu backen: " + pizzen(bonus) + ". Tanti auguri!"));
        } sonst falls (welches == "influencer") {
            effekt = "influencer"; effektRest = 60;
            melde(("📱 Eine Food-Influencerin postet deine Margherita (#pizzaporn – Nonna versteht es nicht): 60 Sekunden lang backt der Betrieb +50 %."));
        } sonst falls (welches == "schmuggler") {
            funghi bonus = portion() * 10;
            backe(bonus); großeEinnahmen++;
            melde(("🍍 Ananas-Schmuggler erwischt! Nonna konfisziert zwölf Kisten und verkauft sie an die Konkurrenz: Gegenwert " + pizzen(bonus) + "."));
        } sonst falls (welches == "tenor") {
            effekt = "tenor"; effektRest = 20;
            melde(("🎤 Ein Tenor singt „O sole mio“ im Lokal – 20 Sekunden lang knetet jeder im Takt: Klicks bringen das Dreifache."));
        } sonst falls (welches == "freitag") {
            effekt = "freitag"; effektRest = kennt("freitagslegende") ? 60 : 30; freitagPizzen = 0;
            melde(("🎉 Freitagabend-Ansturm! " + effektRest + " Sekunden lang backt alles dreifach."));
        } sonst falls (welches == "fussball") {
            effekt = "fussball"; effektRest = 20;
            melde(("⚽ Fußballabend! 20 Sekunden lang backt jeder Klick fünfmal so viel."));
        } sonst falls (welches == "hawaii") {
            hawaii();
        } sonst {
            großbestellung();
        }
        neuBerechnen();
        fundChance("ereignis");        // 📒 Sammelalbum (P5)
    }

    leer beendeEffekt() {
        falls (effekt == "freitag") {
            melde(("Der Freitagabend ist vorbei: " + pizzen(freitagPizzen) + " in der Rushhour."));
        } sonst falls (effekt == "kritiker") {
            melde(("Der Kritiker zahlt, nickt und geht. Morgen steht es in der Zeitung."));
        } sonst falls (effekt == "regen") {
            melde(("Die Sonne kommt raus – die Roller dürfen verschnaufen."));
        } sonst falls (effekt == "influencer") {
            melde(("Der Hashtag ist abgekühlt. Nonna hat inzwischen 12 Follower."));
        } sonst falls (effekt == "tenor") {
            melde(("Bravo! Der Tenor verbeugt sich und bestellt eine Quattro Stagioni."));
        } sonst {
            melde(("Abpfiff. Die Fans gehen satt nach Hause."));
        }
        effekt = "";
        effektRest = 0;
        neuBerechnen();
    }

    salami gästeFaktor() { serviere ((kennt("stammgäste") ? 2 : 1) * (kennt("kultstatus") ? 2 : 1)); }

    leer hawaii() {
        falls (modus == "hawaii") {
            melde(("🍍 Hawaii-Verbot verschärft: Luigi zeigt dem Gast freundlich, aber bestimmt die Tür. Nonna nickt."));
            serviere;
        }
        hawaiiBekehrt++;
        funghi bonus = portion() * 5 * gästeFaktor() * (kennt("diplomatie") ? 3 : 1) * (1 + 0.2 * stufe("bruno"));   // Bruno: +20 % je Stufe
        backe(bonus); großeEinnahmen++;
        melde(("🍍 Ein Gast bestellt Pizza Hawaii. Luigi lächelt, schweigt und serviert eine Margherita aufs Haus. "
            + "Der Gast ist bekehrt und bestellt " + pizzen(bonus) + "!"));
    }

    // Lieferung mit Trinkgeld (Spielregel, K-127): Mehr Kuriere/Roller → mehr Trinkgeld → größeres Zeitbudget → pünktlich.
    leer großbestellung() {
        salami bleche = Zufall.zahl(10, 40) + (hatForschung("karton") ? 5 : 0);   // Kartonfaltung: +5 Bleche
        salami tg = trinkgeld();
        Lieferung<salami> l = bestelle(() -> {
            salami fertig = 0;
            für (salami i : [1 .. bleche]) { fertig++; }
            serviere (fertig);
        });
        l.priorität(tg);   // K-127: Priorität statt Trinkgeld – ordnet nur die wennDa-Phase; das Zeitbudget rechnet das Spiel selbst
        Zustellung<salami> z = l.warte(max: 40ms * (1 + tg / 10));   // jeder Euro Trinkgeld +10 % Zeit (Spielregel, früher Sprachregel)
        großbestellungen++;   // der Stammgast-Wunsch zählt jede angenommene Bestellung (auch ohne Trinkgeld erreichbar)
        falls (z.pünktlich() || kennt("mundpropaganda")) {
            pünktlich++;
            funghi bonus = bleche * portion() * gästeFaktor();
            backe(bonus); großeEinnahmen++;
            margherita wie = kennt("mundpropaganda") ? "dank Mundpropaganda" : (tg == 0 ? "auch ohne Trinkgeld" : "dank " + tg + " € Trinkgeld");
            melde(("📦 Großbestellung über " + bleche + " Bleche – " + wie + " pünktlich geliefert: +"
                + (bonus * preis()).währung("€", kompakt: ja) + "."));
        } sonst {
            melde(("📦 Großbestellung über " + bleche + " Bleche – leider zu spät, die Pizza ist kalt. "
                + "Mehr Kuriere und Roller bringen mehr Trinkgeld."));
        }
    }

    // Minispiel gewonnen: so viele Pizzen, wie in `sek` Sekunden gebacken werden (bzw. ein Klick, wenn der mehr bringt).
    funghi minispielGewinn(salami sek) {
        funghi n = portion() * sek * (kennt("abo") ? 1.5 : 1);
        funghi erlös = backe(n); großeEinnahmen++;
        umsatzMini += erlös;
        umsatzMiniAllzeit += erlös;
        serviere (n);
    }

    // ── Aktionen der Spielerin ──
    // Preisfaktor für Upgrades (Inflation ×3, Belohnung −10 %, Buchhalter Enzo −0,5 % je Stufe – multiplikativ, zusammen höchstens 0,9 · 0,95)
    funghi preisFaktor() { serviere ((modus == "inflation" ? 3 : 1) * (bestanden("inflation") ? 0.9 : 1) * (1 - ENZO_PROZENT / 100 * stufe("enzo"))); }
    // So viele Stück darf man noch kaufen (Mini-Küche: höchstens 25 je Gebäude)
    // (Anteil-Handwerk: höchstens ANTEIL_MAX Stück)
    salami kaufGrenze(Upgrade u) {
        salami g = u.höchstens >= 0 ? Mathe.max(0, u.höchstens - u.anzahl) : 1000;
        serviere (modus == "minikueche" && u.art == "betrieb" ? Mathe.min(g, Mathe.max(0, 25 - u.anzahl)) : g);
    }

    diavolo erlaubt(Upgrade u) {
        falls (u.schlüssel == "zentrale" && filialen <= 0) { serviere (nein); }
        falls (kaufGrenze(u) <= 0) { serviere (nein); }
        falls (modus == "neapel" && u.art == "betrieb") { serviere (u.schlüssel == "lehrling" || u.schlüssel == "steinofen"); }
        serviere (ja);
    }

    // k Stück auf einmal (Kaufmenge 1×/10×/100×/Max) – nur ganz oder gar nicht.
    diavolo kaufe(Upgrade u, salami k) {
        falls (k < 1 || !erlaubt(u) || k > kaufGrenze(u)) { serviere (nein); }
        funghi summe = u.kostenFür(k) * preisFaktor();
        falls (geld < summe) { serviere (nein); }
        geld -= summe;
        u.setzeAnzahl(u.anzahl + k);
        falls (u.art == "betrieb") { gebäudeGekauft += k; }   // Zähler für den Gebäude-Wunsch der Stammgäste
        falls (k > größterKauf) { größterKauf = k; }
        nachricht = u.symbol + " " + u.name + (k > 1 ? " ×" + k : "") + " gekauft (jetzt " + u.anzahl + ").";
        neuBerechnen();
        serviere (ja);
    }

    diavolo rezeptFertig() { serviere (seite >= SEITEN.länge()); }
    diavolo rezeptGesperrt() { serviere (modus == "hawaii"); }
    funghi seitenKosten() { serviere (rezeptFertig() ? 0 : SEITEN_KOSTEN.stück(seite + 1)); }

    diavolo blättere() {
        falls (rezeptGesperrt() || rezeptFertig() || geld < seitenKosten()) { serviere (nein); }
        geld -= seitenKosten();
        seite++;
        margherita b = SEITEN.stück(seite);
        rezept.belegeMit(b);
        neuBerechnen();
        melde(("📖 Nonna verrät Seite " + seite + ": " + b + "! Eine Pizza kostet jetzt " + preis().währung("€") + "."
            + (rezeptFertig() ? " Das Rezeptbuch ist ausgelesen – Nonna legt es zurück in die Schublade. Grazie, Nonna!" : "")));
        serviere (ja);
    }

    diavolo ofenBereit() { serviere (ofenKühlt <= 0 && modus != "fastenzeit"); }

    // Sonderschicht: Der Ofen backt Ladung um Ladung, bis sein Zeitbudget aufgebraucht ist.
    // Heißer (mehr Steinöfen, mehr Sterne) = größeres Zeitbudget (zeit · grad/250 – Spielregel, K-127) = mehr Ladungen.
    leer sonderschicht() {
        falls (!ofenBereit()) { serviere; }
        salami grad = Mathe.min(485, ofenTemperatur());     // mehr verträgt kein Ofen (Spielregel)
        salami ladungen = 0;
        probier {
            ladungen = ofen(zeit: 100ms * (kennt("lavastein") ? 2 : 1) * grad / 250) {   // K-127: heißer = größeres Budget ist Spielregel (grad/250)
                salami n = 0;
                solange (ja) { n++; zwischenstand((n)); }
            } roh (r) {
                serviere (r.teilergebnis());
            };
        } verbrannt (a) {
            // Absicherung: Eine Ananas aus dem Ofen darf nie das Spiel beenden.
            ofenKühlt = 120;
            melde(("🔥 Der Ofen hat gestreikt (" + a + ") – Nonna lüftet, in zwei Minuten geht es weiter."));
            serviere;
        }
        sonderschichten++;
        // Rosa: der Ofen kühlt 2 % je Stufe schneller ab; Schamott-Wärme: 10 von 120 s weniger, anteilig (120 → 110, 45 → 41, 20 → 18)
        ofenKühlt = Mathe.max(1, Mathe.runden((kennt("ewigeglut") ? 20 : (kennt("lavastein") ? 45 : 120)) * (1 - ROSA_PROZENT / 100 * stufe("rosa"))
            * (hatForschung("schamott") ? 1 - SCHAMOTT_SEKUNDEN / 120 : 1)));
        funghi bonus = ladungen * portion();
        backe(bonus); großeEinnahmen++;
        melde(("🔥 Sonderschicht bei " + grad + " °C: " + ladungen + " Ofenladungen, " + pizzen(bonus) + "."));
        fundChance("sonderschicht");   // 📒 Sammelalbum (P5): Klick und Pino
    }

    // ── Feinkost ──
    funghi feinkostFaktor() {
        funghi f = 1;
        für (Feinkost k : HÄNDLER_WAREN) { falls (feinkost.enthält(k.schlüssel)) { f = f * (1 + k.plus / 100); } }
        serviere (f);
    }
    diavolo feinkostOffen() { serviere (rezeptFertig() && !rezeptGesperrt()); }
    // Welle: höchstens zwei Angebote, in der Reihenfolge der Liste
    Blech<Feinkost> feinkostAngebot() {
        Blech<Feinkost> welle = [];
        für (Feinkost k : HÄNDLER_WAREN) { falls (welle.länge() < 2 && !feinkost.enthält(k.schlüssel)) { welle.hinzu(k); } }
        serviere (welle);
    }
    diavolo kaufeFeinkost(Feinkost k) {
        falls (k == karton || !feinkostOffen() || feinkost.enthält(k.schlüssel) || geld < feinkostPreis(k)) { serviere (nein); }
        geld -= feinkostPreis(k);
        feinkost.hinzu(k.schlüssel);
        neuBerechnen();
        melde(("🧀 Frisch vom Feinkost-Händler: " + k.symbol + " " + k.name + " – jede Pizza bringt " + k.plus + " % mehr. Eine Pizza kostet jetzt "
            + preis().währung("€") + "."));
        serviere (ja);
    }

    // ── Meisterbriefe ──
    funghi briefFaktor(margherita gebäude) {
        funghi f = 1;
        für (margherita b : briefe) { falls (b.beginntMit(gebäude + "-")) { f = f * 1.25; } }
        serviere (f);
    }

    // Welle: höchstens WELLE_BRIEFE offene (Stufe erreicht, noch nicht gekauft) – die billigsten zuerst.
    salami WELLE_BRIEFE = 2;   // die Meisterbrief-Zeile hat zwei halbe Knöpfe
    Blech<Meisterbrief> offeneBriefe() {
        Blech<Meisterbrief> offen = ALLE_BRIEFE.filtere((b) -> (!briefe.enthält(b.schlüssel) && anzahl(b.gebäude) >= b.stufe))
            .sortiere((a, b) -> (a.preis < b.preis ? -1 : (a.preis > b.preis ? 1 : 0)));
        Blech<Meisterbrief> welle = [];
        für (Meisterbrief b : offen) { falls (welle.länge() < WELLE_BRIEFE) { welle.hinzu(b); } }
        serviere (welle);
    }

    diavolo kaufeBrief(Meisterbrief b) {
        falls (b == karton || briefe.enthält(b.schlüssel) || anzahl(b.gebäude) < b.stufe || geld < briefPreis(b)) { serviere (nein); }
        geld -= briefPreis(b);
        briefe.hinzu(b.schlüssel);
        neuBerechnen();
        nachricht = "🎓 Meisterbrief „" + b.name + "“: " + b.symbol + " " + finde(b.gebäude).name + " backt jetzt ×"
            + briefFaktor(b.gebäude).kompakt(2) + ".";
        serviere (ja);
    }

    // ── Ebene 1: Neueröffnung (Michelin-Sterne) ──
    // Bis 100 Sterne: ⌊√(Umsatz der Kette / 1 Mio. €)⌋ (1 Stern ab 1 Mio. €, 10 ab 100 Mio. €, 100 ab 10 Mrd. €).
    // Darüber wird es steiler – ⌊100 · ⁴√(Umsatz / 10 Mrd. €)⌋: 200 Sterne ab 160 Mrd. €, 1.000 ab 100 Bio. €,
    // 10.000 ab 1 Trio. € –, sonst schaukeln sich Sterne und Filialen gegenseitig hoch (Schneeball).
    salami STEIL_AB = 100;
    salami sterneFür(funghi umsatz) {
        funghi x = umsatz / 1_000_000;
        falls (x <= STEIL_AB * STEIL_AB) { serviere (Mathe.boden(Mathe.wurzel(x))); }
        serviere (Mathe.boden(STEIL_AB * Mathe.wurzel(Mathe.wurzel(x / (STEIL_AB * STEIL_AB))) + 0.000001));
    }
    salami sterneVerdient() { serviere (sterneFür(umsatzKette)); }
    salami neueSterne() { serviere (Mathe.max(0, sterneVerdient() - sterneVergeben)); }
    funghi sternSchwelle(salami n) {
        falls (n <= STEIL_AB) { serviere (n * n * 1_000_000); }
        funghi q = n / STEIL_AB;
        serviere (STEIL_AB * STEIL_AB * 1_000_000 * q * q * q * q);
    }
    funghi nächsterStern() { serviere (sternSchwelle(sterneVerdient() + 1)); }
    // Anteil des Wegs vom letzten zum nächsten Stern (für den Balken)
    funghi sternFortschritt() {
        funghi von = sternSchwelle(sterneVerdient());
        serviere (Mathe.min(1, (umsatzKette - von) / (nächsterStern() - von)));
    }

    salami vergebeSterne() {
        salami n = neueSterne();
        sterne += n; sterneVergeben += n; sterneAllzeit += n;
        versionGeheim++;
        serviere (n);
    }

    leer setzeRundeZurück() {
        geld = 0; pizzen = 0; umsatz = 0; umsatzKlick = 0; umsatzMini = 0; umsatzGetränke = 0;
        briefe = [];
        feinkost = [];
        // Käufe in den Bereichen fangen von vorn an (die Freischaltung bleibt; Helfer sind dauerhaft, laufende Kampagnen und
        // Pausen sind Uhren, keine Käufe – sie laufen weiter)
        garten = neu Speisekarte<margherita, salami>(); weinkeller = neu Speisekarte<margherita, salami>(); personal = neu Speisekarte<margherita, salami>();
        lieferzonen = neu Speisekarte<margherita, salami>();
        versionGarten++; versionWeinkeller++; versionPersonal++; versionLieferzonen++;
        sparbuch.löseAuf();    // P5: das Sparbuch wird wie die Kasse aufgelöst (sonst parkt man die Kasse über jedes Prestige hinweg)
        für (Upgrade u : handwerk) { u.setzeAnzahl(0); }
        für (Upgrade u : betrieb) { u.setzeAnzahl(0); }
        falls (kennt("sparstrumpf")) {
            finde("lehrling").setzeAnzahl(10);
            finde("steinofen").setzeAnzahl(5);
        }
        falls (kennt("erbstück")) {
            finde("roller").setzeAnzahl(10);
            finde("wuppertal").setzeAnzahl(1);
        }
        falls (!kennt("gedächtnis")) {
            rezept = neu Rezept();
            seite = 0;
        }
        modus = "";
        effekt = ""; effektRest = 0; freitagPizzen = 0; ofenKühlt = 0; bisEreignis = 60;
    }

    diavolo neueröffnung() {
        falls (neueSterne() <= 0) { serviere (nein); }
        margherita abbruch = modus != "" ? " Die Herausforderung ist damit beendet." : "";
        salami neu_ = vergebeSterne();
        neueröffnungen++;
        setzeRundeZurück();
        neuBerechnen();
        melde(("⭐ Neueröffnung! Der Guide Michelin vergibt " + anz(neu_) + (neu_ == 1 ? " Stern" : " Sterne")
            + " – jetzt " + anz(sterne) + " aktiv, also +" + anz(sterne * prozentJeStern()) + " % auf alles." + abbruch));
        serviere (ja);
    }

    // ── Ebene 2: Geheimrezepte ──
    diavolo rezepteOffen() { serviere (sterneAllzeit >= 1); }
    diavolo lernbar(Geheimrezept r) {
        serviere (rezepteOffen() && sterne >= rezeptKosten(r) && offeneRezepte().enthält(r));
    }
    // Jedes gelernte Rezept macht die nächsten 40 % teurer (Nonna wird anspruchsvoller): das 10. kostet ≈ 20-mal,
    // das 22. ≈ 1.000-mal so viel wie sein Grundpreis. Nonna im Urlaub (geschafft): 10 % Rabatt.
    salami rezeptKosten(Geheimrezept r) {
        funghi k = r.kosten * Mathe.potenz(1.4, talente.länge()) * (bestanden("urlaub") ? 0.9 : 1);
        serviere (Mathe.max(1, Mathe.runden(k)));
    }
    Geheimrezept rezeptNamens(margherita s) {
        für (Geheimrezept r : REZEPTE) { falls (r.schlüssel == s) { serviere (r); } }
        serviere (karton);
    }

    // Welle: höchstens WELLE_REZEPTE offene Rezepte (Voraussetzung erfüllt, noch nicht gelernt) – die billigsten zuerst.
    // Gelernte verschwinden, das nächste Glied rückt nach.
    salami WELLE_REZEPTE = 3;
    Blech<Geheimrezept> offeneRezepte() {
        Blech<Geheimrezept> offen = REZEPTE.filtere((r) -> (!gelernt(r.schlüssel) && (r.braucht == "" || gelernt(r.braucht))))
            .sortiere((a, b) -> (a.kosten - b.kosten));
        Blech<Geheimrezept> welle = [];
        für (Geheimrezept r : offen) { falls (welle.länge() < WELLE_REZEPTE) { welle.hinzu(r); } }
        serviere (welle);
    }

    diavolo lerne(Geheimrezept r) {
        falls (!lernbar(r)) { serviere (nein); }
        sterne -= rezeptKosten(r);
        talente.hinzu(r.schlüssel);
        versionGeheim++;
        neuBerechnen();
        melde(("📜 Nonna flüstert dir ein Geheimnis zu: " + r.symbol + " " + r.name + ". " + r.text));
        serviere (ja);
    }

    // ── Ebene 3: Herausforderungen ──
    diavolo herausforderungenOffen() { serviere (sterneAllzeit >= 3); }
    Herausforderung herausforderung(margherita s) {
        für (Herausforderung h : HERAUSFORDERUNGEN) { falls (h.schlüssel == s) { serviere (h); } }
        serviere (karton);
    }

    diavolo staffelOffen(Herausforderung h) { serviere (herausforderungenOffen() && filialen >= h.abFilialen); }

    // Welle: höchstens 2 offene Herausforderungen (die laufende zählt mit), Geschafftes klappt in eine Zeile.
    Blech<Herausforderung> offeneHerausforderungen() {
        Blech<Herausforderung> welle = [];
        falls (modus != "") { welle.hinzu(herausforderung(modus)); }
        für (Herausforderung h : HERAUSFORDERUNGEN) {
            falls (welle.länge() < 2 && h.schlüssel != modus && staffelOffen(h) && !bestanden(h.schlüssel)) { welle.hinzu(h); }
        }
        serviere (welle);
    }

    diavolo startbar(Herausforderung h) {
        serviere (staffelOffen(h) && modus == "" && !bestanden(h.schlüssel) && offeneHerausforderungen().enthält(h));
    }

    diavolo starte(Herausforderung h) {
        falls (!startbar(h)) { serviere (nein); }
        salami neu_ = vergebeSterne();
        falls (neu_ > 0) { neueröffnungen++; }
        setzeRundeZurück();
        modus = h.schlüssel;
        falls (modus == "neapel") {      // nur Holzofen – Nonnas Erbstück bleibt im Keller
            für (Upgrade u : betrieb) { falls (!erlaubt(u)) { u.setzeAnzahl(0); } }
        }
        falls (modus == "hawaii") {      // nur Margherita – auch mit Nonnas Gedächtnis
            rezept = neu Rezept();
            seite = 0;
        }
        falls (modus == "fastenzeit") {
            Upgrade l = finde("lehrling");
            l.setzeAnzahl(Mathe.max(l.anzahl, 3));
        }
        versionGeheim++;
        neuBerechnen();
        melde((h.symbol + " Herausforderung „" + h.name + "“ beginnt" + (neu_ > 0 ? " (+" + anz(neu_) + " ⭐)" : "") + ": " + h.regel
            + " Ziel: " + h.ziel.währung("€", kompakt: ja) + " Umsatz."));
        serviere (ja);
    }

    leer gibAuf() {
        falls (modus == "") { serviere; }
        Herausforderung h = herausforderung(modus);
        modus = "";
        versionGeheim++;
        neuBerechnen();
        melde(("🏳 " + h.name + " aufgegeben. Die Runde geht ohne Auflagen weiter."));
    }

    funghi zielFortschritt() {
        falls (modus == "") { serviere (0); }
        serviere (Mathe.min(1, umsatz / herausforderung(modus).ziel));
    }

    leer prüfeZiel() {
        falls (modus == "") { serviere; }
        Herausforderung h = herausforderung(modus);
        falls (umsatz < h.ziel) { serviere; }
        geschafft.hinzu(h.schlüssel);
        modus = "";
        versionGeheim++;          // nur Texte: der Platz behält „✅ geschafft“, bis ein Klick die nächste nachrücken lässt (R1)
        neuBerechnen();
        melde(("🏅 Herausforderung „" + h.name + "“ geschafft! Belohnung für immer: " + h.belohnung));
    }

    // ── Ebene 4: Franchise ──
    // Filialen insgesamt = ⌊√(Sterne insgesamt ÷ 2,5)⌋: 100 Sterne → 6, 160 → 8, 250 → 10, 1.000 → 20 …
    // Gründen geht erst ab FRANCHISE_AB (100) Sternen in der laufenden Kette und nur, wenn es mindestens eine neue Filiale gibt.
    salami sterneKette() { serviere (sterneVergeben + neueSterne()); }
    salami filialenFür(salami s) { serviere (Mathe.boden(Mathe.wurzel(s / 2.5))); }
    salami neueFilialen() {
        falls (sterneKette() < FRANCHISE_AB) { serviere (0); }
        serviere (Mathe.max(0, filialenFür(sterneAllzeit + neueSterne()) - filialen));
    }
    // Sterne insgesamt, ab denen es die nächste Filiale gibt
    salami sterneFürFiliale(salami f) { serviere (Mathe.decke(f * f * 2.5)); }

    diavolo franchise() {
        falls (neueFilialen() <= 0) { serviere (nein); }
        salami n = neueFilialen();
        vergebeSterne();
        filialen += n; franchises++;
        sterne = 0; sterneVergeben = 0; umsatzKette = 0;
        talente = [];
        versionGeheim++;
        setzeRundeZurück();
        neuBerechnen();
        melde(("🏢 Die Kette ist gegründet! " + anz(n) + " neue Filialen – jetzt " + anz(filialen) + ", also +" + anz(filialen * PROZENT_JE_FILIALE)
            + " % auf alles. Sterne und Geheimrezepte fangen von vorn an, die Franchise-Zentrale ist freigeschaltet."));
        serviere (ja);
    }

    // Alles auf Anfang – auch Sterne, Filialen, Erfolge und Statistik.
    leer allesZurück() {
        talente = [];
        setzeRundeZurück();
        pizzenAllzeit = 0; umsatzAllzeit = 0; umsatzKlickAllzeit = 0; umsatzKette = 0; klicks = 0; sekunden = 0;
        sterne = 0; sterneVergeben = 0; sterneAllzeit = 0; neueröffnungen = 0; filialen = 0; franchises = 0;
        hawaiiBekehrt = 0; pünktlich = 0; sonderschichten = 0; perfekte = 0; kritikerBesuche = 0; regentage = 0;
        größterKauf = 0; offlineBoni = 0;
        minispielPause = 0; minispieleGespielt = 0; minispieleGewonnen = 0; minispielSiege = []; umsatzMiniAllzeit = 0;
        siegeJe = neu Speisekarte<margherita, salami>();
        erfolge = []; geschafft = [];
        frei = []; umsatzGetränkeAllzeit = 0;
        helfer = []; kampagneRest = neu Speisekarte<margherita, salami>(); kampagnePause = neu Speisekarte<margherita, salami>();
        kampagnenGestartet = 0; helferEinsätze = 0;
        forschung = []; forschungLäuft = ""; forschungRest = 0;
        herzen = 0; gebäudeGekauft = 0; großbestellungen = 0;
        katze.zurück(); wettbewerb.allesZurück(); album.leere(); sparbuch.zurück();
        gastWunsch = neu Speisekarte<margherita, salami>(); gastStart = neu Speisekarte<margherita, funghi>(); gastZiel = neu Speisekarte<margherita, funghi>();
        versionGeheim++; versionErfolge++; versionBereiche++; versionSpiele++; versionMarketing++; versionHelfer++; versionLabor++; versionStammgäste++;
        neuBerechnen();
        nachricht = "Frischer Teig, leere Kasse – auf ein Neues!";
    }

    // ── Spielstand (für die Vorratskammer), Fassung 6 ──
    salami FASSUNG = 6;
    Speisekarte<margherita, Vorrat> alsSpeisekarte() {
        Speisekarte<margherita, Vorrat> s = neu Speisekarte<margherita, Vorrat>();
        s.lege("version", FASSUNG).lege("zeit", Uhr.echt().inMs());
        s.lege("geld", geld).lege("pizzen", pizzen).lege("umsatz", umsatz).lege("umsatzKlick", umsatzKlick);
        s.lege("pizzenAllzeit", pizzenAllzeit).lege("umsatzAllzeit", umsatzAllzeit);
        s.lege("umsatzKlickAllzeit", umsatzKlickAllzeit).lege("umsatzKette", umsatzKette);
        s.lege("klicks", klicks).lege("sekunden", sekunden).lege("sterne", sterne).lege("neueröffnungen", neueröffnungen);
        s.lege("sterneVergeben", sterneVergeben).lege("sterneAllzeit", sterneAllzeit);
        s.lege("filialen", filialen).lege("franchises", franchises);
        s.lege("talente", talente).lege("geschafft", geschafft).lege("modus", modus);
        s.lege("hawaiiBekehrt", hawaiiBekehrt).lege("pünktlich", pünktlich).lege("sonderschichten", sonderschichten);
        s.lege("perfekte", perfekte).lege("seite", seite).lege("erfolge", erfolge);
        s.lege("minispielPause", minispielPause).lege("minispieleGespielt", minispieleGespielt);
        s.lege("minispieleGewonnen", minispieleGewonnen).lege("minispielSiege", minispielSiege).lege("siegeJe", siegeJe);
        s.lege("umsatzMini", umsatzMini).lege("umsatzMiniAllzeit", umsatzMiniAllzeit);
        s.lege("feinkost", feinkost);
        s.lege("briefe", briefe).lege("kritikerBesuche", kritikerBesuche).lege("regentage", regentage);
        s.lege("größterKauf", größterKauf).lege("offlineBoni", offlineBoni);
        s.lege("frei", frei);
        s.lege("umsatzGetränke", umsatzGetränke).lege("umsatzGetränkeAllzeit", umsatzGetränkeAllzeit);
        Speisekarte<margherita, Vorrat> bereiche = neu Speisekarte<margherita, Vorrat>();
        bereiche.lege("garten", garten).lege("weinkeller", weinkeller).lege("personal", personal).lege("lieferzonen", lieferzonen);
        bereiche.lege("kampagneRest", kampagneRest).lege("kampagnePause", kampagnePause);
        bereiche.lege("gastWunsch", gastWunsch).lege("gastStart", gastStart).lege("gastZiel", gastZiel);
        s.lege("bereiche", bereiche);
        s.lege("helfer", helfer).lege("kampagnen", kampagnenGestartet).lege("helferEinsätze", helferEinsätze);
        s.lege("forschung", forschung).lege("forschungLäuft", forschungLäuft).lege("forschungRest", forschungRest);
        s.lege("herzen", herzen).lege("gebäudeGekauft", gebäudeGekauft).lege("großbestellungen", großbestellungen);
        s.lege("katze", katze.alsSpeisekarte()).lege("wettbewerb", wettbewerb.alsSpeisekarte());
        s.lege("sticker", album.alsSpeisekarte());   // 📒 P5
        s.lege("sparbuch", sparbuch.alsSpeisekarte());
        Speisekarte<margherita, salami> stück = neu Speisekarte<margherita, salami>();
        für (Upgrade u : handwerk) { stück.lege(u.schlüssel, u.anzahl); }
        für (Upgrade u : betrieb) { stück.lege(u.schlüssel, u.anzahl); }
        s.lege("upgrades", stück);
        serviere (s);
    }

    // Stückzahlen eines Bereichs aus dem Stand (fehlende Schlüssel = 0, geklemmt auf die Höchstzahl)
    Speisekarte<margherita, salami> ladeStück(Speisekarte<margherita, Vorrat> bereiche, margherita s) {
        Speisekarte<margherita, salami> alt = bereiche.hole(s, neu Speisekarte<margherita, salami>());
        Speisekarte<margherita, salami> neu_ = neu Speisekarte<margherita, salami>();
        für (Posten p : postenVon(s)) {
            salami n = Mathe.max(0, Mathe.min(alt.hole(p.schlüssel, 0), p.höchstens));
            falls (n > 0) { neu_.lege(p.schlüssel, n); }
        }
        serviere (neu_);
    }
    // Kampagnen-Uhren aus dem Stand (nur bekannte Kampagnen, nur positive Sekunden)
    Speisekarte<margherita, salami> ladeUhren(Speisekarte<margherita, Vorrat> bereiche, margherita s) {
        Speisekarte<margherita, salami> alt = bereiche.hole(s, neu Speisekarte<margherita, salami>());
        Speisekarte<margherita, salami> neu_ = neu Speisekarte<margherita, salami>();
        für (Kampagne c : KAMPAGNEN) {
            salami n = alt.hole(c.schlüssel, 0);
            falls (n > 0) { neu_.lege(c.schlüssel, n); }
        }
        serviere (neu_);
    }

    // Wunsch-Stände aus dem Stand (nur bekannte Gäste, Zahlen ≥ 0)
    Speisekarte<margherita, funghi> ladeGäste(Speisekarte<margherita, Vorrat> bereiche, margherita s) {
        Speisekarte<margherita, funghi> alt = bereiche.hole(s, neu Speisekarte<margherita, funghi>());
        Speisekarte<margherita, funghi> neu_ = neu Speisekarte<margherita, funghi>();
        für (Gast g : GÄSTE) { falls (alt.hat(g.schlüssel)) { neu_.lege(g.schlüssel, Mathe.max(0, alt.hole(g.schlüssel, 0))); } }
        serviere (neu_);
    }

    // Nur ein Stand derselben Fassung wird geladen – ein fremder (älter oder neuer) wird verworfen, keine Migration,
    // keine Ananas: Das Spiel beginnt mit frischem Teig und sagt es. Liefert ja, wenn der Stand übernommen wurde.
    diavolo ladeAus(Speisekarte<margherita, Vorrat> s) {
        falls (s.hole("version", 0) != FASSUNG) {
            neuBerechnen();
            melde(("🧑‍🍳 Ein alter Spielstand passt nicht mehr zu dieser Fassung – frischer Teig!"));
            serviere (nein);
        }
        geld = s.hole("geld", 0); pizzen = s.hole("pizzen", 0); umsatz = s.hole("umsatz", 0);
        umsatzKlick = s.hole("umsatzKlick", 0);
        pizzenAllzeit = s.hole("pizzenAllzeit", 0); umsatzAllzeit = s.hole("umsatzAllzeit", 0);
        umsatzKlickAllzeit = s.hole("umsatzKlickAllzeit", 0);
        umsatzKette = s.hole("umsatzKette", umsatzAllzeit);
        klicks = s.hole("klicks", 0); sekunden = s.hole("sekunden", 0);
        sterne = s.hole("sterne", 0); neueröffnungen = s.hole("neueröffnungen", 0);
        sterneVergeben = s.hole("sterneVergeben", sterne); sterneAllzeit = s.hole("sterneAllzeit", sterne);
        filialen = s.hole("filialen", 0); franchises = s.hole("franchises", 0);
        talente = s.hole("talente", []); geschafft = s.hole("geschafft", []);
        modus = s.hole("modus", "");
        hawaiiBekehrt = s.hole("hawaiiBekehrt", 0); pünktlich = s.hole("pünktlich", 0);
        sonderschichten = s.hole("sonderschichten", 0); perfekte = s.hole("perfekte", 0);
        erfolge = s.hole("erfolge", []);
        minispielPause = s.hole("minispielPause", 0); minispieleGespielt = s.hole("minispieleGespielt", 0);
        minispieleGewonnen = s.hole("minispieleGewonnen", 0); minispielSiege = s.hole("minispielSiege", []);
        siegeJe = s.hole("siegeJe", neu Speisekarte<margherita, salami>());
        umsatzMini = s.hole("umsatzMini", 0); umsatzMiniAllzeit = s.hole("umsatzMiniAllzeit", 0);
        briefe = s.hole("briefe", []);
        feinkost = s.hole("feinkost", []);
        kritikerBesuche = s.hole("kritikerBesuche", 0); regentage = s.hole("regentage", 0);
        größterKauf = s.hole("größterKauf", 0); offlineBoni = s.hole("offlineBoni", 0);
        frei = s.hole("frei", []);
        umsatzGetränke = s.hole("umsatzGetränke", 0); umsatzGetränkeAllzeit = s.hole("umsatzGetränkeAllzeit", 0);
        Speisekarte<margherita, Vorrat> bereiche = s.hole("bereiche", neu Speisekarte<margherita, Vorrat>());   // ein Stand aus Paket 1 hat keins: alles 0
        garten = ladeStück(bereiche, "garten"); weinkeller = ladeStück(bereiche, "weinkeller"); personal = ladeStück(bereiche, "personal");
        lieferzonen = ladeStück(bereiche, "lieferzonen");
        kampagneRest = ladeUhren(bereiche, "kampagneRest"); kampagnePause = ladeUhren(bereiche, "kampagnePause");
        helfer = s.hole("helfer", []); kampagnenGestartet = s.hole("kampagnen", 0); helferEinsätze = s.hole("helferEinsätze", 0);
        // Labor: nur bekannte Projekte; ein laufendes braucht einen Rest ≥ 1
        Blech<margherita> alteForschung = s.hole("forschung", []);
        forschung = alteForschung.filtere((k) -> (projekt(k) != karton));
        margherita alteLäuft = s.hole("forschungLäuft", "");
        forschungLäuft = projekt(alteLäuft) == karton || forschung.enthält(alteLäuft) ? "" : alteLäuft;
        forschungRest = forschungLäuft == "" ? 0 : Mathe.max(1, s.hole("forschungRest", 0));
        // Stammgäste: Herzen geklemmt, Wünsche nur bekannter Gäste; ein Stand aus Paket 3 mit freiem Bereich bekommt die ersten Wünsche
        herzen = Mathe.max(0, Mathe.min(HERZEN_HÖCHSTENS, s.hole("herzen", 0))); gebäudeGekauft = s.hole("gebäudeGekauft", 0);
        großbestellungen = Mathe.max(pünktlich, s.hole("großbestellungen", pünktlich));   // vor Paket 5 zählte der Wunsch pünktliche
        katze.lade(s.hole("katze", neu Speisekarte<margherita, Vorrat>()));   // P5: fehlt im alten Stand → Vorgaben
        wettbewerb.ladeAus(s.hole("wettbewerb", neu Speisekarte<margherita, Vorrat>()));
        album.lade(s.hole("sticker", neu Speisekarte<margherita, Vorrat>()));   // 📒 P5: fehlt im alten Stand → leer
        sparbuch.lade(s.hole("sparbuch", neu Speisekarte<margherita, Vorrat>()));   // P5: offline keine Zinsen
        gastWunsch = ladeGäste(bereiche, "gastWunsch"); gastStart = ladeGäste(bereiche, "gastStart"); gastZiel = ladeGäste(bereiche, "gastZiel");
        falls (istFrei("stammgaeste")) { starteWünsche(); }
        versionGarten++; versionWeinkeller++; versionPersonal++; versionLieferzonen++; versionMarketing++; versionHelfer++; versionLabor++; versionStammgäste++;
        Speisekarte<margherita, salami> stück = s.hole("upgrades", neu Speisekarte<margherita, salami>());
        für (Upgrade u : handwerk) { salami n = stück.hole(u.schlüssel, 0); u.setzeAnzahl(u.höchstens >= 0 ? Mathe.min(n, u.höchstens) : n); }
        für (Upgrade u : betrieb) { u.setzeAnzahl(stück.hole(u.schlüssel, 0)); }
        rezept = neu Rezept();
        seite = 0;
        salami ziel = Mathe.min(s.hole("seite", 0), SEITEN.länge());
        solange (seite < ziel) { seite++; rezept.belegeMit(SEITEN.stück(seite)); }
        // Marketing-Uhren laufen offline ab (wie Nonnas Pause) – vor neuBerechnen, damit kein abgelaufener Bonus die Nacht verzinst
        salami weg = Mathe.boden((Uhr.echt().inMs() - s.hole("zeit", Uhr.echt().inMs())) / 1000);
        falls (weg > 0) { kampagnenOffline(weg); katze.offline(weg); }   // P5: Katzen-Pausen und Laune-Uhr laufen offline ab
        Projekt fertig = weg > 0 ? forschungOffline(weg) : karton;   // die Forschung läuft offline mit (Deckel 30 min) – vor neuBerechnen, damit ihr Bonus die Nacht zählt
        margherita forschungGruß = fertig == karton ? "" : " 🧪 " + fertig.name + " ist fertig erforscht: " + fertig.wirkung + ".";
        neuBerechnen();
        nachricht = "Willkommen zurück! Dein Imperium hat auf dich gewartet." + forschungGruß;

        // Offline-Fortschritt: Der Betrieb backt weiter – mit halber Kraft (Familienbetrieb: drei Viertel), höchstens 30 Minuten lang.
        salami gezählt = Mathe.min(weg, 30 * 60);
        minispielPause = Mathe.max(0, minispielPause - Mathe.max(0, weg));   // Nonnas Pause läuft auch offline ab
        diavolo familie = kennt("familienbetrieb");
        funghi nachts = proSekunde() * gezählt * (familie ? 0.75 : 0.5);
        funghi getränkeNachts = getränkeWert * gezählt * (familie ? 0.75 : 0.5);   // der Weinkeller läuft mit – gleiche Kraft, gleicher Deckel
        falls (gezählt >= 60 && nachts > 0) {
            backe(nachts); großeEinnahmen++;
            falls (getränkeNachts > 0) { verkaufeGetränke(getränkeNachts); }
            offlineBoni++;
            melde(("🌙 Während du weg warst (" + (1min * Mathe.boden(weg / 60)) + (weg > gezählt ? " – gezählt werden höchstens 30min" : "")
                + "), hat dein Betrieb mit " + (familie ? "drei Vierteln" : "halber") + " Kraft " + pizzen(nachts) + " gebacken: +" + (nachts * preis()).währung("€", kompakt: ja) + "."
                + (getränkeNachts > 0 ? " Der Weinkeller: +" + getränkeNachts.währung("€", kompakt: ja) + "." : "") + forschungGruß));
        }
        serviere (ja);
    }
}

// ─────────────────────────────── Minispiele ─────────────────────────────
// Kurz und freiwillig: Ein Sieg bringt so viele Pizzen, wie der Betrieb in ein
// paar Sekunden backt. Danach macht Nonna zwei Minuten Pause (für alle Spiele
// gemeinsam) – so bleibt der Betrieb das Herz des Imperiums.
klasse Minispiel {
    margherita schlüssel;
    margherita symbol;
    margherita name;
    margherita regel;
    salami belohnung;       // Sekunden Produktion
    Dauer schlag;           // so schnell schlägt die Uhr während des Spiels
    margherita art;         // Grundspiel ("teig", …) – bei der Meister-Variante das Spiel, das sie ersetzt
    diavolo meister = nein;

    Minispiel(margherita s, margherita sym, margherita n, salami b, Dauer d, margherita r) {
        schlüssel = s; symbol = sym; name = n; belohnung = b; schlag = d; regel = r; art = s;
    }

    // Meister-Variante: ersetzt das Grundspiel, sobald es dreimal gewonnen wurde.
    Minispiel ersetzt(margherita grund) { art = grund; meister = ja; serviere (dies); }
}

// Die Spielecke kennt keine Oberfläche: Sie rechnet, schreibt `status` und meldet
// Sieg oder Niederlage über das Spiel. Die Spieluhr ruft tick(n).
klasse Spielecke {
    Spiel s;
    salami PAUSE = 120;
    Blech<Minispiel> SPIELE = [
        neu Minispiel("teig", "🫓", "Teig fangen", 8, 150ms,
            "Luigi wirft den Teig in die Luft – fang ihn, wenn 🫓 über dem grünen Feld ▬▬▬ schwebt."),
        neu Minispiel("bestellung", "🧾", "Bestellung merken", 10, 500ms,
            "Ein Gast diktiert vier Beläge. Merk sie dir drei Sekunden lang und klick sie in der richtigen Reihenfolge nach."),
        neu Minispiel("ofen", "🌡", "Ofen halten", 10, 500ms,
            "Der Ofen kühlt ständig ab. Halte ihn 10 Sekunden zwischen 380 und 440 °C – mindestens 7 Sekunden müssen sitzen."),
        neu Minispiel("route", "🛵", "Lieferroute", 8, 500ms,
            "Drei Wege zum Kunden: Wähle binnen 10 Sekunden den schnellsten. Fahrzeit: 2 min je km, 1 min je Ampel, 4 min je Staustufe."),
        // Meister-Varianten (nach drei Siegen im Grundspiel)
        neu Minispiel("teig2", "🌀", "Pizzaiolo-Wurf", 12, 120ms,
            "Luigi wirft höher und schneller – das grüne Feld ▬▬ ist nur noch zwei Felder breit.").ersetzt("teig"),
        neu Minispiel("bestellung2", "👨‍👩‍👧‍👦", "Großfamilie", 13, 500ms,
            "Die ganze Familie bestellt: sechs Beläge, vier Sekunden zum Merken, zwanzig zum Nachklicken.").ersetzt("bestellung"),
        neu Minispiel("ofen2", "🌋", "Lavastein-Ofen", 13, 500ms,
            "Lavastein kühlt schneller ab: Halte 400 bis 430 °C – mindestens 7 von 10 Sekunden.").ersetzt("ofen"),
        neu Minispiel("route2", "🚦", "Rushhour", 12, 500ms,
            "Feierabendverkehr: Vier Wege, mehr Ampeln, mehr Stau – wähle binnen 10 Sekunden den schnellsten.").ersetzt("route")
    ];
    salami MEISTER_AB = 3;   // so viele Siege im Grundspiel, bis die Meister-Variante es ersetzt
    Blech<margherita> BELÄGE = ["🍅 Tomate", "🧀 Mozzarella", "🍄 Pilze", "🫒 Oliven", "🍕 Salami", "🌿 Basilikum"];
    Blech<margherita> STRASSEN = ["Via Roma", "Lungomare", "Corso Garibaldi", "Vicolo Stretto", "Ponte Vecchio", "Piazza Dante"];
    Blech<margherita> STAU = ["🟢 frei", "🟡 zäh", "🔴 Stau"];

    margherita läuft = "";      // Grundspiel des laufenden Spiels ("" = keins) – Meister-Varianten laufen unter dem Grundspiel
    Minispiel aktuell = karton; // das laufende Spiel (Grund- oder Meister-Variante)
    diavolo meister = nein;
    salami zielMin = 380;       // Ofen halten
    salami zielMax = 440;
    margherita status = "";
    salami ticks = 0;
    // Teig fangen: der Zeiger pendelt über 21 Felder, das Ziel ist 3 Felder breit
    salami zone = 0;
    // Bestellung merken
    Blech<margherita> folge = [];
    salami geraten = 0;
    diavolo zeigt = nein;
    // Ofen halten
    salami grad = 0;
    salami imZiel = 0;
    // Lieferroute (Fahrzeit in Zehntelminuten – ganzzahlig, damit Gleichstand exakt ist)
    Blech<margherita> wege = [];
    Blech<margherita> routen = [];
    Blech<salami> fahrzeit = [];

    Spielecke(Spiel sp) { s = sp; }

    Minispiel spielNamens(margherita k) {
        für (Minispiel m : SPIELE) { falls (m.schlüssel == k) { serviere (m); } }
        serviere (karton);
    }
    diavolo erlaubt() { serviere (s.modus != "fastenzeit"); }
    diavolo bereit() { serviere (läuft == "" && s.minispielPause <= 0 && erlaubt()); }
    Dauer intervall() { serviere (läuft == "" ? 500ms : aktuell.schlag); }

    // Jedes Grundspiel hat einen festen Platz in der Spielecke; nach MEISTER_AB Siegen steht dort seine Meister-Variante
    // (gleicher Platz, gleicher Knopf – nur der Text wechselt).
    Blech<margherita> GRUNDSPIELE = ["teig", "bestellung", "ofen", "route"];
    Minispiel variante(margherita grund) {
        diavolo meisterlich = s.siegeJe.hole(grund, 0) >= MEISTER_AB;
        für (Minispiel m : SPIELE) { falls (m.art == grund && m.meister == meisterlich) { serviere (m); } }
        serviere (karton);
    }

    // Startet das Spiel auf dem Platz `grund` (Grund- oder Meister-Variante, je nach Siegen).
    diavolo starte(margherita grund) {
        falls (!bereit()) { serviere (nein); }
        Minispiel m = variante(grund);
        falls (m == karton) { serviere (nein); }
        s.versionSpiele++;
        aktuell = m;
        meister = m.meister;
        margherita k = m.art;
        läuft = k;
        ticks = 0;
        falls (k == "teig") {
            zone = Zufall.zahl(6, 15);
            status = "Klick auf „Fangen!“, wenn 🫓 über dem grünen Feld " + (meister ? "▬▬" : "▬▬▬") + " schwebt.";
        } sonst falls (k == "bestellung") {
            folge = [];
            für (salami i : [1 .. (meister ? 6 : 4)]) { folge.hinzu(Zufall.wähle(BELÄGE)); }
            geraten = 0;
            zeigt = ja;
            status = "Merk dir die Bestellung – gleich ist sie weg!";
        } sonst falls (k == "ofen") {
            grad = meister ? 415 : 410;
            imZiel = 0;
            zielMin = meister ? 400 : 380;
            zielMax = meister ? 430 : 440;
            status = "Ziel: " + zielMin + " bis " + zielMax + " °C. Holz nachlegen heizt um 25 °C, Klappe auf kühlt um 25 °C.";
        } sonst {
            Blech<margherita> namen = Zufall.mische(STRASSEN);
            wege = []; routen = []; fahrzeit = [];
            für (salami i : [1 .. (meister ? 4 : 3)]) {
                salami zehntel = Zufall.zahl(15, 60);   // 1,5 bis 6 km
                salami ampeln = Zufall.zahl(0, meister ? 9 : 6);
                salami stau = Zufall.zahl(0, 2);
                wege.hinzu(namen.stück(i));
                fahrzeit.hinzu(zehntel * 2 + ampeln * 10 + stau * 40);
                routen.hinzu(namen.stück(i) + ": " + (zehntel / 10).kompakt(1) + " km · " + ampeln + " 🚦 · " + STAU.stück(stau + 1));
            }
            status = "Fahrzeit: 2 min je km, 1 min je Ampel, 4 min je Staustufe (🟡 1, 🔴 2).";
        }
        serviere (ja);
    }

    // ── Teig fangen ──
    salami zeiger() {
        salami p = ticks % 40;
        serviere (p <= 20 ? p : 40 - p);
    }
    diavolo imZiel(salami i) { serviere (i >= zone && i <= zone + (meister ? 1 : 2)); }
    diavolo imFeld() { serviere (imZiel(zeiger())); }
    // Was auf Feld i (0…20) der Bahn zu sehen ist
    margherita feld(salami i) { serviere (i == zeiger() ? "🫓" : (imZiel(i) ? "▬" : "·")); }
    leer fange() {
        falls (läuft != "teig") { serviere; }
        falls (imFeld()) { gewinne("Gefangen! Luigi applaudiert, der Boden wird hauchdünn."); }
        sonst { verliere("Daneben – der Teig klebt an der Decke."); }
    }

    // ── Bestellung merken ──
    leer tippe(margherita b) {
        falls (läuft != "bestellung" || zeigt) { serviere; }
        falls (folge.stück(geraten + 1) != b) {
            verliere("Falsch – der Gast wollte " + folge.verbinde(", ") + ".");
            serviere;
        }
        geraten++;
        falls (geraten >= folge.länge()) { gewinne("Genau so bestellt! Der Gast ist begeistert."); }
        sonst { status = "Richtig! Noch " + (folge.länge() - geraten) + " Beläge."; }
    }
    margherita bestellungText() {
        falls (zeigt) { serviere (folge.verbinde(" → ")); }
        Blech<margherita> teile = [];
        für (salami i : [1 .. folge.länge()]) { teile.hinzu(i <= geraten ? folge.stück(i) : "❓"); }
        serviere (teile.verbinde(" → "));
    }

    // ── Ofen halten ──
    leer heize(salami d) {
        falls (läuft != "ofen") { serviere; }
        grad = Mathe.max(250, Mathe.min(485, grad + d));
    }
    diavolo ofenImZiel() { serviere (grad >= zielMin && grad <= zielMax); }

    // ── Lieferroute ──
    leer nimmRoute(salami i) {
        falls (läuft != "route") { serviere; }
        falls (i > fahrzeit.länge()) { serviere; }
        salami beste = fahrzeit.zusammenklappen((a, b) -> (Mathe.min(a, b)));
        margherita weg = wege.stück(i);
        falls (fahrzeit.stück(i) <= beste) {
            gewinne("Über " + weg + " in " + (fahrzeit.stück(i) / 10).kompakt(1) + " min – schneller geht's nicht!");
        } sonst {
            verliere("Über " + weg + " dauert es " + (fahrzeit.stück(i) / 10).kompakt(1) + " min, der schnellste Weg nur "
                + (beste / 10).kompakt(1) + " min.");
        }
    }

    // Die Spieluhr: n Schläge sind vergangen (n > 1, wenn der Renderer nachholt).
    leer tick(salami n) {
        falls (läuft == "") { serviere; }
        falls (!erlaubt()) {
            läuft = "";
            status = "";
            s.versionSpiele++;
            s.melde(("🎲 Fastenzeit – Nonna räumt die Spiele weg."));
            serviere;
        }
        falls (läuft == "teig") {
            ticks += n;
            falls (ticks >= 80) { verliere("Zu spät – der Teig ist auf dem Boden gelandet."); }
        } sonst falls (läuft == "bestellung") {
            ticks += n;
            falls (zeigt && ticks >= merkTicks()) {
                zeigt = nein;
                ticks = 0;
                status = "Jetzt du: Klick die Beläge in der richtigen Reihenfolge.";
            } sonst falls (!zeigt && ticks >= antwortTicks()) {
                verliere("Zu langsam – der Gast hat sich eine Calzone bestellt.");
            }
        } sonst falls (läuft == "ofen") {
            salami k = Mathe.min(n, 20 - ticks);
            solange (k > 0) {
                k--;
                ticks++;
                grad = Mathe.max(250, Mathe.min(485, grad + (meister ? Zufall.zahl(-20, 8) : Zufall.zahl(-16, 6))));
                falls (ofenImZiel() && ticks % 2 == 0) { imZiel++; }   // gezählt wird jede volle Sekunde
            }
            falls (ticks >= 20) {
                falls (imZiel >= 7) { gewinne("Sauber gehalten – " + imZiel + " von 10 Sekunden im Ziel."); }
                sonst { verliere("Nur " + imZiel + " von 10 Sekunden im Ziel – die Pizza ist ungleichmäßig."); }
            }
        } sonst {
            ticks += n;
            falls (ticks >= 20) { verliere("Zu lange überlegt – der Kunde hat abgesagt."); }
        }
    }

    salami merkTicks() { serviere (meister ? 8 : 6); }       // 4 bzw. 3 Sekunden
    salami antwortTicks() { serviere (meister ? 40 : 30); }  // 20 bzw. 15 Sekunden

    // Wert für den Balken (0…1)
    funghi balken() {
        falls (läuft == "teig") { serviere (zeiger() / 20); }
        falls (läuft == "bestellung") { serviere (zeigt ? 1 - ticks / merkTicks() : 1 - ticks / antwortTicks()); }
        falls (läuft == "ofen") { serviere ((grad - 250) / 235); }
        falls (läuft == "route") { serviere (1 - ticks / 20); }
        serviere (0);
    }

    leer gewinne(margherita text) {
        Minispiel m = aktuell;
        funghi n = s.minispielGewinn(m.belohnung);
        s.minispieleGewonnen++;
        falls (!s.minispielSiege.enthält(m.schlüssel)) { s.minispielSiege.hinzu(m.schlüssel); }
        salami siege = s.siegeJe.hole(m.art, 0) + 1;
        s.siegeJe.lege(m.art, siege);
        beende();
        margherita neu_ = "";
        falls (!m.meister && siege == MEISTER_AB) {
            Minispiel nächstes = SPIELE.filtere((x) -> (x.meister && x.art == m.art)).erstes();
            neu_ = " Nonna ist beeindruckt: Ab jetzt gibt es " + nächstes.symbol + " " + nächstes.name + "!";
        }
        s.melde((m.symbol + " " + m.name + ": " + text + " +" + Spiel.pizzen(n) + " (" + (n * s.preis()).währung("€", kompakt: ja) + ")." + neu_));
        s.fundChance("minispiel");   // 📒 Sammelalbum (P5): Hand und Nonna
    }

    leer verliere(margherita text) {
        Minispiel m = aktuell;
        beende();
        s.melde((m.symbol + " " + m.name + ": " + text + " Diesmal kein Bonus."));
    }

    leer beende() {
        s.minispieleGespielt++;
        s.minispielPause = Mathe.max(1, (s.kennt("kartenspiel") ? 90 : PAUSE) - (s.hatForschung("pausenbrot") ? 15 : 0));   // Pausenbrot: −15 s
        läuft = "";
        status = "";
        s.versionSpiele++;
    }

    // 👵 Spielpartnerin Nonna (Helfer): NONNA_WARTET Sekunden (20) nach dem Ende der Pause, wenn niemand spielt, gewinnt sie das
    // sichtbare Spiel mit der höchsten Belohnung – zählt als Spiel und Sieg (auch für die Meister-Variante), startet die Pause.
    // Wer selbst spielt, bekommt dasselbe. Aus dem Takt-Rückruf, je volle Sekunde; ändert nur Zahlen und Texte.
    salami nonnaWartet = 0;
    leer nonnaTakt(salami n) {
        falls (!s.hatHelfer("nonna") || !erlaubt() || läuft != "" || s.minispielPause > 0) { nonnaWartet = 0; serviere; }
        nonnaWartet += n;
        falls (nonnaWartet < s.NONNA_WARTET) { serviere; }
        nonnaWartet = 0;
        Minispiel best = karton;
        für (margherita g : GRUNDSPIELE) {
            Minispiel m = variante(g);
            falls (best == karton || m.belohnung > best.belohnung) { best = m; }
        }
        aktuell = best;
        s.helferEinsätze++; s.versionHelfer++;
        gewinne("Nonna spielt selbst – und gewinnt natürlich.");
        // Die Wartezeit holt Nonna bei ihrer Pause wieder auf: Ihr Takt ist der einer Hand, die sofort spielt (R2 – nie seltener als die Hand)
        s.minispielPause = Mathe.max(0, s.minispielPause - s.NONNA_WARTET);
    }
}

// ═══════════════════════════════ Spielstart ═════════════════════════════
Spiel spiel = neu Spiel();
Spielecke ecke = neu Spielecke(spiel);

Blech<Erfolg> ERFOLGE = [
    neu Erfolg("Erste Margherita", "Backe deine erste Pizza.", (s) -> (s.pizzenAllzeit >= 1)),
    neu Erfolg("Ein Blech voll", "Backe 100 Pizzen.", (s) -> (s.pizzenAllzeit >= 100)),
    neu Erfolg("Tausendsassa", "Backe 1.000 Pizzen.", (s) -> (s.pizzenAllzeit >= 1000)),
    neu Erfolg("Pizzamillionär", "Backe 1 Million Pizzen.", (s) -> (s.pizzenAllzeit >= 1_000_000)),
    neu Erfolg("Fleißige Hände", "Klicke 100-mal.", (s) -> (s.klicks >= 100)),
    neu Erfolg("Sehnenscheide aus Stahl", "Klicke 1.000-mal.", (s) -> (s.klicks >= 1000)),
    neu Erfolg("Ich hab nur kurz geklickt", "Klicke 10.000-mal.", (s) -> (s.klicks >= 10_000)),
    neu Erfolg("Perfektionist", "Backe drei perfekte Pizzen.", (s) -> (s.perfekte >= 3)),
    neu Erfolg("412 Pizzen an einem Freitag", "Backe 412 Pizzen in einem einzigen Freitagabend-Ansturm.",
        (s) -> (s.freitagPizzen >= 412)),   // freitagPizzen zählt nur während des Ansturms
    neu Erfolg("Standhaft", "Bekehre drei Hawaii-Gäste zur Margherita.", (s) -> (s.hawaiiBekehrt >= 3)),
    neu Erfolg("Pünktlich wie die Post", "Liefere drei Großbestellungen pünktlich.", (s) -> (s.pünktlich >= 3)),
    neu Erfolg("Heiße Nächte", "Fahre fünf Sonderschichten.", (s) -> (s.sonderschichten >= 5)),
    neu Erfolg("Nonnas Spielkamerad", "Gewinne jedes der vier Minispiele einmal.",
        (s) -> (["teig", "bestellung", "ofen", "route"].filtere((k) -> (s.minispielSiege.enthält(k))).länge() >= 4)),
    neu Erfolg("Meisterschüler", "Schalte eine Meister-Variante frei (drei Siege in einem Spiel).",
        (s) -> (["teig", "bestellung", "ofen", "route"].filtere((k) -> (s.siegeJe.hole(k, 0) >= 3)).länge() >= 1)),
    neu Erfolg("Stammspieler", "Spiele 25 Minispiele.", (s) -> (s.minispieleGespielt >= 25)),
    neu Erfolg("Nonnas Liebling", "Lies Nonnas Rezeptbuch bis zur letzten Seite.", (s) -> (s.rezeptFertig())),
    neu Erfolg("Feinschmecker", "Kaufe alles, was der Feinkost-Händler hat – in einer Runde.", (s) -> (s.feinkost.länge() >= s.HÄNDLER_WAREN.länge())),
    neu Erfolg("Wuppertal ruft", "Eröffne eine Filiale in Wuppertal.", (s) -> (s.anzahl("wuppertal") >= 1)),
    neu Erfolg("Großeinkauf", "Kaufe 50 Stück auf einmal.", (s) -> (s.größterKauf >= 50)),
    neu Erfolg("Meisterhaft", "Häng 10 Meisterbriefe in einer Runde an die Wand.", (s) -> (s.briefe.länge() >= 10)),
    neu Erfolg("Lehrlingsheim", "Beschäftige 100 Lehrlinge.", (s) -> (s.anzahl("lehrling") >= 100)),
    neu Erfolg("Food-Truck-Festival", "Besitze 25 Foodtrucks.", (s) -> (s.anzahl("foodtruck") >= 25)),
    neu Erfolg("Fuhrpark", "Besitze 50 Lieferroller.", (s) -> (s.anzahl("roller") >= 50)),
    neu Erfolg("Hitzewelle", "Heize 100 Steinöfen.", (s) -> (s.anzahl("steinofen") >= 100)),
    neu Erfolg("Kaufrausch", "Kaufe 100 Stück auf einmal.", (s) -> (s.größterKauf >= 100)),
    neu Erfolg("Nachteule", "Komm zurück, nachdem dein Betrieb ohne dich gebacken hat.", (s) -> (s.offlineBoni >= 1)),
    neu Erfolg("Kritikerliebling", "Bewirte drei Restaurantkritiker.", (s) -> (s.kritikerBesuche >= 3)),
    neu Erfolg("Regenmacher", "Erlebe fünf Regentage.", (s) -> (s.regentage >= 5)),
    neu Erfolg("Hawaii? Nein danke.", "Bekehre 50 Hawaii-Gäste zur Margherita.", (s) -> (s.hawaiiBekehrt >= 50)),
    neu Erfolg("Erste Million", "Mache 1 Mio. € Umsatz.", (s) -> (s.umsatzAllzeit >= 1_000_000)),
    neu Erfolg("Milliardärin der Margherita", "Mache 1 Mrd. € Umsatz.", (s) -> (s.umsatzAllzeit >= 1_000_000_000)),
    neu Erfolg("Pizzafabrikant", "Backe 1 Milliarde Pizzen.", (s) -> (s.pizzenAllzeit >= 1_000_000_000)),
    neu Erfolg("Billionen-Belag", "Mache 1 Bio. € Umsatz.", (s) -> (s.umsatzAllzeit >= 1_000_000_000_000)),
    neu Erfolg("Sternekoch", "Eröffne neu und hol dir einen Michelin-Stern.", (s) -> (s.sterneAllzeit >= 1)),
    neu Erfolg("Firmament", "Sammle zehn Michelin-Sterne.", (s) -> (s.sterneAllzeit >= 10)),
    neu Erfolg("Nonnas Vertraute", "Lerne ein Geheimrezept.", (s) -> (!s.talente.istLeer())),
    neu Erfolg("Nonnas Erbe", "Kenne zehn Geheimrezepte gleichzeitig.", (s) -> (s.talente.länge() >= 10)),
    neu Erfolg("Ofenmeister", "Lerne die ganze Ofen-Kette bis zum Ofenflüsterer.", (s) -> (s.kennt("ofenflüsterer"))),
    neu Erfolg("Nonna hat nichts mehr zu verraten", "Kenne alle Geheimrezepte gleichzeitig.", (s) -> (s.talente.länge() >= s.REZEPTE.länge())),
    neu Erfolg("Fastenbrecher", "Schaffe die Fastenzeit – ganz ohne Klicken.", (s) -> (s.bestanden("fastenzeit"))),
    neu Erfolg("Prüfungsmeister", "Schaffe drei Herausforderungen.", (s) -> (s.geschafft.länge() >= 3)),
    neu Erfolg("Kettenreaktion", "Gründe deine erste Franchise-Kette.", (s) -> (s.filialen >= 1)),
    neu Erfolg("Inflationsgewinner", "Schaffe die Inflation.", (s) -> (s.bestanden("inflation"))),
    neu Erfolg("Kleine Küche, großer Umsatz", "Schaffe die Mini-Küche.", (s) -> (s.bestanden("minikueche"))),
    neu Erfolg("Urlaubsvertretung", "Schaffe es ohne Nonnas Geheimrezepte.", (s) -> (s.bestanden("urlaub"))),
    neu Erfolg("Großmeister der Spielecke", "Gewinne alle vier Meister-Varianten.",
        (s) -> (["teig2", "bestellung2", "ofen2", "route2"].filtere((k) -> (s.minispielSiege.enthält(k))).länge() >= 4)),
    neu Erfolg("Doppelt hält besser", "Gründe zweimal eine Kette.", (s) -> (s.franchises >= 2)),
    neu Erfolg("Sternenhimmel", "Sammle 100 Michelin-Sterne.", (s) -> (s.sterneAllzeit >= 100)),
    neu Erfolg("Houston, wir haben Hunger", "Eröffne den Saturnring-Lieferdienst.", (s) -> (s.anzahl("saturn") >= 1)),
    neu Erfolg("Pizzaxie", "Gründe die Galaktische Pizzakette.", (s) -> (s.anzahl("galaxie") >= 1)),
    neu Erfolg("Zurück in die Pizzeria", "Bau Nonnas Zeitmaschine.", (s) -> (s.anzahl("zeitmaschine") >= 1)),
    neu Erfolg("Pizza-Universum", "Backe 1 Billion Pizzen.", (s) -> (s.pizzenAllzeit >= 1_000_000_000_000)),
    neu Erfolg("Alle Pizzen, überall, gleichzeitig", "Öffne das Pizza-Multiversum.", (s) -> (s.anzahl("multiversum") >= 1))
];

// Vorratskammer: Spielstand laden (Playground: Browser-Speicher, EXE: Datei im Nutzerverzeichnis).
// Mit Namensraum (K-106): ein Spielstand für Galerie, App-Link jeder Fassung und EXE – egal, aus welchem Tab gestartet.
// Nur Fassung 6 wird übernommen; alles andere ist frischer Teig (ladeAus sagt es in der Meldung).
Vorratskammer kammer = neu Vorratskammer("spielstand", namensraum: "pizza-imperium");
falls (kammer.hat("spielstand")) { spiel.ladeAus(kammer.hole("spielstand")); }
salami gespeichertBei = 0;     // Spielsekunde des letzten Speicherns (alle 30 s wird gespeichert)

leer speichere() {
    kammer.lege("spielstand", spiel.alsSpeisekarte());
    gespeichertBei = spiel.sekunden;
}

// ═══════════════════════════════ Oberfläche ═════════════════════════════
// Reaktiv (Theke v5): Das Modell (Spiel, Spielecke) kennt keine Oberfläche; die Oberfläche kennt kein zeichne().
// Jede Zutat bindet ihre Eigenschaften beim Aufbau einmal an einen Ausdruck (`binde`, `bindeStil`), der aus dem Modell
// rechnet. Damit die Theke weiß, WANN sie neu rechnen muss, liest jeder Ausdruck als Erstes einen Zettel:
//   zTakt      – Taktgeber: dreht sich nach jedem Rückruf (Takt, Klick, Taste). Daran hängt, was an Kasse oder Uhr hängt:
//                Kasse, Balken, „bezahlbar“, Preise der Kaufmenge Max, Abkühl-Countdown, laufendes Minispiel.
//   zSekunde   – Spielsekunde (= spiel.sekunden): Kennzahlen, Pausen-Countdown, Statistik (nur bei offenem Reiter).
//   zVersion   – spiegelt spiel.version (neuBerechnen): alle Beschriftungen von Kopf und Backstube.
//   zPlaetze   – Belegung der Plätze (belegeNeu/belegeRezepte/belegeProben – nur aus Klick-Rückrufen, R1).
//   zBereiche/zGeheim/zErfolge/zSpiele/zGarten/zWeinkeller/zPersonal/… – spiegeln die Versionszähler des Modells je Panel.
//   zNachricht – spiegelt spiel.nachricht;  zMenge – die Kaufmenge;  zFrage – welcher Knopf gerade zurückfragt.
// Die Spiegel setzt `synchronisiere()` am Ende jedes Rückrufs (nachVerarbeitung) – gleicher Wert = keine Neuberechnung
// (K-117). Eine Bindung rechnet nur (K-118): keine Setter, keine Animationen; die stehen in den Rückrufen.
// Imperium und Nonna rechnen nur, wenn ihr Reiter offen ist (quelleImperium/quelleNonna): Die Bindung liest zuerst
// den Ja/Nein-Zettel zImperiumOffen bzw. zNonnaOffen (der Reiter-Rückruf setzt ihn) und erst bei offenem Reiter ihre
// anderen Zettel – Quellen werden je Auswertung neu erfasst, ein Wechsel zwischen anderen Reitern weckt sie nicht.
//
// R3 – unsichtbar, bis es angeboten wird (THEKE-ERWEITERUNGEN §12.9): Sichtbar ist nur, was man kaufen KÖNNTE (unabhängig
// vom Kontostand) – das nächste Gebäude erst nach dem Kauf des vorigen, ein Bereich erst, wenn sein Vorgänger frei ist,
// Feinkost erst mit dem ausgelesenen Buch, Meisterbriefe erst mit der erreichten Stufe, Nonna erst mit dem ersten Stern.
// Keine 🔒-Platzhalter, keine „—“-Zeilen, keine festen Höhen: Die Oberfläche beginnt klein und wächst durch Anhängen.
// Reihenfolge = Erscheinensfolge: Neues hängt hinten an (Zeilen unten im Panel, Panels unten in der Spalte, Reiter rechts)
// und verschiebt nichts Bestehendes. Sichtbarkeit ist gebunden (`binde("sichtbar", …)`) – an Zettel, die sich nur durch
// Klicks ändern (zPlaetze, zBereiche, zGeheim); was im Takt erscheinen oder verschwinden kann (das Spielfeld eines Minispiels,
// die Franchise ab 100 ⭐, „✅ Geschafft“, die Erfolge-Tabelle), steht ganz unten in seiner Spalte oder Seite, sodass darunter
// nichts liegt, das sich bewegen könnte. Wachsende Listen (Betrieb, Handwerk) stehen als letztes Element ihrer Spalte; was
// darüber erscheint (Feinkost, Meisterbriefe), ist je EINE feste Zeile und erscheint nur im Klick-Rückruf – auch wenn Carlo die
// letzte Rezeptseite im Takt liest, steht der Händler erst nach dem nächsten Kauf da (§12.9/8).
//
// Plätze (R1): Welches Gebäude in welchem Slot steht, welches Rezept oder welche Herausforderung nachrückt, entscheidet
// ausschließlich `belegeNeu()` & Co. – und das wird nur aus Klick-Rückrufen aufgerufen (nachKauf(), nachLernen(),
// nachAufstieg()), nie im Takt. Wird im Takt etwas fertig, wechseln nur Texte und Knopfzustände.
//
// Raster (v6/v7): Fenster 860 × 640, Innenbreite immer 820 (breite − 40, K-122); die Seite scrollt, wenn sie länger wird.
// Kopf volle Breite (VOLL), jede Seite eine Reihe aus zwei Spalten (je 404, `senkrecht oben`) – Spiele und Erfolge eine Spalte
// voller Breite. Panel-Innenbreite 370: Zeile = Schild 228 + 8 + Knopf 130, Zeilenhöhe 56 (Knopf mit zwei Zeilen = 53 px)
// bzw. 60 für Schilder mit drei Zeilen. Abschnitt-Titel und Tabellenzellen haben feste Zeilen (K-121), Tabellen feste
// Spaltengewichte (K-126). Geteilte Rechnungen liegen auf abgeleiteten Zetteln (Zettel.aus, K-125).
salami VOLL = 820;
salami SPALTE_BREITE = 404;
salami SCHILD_BREITE = 228;
salami KNOPF_BREITE = 130;
salami HALB_KNOPF = 181;          // zwei Knöpfe nebeneinander in einer Panelzeile (Lieferzonen, Ofen halten)
salami INNEN = 370;
salami KLEIN_SCHILD = 194;        // Schild in den Kleinbetrieben (Abschnitt im Abschnitt: 34 px weniger Platz)
salami VOLL_INNEN = 786;          // Panel in voller Breite (Spiele): 820 − 34
salami VOLL_SCHILD = 648;         // Schild neben einem Knopf in voller Breite: 786 − 8 − 130
salami ZEILE_HOEHE = 56;
salami ZEILE_HOEHE_3 = 60;
salami ZEILE_HOEHE_TEXT = 40;     // Zeile nur aus einem Schild mit zwei Zeilen (Labor: „nächstes“, „erforscht“)

// ── Zettel ──
Zettel zTakt = neu Zettel(0);
Zettel zSekunde = neu Zettel(-1);     // −1: beim ersten synchronisiere() rechnet jede Bindung einmal aus dem fertigen Modell
Zettel zVersion = neu Zettel(-1);
Zettel zPlaetze = neu Zettel(0);
Zettel zBereiche = neu Zettel(-1);
Zettel zGeheim = neu Zettel(-1);
Zettel zErfolge = neu Zettel(-1);
Zettel zSpiele = neu Zettel(-1);
Zettel zGarten = neu Zettel(-1);
Zettel zWeinkeller = neu Zettel(-1);
Zettel zPersonal = neu Zettel(-1);
Zettel zLieferzonen = neu Zettel(-1);
Zettel zMarketing = neu Zettel(-1);
Zettel zHelfer = neu Zettel(-1);
Zettel zLabor = neu Zettel(-1);
Zettel zStammgaeste = neu Zettel(-1);
Zettel zNachricht = neu Zettel("");
Zettel zMenge = neu Zettel(1);        // Kaufmenge 1 · 10 · 100 · 0 = Max (gilt für alle Plätze, wird nicht gespeichert)
Zettel zFrage = neu Zettel("");       // id des Knopfs, der gerade „Wirklich? Nochmal klicken!“ fragt

Zettel zInhalt(margherita s) {
    falls (s == "garten") { serviere (zGarten); }
    falls (s == "weinkeller") { serviere (zWeinkeller); }
    falls (s == "lieferzonen") { serviere (zLieferzonen); }
    falls (s == "marketing") { serviere (zMarketing); }
    falls (s == "helfer") { serviere (zHelfer); }
    falls (s == "labor") { serviere (zLabor); }
    falls (s == "stammgaeste") { serviere (zStammgaeste); }
    serviere (zPersonal);
}

// Acht Reiter in Erscheinensfolge: Backstube · Hof · Spiele · Erfolge · Imperium immer, dann Stadt (sobald die Lieferzonen
// angeboten sind), Labor (sobald die Helfer angeboten sind), Nonna (mit dem ersten Stern). Welcher Reiter offen ist, steht für
// die Bindungen auf zwei Ja/Nein-Zetteln. Die Titel sind fest (Hinweise stehen in den Kennzahlen und als Marke am Reiter).
salami REITER_SPIELE = 3;
salami REITER_IMPERIUM = 5;
salami REITER_NONNA = 8;
Zettel zImperiumOffen = neu Zettel(nein);
Zettel zNonnaOffen = neu Zettel(nein);

// Quellen der Reiter „Imperium“ und „Nonna“ (viele Texte, zwei Tabellen): Sie rechnen nur, wenn ihr Reiter offen ist.
// Ist er zu, liest die Bindung nur den Offen-Zettel – erst das Öffnen weckt sie wieder (Quellen werden je Auswertung neu
// erfasst), das Schließen rechnet einmal nach, ein Wechsel zwischen anderen Reitern gar nicht (K-117: ja bleibt nein).
leer quelleImperium() {
    falls (!zImperiumOffen.wert()) { serviere; }
    zGeheim.wert(); zVersion.wert(); zBereiche.wert(); zSekunde.wert();
}
leer quelleNonna() {
    falls (!zNonnaOffen.wert()) { serviere; }
    zGeheim.wert(); zPlaetze.wert(); zVersion.wert();
}
// Die laufende Herausforderung zählt Umsatz je Sekunde (Nonna-Reiter, nur offen)
leer quelleNonnaSekunde() {
    falls (zNonnaOffen.wert()) { zSekunde.wert(); }
}

// Modell → Zettel: am Ende jedes Rückrufs. Nur ungleiche Werte machen Bindungen schmutzig.
leer synchronisiere() {
    zVersion.setze(spiel.version);
    zBereiche.setze(spiel.versionBereiche);
    zGeheim.setze(spiel.versionGeheim);
    zErfolge.setze(spiel.versionErfolge);
    zSpiele.setze(spiel.versionSpiele);
    zGarten.setze(spiel.versionGarten);
    zWeinkeller.setze(spiel.versionWeinkeller);
    zPersonal.setze(spiel.versionPersonal);
    zLieferzonen.setze(spiel.versionLieferzonen);
    zMarketing.setze(spiel.versionMarketing);
    zHelfer.setze(spiel.versionHelfer);
    zLabor.setze(spiel.versionLabor);
    zStammgaeste.setze(spiel.versionStammgäste);
    zWettbewerb.setze(spiel.wettbewerb.version);   // P5
    zAlbum.setze(spiel.album.version);   // 📒 P5
    zSekunde.setze(spiel.sekunden);
    zNachricht.setze(spiel.nachricht);
    zTakt.setze(zTakt.wert() + 1);
}

// Rückfrage vor jedem Neustart: Der erste Klick fragt (zFrage = id des Knopfs), der zweite (binnen 10 Sekunden)
// bestätigt. Der Knopftext folgt zFrage über seine Bindung; frageRest läuft im Takt ab und setzt zFrage zurück.
salami frageRest = 0;

diavolo bestätigt(Knopf k) {
    falls (zFrage.wert() == k.id()) { zFrage.setze(""); serviere (ja); }
    zFrage.setze(k.id());      // eine andere offene Rückfrage fällt damit zurück auf ihren Normaltext
    frageRest = 10;
    serviere (nein);
}
// Für Bindungen: Text und Aktivität eines Knopfs mit möglicher Rückfrage (die Frage hält den Knopf aktiv)
margherita mitFrage(Knopf k, margherita frage, margherita normal) { serviere (zFrage.wert() == k.id() ? frage : normal); }
diavolo aktivMitFrage(Knopf k, diavolo normal) { serviere (zFrage.wert() == k.id() || normal); }

// Bausteine des Rasters
Schild kleinSchild(margherita id, salami zeilen, salami breite) {
    Schild s = neu Schild("", id: id);
    s.stil("schrift", "klein").stil("zeilen", zeilen);
    falls (breite > 0) { s.stil("breite", breite); }
    serviere (s);
}
Knopf zeilenKnopf(margherita id, salami breite) {
    Knopf k = neu Knopf("", id: id);
    k.stil("breite", breite).stil("zeilen", 2);
    serviere (k);
}
Reihe zeile(margherita id, Blech<Zutat> kinder, salami hoehe) {
    Reihe r = neu Reihe(kinder, id: id);
    r.stil("abstand", 8).stil("hoehe", hoehe);
    serviere (r);
}
Abschnitt panel(margherita titel, margherita id, Blech<Zutat> kinder) {
    Abschnitt a = neu Abschnitt(titel, kinder, id: id);
    a.stil("abstand", 6).stil("zeilen", 1);
    serviere (a);
}
Stapel spalte(margherita id, Blech<Zutat> kinder) {
    Stapel s = neu Stapel(kinder, id: id);
    s.stil("abstand", 8).stil("breite", SPALTE_BREITE);
    serviere (s);
}
// Eine Reiterseite: zwei Spalten fester Breite (2 × 404 + 12 = 820), oben bündig (v6: senkrecht oben).
Reihe seite(margherita id, Stapel links, Stapel rechts) {
    Reihe r = neu Reihe([links, rechts], id: id);
    r.stil("abstand", 12).stil("senkrecht", "oben");
    serviere (r);
}

margherita prozent(funghi teil, funghi ganz) {
    funghi p = ganz > 0 ? teil / ganz * 100 : 0;
    falls (p > 0 && p < 0.1) { serviere ("< 0,1 %"); }
    serviere (p.kompakt(1) + " %");
}

// ─────────────────────────────── Kopf ───────────────────────────────────
// Kasse (riesig), Kennzahlen (2 Zeilen – die zweite ist der Stand der laufenden Herausforderung), Backen und Sonderschicht
// nebeneinander, Meldung (3 Zeilen). Alles mit fester Breite: Texte wechseln, Kästen nie.
klasse KopfPanel {
    Schild kasse;
    Schild kennzahlen;
    Knopf backen;
    Knopf ofenKnopf;
    Schild meldung;
    Reihe knöpfe;

    KopfPanel() {
        kasse = neu Schild("", id: "kasse");
        kasse.stil("schrift", "riesig").stil("farbe", "basilikum").stil("ausrichtung", "mitte").stil("breite", VOLL).stil("zeilen", 1);
        kasse.binde("text", () -> { zTakt.wert(); serviere (spiel.geld.währung("€", kompakt: ja)); });
        kennzahlen = neu Schild("", id: "kennzahlen");
        kennzahlen.stil("schrift", "klein").stil("ausrichtung", "mitte").stil("zeilen", 2).stil("breite", VOLL);
        kennzahlen.binde("text", () -> kennzahlenText());
        kennzahlen.binde("hinweis", () -> { zVersion.wert(); serviere ("Heute im Ofen: " + spiel.rezeptName() + " – " + spiel.preis().währung("€") + " pro Pizza"); });
        backen = neu Knopf("", () -> { backe(); }, id: "backen");
        backen.stil("schrift", "gross").stil("farbe", "tomate").stil("hoehe", 64).stil("ausrichtung", "mitte").stil("zeilen", 1);
        backen.hinweis("Eine Pizza backen und sofort zum Rezeptpreis verkaufen (auch mit der Leertaste). Später bringt jeder Klick zusätzlich einen kleinen Anteil der Sekundenproduktion – das große Geld macht der Betrieb.");
        backen.binde("text", () -> { zVersion.wert(); serviere (spiel.darfKlicken() ? "🍕 Pizza backen!  +" + spiel.proKlick().kompakt(1) : "🙏 Fastenzeit – heute wird nicht geknetet"); });
        backen.binde("aktiv", () -> { zVersion.wert(); serviere (spiel.darfKlicken()); });
        ofenKnopf = neu Knopf("", () -> { spiel.sonderschicht(); nachVerarbeitung(); }, id: "sonderschicht");
        ofenKnopf.stil("farbe", "kruste").stil("hoehe", 64).stil("ausrichtung", "mitte").stil("zeilen", 1);
        ofenKnopf.hinweis("Der Ofen backt Ladung um Ladung, bis sein Zeitbudget leer ist. Heißer = mehr Ladungen.");
        ofenKnopf.binde("text", () -> ofenText());
        ofenKnopf.binde("aktiv", () -> { zTakt.wert(); serviere (spiel.ofenBereit()); });
        backen.stil("breite", SPALTE_BREITE);
        ofenKnopf.stil("breite", SPALTE_BREITE);
        knöpfe = neu Reihe([backen, ofenKnopf], id: "kopf-knoepfe");
        knöpfe.stil("abstand", 12);
        meldung = neu Schild("", id: "meldung");
        meldung.stil("farbe", "tomate").stil("ausrichtung", "mitte").stil("zeilen", 3).stil("breite", VOLL);
        meldung.binde("text", () -> zNachricht.wert());
    }

    // Kennzahlen: je Sekunde und bei neuer Version. Zeile 1 die Zahlen und Hinweise (früher im Reitertitel), Zeile 2 die laufende
    // Herausforderung (sonst leer – die Zeile ist Teil des Schilds, kein eigenes Element).
    margherita kennzahlenText() {
        zVersion.wert(); zSekunde.wert();
        margherita z = Spiel.pizzen(spiel.proKlick()) + " pro Klick · " + spiel.proSekunde().kompakt(1)
            + "/s · " + spiel.preis().währung("€") + "/Pizza";
        falls (spiel.sterne > 0) { z = z + " · ⭐ " + Spiel.anz(spiel.sterne) + " aktiv"; }
        falls (spiel.filialen > 0) { z = z + " · 🏢 " + Spiel.anz(spiel.filialen); }
        salami neu_ = spiel.neueSterne();
        falls (neu_ > 0) { z = z + " · ⭐ " + Spiel.anz(neu_) + (neu_ == 1 ? " wartet" : " warten"); }
        falls (spiel.neueFilialen() > 0) { z = z + " · 🏢 Kette bereit"; }
        falls (spiel.rezepteOffen()) {
            salami lernbar = spiel.offeneRezepte().filtere((x) -> (spiel.lernbar(x))).länge();
            falls (lernbar > 0) { z = z + " · 📜 " + lernbar + " lernbar"; }
        }
        falls (spiel.modus != "") {
            Herausforderung hf = spiel.herausforderung(spiel.modus);
            z = z + "\n" + hf.symbol + " " + hf.name + ": " + spiel.umsatz.währung("€", kompakt: ja) + " von " + hf.ziel.währung("€", kompakt: ja)
                + " Umsatz (" + prozent(spiel.umsatz, hf.ziel) + ")";
        }
        serviere (z);
    }

    margherita ofenText() {
        zTakt.wert();
        falls (spiel.ofenBereit()) { serviere ("🔥 Sonderschicht (" + spiel.ofenTemperatur() + " °C)"); }
        falls (spiel.modus == "fastenzeit") { serviere ("🔥 Fastenzeit – der Ofen bleibt kalt"); }
        serviere ("🔥 Ofen kühlt ab … noch " + (Mathe.decke(spiel.ofenKühlt / 10) * 10) + " s");   // Countdown in Zehnerschritten
    }
}

// ─────────────────────────────── Backstube ──────────────────────────────
// Ein Platz für ein Upgrade: Beschriftung, Balken bis zum Kauf, Kauf-Knopf. Welches Upgrade hier liegt, setzt belege() – nur
// aus Klick-Rückrufen; ein leerer Platz (karton) ist unsichtbar. Knopftext, Knopf an/aus und Balken teilen sich EINE Rechnung je
// Takt auf dem abgeleiteten Zettel `stand` (Zettel.aus, K-125): [Text, aktiv, Balken] – kein Memo von Hand.
klasse UpgradeSlot {
    Upgrade u = karton;
    Schild info;
    Fortschritt balken;
    Knopf knopf;
    Reihe reihe;
    Zettel stand;
    funghi faktor = 1;      // Preisfaktor (Inflation, Belohnung, Enzo) – in rechne() gesetzt
    salami grenze = 1000;   // höchstens so viele Stück (Mini-Küche, Anteil-Deckel)
    salami summeMenge = -1; // für diese Kaufmenge, Stückzahl und diesen Faktor ist `summe` ausgerechnet
    salami summeAnzahl = -1;
    funghi summeFaktor = -1;
    funghi summe = 0;

    UpgradeSlot(margherita id, salami schildBreite) {
        info = kleinSchild("info-" + id, 2, 0);
        info.binde("text", () -> { zPlaetze.wert(); zVersion.wert(); serviere (u == karton ? "" : u.zeile); });
        balken = neu Fortschritt(id: "balken-" + id);
        balken.stil("farbe", "basilikum");
        Stapel links = neu Stapel([info, balken]);
        links.stil("breite", schildBreite).stil("abstand", 2);
        falls (id == "klein-1") { info.hinweis("Die ältesten Gebäude backen weiter – hier kann man sie weiter ausbauen."); }
        knopf = neu Knopf("", () -> { kaufeAuf(dies); }, id: "kauf-" + id);
        knopf.stil("breite", KNOPF_BREITE).stil("zeilen", 2);
        stand = Zettel.aus(() -> rechne());
        knopf.binde("text", () -> stand.wert().stück(1));
        knopf.binde("aktiv", () -> stand.wert().stück(2));
        balken.binde("wert", () -> stand.wert().stück(3));
        reihe = neu Reihe([links, knopf], id: "zeile-" + id);
        reihe.stil("abstand", 8).stil("hoehe", ZEILE_HOEHE);
        reihe.binde("sichtbar", () -> { zPlaetze.wert(); serviere (u != karton); });
    }

    // karton = leerer Platz (unsichtbar). Nur aus Klick-Rückrufen.
    leer belege(Upgrade upgrade) {
        u = upgrade;
        summeMenge = -1; maxAnzahl = -1;
        falls (u != karton) { knopf.hinweis((u.beschreibung)); }
    }

    // Preis für k Stück (Summe der Einzelpreise mal Faktor) – zwischengespeichert je Kaufmenge, Stückzahl und Faktor
    funghi summeFür(salami k) {
        salami gerechnet = Mathe.max(k, 1);
        falls (summeMenge != gerechnet || summeAnzahl != u.anzahl || summeFaktor != faktor) {
            summe = u.kostenFür(gerechnet) * faktor;
            summeMenge = gerechnet;
            summeAnzahl = u.anzahl;
            summeFaktor = faktor;
        }
        serviere (summe);
    }

    // Max: Bei 10 Takten pro Sekunde wird nur neu gezählt, wenn die Kasse aus [unten, oben) herausläuft.
    salami maxK = 0;
    funghi maxUnten = 0;
    funghi maxOben = -1;
    salami maxAnzahl = -1;
    funghi maxFaktor = -1;
    salami maxBei(funghi geld) {
        falls (maxAnzahl == u.anzahl && maxFaktor == faktor && geld >= maxUnten && (maxOben < 0 || geld < maxOben)) { serviere (maxK); }
        salami k = 0;
        funghi summe_ = 0;
        funghi nächster = u.kostenBei(u.anzahl) * faktor;
        solange (k < 1000 && summe_ + nächster <= geld) {
            summe_ += nächster;
            k++;
            nächster = u.kostenBei(u.anzahl + k) * faktor;
        }
        maxK = k; maxUnten = summe_; maxOben = k < 1000 ? summe_ + nächster : -1;
        maxAnzahl = u.anzahl; maxFaktor = faktor;
        serviere (k);
    }

    // Die eine Rechnung des Platzes: [Knopftext, Knopf aktiv, Balken 0…1]. Leere, ausgebaute und verbotene Plätze hängen nur an
    // Belegung und Version; kaufbare zusätzlich an Kaufmenge und Takt (Kasse).
    Blech<Vorrat> rechne() {
        zPlaetze.wert(); zVersion.wert();
        falls (u == karton) { serviere (["", nein, 0]); }
        falls (!spiel.erlaubt(u)) {
            falls (u.ausgebaut()) { serviere (["✅ ausgebaut", nein, 1]); }
            serviere ([spiel.modus == "" ? "🔒" : "🚫 " + spiel.herausforderung(spiel.modus).name, nein, 0]);
        }
        faktor = spiel.preisFaktor();
        grenze = spiel.kaufGrenze(u);
        salami menge = zMenge.wert();
        zTakt.wert();
        funghi geld = spiel.geld;
        salami k = menge == 0 ? Mathe.min(maxBei(geld), grenze) : Mathe.min(menge, grenze);
        funghi s = summeFür(k);
        margherita text = s.währung("€", kompakt: ja);
        falls (menge == 0) { text = text + (k > 0 ? " (Max " + k + ")" : " (Max)"); } sonst falls (k > 1) { text = text + " (×" + k + ")"; }
        diavolo leistbar = k >= 1 && geld >= s;
        salami st = leistbar ? 20 : Mathe.boden(geld / s * 20);   // Balken in 20 Stufen – spart Nachrichten
        serviere ([text, leistbar, st / 20]);
    }
}

// Kaufmenge 1× · 10× · 100× · Max – eine Auswahl (Theke v4), immer da; die Wahl liegt auf dem Zettel zMenge.
Blech<salami> MENGEN = [1, 10, 100, 0];

leer kaufeAuf(UpgradeSlot z) {
    falls (z.u == karton) { serviere; }
    Upgrade u = z.u;
    salami menge = zMenge.wert();
    salami k = menge == 0 ? u.maxFür(spiel.geld / spiel.preisFaktor()) : menge;
    falls (spiel.kaufe(u, Mathe.min(k, spiel.kaufGrenze(u)))) { nachKauf(); }
}

// 🏭 Betrieb: wächst je Kauf – 6 Plätze für die jüngsten erreichten Gebäude, nur belegte sind sichtbar. Ab dem siebten
// Gebäude erscheint OBEN im Panel der klappbare Abschnitt „Kleinbetriebe“ (8 Plätze) mit den ältesten – durch den Kauf, der
// das siebte aufdeckt (Klick). Erreicht ist ein Gebäude, wenn es das erste ist, man eins hat oder das vorige gekauft ist; die
// Franchise-Zentrale braucht außerdem eine Kette.
klasse BetriebPanel {
    Blech<UpgradeSlot> slots = [];
    Blech<UpgradeSlot> klein = [];
    Abschnitt kleinTeil;
    Abschnitt teil;
    salami PLÄTZE = 6;
    salami erreicht = 0;     // Stand der letzten Belegung (für den Kleinbetriebe-Titel)
    salami start = 0;        // so viele liegen in den Kleinbetrieben

    BetriebPanel() {
        Blech<Zutat> kl = [];
        salami n = spiel.betrieb.länge() - PLÄTZE;
        für (salami i : [1 .. n]) {
            UpgradeSlot z = neu UpgradeSlot("klein-" + i, KLEIN_SCHILD);
            klein.hinzu(z);
            kl.hinzu(z.reihe);
        }
        Stapel kleinStapel = neu Stapel(kl, id: "klein-stapel");
        kleinStapel.stil("abstand", 6);
        kleinTeil = neu Abschnitt("", [kleinStapel], id: "kleinbetriebe");
        kleinTeil.klappbar(ja).zu(ja).stil("abstand", 6).stil("zeilen", 1);
        kleinTeil.hinweis("Die ältesten Gebäude – sie backen natürlich weiter. Ein Klick auf die Überschrift klappt sie auf oder zu.");
        kleinTeil.binde("titel", () -> kleinTitel());
        kleinTeil.binde("sichtbar", () -> { zPlaetze.wert(); serviere (start > 0); });
        Blech<Zutat> kinder = [kleinTeil];
        für (salami i : [1 .. PLÄTZE]) {
            UpgradeSlot z = neu UpgradeSlot("betrieb-" + i, SCHILD_BREITE);
            slots.hinzu(z);
            kinder.hinzu(z.reihe);
        }
        teil = panel("🏭 Betrieb – Pizzen pro Sekunde", "betrieb", kinder);
        teil.hinweis("Das nächste Gebäude erscheint, sobald das vorige gekauft ist (14 insgesamt). Ab dem siebten wandern die ältesten in die Kleinbetriebe oben.");
    }

    // Titel kurz halten: er darf nie umbrechen (zeilen 1)
    margherita kleinTitel() {
        zPlaetze.wert(); zVersion.wert();
        falls (start == 0) { serviere ("🧺 Kleinbetriebe"); }
        Blech<Upgrade> b = spiel.betrieb;
        funghi alle = 0;
        funghi kl = 0;
        für (salami i : [1 .. erreicht]) { alle += b.stück(i).gesamt(); }
        für (salami i : [1 .. start]) { kl += b.stück(i).gesamt(); }
        serviere ("🧺 Kleinbetriebe (" + start + ") · " + prozent(kl, alle) + " der Pizzen");
    }

    // Belegung – nur aus Klick-Rückrufen (R1): Fenster der 6 jüngsten erreichten Gebäude, der Rest nach vorn in die Kleinbetriebe.
    leer belegeNeu() {
        Blech<Upgrade> b = spiel.betrieb;
        erreicht = 0;
        Upgrade vorher = karton;
        für (Upgrade u : b) {
            diavolo offen = (vorher == karton || u.anzahl > 0 || vorher.anzahl > 0) && (u.schlüssel != "zentrale" || spiel.filialen > 0);
            falls (!offen) { abbrechen; }
            erreicht++;
            vorher = u;
        }
        start = Mathe.max(0, erreicht - PLÄTZE);
        für (salami i : [1 .. PLÄTZE]) {
            salami n = start + i;
            slots.stück(i).belege(n <= erreicht ? b.stück(n) : karton);
        }
        für (salami i : [1 .. klein.länge()]) {
            klein.stück(i).belege(i <= start ? b.stück(i) : karton);
        }
    }
}

// 🛠 Handwerk: ein Platz je Werkzeug (IDs kauf-<schlüssel>), sichtbar erst, wenn das vorige gekauft ist – wächst je Kauf.
klasse HandwerkPanel {
    Blech<UpgradeSlot> slots = [];
    Abschnitt teil;

    HandwerkPanel() {
        Blech<Zutat> kinder = [];
        für (Upgrade u : spiel.handwerk) {
            UpgradeSlot z = neu UpgradeSlot(u.schlüssel, SCHILD_BREITE);
            slots.hinzu(z);
            kinder.hinzu(z.reihe);
        }
        teil = panel("🛠 Handwerk – mehr Pizzen pro Klick", "handwerk", kinder);
        teil.hinweis("Das nächste Werkzeug erscheint, sobald das vorige gekauft ist (6 insgesamt).");
    }

    leer belegeNeu() {
        Upgrade vorher = karton;
        für (salami i : [1 .. slots.länge()]) {
            Upgrade u = spiel.handwerk.stück(i);
            diavolo offen = vorher == karton || u.anzahl > 0 || vorher.anzahl > 0;
            slots.stück(i).belege(offen ? u : karton);
            vorher = u;
        }
    }
}

// 📖 Rezeptbuch (eine Zeile, immer da, oben links) und 🧀 Feinkost-Händler (EINE Zeile mit zwei halben Knöpfen direkt darunter,
// über dem wachsenden Betrieb). Der Händler erscheint, sobald das Buch ausgelesen ist – aber nur in einem Klick-Rückruf
// (belegeNeu aus nachKauf/nachAufstieg): Liest Carlo die letzte Seite im Takt, steht das Angebot erst nach dem nächsten Kauf da
// (R1, §12.9/8). Danach bleibt die Zeile bis zur nächsten Neueröffnung; sie wächst nie: zwei Angebote in der Reihenfolge der
// Liste („Preis · Name +n %“ im Knopf – der Preis vorn, damit ihn ein langer Name nicht abschneidet; die ganze Beschreibung
// im Hinweis), das Lager steht im Titel. Hawaii-Verbot: Händler zu.
klasse RezeptPanel {
    Schild rezeptInfo;
    Knopf rezeptKnopf;
    Abschnitt teil;
    Blech<Knopf> knöpfe = [];
    Abschnitt feinkostTeil;

    RezeptPanel() {
        rezeptInfo = kleinSchild("rezept-info", 2, SCHILD_BREITE);
        rezeptInfo.binde("text", () -> {
            zVersion.wert();
            falls (spiel.rezeptGesperrt()) { serviere ("📖 Hawaii-Verbot: Nonna hat das Rezeptbuch weggeschlossen – nur Margherita."); }
            falls (spiel.rezeptFertig()) { serviere ("📖 Das Rezeptbuch ist ausgelesen – grazie, Nonna! Jetzt geht es um die Zutaten."); }
            serviere ("📖 Seite " + (spiel.seite + 1) + " von " + spiel.SEITEN.länge() + ": " + spiel.SEITEN.stück(spiel.seite + 1) + " kommt auf die Pizza – heute " + spiel.preis().währung("€") + " je Pizza.");
        });
        rezeptKnopf = zeilenKnopf("rezept", KNOPF_BREITE);
        rezeptKnopf.beiKlick(() -> { falls (spiel.blättere()) { nachKauf(); } });
        rezeptKnopf.hinweis("Jede Seite legt einen Belag auf – die Pizza wird teurer, und jede verkaufte bringt mehr.");
        rezeptKnopf.binde("text", () -> {
            zVersion.wert();
            falls (spiel.rezeptGesperrt()) { serviere ("📖 🔒"); }
            falls (spiel.rezeptFertig()) { serviere ("📖 ✅"); }
            serviere ("📖 Seite " + (spiel.seite + 1) + " · " + spiel.seitenKosten().währung("€", kompakt: ja));
        });
        rezeptKnopf.binde("aktiv", () -> {
            zVersion.wert();
            falls (spiel.rezeptGesperrt() || spiel.rezeptFertig()) { serviere (nein); }
            zTakt.wert();
            serviere (spiel.geld >= spiel.seitenKosten());
        });
        teil = panel("📖 Nonnas Rezeptbuch", "rezeptbuch", [zeile("rezept-zeile", [rezeptInfo, rezeptKnopf], ZEILE_HOEHE)]);
        teil.hinweis("Acht Seiten, jede legt einen Belag auf die Margherita. Was heute im Ofen liegt, steht im Hinweis der Kennzahlen.");

        Blech<Zutat> paar = [];
        für (salami i : [1 .. 2]) {
            Knopf k = zeilenKnopf("feinkost-kauf-" + i, HALB_KNOPF);
            k.beiKlick(() -> { falls (spiel.kaufeFeinkost(angebot(i))) { speichere(); nachKauf(); } });
            k.binde("text", () -> {
                zPlaetze.wert(); zVersion.wert();
                Feinkost f = angebot(i);
                falls (f == karton) {
                    salami n = spiel.feinkost.länge();
                    serviere (n >= spiel.HÄNDLER_WAREN.länge() ? "✅ alles im Lager" : "✅ " + n + "/" + spiel.HÄNDLER_WAREN.länge() + " im Lager");
                }
                serviere (spiel.feinkostPreis(f).währung("€", kompakt: ja) + " · " + f.symbol + " " + kurzName(f) + " +" + f.plus + " %");
            });
            k.binde("aktiv", () -> {
                zPlaetze.wert(); zVersion.wert();
                Feinkost f = angebot(i);
                falls (f == karton) { serviere (nein); }
                zTakt.wert();
                serviere (spiel.geld >= spiel.feinkostPreis(f));
            });
            knöpfe.hinzu(k);
            paar.hinzu(k);
        }
        feinkostTeil = panel("🧀 Feinkost-Händler", "feinkost", [zeile("feinkost-zeile", paar, ZEILE_HOEHE)]);
        feinkostTeil.hinweis("Einmal-Käufe gegen Euro: Jede Zutat macht jede Pizza teurer – bis zur nächsten Neueröffnung. Die Angebote kommen der Reihe nach, zwei auf einmal.");
        // Lager im Titel (eine Zeile) statt einer eigenen Zeile – die Zeile darunter (Betrieb) bleibt stehen
        feinkostTeil.binde("titel", () -> {
            zVersion.wert();
            Blech<Feinkost> lager = spiel.HÄNDLER_WAREN.filtere((x) -> (spiel.feinkost.enthält(x.schlüssel)));
            falls (lager.istLeer()) { serviere ("🧀 Feinkost-Händler"); }
            serviere ("🧀 Feinkost-Händler · im Lager: " + lager.belege((x) -> (x.symbol)).verbinde(" "));
        });
        feinkostTeil.binde("sichtbar", () -> { zPlaetze.wert(); serviere (offen); });
    }

    // Stand des Händlers beim letzten Klick-Rückruf – nur belegeNeu() setzt ihn (R1)
    diavolo offen = nein;

    // Nur aus Klick-Rückrufen: Händler auf/zu (nach dem Stand des Modells) und die Hinweise der beiden Angebote
    leer belegeNeu() {
        offen = spiel.feinkostOffen();
        für (salami i : [1 .. 2]) {
            Feinkost f = angebot(i);
            knöpfe.stück(i).hinweis(f == karton ? (offen ? "Mehr hat der Händler nicht – der Rest liegt schon im Lager." : "Der Händler öffnet, sobald das Rezeptbuch ausgelesen ist.") :
                f.symbol + " " + f.name + " – jede Pizza +" + f.plus + " %. " + f.text + " Einmal kaufen – wirkt bis zur nächsten Neueröffnung.");
        }
    }

    // Kurzname für den halben Knopf (der ganze Name steht im Hinweis)
    margherita kurzName(Feinkost f) {
        falls (f.schlüssel == "sanmarzano") { serviere ("San Marzano"); }
        falls (f.schlüssel == "tipo00") { serviere ("Tipo 00"); }
        falls (f.schlüssel == "büffel") { serviere ("Büffelmozzarella"); }
        falls (f.schlüssel == "olivenöl") { serviere ("Olivenöl"); }
        falls (f.schlüssel == "genua") { serviere ("Genua-Basilikum"); }
        falls (f.schlüssel == "trapani") { serviere ("Trapani-Salz"); }
        falls (f.schlüssel == "trüffel") { serviere ("Alba-Trüffel"); }
        serviere (f.name);
    }

    // Angebot i (1, 2) der Welle – karton, wenn der Händler (beim letzten Klick) zu war oder weniger Angebote übrig sind.
    // Welle und Lager ändern sich nur durch Klicks (Kauf, Neueröffnung).
    Feinkost angebot(salami i) {
        falls (!offen || !spiel.feinkostOffen()) { serviere (karton); }
        Blech<Feinkost> welle = spiel.feinkostAngebot();
        serviere (i <= welle.länge() ? welle.stück(i) : karton);
    }
}

// 🎓 Meisterbriefe: EINE Zeile mit zwei halben Knöpfen (die beiden billigsten offenen Briefe, „Preis · Name“ im Knopf, Gebäude
// und Wirkung im Hinweis) – rechts direkt unter der Kaufmenge, über dem wachsenden Handwerk. Die Zeile erscheint mit dem ersten
// offenen Brief (Gebäude-Kauf = Klick) und bleibt bis zur nächsten Neueröffnung, auch wenn gerade keiner offen ist; ein Brief
// behält seinen Platz, ein neuer rückt auf den freien – nur Texte wechseln, nichts wächst oder schrumpft (§12.9/8).
klasse BriefPanel {
    Blech<Meisterbrief> platz = [karton, karton];
    Blech<Knopf> knöpfe = [];
    Abschnitt teil;
    diavolo da = nein;      // in dieser Runde schon erschienen (nur belegeNeu setzt es – aus Klick-Rückrufen)

    BriefPanel() {
        Blech<Zutat> paar = [];
        für (salami i : [1 .. 2]) {
            Knopf k = zeilenKnopf("brief-kauf-" + i, HALB_KNOPF);
            k.beiKlick(() -> { falls (spiel.kaufeBrief(platz.stück(i))) { nachKauf(); } });
            // Preis mit Meisterrabatt – der kann im Takt fertig werden, deshalb hängt der Knopf auch an zVersion
            k.binde("text", () -> {
                zPlaetze.wert(); zVersion.wert();
                Meisterbrief b = platz.stück(i);
                serviere (b == karton ? "🎓 kein Brief offen" : spiel.briefPreis(b).währung("€", kompakt: ja) + " · " + b.symbol + " " + b.name);
            });
            k.binde("aktiv", () -> {
                zPlaetze.wert(); zVersion.wert();
                Meisterbrief b = platz.stück(i);
                falls (b == karton) { serviere (nein); }
                zTakt.wert();
                serviere (spiel.geld >= spiel.briefPreis(b));
            });
            knöpfe.hinzu(k);
            paar.hinzu(k);
        }
        teil = panel("", "meisterbriefe", [zeile("brief-zeile", paar, ZEILE_HOEHE)]);
        teil.hinweis("Hat ein Gebäude 10, 25, 50 oder 100 Stück, gibt es dafür einen Meisterbrief (×1,25). Sie verfallen bei der nächsten Neueröffnung.");
        // Stand im Titel (eine Zeile) statt einer Kopfzeile
        teil.binde("titel", () -> { zVersion.wert(); salami n = spiel.briefe.länge(); serviere (n > 0 ? "🎓 Meisterbriefe · " + n + " an der Wand" : "🎓 Meisterbriefe"); });
        teil.binde("sichtbar", () -> { zPlaetze.wert(); serviere (da); });
    }

    // Nur aus Klick-Rückrufen (R1). Sichtbar, sobald in dieser Runde ein Brief offen war (offen oder schon an der Wand) –
    // eine Neueröffnung leert beides, dann verschwindet die Zeile mit dem Klick.
    leer belegeNeu() {
        Blech<Meisterbrief> welle = spiel.offeneBriefe();
        für (salami i : [1 .. 2]) {
            Meisterbrief b = platz.stück(i);
            falls (b != karton && !welle.enthält(b)) { platz.setze(i, karton); }
        }
        für (Meisterbrief b : welle) {
            falls (!platz.enthält(b)) {
                salami frei = 0;
                für (salami i : [1 .. 2]) { falls (frei == 0 && platz.stück(i) == karton) { frei = i; } }
                falls (frei > 0) { platz.setze(frei, b); }
            }
        }
        da = !welle.istLeer() || !spiel.briefe.istLeer();
        für (salami i : [1 .. 2]) {
            Meisterbrief b = platz.stück(i);
            knöpfe.stück(i).hinweis(b == karton ? "Gerade ist kein Meisterbrief offen – der nächste kommt mit 10, 25, 50 oder 100 Stück eines Gebäudes." :
                b.symbol + " " + b.name + ": " + spiel.finde(b.gebäude).name + " backt ×1,25 (ab " + b.stufe + " Stück). Einmal kaufen, wirkt bis zur nächsten Neueröffnung.");
        }
    }
}

// ── P5 Katze ── (Oberfläche; Bereich #9, Hof)
// Zwei Zeilen unter dem Kopf des Bereich-Panels: 1 „Mozzarella: Laune n/5 – Text“ + „🐟 Füttern · Preis“ / „😴 satt, n s“ ·
// 2 Katzenweisheit + „🫳 Streicheln“ / „wieder in n s“. Den Kopf (bereich-katze-kopf) liefert kopfText – das BereichPanel
// delegiert. Die Zeilen gehören von Anfang an zum Panel und sind sichtbar, sobald die Katze frei ist (Freischalt-Klick, R1/R3).
// Quelle aller Texte: `stand` – ein abgeleiteter Zettel (K-125) aus dem Taktgeber und spiel.katze.version: rechnet je Rückruf
// einmal, meldet aber nur echte Änderungen (K-117). Countdowns lesen zTakt nur, solange eine Pause läuft (Zehnersekunden).
klasse KatzePanel {
    Zettel stand;
    Schild launeInfo;
    Knopf füttern;
    Schild weisheitInfo;
    Knopf streicheln;
    Blech<Zutat> zeilen = [];

    KatzePanel() {
        stand = Zettel.aus(() -> { zTakt.wert(); serviere (spiel.katze.version); });
        launeInfo = kleinSchild("bereich-katze-info-1", 2, SCHILD_BREITE);
        launeInfo.binde("text", () -> launeZeile());
        füttern = zeilenKnopf("bereich-katze-knopf-1", KNOPF_BREITE);
        füttern.binde("text", () -> futterText());
        füttern.binde("aktiv", () -> futterAktiv());
        füttern.beiKlick(() -> { falls (spiel.katze.füttere(spiel)) { speichere(); nachKauf(); } });
        füttern.hinweis("Laune +2 (höchstens 5), danach 3 Minuten satt. Kostet 10 Sekunden Pizza-Umsatz.");
        weisheitInfo = kleinSchild("bereich-katze-info-2", 2, SCHILD_BREITE);
        weisheitInfo.binde("text", () -> { falls (!frei()) { serviere (""); } stand.wert(); serviere ("💭 " + spiel.katze.weisheit()); });
        streicheln = zeilenKnopf("bereich-katze-knopf-2", KNOPF_BREITE);
        streicheln.binde("text", () -> streichelText());
        streicheln.binde("aktiv", () -> { falls (!frei()) { serviere (nein); } stand.wert(); serviere (spiel.katze.streichelPause <= 0); });
        streicheln.beiKlick(() -> { falls (spiel.katze.streichle(spiel)) { speichere(); nachKauf(); } });
        streicheln.hinweis("Laune +1 (höchstens 5), danach 1 Minute Pause. Kostet nichts – Mozzarella entscheidet selbst, ob es ihr gefällt.");
        zeilen = [zeile("bereich-katze-1", [launeInfo, füttern], ZEILE_HOEHE), zeile("bereich-katze-2", [weisheitInfo, streicheln], ZEILE_HOEHE)];
        für (Zutat z : zeilen) { z.binde("sichtbar", () -> frei()); }
    }

    // Quelle der Freischaltung (nach „Neu anfangen“ wieder zu – die Zeilen verschwinden mit dem Klick)
    diavolo frei() { zBereiche.wert(); serviere (spiel.istFrei("katze")); }

    margherita kopfText() {
        falls (!frei()) { serviere (""); }
        stand.wert();
        Katze k = spiel.katze;
        serviere ("🐱 Mozzarella: +" + spiel.katzePunkte() + " % auf alles (+" + spiel.KATZE_PUNKTE_JE_LAUNE + " je Laune, zählt wie Sterne) · "
            + k.gefüttert + "× gefüttert, " + k.gestreichelt + "× gestreichelt. Alle 10 min sinkt die Laune um 1.");
    }

    margherita launeZeile() {
        falls (!frei()) { serviere (""); }
        stand.wert();
        Katze k = spiel.katze;
        margherita t = "Mozzarella: Laune " + k.laune + "/" + k.HÖCHSTENS + " – " + k.launeText();
        falls (k.laune <= 0) { serviere (t); }
        zTakt.wert();   // „hält noch n min“ in ganzen Minuten (K-117: gleicher Text sendet nichts)
        serviere (t + " (hält noch " + Mathe.decke(k.bisMürrisch / 60) + " min)");
    }

    margherita futterText() {
        falls (!frei()) { serviere (""); }
        stand.wert();
        Katze k = spiel.katze;
        falls (k.futterPause > 0) {
            zTakt.wert();   // Countdown in Zehnersekunden
            serviere ("😴 satt, " + (Mathe.decke(k.futterPause / 10) * 10) + " s");
        }
        zVersion.wert();    // der Preis folgt der Produktion
        serviere ("🐟 Füttern · " + k.futterPreis(spiel).währung("€", kompakt: ja));
    }

    diavolo futterAktiv() {
        falls (!frei()) { serviere (nein); }
        stand.wert();
        Katze k = spiel.katze;
        falls (k.futterPause > 0) { serviere (nein); }
        zTakt.wert();
        serviere (spiel.geld >= k.futterPreis(spiel));
    }

    margherita streichelText() {
        falls (!frei()) { serviere (""); }
        stand.wert();
        Katze k = spiel.katze;
        falls (k.streichelPause > 0) {
            zTakt.wert();
            serviere ("🫳 wieder in " + (Mathe.decke(k.streichelPause / 10) * 10) + " s");
        }
        serviere ("🫳 Streicheln");
    }
}
// ── Ende P5 Katze (Oberfläche) ──

// ── P5 Wettbewerb ── (Oberfläche; Bereich #10, Stadt)
// Inhalt des Bereichs-Panels „🏆 Pizza-Wettbewerb“ (bereich-wettbewerb): Das BereichPanel liefert Teaser-Zeile und Kopf und
// delegiert den Rest hierher – Kopftext (Qualität und Chancen) und vier Zeilen:
//   bereich-wettbewerb-1 (Reihe): …-info-1 „Nächster: Name in n s“ / „Name – offen, noch n s“ + …-knopf-1 „Teilnehmen · Startgeld“ / „✅ dabei“
//   …-info-2 letztes Ergebnis · …-info-3 „Pokale: 🥇a 🥈b 🥉c“ · …-info-4 „Bonus +p %“
// Die Zeilen gehören von Anfang an zum Panel (das BereichPanel hängt `zeilen` an) und sind sichtbar, sobald der Wettbewerb frei
// ist – das ändert nur der Freischalt-Klick (R1/R3). Danach ändern sich nur Texte und aktiv (R1): Countdown in Zehnersekunden
// an zTakt (K-117 entprellt), alles andere an zWettbewerb (spiegelt Wettbewerb.version), zVersion (Startgeld, Qualität) und zBereiche.
Zettel zWettbewerb = neu Zettel(-1);

klasse WettbewerbPanel {
    Schild status;
    Knopf knopf;
    Schild ergebnis;
    Schild pokale;
    Schild bonus;
    Blech<Zutat> zeilen = [];

    WettbewerbPanel() {
        status = kleinSchild("bereich-wettbewerb-info-1", 2, SCHILD_BREITE);
        status.binde("text", () -> statusText());
        knopf = zeilenKnopf("bereich-wettbewerb-knopf-1", KNOPF_BREITE);
        knopf.binde("text", () -> knopfText());
        knopf.binde("aktiv", () -> knopfAktiv());
        knopf.beiKlick(() -> { falls (spiel.nimmAmWettbewerbTeil()) { speichere(); nachVerarbeitung(); } });
        knopf.hinweis("Startgeld = 30 s Umsatz. Das Ergebnis kommt sofort – höchstens eine Teilnahme je Wettbewerb. Pokale bleiben für immer.");
        Reihe r = zeile("bereich-wettbewerb-1", [status, knopf], ZEILE_HOEHE);
        ergebnis = kleinSchild("bereich-wettbewerb-info-2", 2, INNEN);
        ergebnis.binde("text", () -> ergebnisText());
        pokale = kleinSchild("bereich-wettbewerb-info-3", 1, INNEN);
        pokale.binde("text", () -> pokaleText());
        bonus = kleinSchild("bereich-wettbewerb-info-4", 1, INNEN);
        bonus.binde("text", () -> bonusText());
        zeilen = [r, ergebnis, pokale, bonus];
        für (Zutat z : zeilen) { z.binde("sichtbar", () -> frei()); }
    }

    // Quelle der Freischaltung (nach „Neu anfangen“ wieder zu – die Zeilen verschwinden mit dem Klick)
    diavolo frei() { zBereiche.wert(); serviere (spiel.istFrei("wettbewerb")); }

    margherita kopfText() {
        falls (!frei()) { serviere (""); }
        zVersion.wert();
        Wettbewerb w = spiel.wettbewerb;
        salami g = w.goldProzent(spiel);
        serviere ("🏆 Alle 10 min ein Wettbewerb, 2 min offen. Qualität " + w.qualität(spiel) + " (Rezeptseiten + Feinkost + Sterne bis 10): 🥇 "
            + g + " % · 🥈 " + w.SILBER_PROZENT + " % · 🥉 " + (100 - g - w.SILBER_PROZENT) + " %");
    }

    margherita statusText() {
        falls (!frei()) { serviere (""); }
        zWettbewerb.wert();
        zTakt.wert();   // Countdown in Zehnersekunden (K-117: gleicher Text sendet nichts)
        Wettbewerb w = spiel.wettbewerb;
        falls (w.gesperrt(spiel)) { serviere ("🙏 Fastenzeit – keine Wettbewerbe. " + (w.offen() ? "Die " + w.name() + " läuft ohne dich." : "Nächster: " + w.name() + " in " + (Mathe.decke(w.bis / 10) * 10) + " s")); }
        falls (w.offen()) {
            serviere ("🏆 " + w.name() + (w.dabei ? " – angemeldet, schließt in " : " – offen, noch ") + (Mathe.decke(w.offenRest / 10) * 10) + " s");
        }
        serviere ("⏳ Nächster: " + w.name() + " in " + (Mathe.decke(w.bis / 10) * 10) + " s");
    }

    margherita knopfText() {
        falls (!frei()) { serviere (""); }
        zWettbewerb.wert();
        falls (spiel.wettbewerb.dabei) { serviere ("✅ dabei"); }
        zVersion.wert();
        serviere ("Teilnehmen · " + spiel.wettbewerb.startgeld(spiel).währung("€", kompakt: ja));
    }

    diavolo knopfAktiv() {
        falls (!frei()) { serviere (nein); }
        zWettbewerb.wert();
        Wettbewerb w = spiel.wettbewerb;
        falls (!w.offen() || w.dabei) { serviere (nein); }
        zTakt.wert();
        serviere (w.kannTeilnehmen(spiel));
    }

    margherita ergebnisText() {
        falls (!frei()) { serviere (""); }
        zWettbewerb.wert();
        Wettbewerb w = spiel.wettbewerb;
        falls (w.letztes == "") {
            serviere ("Noch keine Teilnahme – die Jury poliert schon die Gabeln. Das Ergebnis kommt sofort beim Teilnehmen.");
        }
        serviere (w.letztes);
    }

    margherita pokaleText() {
        falls (!frei()) { serviere (""); }
        zWettbewerb.wert();
        Wettbewerb w = spiel.wettbewerb;
        serviere ("Pokale: " + w.pokaleText() + " · " + w.teilnahmen + (w.teilnahmen == 1 ? " Teilnahme" : " Teilnahmen"));
    }

    margherita bonusText() {
        falls (!frei()) { serviere (""); }
        zWettbewerb.wert();
        Wettbewerb w = spiel.wettbewerb;
        serviere ("Bonus +" + w.bonusPunkte() + " % auf alles (Pokalpunkte 🥇3 🥈2 🥉1, höchstens +" + w.POKAL_HÖCHSTENS + ", zählt wie Sterne)");
    }

    // Zeilentext des Wettbewerbs-Scouts im Helfer-Panel (angestellt): vor der Freischaltung wie bisher, danach seine Bilanz.
    // Quellen kommen aus dem Helfer-Panel (zBereiche, zHelfer – jeder Scout-Einsatz zählt versionHelfer hoch).
    margherita scoutText(Helfer h) {
        falls (!spiel.istFrei("wettbewerb")) { serviere (h.symbol + " " + h.name + " – wartet auf den ersten Wettbewerb. " + h.text); }
        salami n = spiel.wettbewerb.scoutTeilnahmen;
        serviere (h.symbol + " " + h.name + " – meldet dich an, sobald ein Wettbewerb offen ist und das Startgeld reicht. "
            + (n == 0 ? "Noch nicht im Einsatz." : n + "-mal angemeldet."));
    }
}
WettbewerbPanel wettbewerbPanel = neu WettbewerbPanel();
// ── Ende P5 Wettbewerb (Oberfläche) ──

// ── P5 Album ── Oberfläche des Sammelalbums: drei Zeilen zu vier Sticker-Feldern fester Breite (4 · 86 + 3 · 8 = 368 ≤ 370)
// und fester Zeilenhöhe – ein Fund im Takt (Ereignis, Pino, Nonna) wechselt nur den Text „❔“ → Symbol (R1). Die Zeilen
// gehören von Anfang an zum Bereich-Panel (das BereichPanel hängt `zeilen` an) und sind sichtbar, sobald das Album frei ist –
// das ändert nur der Freischalt-Klick (R1/R3). Die
// Zusammenfassung „n/12 – volle Reihen“ steht wie bei allen Bereichen im Kopf des Panels (albumKopfText, BereichPanel
// delegiert). Alle Texte hängen an zAlbum (= spiel.album.version, in synchronisiere gesetzt) – sie rechnen nur nach einem Fund.
Zettel zAlbum = neu Zettel(-1);
salami STICKER_BREITE = 86;

margherita albumKopfText() {
    zBereiche.wert();
    falls (!spiel.istFrei("album")) { serviere (""); }
    zAlbum.wert();
    Album a = spiel.album;
    falls (a.voll()) { serviere ("📒 Sammelalbum: alle " + a.STICKER.länge() + " Sticker! Volle Reihen: " + a.volleReihen() + " – +" + spiel.albumPunkte() + " % auf alles (zählt wie Sterne, für immer)."); }
    serviere ("📒 Sammelalbum: " + a.anzahl() + "/" + a.STICKER.länge() + " Sticker – volle Reihen: " + a.volleReihen() + " (+" + spiel.ALBUM_PUNKTE_JE_REIHE
        + " % auf alles je Reihe, zählt wie Sterne). Sticker bleiben für immer.");
}

klasse AlbumPanel {
    Blech<Zutat> zeilen = [];
    Blech<Schild> felder = [];

    AlbumPanel() {
        Album a = spiel.album;
        salami jeReihe = a.STICKER.länge() / a.REIHEN;
        für (salami r : [1 .. a.REIHEN]) {
            Blech<Zutat> reihe = [];
            für (salami j : [1 .. jeReihe]) {
                salami n = (r - 1) * jeReihe + j;
                Schild f = kleinSchild("bereich-album-sticker-" + n, 2, STICKER_BREITE);
                f.stil("ausrichtung", "mitte");
                f.binde("text", () -> feldText(n));
                f.binde("hinweis", () -> feldHinweis(n));
                felder.hinzu(f); reihe.hinzu(f);
            }
            Reihe z = zeile("bereich-album-" + r, reihe, ZEILE_HOEHE);
            z.binde("sichtbar", () -> { zBereiche.wert(); serviere (spiel.istFrei("album")); });
            zeilen.hinzu(z);
        }
    }

    margherita feldText(salami n) {
        zAlbum.wert();
        Sticker st = spiel.album.STICKER.stück(n);
        serviere (spiel.album.hat(st.schlüssel) ? st.symbol + " " + st.name : "❔");
    }

    margherita feldHinweis(salami n) {
        zAlbum.wert();
        Sticker st = spiel.album.STICKER.stück(n);
        falls (!spiel.album.hat(st.schlüssel)) {
            serviere ("❔ Noch nicht gefunden. Jedes Ereignis, jede Sonderschicht, jeder Minispiel-Sieg und Wettbewerb hat "
                + (spiel.ALBUM_FUNDCHANCE * 100).kompakt(1) + " % Chance auf einen fehlenden Sticker. Volle Reihe: +" + spiel.ALBUM_PUNKTE_JE_REIHE + " % auf alles.");
        }
        serviere (st.symbol + " " + st.name + " – " + st.text + " Gefunden " + spiel.albumQuelleText(spiel.album.quelle(st.schlüssel)) + ".");
    }
}
// ── Ende P5 Album (Oberfläche) ──

// ── P5 Banca ── (Oberfläche; Bereich #12, Labor)
// Zwei Zeilen unter dem Kopf: 1 „Guthaben … · Zinsen 1 %/min“ + „10 % einzahlen“ · 2 Spruch + „Alles abheben“. Der Kopf
// (bereich-banca-kopf, BereichPanel delegiert) zeigt den Deckel („verzinst bis … (30 min Umsatz)“) und die Zinsen bisher.
// Die Zeilen gehören von Anfang an zum Panel und sind sichtbar, sobald die Banca frei ist (Freischalt-Klick, R1/R3).
// Quelle: `stand` wie bei der Katze (spiel.sparbuch.version, ändert sich mit den Zinsen jede Sekunde); „einzahlen“ hängt an
// der Kasse (zTakt). Zinsen ändern nur Text (R1).
klasse BancaPanel {
    Zettel stand;
    Schild guthabenInfo;
    Knopf einzahlen;
    Schild spruchInfo;
    Knopf abheben;
    Blech<Zutat> zeilen = [];

    BancaPanel() {
        stand = Zettel.aus(() -> { zTakt.wert(); serviere (spiel.sparbuch.version); });
        guthabenInfo = kleinSchild("bereich-banca-info-1", 2, SCHILD_BREITE);
        guthabenInfo.binde("text", () -> {
            falls (!frei()) { serviere (""); }
            stand.wert(); zVersion.wert();
            Sparbuch b = spiel.sparbuch;
            serviere ("💰 Guthaben " + b.guthaben.währung("€", kompakt: ja) + " · Zinsen " + b.ZINS_PROZENT.kompakt(0) + " %/min"
                + (b.guthaben > 0 ? " (+" + b.zinsJeSekunde(spiel).währung("€", kompakt: ja) + "/s)" : ""));
        });
        einzahlen = zeilenKnopf("bereich-banca-knopf-1", KNOPF_BREITE);
        einzahlen.setzeText("💶 10 % einzahlen");
        einzahlen.binde("aktiv", () -> { falls (!frei()) { serviere (nein); } stand.wert(); zTakt.wert(); serviere (spiel.sparbuch.einzahlbar(spiel)); });
        einzahlen.beiKlick(() -> { falls (spiel.sparbuch.zahleEin(spiel)) { speichere(); nachKauf(); } });
        einzahlen.hinweis("Ein Zehntel der Kasse aufs Sparbuch. Kostet nichts – Abheben holt jeden Cent zurück, samt Zinsen.");
        spruchInfo = kleinSchild("bereich-banca-info-2", 2, SCHILD_BREITE);
        spruchInfo.binde("text", () -> { falls (!frei()) { serviere (""); } stand.wert(); serviere ("💬 " + spiel.sparbuch.spruch()); });
        abheben = zeilenKnopf("bereich-banca-knopf-2", KNOPF_BREITE);
        abheben.setzeText("🏧 Alles abheben");
        abheben.binde("aktiv", () -> { falls (!frei()) { serviere (nein); } stand.wert(); serviere (spiel.sparbuch.guthaben > 0); });
        abheben.beiKlick(() -> { falls (spiel.sparbuch.hebeAb(spiel)) { speichere(); nachKauf(); } });
        abheben.hinweis("Das ganze Guthaben zurück in die Kasse. Vor einer Neueröffnung abheben – sonst löst Nonna das Sparbuch mit der Kasse auf.");
        zeilen = [zeile("bereich-banca-1", [guthabenInfo, einzahlen], ZEILE_HOEHE), zeile("bereich-banca-2", [spruchInfo, abheben], ZEILE_HOEHE)];
        für (Zutat z : zeilen) { z.binde("sichtbar", () -> frei()); }
    }

    // Quelle der Freischaltung (nach „Neu anfangen“ wieder zu – die Zeilen verschwinden mit dem Klick)
    diavolo frei() { zBereiche.wert(); serviere (spiel.istFrei("banca")); }

    margherita kopfText() {
        falls (!frei()) { serviere (""); }
        stand.wert(); zVersion.wert();
        Sparbuch b = spiel.sparbuch;
        serviere ("🏦 Sparbuch: verzinst bis " + b.deckel(spiel).währung("€", kompakt: ja) + " (30 min Umsatz) · Zinsen bisher "
            + b.zinsenAllzeit.währung("€", kompakt: ja) + ". Zählt nicht für Sterne; die Neueröffnung löst das Sparbuch auf.");
    }
}
// ── Ende P5 Banca (Oberfläche) ──

// ─────────────────────────────── Bereiche (Hof · Stadt · Labor) ─────────
// Ein Panel je Bereich – unsichtbar, bis der Bereich angeboten ist (Vorgänger der Kette frei). Angeboten zeigt es EINE Zeile:
// Teaser + Freischalt-Knopf frei-<schlüssel>. Der Freischalt-Klick lässt im selben Rückruf den Inhalt wachsen: Kopfzeile
// (Zusammenfassung, bereich-<s>-kopf) und die Zeilen des Bereichs (bereich-<s>-<n> mit Schild …-info-<n> und Knopf …-knopf-<n>;
// Lieferzonen: drei Zeilen mit je zwei halben Knöpfen für sechs Viertel). Bereiche ohne Inhalt (Paket 5) zeigen nur den Kopf.
//
// Bereiche mit Inhalt (Garten, Weinkeller, Personal, Lieferzonen, Marketing, Helfer, Stammgäste): Zeile i gehört zu Posten/
// Kampagne/Helfer/Gast i; der Knopf kauft ein Stück bzw. holt die Belohnung (Klick-Rückruf → nachKauf). Texte hängen an zBereiche
// und der Inhalts-Version des Bereichs (Kauf, Rundenreset) – Garten, Weinkeller und Marketing zusätzlich an zVersion, weil
// Pizzapreis und €/s an der Produktion hängen –, Knopf an/aus am Takt (Kasse), aber nur, solange es etwas zu kaufen gibt.
// Rezeptlabor: Zeile 1 „läuft/bereit“ mit Fortschritt und Knopf „🔬 Forschen · Preis“ / „⏳ läuft“, Zeile 2 „nächstes“, Zeile 3
// „erforscht: n/10“ – die erscheint mit dem ERSTEN Forschen-Klick (nie im Takt: darunter kann die Banca liegen) und bleibt.
// Stammgäste: vier Zeilen „Name: Wunsch – „Satz“ (x/y)“ mit Knopf „🎁 Belohnung“ (aktiv, wenn erfüllt – der Zähler bewegt sich im
// Takt, deshalb hängt die Zeile an zSekunde, solange der Wunsch offen ist).
klasse BereichPanel {
    Bereich b;
    Schild teaser;
    Knopf freiKnopf;
    Reihe teaserZeile;
    Schild kopf;
    Blech<Schild> infos = [];
    Blech<Knopf> knöpfe = [];
    Abschnitt teil;
    Blech<Posten> posten = [];
    Fortschritt laborBalken = karton;
    KatzePanel katzePanel = karton;   // P5: nur bei der Katze
    AlbumPanel albumPanel = karton;   // 📒 P5: nur beim Sammelalbum
    BancaPanel bancaPanel = karton;   // P5: nur bei der Banca

    salami zeilenZahl(margherita s) {
        falls (s == "garten" || s == "lieferzonen" || s == "labor") { serviere (3); }
        falls (s == "weinkeller" || s == "personal" || s == "marketing" || s == "helfer" || s == "stammgaeste") { serviere (4); }
        serviere (0);
    }

    BereichPanel(Bereich bereich) {
        b = bereich;
        margherita s = b.schlüssel;
        posten = spiel.postenVon(s);
        falls (s == "katze") { katzePanel = neu KatzePanel(); }   // P5: vor der Kopf-Bindung (kopfText delegiert)
        falls (s == "banca") { bancaPanel = neu BancaPanel(); }
        teaser = kleinSchild("bereich-" + s + "-teaser", 3, SCHILD_BREITE);
        teaser.setzeText(b.teaser);
        freiKnopf = zeilenKnopf("frei-" + s, KNOPF_BREITE);
        freiKnopf.beiKlick(() -> { falls (spiel.schalteFrei(b.schlüssel)) { speichere(); nachKauf(); } });
        freiKnopf.hinweis(b.teaser + " Freischalten ist dauerhaft – es überlebt Neueröffnung und Franchise.");
        freiKnopf.binde("text", () -> { zBereiche.wert(); serviere (spiel.istFrei(b.schlüssel) ? "✅" : "Freischalten · " + b.preis.währung("€", kompakt: ja)); });
        freiKnopf.binde("aktiv", () -> {
            zBereiche.wert();
            falls (!spiel.freischaltbar(b.schlüssel)) { serviere (nein); }
            zTakt.wert();
            serviere (spiel.geld >= b.preis);
        });
        teaserZeile = zeile("bereich-" + s + "-kopfzeile", [teaser, freiKnopf], ZEILE_HOEHE_3);
        teaserZeile.binde("sichtbar", () -> { zBereiche.wert(); serviere (!spiel.istFrei(b.schlüssel)); });
        kopf = kleinSchild("bereich-" + s + "-kopf", 2, INNEN);
        kopf.binde("text", () -> kopfText());
        kopf.binde("sichtbar", () -> { zBereiche.wert(); serviere (spiel.istFrei(b.schlüssel)); });
        Blech<Zutat> kinder = [teaserZeile, kopf];
        für (salami i : [1 .. Mathe.max(1, zeilenZahl(s))]) {
            falls (zeilenZahl(s) == 0) { abbrechen; }   // Bereiche ohne Inhalt (Paket 4/5): nur Teaser-Zeile und Kopf
            Reihe r = karton;
            falls (s == "lieferzonen") {
                // Zwei Viertel je Zeile: Knopf j = 2i−1 bzw. 2i ist Viertel j (Einmal-Kauf, Text „Name · Preis“ → „✅ Name“)
                Blech<Zutat> paar = [];
                für (salami j : [2 * i - 1 .. 2 * i]) {
                    Knopf k = zeilenKnopf("bereich-" + s + "-knopf-" + j, HALB_KNOPF);
                    k.binde("text", () -> knopfText(j));
                    k.binde("aktiv", () -> knopfAktiv(j));
                    k.beiKlick(() -> { falls (spiel.kaufePosten(b.schlüssel, j)) { nachKauf(); } });
                    k.hinweis(posten.stück(j).text);
                    knöpfe.hinzu(k); paar.hinzu(k);
                }
                r = zeile("bereich-" + s + "-" + i, paar, ZEILE_HOEHE);
            } sonst falls (s == "labor" && i > 1) {
                // „nächstes: …“ und „erforscht: n/10“ – nur ein Schild in Innenbreite, kein Knopf
                Schild info = kleinSchild("bereich-" + s + "-info-" + i, 2, INNEN);
                info.binde("text", () -> zeilenText(i));
                infos.hinzu(info);
                r = zeile("bereich-" + s + "-" + i, [info], ZEILE_HOEHE_TEXT);
            } sonst {
                Schild info = kleinSchild("bereich-" + s + "-info-" + i, s == "stammgaeste" ? 3 : 2, SCHILD_BREITE);
                Knopf k = zeilenKnopf("bereich-" + s + "-knopf-" + i, KNOPF_BREITE);
                info.binde("text", () -> zeilenText(i));
                k.binde("text", () -> knopfText(i));
                k.binde("aktiv", () -> knopfAktiv(i));
                Blech<Zutat> zk = [info, k];
                falls (s == "marketing") {
                    k.beiKlick(() -> { falls (spiel.starteKampagne(i)) { nachKauf(); } });
                    k.hinweis(spiel.KAMPAGNEN.stück(i).text);
                } sonst falls (s == "helfer") {
                    k.beiKlick(() -> { falls (spiel.kaufeHelfer(i)) { speichere(); nachKauf(); } });
                    k.hinweis(spiel.ALLE_HELFER.stück(i).text);
                } sonst falls (s == "labor") {
                    // Zeile 1: Schild + Fortschritt im Stapel (wie ein Upgrade-Platz), Knopf startet das nächste Projekt
                    laborBalken = neu Fortschritt(id: "bereich-labor-balken");
                    laborBalken.stil("farbe", "kruste");
                    laborBalken.binde("wert", () -> laborFortschritt());
                    Stapel st = neu Stapel([info, laborBalken]);
                    st.stil("breite", SCHILD_BREITE).stil("abstand", 2);
                    zk = [st, k];
                    k.beiKlick(() -> { falls (spiel.starteForschung()) { speichere(); nachKauf(); } });
                    k.hinweis("Startet das nächste Projekt (nur eins zugleich). Die Forschung läuft in Spielzeit – auch offline, höchstens 30 Minuten – und ihr Bonus gilt für immer, auch nach Neueröffnung und Franchise.");
                } sonst falls (s == "stammgaeste") {
                    k.beiKlick(() -> { falls (spiel.belohne(i)) { speichere(); nachKauf(); } });
                    k.hinweis(spiel.GÄSTE.stück(i).name + ": Ist der Wunsch erfüllt, bringt der Klick " + spiel.BELOHNUNG_PORTIONEN + " Portionen (als Betrieb) und ein Treueherz – +" + spiel.HERZ_PUNKTE.kompakt(1) + " Punkte im Alles-Bonus, für immer (höchstens " + spiel.HERZEN_HÖCHSTENS + " Herzen). Danach kommt der nächste Wunsch.");
                } sonst {
                    k.beiKlick(() -> { falls (spiel.kaufePosten(b.schlüssel, i)) { nachKauf(); } });
                    k.hinweis(posten.stück(i).text);
                }
                infos.hinzu(info); knöpfe.hinzu(k);
                r = zeile("bereich-" + s + "-" + i, zk, s == "stammgaeste" ? ZEILE_HOEHE_3 : ZEILE_HOEHE);
            }
            falls (s == "labor" && i == 3) {
                // erscheint mit dem ersten Forschen-Klick und bleibt (läuft eins oder ist eins fertig) – kein Takt blendet es ein oder aus
                r.binde("sichtbar", () -> { zBereiche.wert(); falls (!spiel.istFrei("labor")) { serviere (nein); } zLabor.wert(); serviere (spiel.forschungLäuft != "" || !spiel.forschung.istLeer()); });
            } sonst {
                r.binde("sichtbar", () -> { zBereiche.wert(); serviere (spiel.istFrei(b.schlüssel)); });
            }
            kinder.hinzu(r);
        }
        // P5: Katze, Wettbewerb, Sammelalbum und Banca bauen ihre Zeilen selbst (eigene Panel-Klassen) und liefern den Kopftext
        falls (s == "katze") { für (Zutat z : katzePanel.zeilen) { kinder.hinzu(z); } }
        falls (s == "wettbewerb") { für (Zutat z : wettbewerbPanel.zeilen) { kinder.hinzu(z); } }
        falls (s == "album") { albumPanel = neu AlbumPanel(); für (Zutat z : albumPanel.zeilen) { kinder.hinzu(z); } }
        falls (s == "banca") { für (Zutat z : bancaPanel.zeilen) { kinder.hinzu(z); } }
        teil = panel(b.titel(), "bereich-" + s, kinder);
        teil.binde("sichtbar", () -> { zBereiche.wert(); serviere (spiel.istFrei(b.schlüssel) || spiel.freischaltbar(b.schlüssel)); });
    }

    // Quellen des Inhalts: Freischaltung, Inhalts-Version; Garten, Weinkeller und Marketing (Preis = 60 s Umsatz) auch die Produktion
    diavolo inhaltOffen() {
        margherita s = b.schlüssel;
        zBereiche.wert();
        falls (!spiel.hatInhalt(s) || !spiel.istFrei(s)) { serviere (nein); }
        zInhalt(s).wert();
        falls (s == "garten" || s == "weinkeller" || s == "marketing") { zVersion.wert(); }
        serviere (ja);
    }

    margherita kopfText() {
        margherita s = b.schlüssel;
        falls (s == "katze") { serviere (katzePanel.kopfText()); }   // P5
        falls (s == "wettbewerb") { serviere (wettbewerbPanel.kopfText()); }
        falls (s == "album") { serviere (albumKopfText()); }   // 📒 P5
        falls (s == "banca") { serviere (bancaPanel.kopfText()); }   // P5
        falls (inhaltOffen()) {
            falls (s == "garten") { serviere ("🍅 Garten: +" + spiel.gartenProzent().kompakt(1) + " % Preis je Pizza (höchstens +" + spiel.GARTEN_HÖCHSTENS + " %, 20 Stück je Beet) – eine Pizza bringt " + spiel.preis().währung("€") + "."); }
            falls (s == "weinkeller") { serviere ("🍷 Weinkeller: " + spiel.getränkeWert.währung("€", kompakt: ja) + "/s (" + spiel.getränkeProzent().kompakt(3) + " % extra, läuft von selbst)"); }
            falls (s == "lieferzonen") {
                serviere ("🛵 Lieferzonen: " + spiel.viertelAnzahl() + "/" + posten.länge() + " Viertel – +" + spiel.viertelProzent() + " % auf alles (je Viertel +" + spiel.VIERTEL_PROZENT + ", zählt wie Sterne; Einmal-Kauf je Runde)"
                    + (spiel.viertelAnzahl() >= posten.länge() ? " Ganz Neapel isst bei dir." : ""));
            }
            falls (s == "marketing") {
                salami n = spiel.kampagnenLaufend();
                falls (n == 0) { serviere ("📣 Marketing: keine Kampagne läuft – jede kostet 60 s Umsatz (" + spiel.kampagnePreis().währung("€", kompakt: ja) + "), mehrere dürfen zugleich laufen."); }
                serviere ("📣 Marketing: " + n + (n == 1 ? " Kampagne läuft" : " Kampagnen laufen") + " – +" + spiel.marketingPunkte().kompakt(0) + " % auf alles · Preis ×" + spiel.marketingFaktor("preis").kompakt(2));
            }
            falls (s == "helfer") {
                serviere ("🤖 Nonnas Helfer: " + spiel.helfer.länge() + "/" + spiel.ALLE_HELFER.länge() + " angestellt · " + spiel.helferEinsätze + " Einsätze. Sie ersetzen Klicks – nie weniger wert als die Hand.");
            }
            falls (s == "labor") {
                Projekt l = spiel.laufendesProjekt();
                serviere ("🧪 Rezeptlabor: " + spiel.forschung.länge() + "/" + spiel.PROJEKTE.länge() + " erforscht · " + (l == karton ? "nichts läuft" : "läuft: " + l.name)
                    + " – eins zugleich, in Spielzeit (auch offline, höchstens 30 min), für immer.");
            }
            falls (s == "stammgaeste") {
                serviere ("❤️ " + spiel.herzen + (spiel.herzen == 1 ? " Herz" : " Herzen") + " – +" + spiel.herzPunkte().kompakt(1) + " Punkte auf alles (wie Sterne, höchstens " + spiel.HERZEN_HÖCHSTENS + " Herzen) · "
                    + spiel.wünscheErfüllt() + (spiel.wünscheErfüllt() == 1 ? " Wunsch" : " Wünsche") + " erfüllt. Erfüllt → 🎁 " + spiel.BELOHNUNG_PORTIONEN + " Portionen + 1 Herz.");
            }
            salami stufen = 0;
            für (Posten r : posten) { stufen += spiel.stück(s, r); }
            serviere ("👩‍🍳 Personal " + stufen + "/" + (10 * posten.länge()) + ": Trinkgeld +" + spiel.stufe("luigi") + " · Ofen −" + (spiel.ROSA_PROZENT * spiel.stufe("rosa"))
                + " % · Rabatt " + (spiel.ENZO_PROZENT * spiel.stufe("enzo")).kompakt(1) + " % · Hawaii +" + (20 * spiel.stufe("bruno")) + " %");
        }
        falls (spiel.istFrei(s)) { serviere ("✅ freigeschaltet – der Inhalt kommt im nächsten Paket."); }
        serviere ("");
    }

    margherita zeilenText(salami i) {
        falls (!inhaltOffen()) { serviere (""); }
        margherita s = b.schlüssel;
        falls (s == "marketing") {
            Kampagne c = spiel.KAMPAGNEN.stück(i);
            serviere (c.symbol + " " + c.name + " – " + c.wirkung() + ". " + c.text);
        }
        falls (s == "helfer") {
            Helfer h = spiel.ALLE_HELFER.stück(i);
            falls (h.schlüssel == "scout" && spiel.hatHelfer("scout")) { serviere (wettbewerbPanel.scoutText(h)); }   // P5
            serviere (h.symbol + " " + h.name + " – " + h.wirkung + ". " + h.text);
        }
        falls (s == "labor") { serviere (laborText(i)); }
        falls (s == "stammgaeste") { serviere (gastText(spiel.GÄSTE.stück(i))); }
        Posten p = posten.stück(i);
        salami n = spiel.stück(s, p);
        falls (s == "garten") { serviere (p.symbol + " " + p.name + " ×" + n + " – +" + p.wirkung.kompakt(2) + " % Preis je Stück. " + p.text); }
        falls (s == "weinkeller") { serviere (p.symbol + " " + p.name + " ×" + n + " – " + spiel.getränkWert(p).währung("€", kompakt: ja) + "/s (" + p.wirkung.kompakt(3) + " % je Stück)"); }
        serviere (p.symbol + " " + p.name + " – Stufe " + n + "/" + p.höchstens + ": " + spiel.rollenWirkung(p, n));
    }

    // Knopf i: Lieferzonen i = Viertel 1…6; Marketing/Helfer i = Kampagne/Helfer 1…4; sonst Posten i
    margherita knopfText(salami i) {
        falls (!inhaltOffen()) { serviere (""); }
        margherita s = b.schlüssel;
        falls (s == "marketing") {
            Kampagne c = spiel.KAMPAGNEN.stück(i);
            salami rest = spiel.kampagneRestVon(c.schlüssel);
            salami pause = spiel.kampagnePauseVon(c.schlüssel);
            falls (rest > 0 || pause > 0) {
                zTakt.wert();   // Countdown in Zehnersekunden (K-117: gleicher Text sendet nichts)
                serviere (rest > 0 ? "⏳ läuft noch " + (Mathe.decke(rest / 10) * 10) + " s" : "☕ Pause " + (Mathe.decke(pause / 10) * 10) + " s");
            }
            serviere ("Starten · " + spiel.kampagnePreis().währung("€", kompakt: ja));
        }
        falls (s == "helfer") {
            Helfer h = spiel.ALLE_HELFER.stück(i);
            serviere (spiel.hatHelfer(h.schlüssel) ? "✅ angestellt" : h.preis.währung("€", kompakt: ja));
        }
        falls (s == "labor") {
            falls (spiel.forschungLäuft != "") { serviere ("⏳ läuft"); }
            Projekt p = spiel.nächstesProjekt();
            serviere (p == karton ? "🎓 fertig" : "🔬 Forschen · " + p.preis.währung("€", kompakt: ja));
        }
        falls (s == "stammgaeste") { serviere ("🎁 Belohnung"); }
        Posten p = posten.stück(i);
        salami n = spiel.stück(s, p);
        falls (s == "lieferzonen") { serviere (n >= 1 ? "✅ " + p.name : p.name + " · " + p.preisBei(0).währung("€", kompakt: ja)); }
        falls (n >= p.höchstens) { serviere (s == "personal" ? "✅ Chef" : "✅ voll"); }
        serviere ((s == "personal" ? "Befördern · " : "") + p.preisBei(n).währung("€", kompakt: ja));
    }

    diavolo knopfAktiv(salami i) {
        falls (!inhaltOffen()) { serviere (nein); }
        margherita s = b.schlüssel;
        falls (s == "marketing") {
            Kampagne c = spiel.KAMPAGNEN.stück(i);
            falls (!spiel.kampagneStartbar(c)) { serviere (nein); }
            zTakt.wert();
            serviere (spiel.geld >= spiel.kampagnePreis());
        }
        falls (s == "helfer") {
            Helfer h = spiel.ALLE_HELFER.stück(i);
            falls (spiel.hatHelfer(h.schlüssel)) { serviere (nein); }
            zTakt.wert();
            serviere (spiel.geld >= h.preis);
        }
        falls (s == "labor") {
            falls (!spiel.forschungStartbar()) { serviere (nein); }
            zTakt.wert();
            serviere (spiel.geld >= spiel.nächstesProjekt().preis);
        }
        falls (s == "stammgaeste") {
            Gast g = spiel.GÄSTE.stück(i);
            falls (!spiel.gastZiel.hat(g.schlüssel)) { serviere (nein); }
            zSekunde.wert();   // der Zähler bewegt sich im Takt (Pizzen, Pino, Nonna …) – je Sekunde nachsehen
            serviere (spiel.wunschErfüllt(g));
        }
        Posten p = posten.stück(i);
        salami n = spiel.stück(s, p);
        falls (n >= p.höchstens) { serviere (nein); }
        zTakt.wert();
        serviere (spiel.geld >= p.preisBei(n));
    }

    // 🧪 Rezeptlabor – Zeile 1 „läuft/bereit“, Zeile 2 „nächstes“, Zeile 3 „erforscht“. Rest in Minuten (unter einer Minute in
    // Zehnersekunden) – K-117: gleicher Text sendet nichts.
    margherita restText(salami rest) { serviere (rest >= 60 ? Mathe.decke(rest / 60) + " min" : (Mathe.decke(rest / 10) * 10) + " s"); }
    margherita laborText(salami i) {
        Projekt l = spiel.laufendesProjekt();
        falls (i == 1) {
            falls (l != karton) { zSekunde.wert(); serviere ("⏳ läuft: " + l.symbol + " " + l.name + " · Rest " + restText(spiel.forschungRest) + " – danach " + l.wirkung + "."); }
            Projekt p = spiel.nächstesProjekt();
            falls (p == karton) { serviere ("🎓 Alles erforscht – Nonna ist jetzt Doktorin der Pizzologie. Das Labor duftet nach Oregano."); }
            serviere ("🔬 bereit: " + p.symbol + " " + p.name + " (" + p.minuten() + ") – " + p.wirkung + ". " + p.text);
        }
        falls (i == 2) {
            Projekt p = spiel.danachProjekt();
            falls (p == karton) { serviere (l == karton && spiel.nächstesProjekt() == karton ? "Nichts mehr zu forschen – Nonna schreibt jetzt Fachartikel." : "danach: nichts mehr – das ist das letzte Projekt."); }
            serviere ("nächstes: " + p.symbol + " " + p.name + " (" + p.minuten() + ", " + p.preis.währung("€", kompakt: ja) + ") – " + p.wirkung);
        }
        salami n = spiel.forschung.länge();
        falls (n == 0) { serviere ("erforscht: 0/" + spiel.PROJEKTE.länge() + " – Nonna spitzt den Bleistift."); }
        margherita was = spiel.PROJEKTE.filtere((p) -> (spiel.hatForschung(p.schlüssel))).belege((p) -> (p.symbol)).verbinde(" ");
        serviere ("erforscht: " + n + "/" + spiel.PROJEKTE.länge() + " – " + was);
    }
    // Balken 0…1 in 20 Stufen (spart Nachrichten); ohne laufende Forschung 0
    funghi laborFortschritt() {
        falls (!inhaltOffen()) { serviere (0); }
        Projekt l = spiel.laufendesProjekt();
        falls (l == karton) { serviere (0); }
        zSekunde.wert();
        serviere (Mathe.boden((l.dauer - spiel.forschungRest) / l.dauer * 20) / 20);
    }

    // 🧑‍🤝‍🧑 Stammgast: „Name: Wunsch – „Satz“ (x/y)“; offen → hängt an zSekunde (Zähler), erfüllt → nur an der Version
    margherita gastText(Gast g) {
        falls (!spiel.gastZiel.hat(g.schlüssel)) { serviere (g.symbol + " " + g.name + " schaut auf die Karte."); }
        margherita art = spiel.gastArt(g);
        funghi ziel = spiel.gastZielVon(g);
        // Stand vorn, der Satz hinten – wird er in den drei Zeilen abgeschnitten, bleibt der Stand lesbar
        margherita kopf_ = g.symbol + " " + g.name + ": " + spiel.wunschText(art, ziel);
        margherita satz_ = " – „" + g.satz(spiel.wunschNr(g)) + "“";
        falls (spiel.wunschErfüllt(g)) { serviere (kopf_ + " ✅ erfüllt" + satz_); }
        zSekunde.wert();
        serviere (kopf_ + " (" + Spiel.anz(spiel.gastFortschritt(g)) + "/" + Spiel.anz(ziel) + ")" + satz_);
    }
}

// ─────────────────────────────── Imperium ───────────────────────────────
// Links: Aufstieg-Tabelle (Zeilen erscheinen mit der erreichten Ebene), Neueröffnung, Franchise (erscheint ab 100 ⭐ in der
// Kette – auch im Takt, deshalb ganz unten). Rechts: Statistik (feste Zeilen), Neu anfangen.
// Alles rechnet nur, wenn der Reiter offen ist (quelleImperium) – das Schließen rechnet einmal nach, dann ist Ruhe.
klasse ImperiumPanel {
    Tabelle aufstieg;
    Schild prestigeInfo;
    Fortschritt prestigeBalken;
    Knopf prestigeKnopf;
    Schild franchiseInfo;
    Fortschritt franchiseBalken;
    Knopf franchiseKnopf;
    Abschnitt franchiseTeil;
    Tabelle statistik;
    Schild neuInfo;
    Knopf neuAnfangen;
    Reihe seite_;

    ImperiumPanel() {
        aufstieg = neu Tabelle(["Ebene", "Stand"], [], id: "aufstieg");
        aufstieg.stil("schrift", "klein").stil("zeilen", 2).stil("spalten", [4, 5]);
        aufstieg.binde("zeilen", () -> aufstiegZeilen());
        Abschnitt aufstiegTeil = panel("🪜 Dein Aufstieg", "aufstieg-teil", [aufstieg]);

        prestigeInfo = kleinSchild("prestige-info", 2, INNEN);
        prestigeInfo.binde("text", () -> {
            quelleImperium();
            salami neu_ = spiel.neueSterne();
            falls (neu_ > 0) {
                serviere ("Der Guide Michelin ist begeistert: " + Spiel.anz(neu_) + (neu_ == 1 ? " Stern" : " Sterne") + " (+" + spiel.prozentJeStern()
                    + " % je Stern) warten. Neueröffnen setzt Kasse, Upgrades und Rezeptbuch zurück.");
            }
            serviere ("Nächster Michelin-Stern ab " + spiel.nächsterStern().währung("€", kompakt: ja) + " Umsatz in dieser Kette (bisher "
                + spiel.umsatzKette.währung("€", kompakt: ja) + ").");
        });
        prestigeBalken = neu Fortschritt(id: "prestige-balken");
        prestigeBalken.stil("farbe", "kruste").stil("breite", SCHILD_BREITE);
        prestigeBalken.binde("wert", () -> { quelleImperium(); serviere (spiel.sternFortschritt()); });
        prestigeKnopf = zeilenKnopf("neueroeffnung", KNOPF_BREITE);
        prestigeKnopf.stil("farbe", "mozzarella");
        prestigeKnopf.beiKlick(() -> {
            falls (!bestätigt(prestigeKnopf)) { serviere; }
            falls (spiel.neueröffnung()) { speichere(); }
            nachAufstieg();
        });
        prestigeKnopf.hinweis("Kasse, Upgrades und Rezeptbuch fangen von vorn an – die Sterne bleiben (bis zur Franchise-Gründung). Eine laufende Herausforderung endet.");
        prestigeKnopf.binde("text", () -> { quelleImperium(); salami neu_ = spiel.neueSterne(); serviere (mitFrage(prestigeKnopf, "⭐ Wirklich? Nochmal klicken!", "⭐ Neueröffnung" + (neu_ > 0 ? " (+" + Spiel.anz(neu_) + ")" : ""))); });
        prestigeKnopf.binde("aktiv", () -> { quelleImperium(); serviere (aktivMitFrage(prestigeKnopf, spiel.neueSterne() > 0)); });
        Abschnitt sterneTeil = panel("⭐ Neueröffnung", "sterne", [prestigeInfo, zeile("sterne-zeile", [prestigeBalken, prestigeKnopf], ZEILE_HOEHE)]);

        franchiseInfo = kleinSchild("franchise-info", 2, INNEN);
        franchiseInfo.binde("text", () -> franchiseText());
        franchiseBalken = neu Fortschritt(id: "franchise-balken");
        franchiseBalken.stil("farbe", "tomate").stil("breite", SCHILD_BREITE);
        franchiseBalken.binde("wert", () -> {
            quelleImperium();
            salami kette = spiel.sterneKette();
            salami gesamt = spiel.sterneAllzeit + spiel.neueSterne();
            salami ziel = spiel.filialen + spiel.neueFilialen() + 1;
            salami von = spiel.sterneFürFiliale(ziel - 1);
            serviere (Mathe.min(kette / spiel.FRANCHISE_AB, (gesamt - von) / (spiel.sterneFürFiliale(ziel) - von)));
        });
        franchiseKnopf = zeilenKnopf("franchise", KNOPF_BREITE);
        franchiseKnopf.stil("farbe", "mozzarella");
        franchiseKnopf.beiKlick(() -> {
            falls (!bestätigt(franchiseKnopf)) { serviere; }
            falls (spiel.franchise()) { speichere(); }
            nachAufstieg();
        });
        franchiseKnopf.hinweis("Ab 100 Sternen in einer Kette. Filialen insgesamt = ⌊√(Sterne insgesamt ÷ 2,5)⌋ – 100 Sterne → 6, 250 → 10, 1.000 → 20; jede Filiale +200 % auf alles, für immer (zusammen mit den Sternen). Sterne, Geheimrezepte und die Runde fangen von vorn an; Herausforderungen, Erfolge und Bereiche bleiben.");
        franchiseKnopf.binde("text", () -> { quelleImperium(); salami f = spiel.neueFilialen(); serviere (mitFrage(franchiseKnopf, "🏢 Wirklich? Nochmal klicken!", "🏢 Kette gründen" + (f > 0 ? " (+" + Spiel.anz(f) + ")" : ""))); });
        franchiseKnopf.binde("aktiv", () -> { quelleImperium(); serviere (aktivMitFrage(franchiseKnopf, spiel.neueFilialen() > 0)); });
        franchiseTeil = panel("🏢 Franchise – Kette gründen", "franchise-teil", [franchiseInfo, zeile("franchise-zeile", [franchiseBalken, franchiseKnopf], ZEILE_HOEHE)]);
        // Erscheint ab 100 ⭐ in der Kette (kann im Takt kommen – ganz unten in der Spalte) und bleibt, sobald es eine Kette gibt
        franchiseTeil.binde("sichtbar", () -> { quelleImperium(); serviere (franchiseOffen()); });

        statistik = neu Tabelle(["Kennzahl", "Wert"], [], id: "statistik");
        statistik.stil("schrift", "klein").stil("zeilen", 1).stil("spalten", [1, 1]);
        statistik.binde("zeilen", () -> statistikZeilen());
        Abschnitt statistikTeil = panel("📊 Statistik", "statistik-teil", [statistik]);

        neuInfo = kleinSchild("neu-info", 2, SCHILD_BREITE);
        neuInfo.setzeText("Alles auf Anfang – Sterne, Filialen, Bereiche, Erfolge, Statistik und der gespeicherte Spielstand.");
        neuAnfangen = zeilenKnopf("neu-anfangen", KNOPF_BREITE);
        neuAnfangen.stil("farbe", "mozzarella").hinweis("Löscht den Spielstand in der Vorratskammer.");
        neuAnfangen.beiKlick(() -> {
            falls (!bestätigt(neuAnfangen)) { serviere; }
            spiel.allesZurück();
            kammer.leeren();
            sortiereErfolge();
            nachAufstieg();
        });
        neuAnfangen.binde("text", () -> mitFrage(neuAnfangen, "🗑 Wirklich alles? Nochmal klicken!", "🗑 Neu anfangen"));
        Abschnitt neuTeil = panel("🗑 Neu anfangen", "neu-teil", [zeile("neu-zeile", [neuInfo, neuAnfangen], ZEILE_HOEHE)]);

        seite_ = seite("seite-imperium", spalte("imperium-links", [aufstiegTeil, sterneTeil, franchiseTeil]), spalte("imperium-rechts", [statistikTeil, neuTeil]));
        // Badge am Reiter: wartende Sterne bzw. eine Kette, die gegründet werden kann (Reitertitel bleibt fest)
        seite_.binde("marke", () -> {
            zGeheim.wert(); zSekunde.wert();
            salami neu_ = spiel.neueSterne();
            falls (neu_ > 0) { serviere ("⭐ " + Spiel.anz(neu_)); }
            serviere (spiel.neueFilialen() > 0 ? "🏢" : "");
        });
    }

    // Die Franchise ist Thema, sobald die Kette 100 ⭐ hat oder es schon Filialen gibt
    diavolo franchiseOffen() { serviere (spiel.filialen > 0 || spiel.sterneKette() >= spiel.FRANCHISE_AB); }

    // Zeilen erscheinen mit der Ebene (nur durch Klicks: Neueröffnung, Herausforderung, Franchise) – „Zusammen“ steht immer unten
    Blech<Blech<margherita>> aufstiegZeilen() {
        quelleImperium();
        salami ausgegeben = spiel.sterneVergeben - spiel.sterne;
        funghi f = 1 + spiel.sterne * spiel.prozentJeStern() / 100 + spiel.filialen * spiel.PROZENT_JE_FILIALE / 100 + (spiel.BONUS_ADDITIV ? spiel.bonusPunkte() / 100 : 0);
        Blech<Blech<margherita>> z = [
            ["⭐ Sterne", Spiel.anz(spiel.sterne) + " aktiv" + (ausgegeben > 0 ? " · " + Spiel.anz(ausgegeben) + " ausgegeben" : "")
                + " → +" + Spiel.anz(spiel.sterne * spiel.prozentJeStern()) + " %"]
        ];
        falls (spiel.rezepteOffen()) { z.hinzu(["📜 Geheimrezepte", spiel.talente.länge() + " von " + spiel.REZEPTE.länge() + " gelernt"]); }
        falls (spiel.herausforderungenOffen()) { z.hinzu(["🏅 Herausforderungen", spiel.geschafft.länge() + " von " + spiel.HERAUSFORDERUNGEN.länge() + " geschafft"]); }
        falls (spiel.filialen > 0) { z.hinzu(["🏢 Franchise", Spiel.anz(spiel.filialen) + (spiel.filialen == 1 ? " Filiale" : " Filialen") + " → +" + Spiel.anz(spiel.filialen * spiel.PROZENT_JE_FILIALE) + " %"]); }
        z.hinzu(["Zusammen", "×" + f.kompakt(2) + " auf alles (Sterne" + (spiel.filialen > 0 ? " + Filialen" : "") + (spiel.BONUS_ADDITIV && spiel.bonusPunkte() > 0 ? " + Bereiche" : "") + ")"]);
        serviere (z);
    }

    margherita franchiseText() {
        quelleImperium();
        salami kette = spiel.sterneKette();
        salami gesamt = spiel.sterneAllzeit + spiel.neueSterne();
        salami filialenNeu = spiel.neueFilialen();
        salami ziel = spiel.filialen + filialenNeu + 1;          // die nächste Filiale danach
        margherita nächste = "Die " + Spiel.anz(ziel) + ". Filiale gibt es ab " + Spiel.anz(spiel.sterneFürFiliale(ziel)) + " Sternen insgesamt (bisher " + Spiel.anz(gesamt) + ").";
        falls (filialenNeu > 0) {
            serviere ("Deine Sterne reichen für " + Spiel.anz(filialenNeu) + (filialenNeu == 1 ? " neue Filiale" : " neue Filialen") + " (+"
                + Spiel.anz(filialenNeu * spiel.PROZENT_JE_FILIALE) + " % auf alles, für immer). Sterne, Geheimrezepte und die Runde fangen von vorn an.");
        }
        falls (kette < spiel.FRANCHISE_AB) { serviere ("Eine Kette gründen kannst du ab 100 Sternen in der laufenden Kette (bisher " + Spiel.anz(kette) + "). " + nächste); }
        serviere ("Für eine neue Filiale fehlen noch Sterne. " + nächste);
    }

    Blech<Blech<margherita>> statistikZeilen() {
        quelleImperium();
        serviere ([
            ["Pizzen (Runde)", spiel.pizzen.kompakt(1)],
            ["Pizzen (insgesamt)", spiel.pizzenAllzeit.kompakt(1)],
            ["Umsatz insgesamt", spiel.umsatzAllzeit.währung("€", kompakt: ja)],
            ["Anteil Klicken (Runde)", prozent(spiel.umsatzKlick, spiel.umsatz)],
            ["Anteil Klicken (gesamt)", prozent(spiel.umsatzKlickAllzeit, spiel.umsatzAllzeit)],
            ["Anteil Minispiele (Runde)", prozent(spiel.umsatzMini, spiel.umsatz)],
            ["Anteil Minispiele (gesamt)", prozent(spiel.umsatzMiniAllzeit, spiel.umsatzAllzeit)],
            ["Getränkeumsatz", spiel.umsatzGetränkeAllzeit.währung("€", kompakt: ja) + " (" + prozent(spiel.umsatzGetränkeAllzeit, spiel.umsatzAllzeit) + ")"],
            ["Klicks", spiel.klicks.tausender()],
            ["Spielzeit", (1s * spiel.sekunden).alsText()],
            ["Michelin-Sterne (insgesamt)", Spiel.anz(spiel.sterneAllzeit)],
            ["Neueröffnungen", spiel.neueröffnungen.alsText()],
            ["Franchise-Gründungen", spiel.franchises.alsText()],
            ["Bereiche frei", spiel.frei.länge() + " von " + spiel.BEREICHE.länge()],
            ["Perfekte Pizzen", spiel.perfekte.alsText()],
            ["Hawaii-Gäste bekehrt", spiel.hawaiiBekehrt.alsText()],
            ["Großbestellungen pünktlich", spiel.pünktlich.alsText()],
            ["Sonderschichten", spiel.sonderschichten.alsText()],
            ["Minispiele gewonnen", spiel.minispieleGewonnen + " von " + spiel.minispieleGespielt],
            ["Marketing-Kampagnen", spiel.kampagnenGestartet.alsText()],
            ["Helfer-Einsätze", spiel.helferEinsätze.alsText()]
        ]);
    }
}

// ─────────────────────────────── Nonna ──────────────────────────────────
// Ein Platz in Nonnas Geheimrezepten (sichtbar nur mit Rezept): Wird das Rezept gelernt, rückt hier das nächste nach (im
// Klick-Rückruf) – die anderen Plätze bleiben, wo sie sind.
klasse RezeptPlatz {
    Geheimrezept r = karton;
    Schild info;
    Knopf knopf;
    Reihe reihe;

    RezeptPlatz(salami nr) {
        info = kleinSchild("geheim-info-" + nr, 3, SCHILD_BREITE);
        info.binde("text", () -> {
            zPlaetze.wert(); zGeheim.wert();   // nicht an den offenen Reiter gebunden: die Plätze stehen schon beim ersten Öffnen beschriftet da
            falls (r == karton) { serviere (""); }
            margherita voraus = r.braucht == "" ? "" : " (nach " + spiel.rezeptNamens(r.braucht).name + ")";
            serviere (r.symbol + " " + r.name + voraus + " – " + r.text);
        });
        knopf = zeilenKnopf("geheim-lernen-" + nr, KNOPF_BREITE);
        knopf.beiKlick(() -> { falls (r != karton && spiel.lerne(r)) { speichere(); nachLernen(); } });
        knopf.binde("text", () -> { zPlaetze.wert(); zGeheim.wert(); serviere (r == karton ? "" : Spiel.anz(spiel.rezeptKosten(r)) + " ⭐ lernen"); });
        knopf.binde("aktiv", () -> { zPlaetze.wert(); zGeheim.wert(); serviere (r != karton && spiel.lernbar(r)); });
        reihe = zeile("geheim-platz-" + nr, [info, knopf], ZEILE_HOEHE_3);
        reihe.binde("sichtbar", () -> { zPlaetze.wert(); serviere (r != karton); });
    }
}

// Ein Platz bei den Herausforderungen (zwei Plätze, sichtbar nur mit Inhalt). Eine geschaffte bleibt mit „✅ geschafft“
// stehen, bis ein Klick die nächste nachrücken lässt.
klasse ProbePlatz {
    Herausforderung h = karton;
    Schild info;
    Knopf knopf;
    Reihe reihe;

    ProbePlatz(salami nr) {
        info = kleinSchild("probe-info-" + nr, 3, SCHILD_BREITE);
        info.binde("text", () -> {
            zPlaetze.wert(); zGeheim.wert();   // wie die Rezept-Plätze: beschriftet, bevor der Reiter zum ersten Mal offen ist
            falls (h == karton) { serviere (""); }
            serviere (h.symbol + " " + h.name + " – Ziel " + h.ziel.währung("€", kompakt: ja) + " Umsatz. " + h.regel + " Belohnung: " + h.belohnung);
        });
        knopf = zeilenKnopf("probe-start-" + nr, KNOPF_BREITE);
        knopf.hinweis("Startet eine Neueröffnung unter Auflagen (wartende Sterne gibt es dazu). Kasse, Upgrades und Rezeptbuch fangen von vorn an.");
        knopf.beiKlick(() -> {
            falls (h == karton || !spiel.startbar(h)) { serviere; }
            falls (!bestätigt(knopf)) { serviere; }
            falls (spiel.starte(h)) { speichere(); }
            nachAufstieg();
        });
        knopf.binde("text", () -> {
            zPlaetze.wert(); zGeheim.wert();
            falls (h == karton) { serviere (""); }
            falls (spiel.bestanden(h.schlüssel)) { serviere ("✅ geschafft"); }
            falls (spiel.modus == h.schlüssel) { serviere ("⏳ läuft"); }
            serviere (mitFrage(knopf, "▶ Wirklich? Nochmal!", "▶ Starten"));
        });
        knopf.binde("aktiv", () -> {
            zPlaetze.wert(); zGeheim.wert();
            falls (h == karton || spiel.bestanden(h.schlüssel) || spiel.modus == h.schlüssel) { serviere (nein); }
            serviere (aktivMitFrage(knopf, spiel.startbar(h)));
        });
        reihe = zeile("probe-platz-" + nr, [info, knopf], ZEILE_HOEHE_3);
        reihe.binde("sichtbar", () -> { zPlaetze.wert(); serviere (h != karton); });
    }
}

// Die Nonna-Seite erscheint mit dem ersten Stern (Reiter rechts außen). Links die Geheimrezepte (Kopf, bis drei Plätze, darunter
// „✅ Gelernt“ nach dem ersten Lernen), rechts die Herausforderungen (ab 3 ⭐: Kopf, zwei Plätze, die Zeile der laufenden
// Herausforderung, ganz unten „✅ Geschafft“ – das erscheint im Takt, darunter liegt nichts).
klasse NonnaPanel {
    Schild geheimInfo;
    Blech<RezeptPlatz> rezeptPlätze = [];
    Schild gelerntInfo;
    Abschnitt gelerntTeil;
    Schild probeInfo;
    Blech<ProbePlatz> probePlätze = [];
    Fortschritt zielBalken;
    Knopf aufgeben;
    Reihe laufendZeile;
    diavolo laufendBelegt = nein;    // bei der letzten Belegung lief eine Herausforderung (die Zeile bleibt bis zum nächsten Klick)
    Schild geschafftInfo;
    Abschnitt geschafftTeil;
    Abschnitt probeTeil;
    Reihe seite_;

    NonnaPanel() {
        geheimInfo = kleinSchild("geheim-kopf", 3, INNEN);
        geheimInfo.binde("text", () -> {
            quelleNonna();
            serviere ("Nonna verrät ihre Geheimnisse nur gegen Michelin-Sterne – du hast " + Spiel.anz(spiel.sterne)
                + " ⭐. Ein ausgegebener Stern bringt keine +" + spiel.prozentJeStern() + " % mehr; die Rezepte wirken bis zur nächsten Kette.");
        });
        Blech<Zutat> links = [geheimInfo];
        für (salami i : [1 .. 3]) {
            RezeptPlatz z = neu RezeptPlatz(i);
            rezeptPlätze.hinzu(z);
            links.hinzu(z.reihe);
        }
        gelerntInfo = kleinSchild("geheim-gelernt", 3, INNEN);
        gelerntInfo.stil("farbe", "basilikum");
        gelerntInfo.binde("text", () -> { quelleNonna(); serviere (gelernte().belege((r) -> (r.symbol + " " + r.name)).verbinde(" · ")); });
        gelerntTeil = neu Abschnitt("", [gelerntInfo], id: "geheim-gelernt-teil");
        gelerntTeil.klappbar(ja).zu(ja).stil("zeilen", 1);
        gelerntTeil.binde("titel", () -> {
            quelleNonna();
            salami n = gelernte().länge();
            serviere ("✅ Gelernt: " + n + (n == 1 ? " Geheimrezept" : " Geheimrezepte") + (spiel.offeneRezepte().istLeer() && n > 0 ? " – alles" : ""));
        });
        gelerntTeil.binde("sichtbar", () -> { zGeheim.wert(); serviere (!spiel.talente.istLeer()); });
        links.hinzu(gelerntTeil);
        Abschnitt geheimTeil = panel("📜 Nonnas Geheimrezepte", "geheimrezepte", links);

        probeInfo = kleinSchild("probe-kopf", 3, INNEN);
        probeInfo.binde("text", () -> {
            quelleNonna();
            falls (spiel.modus != "") {
                quelleNonnaSekunde();
                Herausforderung h = spiel.herausforderung(spiel.modus);
                serviere (h.symbol + " " + h.name + " läuft: " + spiel.umsatz.währung("€", kompakt: ja) + " von " + h.ziel.währung("€", kompakt: ja) + " Umsatz. " + h.regel);
            }
            serviere ("Eine Runde unter Auflagen – schaffst du das Ziel, gilt die Belohnung für immer, auch nach einer Franchise-Gründung."
                + (spiel.filialen <= 0 && spiel.geschafft.länge() >= 3 ? " Mit einer Franchise-Kette wartet die nächste Staffel." : ""));
        });
        Blech<Zutat> rechts = [probeInfo];
        für (salami i : [1 .. 2]) {
            ProbePlatz z = neu ProbePlatz(i);
            probePlätze.hinzu(z);
            rechts.hinzu(z.reihe);
        }
        zielBalken = neu Fortschritt(id: "ziel-balken");
        zielBalken.stil("farbe", "basilikum").stil("breite", SCHILD_BREITE);
        zielBalken.binde("wert", () -> { quelleNonna(); falls (spiel.modus == "") { serviere (laufendBelegt ? 1 : 0); } quelleNonnaSekunde(); serviere (spiel.zielFortschritt()); });
        aufgeben = zeilenKnopf("aufgeben", KNOPF_BREITE);
        aufgeben.stil("farbe", "mozzarella").hinweis("Die Auflagen fallen weg, die Runde läuft normal weiter – ohne Belohnung.");
        aufgeben.beiKlick(() -> {
            falls (spiel.modus == "") { serviere; }
            falls (!bestätigt(aufgeben)) { serviere; }
            spiel.gibAuf();
            nachAufstieg();
        });
        aufgeben.binde("text", () -> { quelleNonna(); serviere (spiel.modus == "" ? "🏅 geschafft" : mitFrage(aufgeben, "🏳 Wirklich aufgeben? Nochmal!", "🏳 Aufgeben")); });
        aufgeben.binde("aktiv", () -> { quelleNonna(); serviere (aktivMitFrage(aufgeben, spiel.modus != "")); });
        laufendZeile = zeile("probe-laufend", [zielBalken, aufgeben], ZEILE_HOEHE_3);
        // Erscheint mit dem Start (Klick) und verschwindet mit dem nächsten Klick nach dem Ende – nie im Takt (R1)
        laufendZeile.binde("sichtbar", () -> { zPlaetze.wert(); serviere (laufendBelegt); });
        rechts.hinzu(laufendZeile);
        geschafftInfo = kleinSchild("probe-geschafft", 3, INNEN);
        geschafftInfo.stil("farbe", "basilikum");
        geschafftInfo.binde("text", () -> { quelleNonna(); serviere (geschaffte().belege((h) -> (h.symbol + " " + h.name + " – " + h.belohnung)).verbinde(" · ")); });
        geschafftTeil = neu Abschnitt("", [geschafftInfo], id: "probe-geschafft-teil");
        geschafftTeil.klappbar(ja).zu(ja).stil("zeilen", 1);
        geschafftTeil.binde("titel", () -> { quelleNonna(); salami g = geschaffte().länge(); serviere ("✅ Geschafft: " + g + (g == 1 ? " Herausforderung" : " Herausforderungen")); });
        // Die erste Herausforderung wird im Takt geschafft – der Abschnitt steht ganz unten, darunter liegt nichts
        geschafftTeil.binde("sichtbar", () -> { zGeheim.wert(); serviere (!spiel.geschafft.istLeer()); });
        rechts.hinzu(geschafftTeil);
        probeTeil = panel("🏅 Herausforderungen", "herausforderungen", rechts);
        probeTeil.binde("sichtbar", () -> { zGeheim.wert(); serviere (spiel.herausforderungenOffen()); });

        seite_ = seite("seite-nonna", spalte("nonna-links", [geheimTeil]), spalte("nonna-rechts", [probeTeil]));
        // Die Seite (und ihr Reiter) erscheint mit dem ersten Stern – durch Neueröffnung oder Herausforderung (Klick)
        seite_.binde("sichtbar", () -> { zGeheim.wert(); serviere (spiel.rezepteOffen()); });
        // Badge am Reiter: so viele Geheimrezepte sind gerade lernbar
        seite_.binde("marke", () -> {
            zGeheim.wert();
            falls (!spiel.rezepteOffen()) { serviere (""); }
            salami n = spiel.offeneRezepte().filtere((x) -> (spiel.lernbar(x))).länge();
            serviere (n > 0 ? "📜 " + n : "");
        });
    }

    Blech<Geheimrezept> gelernte() { serviere (spiel.REZEPTE.filtere((r) -> (spiel.gelernt(r.schlüssel)))); }
    Blech<Herausforderung> geschaffte() { serviere (spiel.HERAUSFORDERUNGEN.filtere((h) -> (spiel.bestanden(h.schlüssel)))); }

    // Rezept-Plätze neu belegen (nach Lernen, Neueröffnung, Franchise, Neu anfangen)
    leer belegeRezepte() {
        Blech<Geheimrezept> welle = spiel.offeneRezepte();
        für (RezeptPlatz z : rezeptPlätze) { falls (z.r != karton && !welle.enthält(z.r)) { z.r = karton; } }
        für (Geheimrezept r : welle) {
            falls (rezeptPlätze.filtere((z) -> (z.r == r)).istLeer()) {
                Blech<RezeptPlatz> frei = rezeptPlätze.filtere((z) -> (z.r == karton));
                falls (!frei.istLeer()) { RezeptPlatz z = frei.erstes(); z.r = r; z.knopf.hinweis((r.text)); }
            }
        }
    }

    // Herausforderungs-Plätze neu belegen (nach jedem Klick, der Plätze ordnet: Kauf, Starten, Aufgeben, Neueröffnung, Franchise, Neu anfangen)
    leer belegeProben() {
        Blech<Herausforderung> welle = spiel.offeneHerausforderungen();
        für (ProbePlatz z : probePlätze) { falls (z.h != karton && !welle.enthält(z.h)) { z.h = karton; } }
        für (Herausforderung h : welle) {
            falls (probePlätze.filtere((z) -> (z.h == h)).istLeer()) {
                Blech<ProbePlatz> frei = probePlätze.filtere((z) -> (z.h == karton));
                falls (!frei.istLeer()) { frei.erstes().h = h; }
            }
        }
        laufendBelegt = spiel.modus != "";
    }
}

// ─────────────────────────────── Spiele ─────────────────────────────────
// Eine Spielzeile je Grundspiel (Knopf mini-<grundspiel>) in voller Breite: Die Meister-Variante wechselt nur den Text.
klasse MinispielZeile {
    margherita grund;
    Schild info;
    Knopf knopf;
    Reihe reihe;

    MinispielZeile(margherita g) {
        grund = g;
        info = kleinSchild("mini-info-" + g, 2, VOLL_SCHILD);
        info.binde("text", () -> { zSpiele.wert(); Minispiel m = ecke.variante(grund); serviere (m.symbol + " " + m.name + " – Gewinn: " + m.belohnung + " Sekunden Produktion. " + m.regel); });
        knopf = zeilenKnopf("mini-" + g, KNOPF_BREITE);
        knopf.beiKlick(() -> { falls (ecke.starte(grund)) { nachVerarbeitung(); } });
        knopf.binde("hinweis", () -> { zSpiele.wert(); serviere ("Ein Sieg bringt so viele Pizzen, wie dein Betrieb in " + ecke.variante(grund).belohnung
            + " Sekunden backt (oder ein Klick, wenn der mehr bringt). Danach macht Nonna zwei Minuten Pause – für alle Spiele."); });
        knopf.binde("text", () -> {
            zSpiele.wert(); zVersion.wert(); zSekunde.wert();
            falls (ecke.läuft == grund) { serviere ("⏳ läuft"); }
            falls (!ecke.erlaubt()) { serviere ("🙏 Fastenzeit"); }
            falls (spiel.minispielPause > 0) { serviere ("☕ noch " + (Mathe.decke(spiel.minispielPause / 10) * 10) + " s"); }
            serviere ("▶ Spielen");
        });
        knopf.binde("aktiv", () -> { zSpiele.wert(); zVersion.wert(); zSekunde.wert(); serviere (ecke.läuft == "" && ecke.erlaubt() && spiel.minispielPause <= 0); });
        reihe = zeile("mini-zeile-" + g, [info, knopf], ZEILE_HOEHE);
    }
}

// Oben Nonnas Spielecke mit den vier Spielzeilen (volle Breite), DARUNTER das Spielfeld: Es erscheint beim Start (Klick) und
// verschwindet mit dem Ende des Spiels (auch im Takt) – ganz unten auf der Seite, darunter liegt nichts. Innen wechseln die
// Knöpfe des laufenden Spiels. Das Spielfeld hängt am Takt, solange ein Spiel läuft (zSpiele zuerst, zTakt nur dann).
klasse SpielePanel {
    Abschnitt spielfeld;
    Schild spielAnzeige;
    Fortschritt spielBalken;
    Schild spielStatus;
    Blech<Schild> teigFelder = [];
    Stapel teigTeil;
    Knopf fangen;
    Blech<Knopf> belagKnöpfe = [];
    Stapel belagTeil;
    Knopf heizen;
    Knopf lüften;
    Reihe ofenTeil;
    Blech<Knopf> routenKnöpfe = [];
    Stapel routenTeil;
    Schild miniKopf;
    Blech<MinispielZeile> zeilen = [];
    Stapel seite_;

    SpielePanel() {
        spielAnzeige = neu Schild("", id: "spiel-anzeige");
        spielAnzeige.stil("schrift", "gross").stil("ausrichtung", "mitte").stil("zeilen", 1).stil("breite", VOLL_INNEN);
        spielAnzeige.binde("text", () -> anzeigeText());
        spielAnzeige.bindeStil("farbe", () -> {
            zSpiele.wert();
            falls (ecke.läuft != "ofen") { serviere ("normal"); }
            zTakt.wert();
            serviere (ecke.ofenImZiel() ? "basilikum" : "tomate");
        });
        spielBalken = neu Fortschritt(id: "spiel-balken");
        spielBalken.stil("farbe", "kruste");
        spielBalken.binde("wert", () -> { zSpiele.wert(); falls (ecke.läuft == "") { serviere (0); } zTakt.wert(); serviere (Mathe.max(0, Mathe.min(1, ecke.balken()))); });
        spielStatus = kleinSchild("spiel-status", 2, VOLL_INNEN);
        spielStatus.stil("ausrichtung", "mitte");
        spielStatus.binde("text", () -> statusText());

        // Die Bahn des Teigs: 21 Felder à 17 px (357 px), das grüne Ziel ist 3 Felder breit.
        Reihe teigBahn = neu Reihe([], id: "teig-bahn");
        teigBahn.stil("abstand", 0).stil("ausrichtung", "mitte");
        für (salami i : [0 .. 20]) {
            Schild f = neu Schild("·", id: "teig-feld-" + i);
            f.stil("breite", 17).stil("ausrichtung", "mitte");
            f.binde("text", () -> { zSpiele.wert(); falls (ecke.läuft != "teig") { serviere ("·"); } zTakt.wert(); serviere (ecke.feld(i)); });
            f.bindeStil("farbe", () -> { zSpiele.wert(); serviere (ecke.läuft == "teig" && ecke.imZiel(i) ? "basilikum" : "normal"); });
            teigFelder.hinzu(f);
            teigBahn.hinzu(f);
        }
        fangen = neu Knopf("✋ Fangen! (Leertaste)", () -> { ecke.fange(); nachVerarbeitung(); }, id: "teig-fangen");
        fangen.stil("farbe", "tomate").stil("ausrichtung", "mitte").stil("zeilen", 1).hinweis("Genau dann klicken (oder die Leertaste drücken), wenn 🫓 über dem grünen Feld schwebt.");
        teigTeil = neu Stapel([teigBahn, fangen], id: "teig-teil");
        teigTeil.stil("abstand", 8);
        teigTeil.binde("sichtbar", () -> { zSpiele.wert(); serviere (ecke.läuft == "teig"); });

        Blech<Zutat> belagZeilen = [];
        Reihe belagReihe = karton;
        für (salami i : [1 .. ecke.BELÄGE.länge()]) {
            margherita b = ecke.BELÄGE.stück(i);
            Knopf k = neu Knopf(i + " · " + b, () -> { ecke.tippe(b); nachVerarbeitung(); }, id: "belag-" + i);
            k.stil("breite", HALB_KNOPF).stil("zeilen", 1).hinweis("Klicken oder Taste " + i + ".");
            k.binde("aktiv", () -> { zSpiele.wert(); falls (ecke.läuft != "bestellung") { serviere (ja); } zTakt.wert(); serviere (!ecke.zeigt); });
            belagKnöpfe.hinzu(k);
            falls (i % 2 == 1) { belagReihe = neu Reihe([], id: "belag-reihe-" + ((i + 1) / 2)); belagReihe.stil("abstand", 8).stil("ausrichtung", "mitte"); belagZeilen.hinzu(belagReihe); }
            belagReihe.hinzu(k);
        }
        belagTeil = neu Stapel(belagZeilen, id: "belag-teil");
        belagTeil.stil("abstand", 6);
        belagTeil.binde("sichtbar", () -> { zSpiele.wert(); serviere (ecke.läuft == "bestellung"); });

        heizen = neu Knopf("🪵 Holz nachlegen ↑", () -> { ecke.heize(25); nachVerarbeitung(); }, id: "ofen-heizen");
        heizen.stil("farbe", "tomate").stil("breite", HALB_KNOPF).stil("zeilen", 1).hinweis("+25 °C (oder Pfeil nach oben)");
        lüften = neu Knopf("💨 Klappe auf ↓", () -> { ecke.heize(-25); nachVerarbeitung(); }, id: "ofen-lueften");
        lüften.stil("farbe", "mozzarella").stil("breite", HALB_KNOPF).stil("zeilen", 1).hinweis("−25 °C (oder Pfeil nach unten)");
        ofenTeil = neu Reihe([heizen, lüften], id: "ofen-teil");
        ofenTeil.stil("abstand", 8).stil("ausrichtung", "mitte");
        ofenTeil.binde("sichtbar", () -> { zSpiele.wert(); serviere (ecke.läuft == "ofen"); });

        routenTeil = neu Stapel([], id: "routen-teil");
        routenTeil.stil("abstand", 6);
        für (salami i : [1 .. 4]) {    // der vierte Weg nur in der Rushhour
            Knopf k = neu Knopf("", () -> { ecke.nimmRoute(i); nachVerarbeitung(); }, id: "route-" + i);
            k.stil("zeilen", 1);
            k.binde("text", () -> { zSpiele.wert(); serviere (ecke.läuft == "route" && i <= ecke.routen.länge() ? i + " · " + ecke.routen.stück(i) : ""); });
            k.binde("sichtbar", () -> { zSpiele.wert(); serviere (ecke.läuft != "route" || i <= ecke.routen.länge()); });
            routenKnöpfe.hinzu(k);
            routenTeil.hinzu(k);
        }
        routenTeil.binde("sichtbar", () -> { zSpiele.wert(); serviere (ecke.läuft == "route"); });

        spielfeld = neu Abschnitt("🎲 Spielfeld", [spielAnzeige, spielBalken, spielStatus, teigTeil, belagTeil, ofenTeil, routenTeil], id: "spielfeld");
        spielfeld.stil("abstand", 8).stil("breite", VOLL).stil("zeilen", 1);
        spielfeld.binde("titel", () -> { zSpiele.wert(); serviere (ecke.läuft == "" ? "🎲 Spielfeld" : ecke.aktuell.symbol + " " + ecke.aktuell.name); });
        spielfeld.binde("sichtbar", () -> { zSpiele.wert(); serviere (ecke.läuft != ""); });

        miniKopf = kleinSchild("mini-kopf", 2, VOLL_INNEN);
        miniKopf.binde("text", () -> {
            zSpiele.wert(); zVersion.wert(); zSekunde.wert();
            margherita bilanz = spiel.minispieleGespielt > 0 ? " Bisher " + spiel.minispieleGewonnen + " von " + spiel.minispieleGespielt + " gewonnen." : "";
            falls (!ecke.erlaubt()) { serviere ("🙏 Fastenzeit: Nonna hat die Spiele weggeräumt – nur der Betrieb backt." + bilanz); }
            falls (spiel.minispielPause > 0 && ecke.läuft == "") { serviere ("☕ Nonna macht Pause – in " + (Mathe.decke(spiel.minispielPause / 10) * 10) + " s spielt sie wieder mit." + bilanz); }
            serviere ("Kurze Spiele für zwischendurch: Ein Sieg bringt Pizzen im Wert von 8 bis 13 Sekunden Produktion, danach macht Nonna zwei Minuten Pause. Das Spielfeld erscheint hier unten." + bilanz);
        });
        Blech<Zutat> kinder = [miniKopf];
        für (margherita g : ecke.GRUNDSPIELE) {
            MinispielZeile z = neu MinispielZeile(g);
            zeilen.hinzu(z);
            kinder.hinzu(z.reihe);
        }
        Abschnitt spieleTeil = panel("🎲 Nonnas Spielecke", "spielecke", kinder);
        spieleTeil.stil("breite", VOLL);
        seite_ = neu Stapel([spieleTeil, spielfeld], id: "seite-spiele");
        seite_.stil("abstand", 8).stil("breite", VOLL);
    }

    margherita anzeigeText() {
        zSpiele.wert();
        margherita l = ecke.läuft;
        falls (l == "") { serviere (""); }
        zTakt.wert();
        falls (l == "teig") { serviere ("🫓 Der Teig fliegt …"); }
        falls (l == "bestellung") { serviere (ecke.bestellungText()); }
        falls (l == "ofen") { serviere ("🌡 " + ecke.grad + " °C"); }
        serviere ("🛵 Welcher Weg ist am schnellsten?");
    }

    margherita statusText() {
        zSpiele.wert();
        margherita l = ecke.läuft;
        falls (l == "") { serviere (""); }
        zTakt.wert();
        falls (l == "ofen") { serviere ("Ziel " + ecke.zielMin + "–" + ecke.zielMax + " °C · im Ziel: " + ecke.imZiel + " von 10 s (7 nötig) · noch " + Mathe.decke((20 - ecke.ticks) / 2) + " s"); }
        falls (l == "route") { serviere (ecke.status + " Noch " + Mathe.decke((20 - ecke.ticks) / 2) + " s."); }
        serviere (ecke.status);
    }
}

// ─────────────────────────────── Erfolge ────────────────────────────────
// Kopfzeile + Tabelle in Erscheinensfolge: oben die nächsten drei Ziele („???“, Texte wechseln), darunter alle erreichten
// Erfolge in der Reihenfolge, in der sie kamen – jeder neue hängt unten an (auch im Takt: die Tabelle ist das letzte Element
// der Seite). Feste Spaltengewichte (K-126), eine Zeile je Zelle.
klasse ErfolgePanel {
    Schild kopf;
    Tabelle tabelle;
    Stapel seite_;

    ErfolgePanel() {
        kopf = kleinSchild("erfolge-kopf", 1, VOLL);
        kopf.binde("text", () -> {
            zErfolge.wert();
            salami n = spiel.erfolge.länge();
            salami rest = Mathe.max(0, offeneErfolge.länge() - 3);
            falls (n == 0) { serviere ("Noch kein Erfolg – fang einfach an zu backen! Die nächsten drei Ziele stehen unten, " + rest + " weitere tauchen auf, wenn es so weit ist."); }
            falls (offeneErfolge.istLeer()) { serviere ("Alle " + n + " Erfolge freigeschaltet – Nonna ist sprachlos. Zum ersten Mal."); }
            serviere ("Freigeschaltet: " + n + " von " + ERFOLGE.länge() + " · die nächsten Ziele oben, " + rest + " weitere tauchen auf, wenn es so weit ist.");
        });
        tabelle = neu Tabelle(["", "Erfolg", "Ziel"], [], id: "erfolge");
        tabelle.stil("schrift", "klein").stil("breite", VOLL).stil("zeilen", 1).stil("spalten", [1, 7, 12]);
        tabelle.binde("zeilen", () -> erfolgZeilen());
        seite_ = neu Stapel([kopf, tabelle], id: "erfolge-seite");   // eine Spalte voller Breite
        seite_.stil("abstand", 8).stil("breite", VOLL);
    }

    Blech<Blech<margherita>> erfolgZeilen() {
        zErfolge.wert();
        Blech<Blech<margherita>> zeilen_ = [];
        salami gezeigt = 0;
        für (Erfolg e : offeneErfolge) {
            falls (gezeigt < 3) { zeilen_.hinzu(["🎯", "???", e.text]); gezeigt++; }
        }
        für (margherita name : spiel.erfolge) {
            Blech<Erfolg> treffer = ERFOLGE.filtere((x) -> (x.name == name));
            falls (!treffer.istLeer()) { zeilen_.hinzu(["🏆", name, treffer.erstes().text]); }
        }
        serviere (zeilen_);
    }
}

// ─────────────────────────────── Aufbau ─────────────────────────────────
Theke theke = neu Theke("Pizza-Imperium", breite: 860, hoehe: 640);

Blech<Erfolg> offeneErfolge = [];
leer sortiereErfolge() {
    offeneErfolge = ERFOLGE.filtere((e) -> (!spiel.erfolge.enthält(e.name)));
}

KopfPanel kopf = neu KopfPanel();
RezeptPanel rezeptPanel = neu RezeptPanel();
BetriebPanel betriebPanel = neu BetriebPanel();
HandwerkPanel handwerkPanel = neu HandwerkPanel();
BriefPanel briefPanel = neu BriefPanel();

Schild mengeSchild = neu Schild("Kaufmenge:", id: "kaufmenge-text");
mengeSchild.stil("schrift", "klein");
Auswahl mengeWahl = neu Auswahl(["1×", "10×", "100×", "Max"], id: "kaufmenge-wahl");
mengeWahl.stil("farbe", "basilikum").hinweis("1× – ein Stück pro Klick · 10× und 100× – nur, wenn alle bezahlbar sind · Max – so viele, wie die Kasse hergibt.");
mengeWahl.beiAenderung((n) -> { zMenge.setze(MENGEN.stück(n)); });
Reihe kaufmengeReihe = neu Reihe([mengeSchild, mengeWahl], id: "kaufmenge");
kaufmengeReihe.stil("abstand", 6).stil("ausrichtung", "mitte").stil("hoehe", 42);

// Backstube (§12.9/8): Wachsende Listen stehen als letztes Element ihrer Spalte – links Rezeptbuch · Feinkost (eine Zeile, per
// Klick) · Betrieb (wächst), rechts Kaufmenge · Meisterbriefe (eine Zeile, per Klick) · Handwerk (wächst).
Reihe backstube = seite("seite-backstube",
    spalte("backstube-links", [rezeptPanel.teil, rezeptPanel.feinkostTeil, betriebPanel.teil]),
    spalte("backstube-rechts", [kaufmengeReihe, briefPanel.teil, handwerkPanel.teil]));

// Bereiche: ein Panel je Bereich, je Reiter 2 × 2 in Erscheinensfolge (links oben, rechts oben, links unten, rechts unten);
// die Seiten Stadt und Labor erscheinen mit ihrem ersten angebotenen Bereich (Lieferzonen bzw. Helfer).
Blech<BereichPanel> bereichPanels = [];
für (Bereich b : spiel.BEREICHE) { bereichPanels.hinzu(neu BereichPanel(b)); }
BereichPanel bereichPanel(margherita s) {
    für (BereichPanel p : bereichPanels) { falls (p.b.schlüssel == s) { serviere (p); } }
    serviere (karton);
}
Reihe bereichSeite(margherita id, Blech<margherita> vier) {
    serviere (seite(id,
        spalte(id + "-links", [bereichPanel(vier.stück(1)).teil, bereichPanel(vier.stück(3)).teil]),
        spalte(id + "-rechts", [bereichPanel(vier.stück(2)).teil, bereichPanel(vier.stück(4)).teil])));
}
Reihe hof = bereichSeite("seite-hof", ["garten", "weinkeller", "personal", "katze"]);
Reihe stadt = bereichSeite("seite-stadt", ["lieferzonen", "marketing", "stammgaeste", "wettbewerb"]);
Reihe labor = bereichSeite("seite-labor", ["helfer", "labor", "album", "banca"]);
stadt.binde("sichtbar", () -> { zBereiche.wert(); serviere (spiel.istFrei("lieferzonen") || spiel.freischaltbar("lieferzonen")); });
labor.binde("sichtbar", () -> { zBereiche.wert(); serviere (spiel.istFrei("helfer") || spiel.freischaltbar("helfer")); });

ImperiumPanel imperiumPanel = neu ImperiumPanel();
NonnaPanel nonnaPanel = neu NonnaPanel();
SpielePanel spielePanel = neu SpielePanel();
ErfolgePanel erfolgePanel = neu ErfolgePanel();

Reiter reiter = neu Reiter(["🍕 Backstube", "🌱 Hof", "🎲 Spiele", "🏆 Erfolge", "⭐ Imperium", "🏙 Stadt", "🔬 Labor", "📜 Nonna"],
    [backstube, hof, spielePanel.seite_, erfolgePanel.seite_, imperiumPanel.seite_, stadt, labor, nonnaPanel.seite_], id: "reiter");
// Der Reiter-Rückruf ändert nur Zustand: Imperium/Nonna rechnen nur bei offenem Reiter (quelleImperium/quelleNonna)
reiter.beiAenderung((n) -> { zImperiumOffen.setze(n == REITER_IMPERIUM); zNonnaOffen.setze(n == REITER_NONNA); });

// ── Backen, Tastatur ──
leer backe() {
    salami klicksVorher = spiel.klicks;
    spiel.klick();
    nachVerarbeitung();
    falls (spiel.klicks > klicksVorher) {          // Animationen (rein visuell, Theke v3) – gehören in den Rückruf, nie in eine Bindung
        kopf.backen.animiere("huepfen");
        theke.schwebe("+" + spiel.letzterKlick.kompakt(1) + " 🍕", bei: kopf.backen, farbe: "basilikum");
    }
}

// Tastatur (Theke v4): Leertaste backt, in den Minispielen spielt man mit Tasten.
// Die Leertaste ist nie schneller als die Maus: ein Druck = eine Pizza (Wiederholungen beim Festhalten schickt der
// Renderer nicht) und höchstens eine je Schlag der Uhr. Ein Druck klickt nie zusätzlich einen Knopf (K-114: eine Taste,
// ein Empfänger – nach einem Mausklick liegt der Fokus wieder auf der Theke).
salami uhrMs = 0;            // Spielzeit der Uhr in ms (zählt die Takte)
salami leerBeiMs = -1000;    // wann die Leertaste zuletzt gebacken hat
Blech<margherita> ZIFFERN = ["1", "2", "3", "4", "5", "6"];

leer taste(margherita t) {
    falls (ecke.läuft != "" && reiter.gewaehlt() == REITER_SPIELE) { spielTaste(t); serviere; }
    falls (t != "Leertaste" || !kopf.backen.aktiv() || leerBeiMs == uhrMs) { serviere; }
    leerBeiMs = uhrMs;
    backe();
}

leer spielTaste(margherita t) {
    margherita l = ecke.läuft;
    salami z = 0;   // Ziffer 1…6 → Belag bzw. Weg
    für (salami i : [1 .. ZIFFERN.länge()]) { falls (ZIFFERN.stück(i) == t) { z = i; } }
    falls (l == "teig" && t == "Leertaste") { ecke.fange(); }
    sonst falls (l == "bestellung" && z > 0) { ecke.tippe(ecke.BELÄGE.stück(z)); }
    sonst falls (l == "ofen" && t == "Hoch") { ecke.heize(25); }
    sonst falls (l == "ofen" && t == "Runter") { ecke.heize(-25); }
    sonst falls (l == "route" && z > 0) { ecke.nimmRoute(z); }
    sonst { serviere; }
    nachVerarbeitung();
}
Tastatur tasten = neu Tastatur((t) -> { taste(t); }, id: "tasten");

// ── Die Uhr der Backstube ──
// Eine Uhr für alles, 10 Schläge pro Sekunde: Kasse und Balken laufen flüssig. Während eines Minispiels schlägt sie
// im Takt des Spiels (120 bis 500 ms); die Backstube bekommt die verstrichene Zeit in Millisekunden und backt weiter.
// Der Takt-Rückruf ist reine Simulation: Spielecke, Backstube, Rückfrage-Ablauf – kein Wort über die Oberfläche.
salami TAKT_MS = 100;
salami taktMs = TAKT_MS;
Takt takt = neu Takt(100ms, (n) -> {
    salami sekVorher = spiel.sekunden;
    falls (ecke.läuft != "") { ecke.tick(n); }
    uhrMs += n * taktMs;
    spiel.vergehe(n * taktMs);
    salami sek = spiel.sekunden - sekVorher;
    falls (sek > 0) { ecke.nonnaTakt(sek); }        // Spielpartnerin Nonna (Helfer) – nur Zahlen und Texte
    falls (sek > 0 && zFrage.wert() != "") {
        frageRest = frageRest - sek;
        falls (frageRest <= 0) { zFrage.setze(""); }
    }
    nachVerarbeitung();
}, id: "takt");

// Die Uhr schlägt im Takt des laufenden Spiels – bzw. wieder zehnmal je Sekunde (K-117: gleiches Intervall sendet nichts)
leer taktTempo() {
    Dauer schlag = ecke.läuft == "" ? 100ms : ecke.aktuell.schlag;
    taktMs = Mathe.runden(schlag.inMs());
    takt.setzeIntervall(schlag);
}

// ─────────────────────────────── Nach jedem Rückruf ─────────────────────
salami gemeldeteSterne = 0;
salami gemeldeteFilialen = 0;

diavolo erfolgNeu = nein;
leer prüfeErfolge() {
    Blech<Erfolg> neue = offeneErfolge.filtere((e) -> (e.erreicht(spiel)));
    falls (neue.istLeer()) { serviere; }
    offeneErfolge = offeneErfolge.filtere((e) -> (!neue.enthält(e)));
    für (Erfolg e : neue) {
        spiel.erfolge.hinzu(e.name);
        erfolgNeu = ja;
        Bote.sage(("🏆 Erfolg: " + e.name + " – " + e.text));
        spiel.nachricht = "🏆 Erfolg freigeschaltet: " + e.name + "!";
    }
    spiel.versionErfolge++;
}

// Animationen (Theke v3) – im Rückruf, nie in einer Bindung
salami gezeigteEinnahmen = 0;
salami gezeigteTreffer = 0;
diavolo thekeOffen = nein;     // erst nach theke.zeige animieren (sonst W0102)
leer zeigeEffekte() {
    falls (!thekeOffen) { gezeigteEinnahmen = spiel.großeEinnahmen; gezeigteTreffer = spiel.glückstreffer; erfolgNeu = nein; serviere; }
    falls (spiel.großeEinnahmen != gezeigteEinnahmen) { gezeigteEinnahmen = spiel.großeEinnahmen; kopf.kasse.animiere("puls"); }
    falls (spiel.glückstreffer != gezeigteTreffer) { gezeigteTreffer = spiel.glückstreffer; kopf.meldung.animiere("funkeln"); }
    sonst falls (erfolgNeu) { kopf.meldung.animiere("aufpoppen"); }
    erfolgNeu = nein;
}

// Nach jedem Ereignis: Ziel prüfen, Erfolge, Meldungen über wartende Sterne/Filialen, Animationen, Takt-Tempo,
// Zettel aus dem Modell setzen (die Theke rechnet daraus am Synchronisationspunkt alles nach, was sich geändert hat), speichern.
leer nachVerarbeitung() {
    spiel.prüfeZiel();
    prüfeErfolge();
    salami neu_ = spiel.neueSterne();
    // Nur melden, wenn zum ersten Mal Sterne warten oder sich die wartenden verdoppelt haben – nicht bei jedem Takt.
    falls (neu_ <= 0) { gemeldeteSterne = 0; }
    sonst falls (gemeldeteSterne == 0 || neu_ >= gemeldeteSterne * 2) {
        spiel.melde(("⭐ Der Guide Michelin ist da! Im Reiter „Imperium“ " + (neu_ == 1 ? "wartet ein neuer Stern" : "warten " + Spiel.anz(neu_) + " neue Sterne") + "."));
        gemeldeteSterne = neu_;
    }
    salami fil = spiel.neueFilialen();
    falls (fil > 0 && gemeldeteFilialen == 0) {
        spiel.melde(("🏢 Investoren klopfen an: Deine Sterne reichen für eine Franchise-Kette (Reiter „Imperium“)."));
    }
    gemeldeteFilialen = fil;
    zeigeEffekte();
    taktTempo();
    synchronisiere();
    falls (spiel.sekunden - gespeichertBei >= 30 || spiel.sekunden < gespeichertBei) { speichere(); }
}

// Plätze neu belegen – nur hier, also nur nach Klicks (R1); zPlaetze sagt den Bindungen der Plätze Bescheid.
// nachKauf: Käufe (Upgrades, Rezeptseite, Feinkost, Meisterbrief, Freischaltung, Bereiche) ordnen die Backstube-Plätze und
// lassen eine im Takt geschaffte Herausforderung nachrücken.
leer nachKauf() {
    betriebPanel.belegeNeu();
    handwerkPanel.belegeNeu();
    briefPanel.belegeNeu();
    rezeptPanel.belegeNeu();
    nonnaPanel.belegeProben();
    zPlaetze.setze(zPlaetze.wert() + 1);
    nachVerarbeitung();
}
// nachLernen: ein Geheimrezept gelernt – das nächste rückt nach.
leer nachLernen() {
    nonnaPanel.belegeRezepte();
    zPlaetze.setze(zPlaetze.wert() + 1);
    nachVerarbeitung();
}
// nachAufstieg: Neueröffnung, Herausforderung starten/aufgeben, Franchise, Neu anfangen – alles neu belegen.
leer nachAufstieg() {
    betriebPanel.belegeNeu();
    handwerkPanel.belegeNeu();
    briefPanel.belegeNeu();
    rezeptPanel.belegeNeu();
    nonnaPanel.belegeRezepte();
    nonnaPanel.belegeProben();
    zPlaetze.setze(zPlaetze.wert() + 1);
    nachVerarbeitung();
}

// ─────────────────────────────── Los ────────────────────────────────────
Stapel wurzel = neu Stapel([kopf.kasse, kopf.kennzahlen, kopf.knöpfe, kopf.meldung, reiter, takt, tasten], id: "wurzel");
wurzel.stil("abstand", 10);

sortiereErfolge();
nachAufstieg();            // Plätze einmal belegen, Zettel setzen – die Bindungen rechnen vor dem ersten Bild nach
theke.zeige(wurzel);
thekeOffen = ja;
theke.bediene();

speichere();
Bote.sage(("Feierabend! " + Spiel.pizzen(spiel.pizzenAllzeit) + " gebacken, " + spiel.umsatzAllzeit.währung("€", kompakt: ja)
    + " Umsatz, " + spiel.erfolge.länge() + " Erfolge."));
