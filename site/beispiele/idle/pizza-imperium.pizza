kaufmengeReihe.stil("abstand", 6).stil("ausrichtung", "mitte");
kaufmengeReihe.sichtbar(nein);
für (salami m : MENGEN) {
    Knopf k = neu Knopf(m == 0 ? "Max" : m + "×", () -> {
        kaufMenge = m;
        zeichneKaufmenge();
        zeichne();
    }, id: "menge-" + (m == 0 ? "max" : m.alsText()));
    k.stil("breite", 84).hinweis(m == 0 ? "So viele, wie die Kasse hergibt." : (m == 1 ? "Ein Stück pro Klick." : m + " Stück auf einmal – nur, wenn alle bezahlbar sind."));
    mengenKnöpfe.hinzu(k);
    kaufmengeReihe.hinzu(k);
}

