// ═══════════════════════════════════════════════════════════════════════
//  🍕 Pizza-Imperium – ein Idle-Game an der Theke
// ═══════════════════════════════════════════════════════════════════════
//  Klick auf „Pizza backen!“, verkaufe jede Pizza zum echten Rezeptpreis,
//  kaufe Handwerkszeug (mehr Pizzen pro Klick) und baue einen Betrieb auf,
//  der von selbst backt (Pizzen pro Sekunde) – auf Dauer ist der Betrieb
//  das Herz des Imperiums, der Klick nur noch die Prise Salz.
//
//  Der Aufstieg hat vier Ebenen, die aufeinander aufbauen:
//    ⭐ Neueröffnung     – Michelin-Sterne, +10 % auf alles je Stern
//    📜 Geheimrezepte    – Nonnas Talentbaum, bezahlt mit Sternen
//    🏅 Herausforderungen – Läufe unter Auflagen mit Belohnung für immer
//    🏢 Franchise        – Kette gründen: Sterne werden zu Filialen
//
//  Der Spielstand liegt in der Vorratskammer: Beim nächsten Start geht es
//  weiter – und der Betrieb hat in der Zwischenzeit gebacken
//  (mit halber Kraft, höchstens 30 Minuten lang).
//
//  Sprache im Einsatz:
//    • Takt              – die Uhr der Backstube (10 Schläge pro Sekunde, Produktion anteilig)
//    • Pizza + Belag     – Nonnas Rezeptbuch legt Beläge auf, preis() zählt
//    • @Kühlschrank      – Upgrade-Kosten werden nur einmal ausgerechnet
//    • ofen(…) roh       – die Sonderschicht backt, bis das Ofen-Budget leer ist
//    • bestelle/trinkgeld – Großbestellungen kommen nur mit Trinkgeld pünktlich
//    • Zufall            – Ereignisse und perfekte Pizzen
//    • Vorratskammer + Uhr.echt() – Speichern und Offline-Fortschritt
//    • kompakt()/euro(kompakt: ja) – „1,23 Mio. €“
//    • Abschnitt, Reiter, Tabelle, Fortschritt, hinweis – die Theke v2
//    • Takt.setzeIntervall – im Minispiel schlägt die Uhr im Takt des Spiels (120–500 ms)
//
//  🎲 Minispiele für zwischendurch (Teig fangen, Bestellung merken, Ofen
//  halten, Lieferroute): optional, ein Sieg bringt ein paar Sekunden
//  Produktion, danach macht Nonna zwei Minuten Pause.
//
//  Aufbau:  Upgrade · Geheimrezept · Herausforderung · Erfolg
//           · Spiel (Regeln, ohne Oberfläche) · Minispiele (Spielecke)
//           · Zeilen der Oberfläche
//           · Oberfläche · Start
// ═══════════════════════════════════════════════════════════════════════

// ─────────────────────────────── Upgrades ───────────────────────────────
// Ein Upgrade kann man mehrfach kaufen; jedes weitere kostet mehr
// (Betrieb +15 %, Handwerk +40 bzw. +60 % – Klick-Werkzeug ist selten und teuer).
// art: "klick"   – feste Pizzen pro Klick
//      "anteil"  – Prozent der Sekundenproduktion pro Klick
//      "betrieb" – Pizzen pro Sekunde
klasse Upgrade {
    margherita schlüssel;
    margherita symbol;
    margherita name;
    margherita art;
    margherita einheit;
    margherita beschreibung;
    funghi basis;
    funghi wirkung;
    funghi faktor;
    salami anzahl = 0;
    funghi preisJetzt = 0;   // Preis des nächsten Stücks
    margherita zeile = "";   // Beschriftung für die Oberfläche

    Upgrade(margherita s, margherita sym, margherita n, funghi b, funghi w, margherita a, margherita text) {
        schlüssel = s; symbol = sym; name = n; basis = b; wirkung = w; art = a; beschreibung = text;
        faktor = 1.4;
        einheit = "% der Pizzen pro Sekunde je Klick";
        falls (art == "klick") { einheit = w == 1 ? "Pizza pro Klick" : "Pizzen pro Klick"; faktor = 1.6; }
        falls (art == "betrieb") { einheit = "Pizzen pro Sekunde"; faktor = 1.15; }
        setzeAnzahl(0);
    }

    @Kühlschrank(haltbar: 1d)
    funghi kostenBei(salami n) {
        serviere (Mathe.runden(basis * Mathe.potenz(faktor, n)));
    }

    // Preis und Beschriftung ändern sich nur hier.
    leer setzeAnzahl(salami n) {
        anzahl = n;
        preisJetzt = kostenBei(n);
        zeile = symbol + " " + name + (anzahl > 0 ? " ×" + anzahl : "") + " – +" + wirkung.kompakt(2) + " " + einheit;
    }

    funghi gesamt() { serviere (wirkung * anzahl); }

    // Kaufmenge: k Stück kosten genau die Summe der (gerundeten) Einzelpreise – wie k Einzelkäufe.
    funghi kostenFür(salami k) {
        funghi summe = 0;
        für (salami i : [0 .. k - 1]) { summe += kostenBei(anzahl + i); }
        serviere (summe);
    }

    // So viele Stück, wie die Kasse hergibt (höchstens 1000).
    salami maxFür(funghi geld) {
        salami k = 0;
        funghi summe = 0;
        solange (k < 1000) {
            funghi nächster = kostenBei(anzahl + k);
            falls (summe + nächster > geld) { serviere (k); }
            summe += nächster;
            k++;
        }
        serviere (k);
    }
}

// ──────────────────── Nonnas Geheimrezepte (Talentbaum) ─────────────────
// Kosten Michelin-Sterne. Ein ausgegebener Stern bringt keine +10 % mehr –
// dafür wirkt das Rezept bis zur nächsten Franchise-Gründung.
klasse Geheimrezept {
    margherita schlüssel;
    margherita symbol;
    margherita name;
    margherita text;
    salami kosten;
    margherita braucht;     // "" = Wurzel des Baums

    Geheimrezept(margherita s, margherita sym, margherita n, salami k, margherita b, margherita t) {
        schlüssel = s; symbol = sym; name = n; kosten = k; braucht = b; text = t;
    }
}

// ─────────────────────────── Feinkost-Händler ───────────────────────────
// Nimmt den Platz des ausgelesenen Rezeptbuchs ein: Einmal-Käufe gegen Euro, jede Zutat macht jede Pizza teurer.
// Bei jeder Neueröffnung ist das Lager wieder leer.
klasse Feinkost {
    margherita schlüssel;
    margherita symbol;
    margherita name;
    salami plus;
    funghi preis;
    margherita text;

    Feinkost(margherita s, margherita sym, margherita n, salami p, funghi pr, margherita t) {
        schlüssel = s; symbol = sym; name = n; plus = p; preis = pr; text = t;
    }
}

// ─────────────────────────────── Meisterbriefe ──────────────────────────
// Einmal-Käufe gegen Euro: Hat man 10, 25, 50 bzw. 100 Stück eines Gebäudes, gibt es dafür einen
// Meisterbrief – das Gebäude backt dann ×1,25 (je Brief). Bei jeder Neueröffnung verfallen sie.
klasse Meisterbrief {
    margherita schlüssel;   // z. B. "lehrling-25"
    margherita gebäude;
    salami stufe;
    margherita symbol;
    margherita name;
    funghi preis;

    Meisterbrief(Upgrade u, salami st, margherita n) {
        gebäude = u.schlüssel; stufe = st; name = n; symbol = u.symbol;
        schlüssel = u.schlüssel + "-" + st;
        preis = u.kostenBei(st - 1) * 25;   // 25-mal so viel wie das Stück, mit dem man die Stufe erreicht
    }
}

// ─────────────────────────── Herausforderungen ──────────────────────────
// Ein Lauf unter Auflagen: beginnt wie eine Neueröffnung, Ziel ist Umsatz in
// dieser Runde. Geschafft → Belohnung für immer (auch nach Franchise).
klasse Herausforderung {
    margherita schlüssel;
    margherita symbol;
    margherita name;
    margherita regel;
    margherita belohnung;
    funghi ziel;
    salami abFilialen = 0;   // zweite Staffel: erst mit einer Franchise-Kette

    Herausforderung(margherita s, margherita sym, margherita n, funghi z, margherita r, margherita b) {
        schlüssel = s; symbol = sym; name = n; ziel = z; regel = r; belohnung = b;
    }

    Herausforderung abKette() { abFilialen = 1; serviere (dies); }
}

// ─────────────────────────────── Erfolge ────────────────────────────────
klasse Erfolg {
    margherita name;
    margherita text;
    Funktion bedingung;     // (Spiel s) -> diavolo

    Erfolg(margherita n, margherita t, Funktion b) { name = n; text = t; bedingung = b; }
    diavolo erreicht(Spiel s) { serviere (bedingung.rufe(s)); }
}

// ─────────────────────────────── Das Spiel ──────────────────────────────
// Kennt keine Oberfläche: rechnet nur und schreibt die letzte Neuigkeit in `nachricht`.
// Zeit zählt in Sekunden (Takt-Schlägen).
klasse Spiel {
    // Kasse & Statistik: diese Runde / seit Eröffnung der ersten Pizzeria
    funghi geld = 0;
    funghi pizzen = 0;
    funghi umsatz = 0;
    funghi umsatzKlick = 0;          // davon durch Klicken (diese Runde)
    funghi pizzenAllzeit = 0;
    funghi umsatzAllzeit = 0;
    funghi umsatzKlickAllzeit = 0;
    funghi umsatzKette = 0;          // seit der letzten Franchise-Gründung (zählt für Sterne)
    salami klicks = 0;
    salami sekunden = 0;
    salami hawaiiBekehrt = 0;
    salami pünktlich = 0;
    salami sonderschichten = 0;
    salami perfekte = 0;
    salami kritikerBesuche = 0;
    salami größterKauf = 0;          // meiste Stück auf einmal
    salami offlineBoni = 0;          // so oft hat der Betrieb ohne dich gebacken
    salami regentage = 0;
    Blech<margherita> erfolge = [];
    margherita nachricht = "Willkommen in deiner Trattoria! Klick auf „Pizza backen!“.";

    // Aufstieg
    salami sterne = 0;               // aktive Sterne (+10 % je Stern)
    salami sterneVergeben = 0;       // in dieser Kette verliehen, auch die ausgegebenen
    salami sterneAllzeit = 0;
    salami neueröffnungen = 0;
    salami filialen = 0;             // Franchise: +200 % auf alles je Filiale (zusammen mit den Sternen, nicht mal)
    salami franchises = 0;
    Blech<margherita> talente = [];  // gelernte Geheimrezepte
    Blech<margherita> geschafft = [];// bestandene Herausforderungen
    margherita modus = "";           // laufende Herausforderung

    // Minispiele (die Regeln stehen in der Spielecke, hier nur Pause, Statistik und Belohnung)
    salami minispielPause = 0;       // Sekunden, bis Nonna wieder mitspielt
    salami minispieleGespielt = 0;
    salami minispieleGewonnen = 0;
    Blech<margherita> minispielSiege = [];   // welche Minispiele schon einmal gewonnen wurden
    Speisekarte<margherita, salami> siegeJe = neu Speisekarte<margherita, salami>();   // Siege je Grundspiel (Meister-Varianten zählen mit)
    funghi umsatzMini = 0;           // durch Minispiele (diese Runde)
    funghi umsatzMiniAllzeit = 0;

    Blech<Upgrade> handwerk = [
        neu Upgrade("teigschaber", "🥄", "Teigschaber", 100, 1, "klick",
            "Kratzt den letzten Rest Teig aus der Schüssel."),
        neu Upgrade("nudelholz", "🪵", "Nudelholz aus Olivenholz", 2_500, 2, "klick",
            "Von Nonnas Olivenbaum. Rollt praktisch von allein."),
        neu Upgrade("kurier", "🚲", "Fahrradkurier", 40_000, 0.05, "anteil",
            "Fährt bei jedem Wetter – und bringt Großbestellungen 1 € Trinkgeld."),
        neu Upgrade("tarantella", "🎵", "Tarantella-Rhythmus", 1_500_000, 0.05, "anteil",
            "Wer im Takt knetet, knetet doppelt."),
        neu Upgrade("roboter", "🦾", "Pizza-Roboter Pietro", 80_000_000, 0.05, "anteil",
            "Pietro wirft den Teig bis an die Decke. Fängt ihn meistens."),
        neu Upgrade("vesuv", "🌋", "Glut vom Vesuv", 5_000_000_000, 0.05, "anteil",
            "Echte Vulkanglut. Der Ofen ist in 90 Sekunden heiß – na ja, in 9.")
    ];
    Blech<Upgrade> betrieb = [
        neu Upgrade("lehrling", "🧑‍🍳", "Pizzaiolo-Lehrling", 50, 0.5, "betrieb",
            "Backt alle zwei Sekunden eine Pizza. Mit Liebe."),
        neu Upgrade("steinofen", "🧱", "Steinofen", 600, 4, "betrieb",
            "Jeder Steinofen macht auch die Sonderschicht 20 °C heißer."),
        neu Upgrade("roller", "🛵", "Lieferroller", 7_000, 18, "betrieb",
            "Liefert bis an die Haustür – und bringt Großbestellungen 1 € Trinkgeld."),
        neu Upgrade("foodtruck", "🚚", "Foodtruck", 25_000, 40, "betrieb",
            "Parkt immer genau vor der Konkurrenz."),
        neu Upgrade("wuppertal", "🏪", "Filiale in Wuppertal", 80_000, 80, "betrieb",
            "Mit Blick auf die Schwebebahn."),
        neu Upgrade("teigfabrik", "🏭", "Teigfabrik", 1_000_000, 360, "betrieb",
            "Zwölf Tonnen Teig am Tag. Nonna ist skeptisch."),
        neu Upgrade("satellit", "🛰️", "Pizza-Satellit", 12_000_000, 1_600, "betrieb",
            "Liefert per Fallschirm. Die Pizza kommt warm an (Wiedereintritt)."),
        neu Upgrade("mond", "🌙", "Pizzeria auf dem Mond", 170_000_000, 7_000, "betrieb",
            "Geringe Schwerkraft – perfekt für luftigen Teig."),
        neu Upgrade("zentrale", "🏢", "Franchise-Zentrale", 2_500_000_000, 30_000, "betrieb",
            "Gibt es erst ab der ersten Franchise-Filiale. Steuert die ganze Kette."),
        // Ab hier geht es nur mit der Kette weiter (jedes Gebäude erscheint erst, wenn das vorige gekauft ist).
        neu Upgrade("saturn", "🪐", "Saturnring-Lieferdienst", 35_000_000_000, 130_000, "betrieb",
            "Die Ringe sind aus Parmesan. Behauptet jedenfalls die Werbung."),
        neu Upgrade("wurmloch", "🕳️", "Wurmloch-Lieferung", 500_000_000_000, 600_000, "betrieb",
            "Die Pizza kommt an, bevor sie bestellt wurde. Das Trinkgeld leider auch."),
        neu Upgrade("galaxie", "🌌", "Galaktische Pizzakette", 7_000_000_000_000, 2_800_000, "betrieb",
            "Milchstraße? Mozzarellastraße."),
        neu Upgrade("zeitmaschine", "⏳", "Nonnas Zeitmaschine", 100_000_000_000_000, 13_000_000, "betrieb",
            "Holt Rezepte direkt aus dem Jahr 1890 – original!"),
        neu Upgrade("multiversum", "🍕", "Pizza-Multiversum", 1_500_000_000_000_000, 60_000_000, "betrieb",
            "In jedem Universum eine Pizzeria. In keinem gibt es Ananas.")
    ];

    // Fünf Ketten (🔥 Ofen, 🫙 Teig, 🎉 Gäste, 🧦 Nonna, 🎲 Spiel): Jedes Rezept braucht das vorige seiner Kette.
    // Sichtbar sind nur die drei billigsten offenen (Welle), gelernte verschwinden.
    // Meisterbriefe: je Gebäude (Reihenfolge wie `betrieb`) vier Namen für 10, 25, 50, 100 Stück.
    Blech<salami> BRIEF_STUFEN = [10, 25, 50, 100];
    Blech<Blech<margherita>> BRIEF_NAMEN = [
        ["Kochmützen für alle", "Gesellenprüfung", "Meisterbrief mit Goldrand", "Lehrlingsgewerkschaft"],
        ["Schamottsteine", "Ofenkacheln aus Neapel", "Pizzaschaufel aus Kirschholz", "Ofensegen vom Pfarrer"],
        ["Warmhaltebox", "Vespa-Tuning", "Navi mit Nonna-Stimme", "Blaulicht (inoffiziell)"],
        ["Lichterkette", "Stammplatz beim Stadtfest", "Holzofen im Truck", "Foodtruck-Rennen"],
        ["Schwebebahn-Lieferung", "Elberfelder Teigwerk", "Barmer Margherita", "Ehrenbürgerschaft"],
        ["Fließband", "Teigroboter", "24/7-Schicht", "Mehlsilo „Nonna I“"],
        ["Hitzeschild", "Fallschirm mit Basilikum-Muster", "Umlaufbahn über Neapel", "Zweiter Satellit (heimlich)"],
        ["Mondkäse (endlich echt)", "Krater-Ofen", "Schwerelos-Teig", "Mondbasis „Margherita“"],
        ["Excel-Tabelle", "Franchise-Handbuch", "Hauptversammlung im Ofen", "Börsengang (WKN: PIZZA)"],
        ["Parmesan-Ringe (echt jetzt)", "Tomaten vom Titan", "Ringförmige Pizza", "Saturntag ist Pizzatag"],
        ["Rückwärts-Lieferschein", "Pünktlich gestern", "Paradoxon-Pizza", "Lieferung in alle Zeiten"],
        ["Sternenstaub-Oregano", "Schwarzes-Loch-Ofen", "Galaktisches Rezeptbuch", "Gipfeltreffen der Pizzaxien"],
        ["Nonna von 1890 zu Besuch", "Teig von morgen", "Gleichzeitig backen", "Nonna trifft Nonna"],
        ["Universum ohne Ananas", "Unendlich viele Nonnas", "Pizza mit allem", "Das Ende der Speisekarte"]
    ];
    Blech<Meisterbrief> ALLE_BRIEFE = [];
    Blech<margherita> briefe = [];   // gekaufte Meisterbriefe (Schlüssel) – verfallen bei jeder Neueröffnung

    Blech<Feinkost> HÄNDLER_WAREN = [
        neu Feinkost("sanmarzano", "🍅", "San-Marzano-Tomaten", 15, 300_000_000_000, "Am Vesuv gereift. Nonna erkennt sie am Duft."),
        neu Feinkost("tipo00", "🌾", "Mehl Tipo 00", 15, 1_800_000_000_000, "So fein, dass es beim Öffnen der Tüte schwebt."),
        neu Feinkost("büffel", "🐃", "Büffelmozzarella aus Kampanien", 20, 10_800_000_000_000, "Die Büffel heißen Gina, Bruno und Signora Rossi."),
        neu Feinkost("olivenöl", "🫒", "Olivenöl extra vergine", 10, 64_800_000_000_000, "Kaltgepresst, warm empfohlen."),
        neu Feinkost("genua", "🌿", "Basilikum aus Genua", 10, 388_800_000_000_000, "Mit Herkunftsnachweis und eigenem Fanclub."),
        neu Feinkost("trapani", "🧂", "Meersalz aus Trapani", 5, 2_332_800_000_000_000, "Nonna sagt: Das schmeckt man. Luigi schmeckt es nicht."),
        neu Feinkost("trüffel", "🍄", "Weißer Trüffel aus Alba", 50, 14_000_000_000_000_000, "Wird mit dem Hobel serviert und mit Leibwächter geliefert.")
    ];
    Blech<margherita> feinkost = [];   // im Lager (Schlüssel) – leer nach jeder Neueröffnung

    Spiel() {
        für (salami i : [1 .. betrieb.länge()]) {
            Upgrade u = betrieb.stück(i);
            für (salami j : [1 .. BRIEF_STUFEN.länge()]) {
                ALLE_BRIEFE.hinzu(neu Meisterbrief(u, BRIEF_STUFEN.stück(j), BRIEF_NAMEN.stück(i).stück(j)));
            }
        }
    }

    Blech<Geheimrezept> REZEPTE = [
        neu Geheimrezept("holzofen", "🔥", "Holzofen-Glut", 1, "", "Der ganze Betrieb backt +50 %."),
        neu Geheimrezept("sauerteig", "🫙", "Sauerteig von 1890", 1, "", "Jede Pizza bringt 20 % mehr."),
        neu Geheimrezept("stammgäste", "🎉", "Stammgäste", 2, "", "Ereignisse kommen doppelt so oft, Hawaii-Gäste und Großbestellungen bringen doppelt so viel."),
        neu Geheimrezept("sparstrumpf", "🧦", "Nonnas Sparstrumpf", 2, "", "Jede Neueröffnung beginnt mit 10 Lehrlingen und 5 Steinöfen."),
        neu Geheimrezept("gedächtnis", "📖", "Nonnas Gedächtnis", 3, "sauerteig", "Das Rezeptbuch bleibt bei Neueröffnungen aufgeschlagen."),
        neu Geheimrezept("kartenspiel", "🃏", "Nonnas Kartenspiel", 3, "", "Nonna mogelt beim Scopa – die Minispiel-Pause dauert nur 90 statt 120 Sekunden."),
        neu Geheimrezept("lavastein", "🌋", "Lavastein-Ofen", 4, "holzofen", "Die Sonderschicht backt doppelt so lange und kühlt in 45 statt 120 Sekunden ab."),
        neu Geheimrezept("mundpropaganda", "🗣", "Mundpropaganda", 4, "stammgäste", "Die halbe Stadt hilft beim Ausliefern: Großbestellungen kommen immer pünktlich."),
        neu Geheimrezept("erbstück", "💍", "Nonnas Erbstück", 5, "sparstrumpf", "Jede Neueröffnung beginnt zusätzlich mit 10 Lieferrollern und der Filiale in Wuppertal."),
        neu Geheimrezept("langteig", "⏳", "72-Stunden-Teig", 6, "gedächtnis", "Drei Tage Gehzeit: Jede Pizza bringt 30 % mehr."),
        neu Geheimrezept("diplomatie", "🍍", "Hawaii-Diplomatie", 6, "mundpropaganda", "Bekehrte Hawaii-Gäste bestellen dreimal so viel."),
        neu Geheimrezept("glückspilz", "🍀", "Glückspilz", 6, "kartenspiel", "Jede dreiunddreißigste Pizza wird perfekt (3 % statt 2 %)."),
        neu Geheimrezept("vesuvkamin", "🏔", "Vesuv-Kamin", 7, "lavastein", "Der Ofen glüht sofort mit vollen 485 °C – auch ohne einen einzigen Steinofen."),
        neu Geheimrezept("familienbetrieb", "👪", "Familienbetrieb", 8, "erbstück", "Die Familie backt mit, während du weg bist: drei Viertel statt halber Kraft (weiterhin höchstens 30 Minuten)."),
        neu Geheimrezept("freitagslegende", "🕺", "Freitags-Legende", 9, "diplomatie", "Der Freitagabend-Ansturm dauert 60 statt 30 Sekunden."),
        neu Geheimrezept("mutterhefe", "🧫", "Mutterhefe aus Neapel", 10, "langteig", "Seit 1890 gefüttert, nie ausgegangen: Jede Pizza bringt 50 % mehr."),
        neu Geheimrezept("abo", "🎟", "Spielecken-Abo", 10, "glückspilz", "Minispiel-Siege bringen 50 % mehr."),
        neu Geheimrezept("ewigeglut", "♨", "Ewige Glut", 11, "vesuvkamin", "Der Ofen kühlt nie richtig ab: Nach der Sonderschicht ist er in 20 Sekunden wieder bereit."),
        neu Geheimrezept("segen", "🙌", "Nonnas Segen", 12, "familienbetrieb", "Jeder aktive Michelin-Stern bringt +12 % statt +10 %."),
        neu Geheimrezept("kultstatus", "🌟", "Kultstatus", 14, "freitagslegende", "Die Pizzeria ist Kult: Alle Ereignis-Boni (Hawaii-Gäste, Großbestellungen) zählen doppelt."),
        neu Geheimrezept("seele", "💛", "Teig mit Seele", 15, "mutterhefe", "Eine perfekte Pizza zählt 25-fach statt 10-fach."),
        neu Geheimrezept("ofenflüsterer", "🔮", "Ofenflüsterer", 16, "ewigeglut", "Du hörst, was der Ofen will: Der ganze Betrieb backt +100 %.")
    ];

    Blech<Herausforderung> HERAUSFORDERUNGEN = [
        neu Herausforderung("neapel", "🔥", "Neapel-Modus", 5_000_000,
            "Nur Holzofen: Im Betrieb backen ausschließlich Lehrlinge und Steinöfen.",
            "Lehrlinge und Steinöfen backen für immer dreifach."),
        neu Herausforderung("hawaii", "🍍", "Hawaii-Verbot verschärft", 1_000_000_000,
            "Nonna traut keinem Belag mehr: Rezeptbuch gesperrt, nur Margherita – und Hawaii-Gäste fliegen raus.",
            "Jede Pizza bringt für immer 25 % mehr."),
        neu Herausforderung("fastenzeit", "🙏", "Fastenzeit", 5_000_000_000,
            "Kein Klicken, keine Sonderschicht, keine Feste, keine Minispiele: Nur der Betrieb backt, Ereignisse fallen aus. 3 Lehrlinge helfen beim Start.",
            "Der ganze Betrieb backt für immer +25 %."),
        // Zweite Staffel – ab der ersten Franchise-Kette
        neu Herausforderung("inflation", "💸", "Inflation", 200_000_000_000,
            "Der Großhändler spinnt: Alle Upgrades kosten das Dreifache.",
            "Alle Upgrades kosten für immer 10 % weniger.").abKette(),
        neu Herausforderung("minikueche", "🤏", "Mini-Küche", 1_000_000_000_000,
            "Das Bauamt hat Nein gesagt: höchstens 25 Stück je Gebäude.",
            "Der ganze Betrieb backt für immer +50 %.").abKette(),
        neu Herausforderung("urlaub", "🏖", "Nonna im Urlaub", 5_000_000_000_000,
            "Nonna ist auf Ischia und hat ihre Geheimrezepte mitgenommen: Keins wirkt.",
            "Geheimrezepte kosten für immer 10 % weniger.").abKette()
    ];

    // Nonnas Rezeptbuch: jede Seite legt einen Belag auf die Margherita.
    Pizza rezept = ((Tomate, Mozzarella, Basilikum));
    salami seite = 0;
    Blech<Belag> SEITEN = [Salami, Pilze, Oliven, Parmesan, Rucola, Gorgonzola, Artischocken, Knoblauch];
    Blech<funghi> SEITEN_KOSTEN = [800, 15_000, 250_000, 4_000_000, 60_000_000, 900_000_000, 12_000_000_000, 150_000_000_000];

    // Ereignisse und Ofen (in Sekunden)
    margherita effekt = "";
    salami effektRest = 0;
    funghi freitagPizzen = 0;
    salami bisEreignis = 60;
    salami ofenKühlt = 0;

    // ── Kennzahlen ── zwischengespeichert; neuBerechnen() nach jeder Änderung an
    // Upgrades, Rezept, Sternen, Talenten, Modus oder Effekt. `version` sagt der Oberfläche: alles neu zeichnen.
    funghi klickWert = 1;
    funghi sekundeWert = 0;
    funghi preisWert = 8;
    salami version = 0;

    // gelernt: Nonna hat es verraten. kennt: es wirkt (im Urlaub wirkt keins).
    diavolo gelernt(margherita talent) { serviere (talente.enthält(talent)); }
    diavolo kennt(margherita talent) { serviere (modus != "urlaub" && talente.enthält(talent)); }
    diavolo bestanden(margherita h) { serviere (geschafft.enthält(h)); }

    salami prozentJeStern() { serviere (kennt("segen") ? 12 : 10); }

    // Alles-Faktor: (1 + Sterne-Bonus + Filialen-Bonus) × Freitagabend. Sterne und Filialen zählen ZUSAMMEN statt
    // miteinander mal genommen – sonst schaukeln sie sich gegenseitig hoch (Schneeball: Millionen Sterne nach kurzer Zeit).
    salami PROZENT_JE_FILIALE = 200;
    salami FRANCHISE_AB = 100;       // Sterne in der laufenden Kette, ab denen man eine Kette gründen kann
    funghi faktor() {
        serviere ((1 + sterne * prozentJeStern() / 100 + filialen * PROZENT_JE_FILIALE / 100) * (effekt == "freitag" ? 3 : 1));
    }

    leer neuBerechnen() {
        funghi f = faktor();
        funghi fb = f * (bestanden("minikueche") ? 1.5 : 1) * (effekt == "regen" ? 2 : 1) * (effekt == "influencer" ? 1.5 : 1) * (kennt("holzofen") ? 1.5 : 1) * (kennt("ofenflüsterer") ? 2 : 1) * (bestanden("fastenzeit") ? 1.25 : 1);
        funghi s = 0;
        für (Upgrade u : betrieb) {
            diavolo holzofen = u.schlüssel == "lehrling" || u.schlüssel == "steinofen";
            s = s + u.gesamt() * (holzofen && bestanden("neapel") ? 3 : 1) * briefFaktor(u.schlüssel);
        }
        sekundeWert = s * fb;
        // Klick: ein paar feste Pizzen (mit Sternen/Filialen) + ein kleiner Anteil der Sekundenproduktion
        funghi fest = 1;
        funghi anteil = 0;
        für (Upgrade u : handwerk) {
            falls (u.art == "klick") { fest = fest + u.gesamt(); } sonst { anteil = anteil + u.gesamt(); }
        }
        klickWert = (fest * f + anteil / 100 * sekundeWert) * (effekt == "fussball" ? 5 : 1) * (effekt == "tenor" ? 3 : 1);
        preisWert = rezept.preis() * (kennt("sauerteig") ? 1.2 : 1) * (kennt("langteig") ? 1.3 : 1) * (kennt("mutterhefe") ? 1.5 : 1)
            * (bestanden("hawaii") ? 1.25 : 1) * (effekt == "kritiker" ? 2 : 1) * feinkostFaktor();
        version++;
    }

    funghi preis() { serviere (preisWert); }
    funghi proKlick() { serviere (klickWert); }
    funghi proSekunde() { serviere (sekundeWert); }

    // Für Boni: eine „Portion“ ist ein Klick oder eine Sekunde Betrieb – was mehr ist.
    funghi portion() { serviere (Mathe.max(proKlick(), proSekunde())); }

    Upgrade finde(margherita schlüssel) {
        für (Upgrade u : handwerk) { falls (u.schlüssel == schlüssel) { serviere (u); } }
        für (Upgrade u : betrieb) { falls (u.schlüssel == schlüssel) { serviere (u); } }
        serviere (karton);
    }

    salami anzahl(margherita schlüssel) { serviere (finde(schlüssel).anzahl); }

    salami trinkgeld() { serviere (anzahl("kurier") + anzahl("roller")); }
    // Mehr als 485 °C verträgt kein Ofen (sonst VerbranntAnanas) – der Vesuv-Kamin heizt sofort bis an die Grenze.
    salami ofenTemperatur() { serviere (kennt("vesuvkamin") ? 485 : Mathe.min(485, 250 + 20 * anzahl("steinofen") + 10 * sterne)); }

    margherita rezeptName() {
        Blech<margherita> b = rezept.beläge();
        falls (b.länge() <= 3) { serviere ("Margherita"); }
        Blech<margherita> extra = [];
        für (salami i : [4 .. b.länge()]) { extra.hinzu(b.stück(i)); }
        serviere ("Margherita mit " + extra.verbinde(", "));
    }

    // Große Anzahlen lesbar: bis 999.999 mit Tausenderpunkten, darüber kompakt („5,61 Mio.“).
    tiefkühl margherita anz(funghi x) {
        serviere (x < 1_000_000 ? x.tausender() : x.kompakt(2));
    }

    tiefkühl margherita pizzen(funghi x) {
        serviere (x.kompakt(1) + (x == 1 ? " Pizza" : " Pizzen"));
    }

    // ── Backen & Verkaufen ──
    funghi backe(funghi n) {
        pizzen += n;
        pizzenAllzeit += n;
        funghi erlös = n * preis();
        geld += erlös;
        umsatz += erlös;
        umsatzAllzeit += erlös;
        umsatzKette += erlös;
        falls (effekt == "freitag") { freitagPizzen += n; }
        serviere (erlös);
    }

    leer melde(margherita text) {
        nachricht = text;
        Bote.sage((text));
    }

    diavolo darfKlicken() { serviere (modus != "fastenzeit"); }

    leer klick() {
        falls (!darfKlicken()) { serviere; }
        klicks++;
        funghi n = proKlick();
        // Glückstreffer: jede fünfzigste Pizza wird perfekt – und zählt zehnfach.
        falls (Zufall.wahr(kennt("glückspilz") ? 0.03 : 0.02)) {
            perfekte++;
            n = n * (kennt("seele") ? 25 : 10);
            nachricht = "✨ Perfekte Pizza! Der Rand ist ein Gedicht: " + pizzen(n) + " auf einmal.";
        }
        funghi erlös = backe(n);
        umsatzKlick += erlös;
        umsatzKlickAllzeit += erlös;
    }

    // Takt: `ms` Millisekunden sind vergangen (10 Schläge pro Sekunde; mehr, wenn der Renderer nachholt).
    // Der Betrieb backt anteilig (Rate × Zeit, Bruchteile von Pizzen zählen mit – nichts geht durch Runden verloren);
    // die Uhren (Ereignisse, Effekte, Ofen, Nonnas Pause) laufen in ganzen Sekunden. Holt der Renderer viel auf einmal
    // nach, wird Sekunde für Sekunde gerechnet – ein Freitagabend wirkt also genau 30 Sekunden lang.
    salami msInSekunde = 0;          // Bruchteil der laufenden Sekunde
    leer vergehe(salami ms) {
        salami rest = ms;
        solange (rest > 0) {
            salami schritt = Mathe.min(rest, 1000 - msInSekunde);
            backe(proSekunde() * schritt / 1000);
            msInSekunde += schritt;
            rest -= schritt;
            falls (msInSekunde >= 1000) {
                msInSekunde = 0;
                sekunden++;
                falls (minispielPause > 0) { minispielPause--; }
                ticke(1);
            }
        }
    }

    leer ticke(salami n) {
        falls (ofenKühlt > 0) { ofenKühlt = Mathe.max(0, ofenKühlt - n); }
        falls (effekt != "") {
            effektRest = effektRest - n;
            falls (effektRest <= 0) { beendeEffekt(); }
            serviere;
        }
        bisEreignis = bisEreignis - n;
        falls (bisEreignis <= 0) {
            falls (modus != "fastenzeit") { ereignis(); }   // Fastenzeit: keine Feste
            bisEreignis = kennt("stammgäste") ? Zufall.zahl(30, 75) : Zufall.zahl(60, 150);
        }
    }

    // ── Ereignisse ──
    // Der Topf wächst: Neue Ereignisse kommen erst dazu, wenn ihre Bedingung erfüllt ist.
    Blech<margherita> ereignisTopf() {
        Blech<margherita> topf = ["freitag", "fussball", "hawaii", "großbestellung"];
        falls (sterneAllzeit >= 1) { topf.hinzu("kritiker"); }
        falls (anzahl("roller") >= 10) { topf.hinzu("regen"); }
        falls (neueröffnungen >= 1) { topf.hinzu("geburtstag"); }
        falls (anzahl("wuppertal") >= 1) { topf.hinzu("influencer"); }
        falls (hawaiiBekehrt >= 3) { topf.hinzu("schmuggler"); }
        falls (anzahl("foodtruck") >= 1) { topf.hinzu("tenor"); }
        serviere (topf);
    }

    leer ereignis() {
        margherita welches = Zufall.wähle(ereignisTopf());
        falls (welches == "kritiker") {
            effekt = "kritiker"; effektRest = 30; kritikerBesuche++;
            melde(("🧐 Ein Restaurantkritiker sitzt an Tisch 4! 30 Sekunden lang bringt jede Pizza das Doppelte – Luigi poliert die Teller."));
        } sonst falls (welches == "regen") {
            effekt = "regen"; effektRest = 45; regentage++;
            melde(("🌧 Regentag! Niemand will raus, alle bestellen Lieferung: 45 Sekunden lang backt der Betrieb doppelt."));
        } sonst falls (welches == "geburtstag") {
            funghi bonus = portion() * 30;
            backe(bonus);
            melde(("🎂 Nonna hat Geburtstag und lässt es sich nicht nehmen, selbst zu backen: " + pizzen(bonus) + ". Tanti auguri!"));
        } sonst falls (welches == "influencer") {
            effekt = "influencer"; effektRest = 60;
            melde(("📱 Eine Food-Influencerin postet deine Margherita (#pizzaporn – Nonna versteht es nicht): 60 Sekunden lang backt der Betrieb +50 %."));
        } sonst falls (welches == "schmuggler") {
            funghi bonus = portion() * 10;
            backe(bonus);
            melde(("🍍 Ananas-Schmuggler erwischt! Nonna konfisziert zwölf Kisten und verkauft sie an die Konkurrenz: Gegenwert " + pizzen(bonus) + "."));
        } sonst falls (welches == "tenor") {
            effekt = "tenor"; effektRest = 20;
            melde(("🎤 Ein Tenor singt „O sole mio“ im Lokal – 20 Sekunden lang knetet jeder im Takt: Klicks bringen das Dreifache."));
        } sonst falls (welches == "freitag") {
            effekt = "freitag"; effektRest = kennt("freitagslegende") ? 60 : 30; freitagPizzen = 0;
            melde(("🎉 Freitagabend-Ansturm! " + effektRest + " Sekunden lang backt alles dreifach."));
        } sonst falls (welches == "fussball") {
            effekt = "fussball"; effektRest = 20;
            melde(("⚽ Fußballabend! 20 Sekunden lang backt jeder Klick fünfmal so viel."));
        } sonst falls (welches == "hawaii") {
            hawaii();
        } sonst {
            großbestellung();
        }
        neuBerechnen();
    }

    leer beendeEffekt() {
        falls (effekt == "freitag") {
            melde(("Der Freitagabend ist vorbei: " + pizzen(freitagPizzen) + " in der Rushhour."));
        } sonst falls (effekt == "kritiker") {
            melde(("Der Kritiker zahlt, nickt und geht. Morgen steht es in der Zeitung."));
        } sonst falls (effekt == "regen") {
            melde(("Die Sonne kommt raus – die Roller dürfen verschnaufen."));
        } sonst falls (effekt == "influencer") {
            melde(("Der Hashtag ist abgekühlt. Nonna hat inzwischen 12 Follower."));
        } sonst falls (effekt == "tenor") {
            melde(("Bravo! Der Tenor verbeugt sich und bestellt eine Quattro Stagioni."));
        } sonst {
            melde(("Abpfiff. Die Fans gehen satt nach Hause."));
        }
        effekt = "";
        effektRest = 0;
        neuBerechnen();
    }

    salami gästeFaktor() { serviere ((kennt("stammgäste") ? 2 : 1) * (kennt("kultstatus") ? 2 : 1)); }

    leer hawaii() {
        falls (modus == "hawaii") {
            melde(("🍍 Hawaii-Verbot verschärft: Luigi zeigt dem Gast freundlich, aber bestimmt die Tür. Nonna nickt."));
            serviere;
        }
        hawaiiBekehrt++;
        funghi bonus = portion() * 5 * gästeFaktor() * (kennt("diplomatie") ? 3 : 1);
        backe(bonus);
        melde(("🍍 Ein Gast bestellt Pizza Hawaii. Luigi lächelt, schweigt und serviert eine Margherita aufs Haus. "
            + "Der Gast ist bekehrt und bestellt " + pizzen(bonus) + "!"));
    }

    // Lieferung mit Trinkgeld: Mehr Kuriere/Roller → mehr Trinkgeld → größeres Budget → pünktlich.
    leer großbestellung() {
        salami bleche = Zufall.zahl(10, 40);
        salami tg = trinkgeld();
        Lieferung<salami> l = bestelle(() -> {
            salami fertig = 0;
            für (salami i : [1 .. bleche]) { fertig++; }
            serviere (fertig);
        });
        l.trinkgeld(tg);
        Zustellung<salami> z = l.warte(max: 40ms);
        falls (z.pünktlich() || kennt("mundpropaganda")) {
            pünktlich++;
            funghi bonus = bleche * portion() * gästeFaktor();
            backe(bonus);
            margherita wie = kennt("mundpropaganda") ? "dank Mundpropaganda" : (tg == 0 ? "auch ohne Trinkgeld" : "dank " + tg + " € Trinkgeld");
            melde(("📦 Großbestellung über " + bleche + " Bleche – " + wie + " pünktlich geliefert: +"
                + (bonus * preis()).euro(kompakt: ja) + "."));
        } sonst {
            melde(("📦 Großbestellung über " + bleche + " Bleche – leider zu spät, die Pizza ist kalt. "
                + "Mehr Kuriere und Roller bringen mehr Trinkgeld."));
        }
    }

    // Minispiel gewonnen: so viele Pizzen, wie in `sek` Sekunden gebacken werden (bzw. ein Klick, wenn der mehr bringt).
    funghi minispielGewinn(salami sek) {
        funghi n = portion() * sek * (kennt("abo") ? 1.5 : 1);
        funghi erlös = backe(n);
        umsatzMini += erlös;
        umsatzMiniAllzeit += erlös;
        serviere (n);
    }

    // ── Aktionen der Spielerin ──
    // Preisfaktor für Upgrades (Inflation ×3, Belohnung −10 %)
    funghi preisFaktor() { serviere ((modus == "inflation" ? 3 : 1) * (bestanden("inflation") ? 0.9 : 1)); }
    // So viele Stück darf man noch kaufen (Mini-Küche: höchstens 25 je Gebäude)
    salami kaufGrenze(Upgrade u) { serviere (modus == "minikueche" && u.art == "betrieb" ? Mathe.max(0, 25 - u.anzahl) : 1000); }

    diavolo erlaubt(Upgrade u) {
        falls (u.schlüssel == "zentrale" && filialen <= 0) { serviere (nein); }
        falls (kaufGrenze(u) <= 0) { serviere (nein); }
        falls (modus == "neapel" && u.art == "betrieb") { serviere (u.schlüssel == "lehrling" || u.schlüssel == "steinofen"); }
        serviere (ja);
    }

    // k Stück auf einmal (Kaufmenge 1×/10×/100×/Max) – nur ganz oder gar nicht.
    diavolo kaufe(Upgrade u, salami k) {
        falls (k < 1 || !erlaubt(u) || k > kaufGrenze(u)) { serviere (nein); }
        funghi summe = u.kostenFür(k) * preisFaktor();
        falls (geld < summe) { serviere (nein); }
        geld -= summe;
        u.setzeAnzahl(u.anzahl + k);
        falls (k > größterKauf) { größterKauf = k; }
        nachricht = u.symbol + " " + u.name + (k > 1 ? " ×" + k : "") + " gekauft (jetzt " + u.anzahl + ").";
        neuBerechnen();
        serviere (ja);
    }

    diavolo rezeptFertig() { serviere (seite >= SEITEN.länge()); }
    diavolo rezeptGesperrt() { serviere (modus == "hawaii"); }
    funghi seitenKosten() { serviere (rezeptFertig() ? 0 : SEITEN_KOSTEN.stück(seite + 1)); }

    diavolo blättere() {
        falls (rezeptGesperrt() || rezeptFertig() || geld < seitenKosten()) { serviere (nein); }
        geld -= seitenKosten();
        seite++;
        Belag b = SEITEN.stück(seite);
        rezept = rezept + b;
        neuBerechnen();
        melde(("📖 Nonna verrät Seite " + seite + ": " + b + "! Eine Pizza kostet jetzt " + preis().euro() + "."
            + (rezeptFertig() ? " Das Rezeptbuch ist ausgelesen – Nonna legt es zurück in die Schublade. Grazie, Nonna!" : "")));
        serviere (ja);
    }

    diavolo ofenBereit() { serviere (ofenKühlt <= 0 && modus != "fastenzeit"); }

    // Sonderschicht: Der Ofen backt Ladung um Ladung, bis sein Zeitbudget aufgebraucht ist.
    // Heißer (mehr Steinöfen, mehr Sterne) = größeres Budget = mehr Ladungen.
    leer sonderschicht() {
        falls (!ofenBereit()) { serviere; }
        salami grad = Mathe.min(485, ofenTemperatur());     // mehr verträgt kein Ofen (sonst VerbranntAnanas)
        salami ladungen = 0;
        probier {
            ladungen = ofen(temperatur: grad, zeit: 100ms * (kennt("lavastein") ? 2 : 1)) {
                salami n = 0;
                solange (ja) { n++; zwischenstand((n)); }
            } roh (r) {
                serviere (r.teilergebnis());
            };
        } verbrannt (a) {
            // Absicherung: Eine Ananas aus dem Ofen darf nie das Spiel beenden.
            ofenKühlt = 120;
            melde(("🔥 Der Ofen hat gestreikt (" + a + ") – Nonna lüftet, in zwei Minuten geht es weiter."));
            serviere;
        }
        sonderschichten++;
        ofenKühlt = kennt("ewigeglut") ? 20 : (kennt("lavastein") ? 45 : 120);
        funghi bonus = ladungen * portion();
        backe(bonus);
        melde(("🔥 Sonderschicht bei " + grad + " °C: " + ladungen + " Ofenladungen, " + pizzen(bonus) + "."));
    }

    // ── Feinkost ──
    funghi feinkostFaktor() {
        funghi f = 1;
        für (Feinkost k : HÄNDLER_WAREN) { falls (feinkost.enthält(k.schlüssel)) { f = f * (1 + k.plus / 100); } }
        serviere (f);
    }
    diavolo feinkostOffen() { serviere (rezeptFertig() && !rezeptGesperrt()); }
    // Welle: höchstens zwei Angebote, in der Reihenfolge der Liste
    Blech<Feinkost> feinkostAngebot() {
        Blech<Feinkost> welle = [];
        für (Feinkost k : HÄNDLER_WAREN) { falls (welle.länge() < 2 && !feinkost.enthält(k.schlüssel)) { welle.hinzu(k); } }
        serviere (welle);
    }
    diavolo kaufeFeinkost(Feinkost k) {
        falls (k == karton || !feinkostOffen() || feinkost.enthält(k.schlüssel) || geld < k.preis) { serviere (nein); }
        geld -= k.preis;
        feinkost.hinzu(k.schlüssel);
        neuBerechnen();
        melde(("🧀 Frisch vom Feinkost-Händler: " + k.symbol + " " + k.name + " – jede Pizza bringt " + k.plus + " % mehr. Eine Pizza kostet jetzt "
            + preis().euro() + "."));
        serviere (ja);
    }

    // ── Meisterbriefe ──
    funghi briefFaktor(margherita gebäude) {
        funghi f = 1;
        für (margherita b : briefe) { falls (b.beginntMit(gebäude + "-")) { f = f * 1.25; } }
        serviere (f);
    }

    // Welle: höchstens WELLE_BRIEFE offene (Stufe erreicht, noch nicht gekauft) – die billigsten zuerst.
    salami WELLE_BRIEFE = 3;
    Blech<Meisterbrief> offeneBriefe() {
        Blech<Meisterbrief> offen = ALLE_BRIEFE.filtere((b) -> (!briefe.enthält(b.schlüssel) && anzahl(b.gebäude) >= b.stufe))
            .sortiere((a, b) -> (a.preis < b.preis ? -1 : (a.preis > b.preis ? 1 : 0)));
        Blech<Meisterbrief> welle = [];
        für (Meisterbrief b : offen) { falls (welle.länge() < WELLE_BRIEFE) { welle.hinzu(b); } }
        serviere (welle);
    }

    diavolo kaufeBrief(Meisterbrief b) {
        falls (b == karton || briefe.enthält(b.schlüssel) || anzahl(b.gebäude) < b.stufe || geld < b.preis) { serviere (nein); }
        geld -= b.preis;
        briefe.hinzu(b.schlüssel);
        neuBerechnen();
        nachricht = "🎓 Meisterbrief „" + b.name + "“: " + b.symbol + " " + finde(b.gebäude).name + " backt jetzt ×"
            + briefFaktor(b.gebäude).kompakt(2) + ".";
        serviere (ja);
    }

    // ── Ebene 1: Neueröffnung (Michelin-Sterne) ──
    // Bis 100 Sterne: ⌊√(Umsatz der Kette / 1 Mio. €)⌋ (1 Stern ab 1 Mio. €, 10 ab 100 Mio. €, 100 ab 10 Mrd. €).
    // Darüber wird es steiler – ⌊100 · ⁴√(Umsatz / 10 Mrd. €)⌋: 200 Sterne ab 160 Mrd. €, 1.000 ab 100 Bio. €,
    // 10.000 ab 1 Trio. € –, sonst schaukeln sich Sterne und Filialen gegenseitig hoch (Schneeball).
    salami STEIL_AB = 100;
    salami sterneFür(funghi umsatz) {
        funghi x = umsatz / 1_000_000;
        falls (x <= STEIL_AB * STEIL_AB) { serviere (Mathe.boden(Mathe.wurzel(x))); }
        serviere (Mathe.boden(STEIL_AB * Mathe.wurzel(Mathe.wurzel(x / (STEIL_AB * STEIL_AB))) + 0.000001));
    }
    salami sterneVerdient() { serviere (sterneFür(umsatzKette)); }
    salami neueSterne() { serviere (Mathe.max(0, sterneVerdient() - sterneVergeben)); }
    funghi sternSchwelle(salami n) {
        falls (n <= STEIL_AB) { serviere (n * n * 1_000_000); }
        funghi q = n / STEIL_AB;
        serviere (STEIL_AB * STEIL_AB * 1_000_000 * q * q * q * q);
    }
    funghi nächsterStern() { serviere (sternSchwelle(sterneVerdient() + 1)); }
    // Anteil des Wegs vom letzten zum nächsten Stern (für den Balken)
    funghi sternFortschritt() {
        funghi von = sternSchwelle(sterneVerdient());
        serviere (Mathe.min(1, (umsatzKette - von) / (nächsterStern() - von)));
    }

    salami vergebeSterne() {
        salami n = neueSterne();
        sterne += n; sterneVergeben += n; sterneAllzeit += n;
        serviere (n);
    }

    leer setzeRundeZurück() {
        geld = 0; pizzen = 0; umsatz = 0; umsatzKlick = 0; umsatzMini = 0;
        briefe = [];
        feinkost = [];
        für (Upgrade u : handwerk) { u.setzeAnzahl(0); }
        für (Upgrade u : betrieb) { u.setzeAnzahl(0); }
        falls (kennt("sparstrumpf")) {
            finde("lehrling").setzeAnzahl(10);
            finde("steinofen").setzeAnzahl(5);
        }
        falls (kennt("erbstück")) {
            finde("roller").setzeAnzahl(10);
            finde("wuppertal").setzeAnzahl(1);
        }
        falls (!kennt("gedächtnis")) {
            rezept = ((Tomate, Mozzarella, Basilikum));
            seite = 0;
        }
        modus = "";
        effekt = ""; effektRest = 0; freitagPizzen = 0; ofenKühlt = 0; bisEreignis = 60;
    }

    diavolo neueröffnung() {
        falls (neueSterne() <= 0) { serviere (nein); }
        margherita abbruch = modus != "" ? " Die Herausforderung ist damit beendet." : "";
        salami neu_ = vergebeSterne();
        neueröffnungen++;
        setzeRundeZurück();
        neuBerechnen();
        melde(("⭐ Neueröffnung! Der Guide Michelin vergibt " + anz(neu_) + (neu_ == 1 ? " Stern" : " Sterne")
            + " – jetzt " + anz(sterne) + " aktiv, also +" + anz(sterne * prozentJeStern()) + " % auf alles." + abbruch));
        serviere (ja);
    }

    // ── Ebene 2: Geheimrezepte ──
    diavolo rezepteOffen() { serviere (sterneAllzeit >= 1); }
    diavolo lernbar(Geheimrezept r) {
        serviere (rezepteOffen() && sterne >= rezeptKosten(r) && offeneRezepte().enthält(r));
    }
    // Jedes gelernte Rezept macht die nächsten 40 % teurer (Nonna wird anspruchsvoller): das 10. kostet ≈ 20-mal,
    // das 22. ≈ 1.000-mal so viel wie sein Grundpreis. Nonna im Urlaub (geschafft): 10 % Rabatt.
    salami rezeptKosten(Geheimrezept r) {
        funghi k = r.kosten * Mathe.potenz(1.4, talente.länge()) * (bestanden("urlaub") ? 0.9 : 1);
        serviere (Mathe.max(1, Mathe.runden(k)));
    }
    Geheimrezept rezeptNamens(margherita s) {
        für (Geheimrezept r : REZEPTE) { falls (r.schlüssel == s) { serviere (r); } }
        serviere (karton);
    }

    // Welle: höchstens WELLE_REZEPTE offene Rezepte (Voraussetzung erfüllt, noch nicht gelernt) – die billigsten zuerst.
    // Gelernte verschwinden, das nächste Glied rückt nach.
    salami WELLE_REZEPTE = 3;
    Blech<Geheimrezept> offeneRezepte() {
        Blech<Geheimrezept> offen = REZEPTE.filtere((r) -> (!gelernt(r.schlüssel) && (r.braucht == "" || gelernt(r.braucht))))
            .sortiere((a, b) -> (a.kosten - b.kosten));
        Blech<Geheimrezept> welle = [];
        für (Geheimrezept r : offen) { falls (welle.länge() < WELLE_REZEPTE) { welle.hinzu(r); } }
        serviere (welle);
    }

    diavolo lerne(Geheimrezept r) {
        falls (!lernbar(r)) { serviere (nein); }
        sterne -= rezeptKosten(r);
        talente.hinzu(r.schlüssel);
        neuBerechnen();
        melde(("📜 Nonna flüstert dir ein Geheimnis zu: " + r.symbol + " " + r.name + ". " + r.text));
        serviere (ja);
    }

    // ── Ebene 3: Herausforderungen ──
    diavolo herausforderungenOffen() { serviere (sterneAllzeit >= 3); }
    Herausforderung herausforderung(margherita s) {
        für (Herausforderung h : HERAUSFORDERUNGEN) { falls (h.schlüssel == s) { serviere (h); } }
        serviere (karton);
    }

    diavolo staffelOffen(Herausforderung h) { serviere (herausforderungenOffen() && filialen >= h.abFilialen); }

    // Welle: höchstens 2 offene Herausforderungen (die laufende zählt mit), Geschafftes klappt in eine Zeile.
    Blech<Herausforderung> offeneHerausforderungen() {
        Blech<Herausforderung> welle = [];
        falls (modus != "") { welle.hinzu(herausforderung(modus)); }
        für (Herausforderung h : HERAUSFORDERUNGEN) {
            falls (welle.länge() < 2 && h.schlüssel != modus && staffelOffen(h) && !bestanden(h.schlüssel)) { welle.hinzu(h); }
        }
        serviere (welle);
    }

    diavolo startbar(Herausforderung h) {
        serviere (staffelOffen(h) && modus == "" && !bestanden(h.schlüssel) && offeneHerausforderungen().enthält(h));
    }

    diavolo starte(Herausforderung h) {
        falls (!startbar(h)) { serviere (nein); }
        salami neu_ = vergebeSterne();
        falls (neu_ > 0) { neueröffnungen++; }
        setzeRundeZurück();
        modus = h.schlüssel;
        falls (modus == "neapel") {      // nur Holzofen – Nonnas Erbstück bleibt im Keller
            für (Upgrade u : betrieb) { falls (!erlaubt(u)) { u.setzeAnzahl(0); } }
        }
        falls (modus == "hawaii") {      // nur Margherita – auch mit Nonnas Gedächtnis
            rezept = ((Tomate, Mozzarella, Basilikum));
            seite = 0;
        }
        falls (modus == "fastenzeit") {
            Upgrade l = finde("lehrling");
            l.setzeAnzahl(Mathe.max(l.anzahl, 3));
        }
        neuBerechnen();
        melde((h.symbol + " Herausforderung „" + h.name + "“ beginnt" + (neu_ > 0 ? " (+" + anz(neu_) + " ⭐)" : "") + ": " + h.regel
            + " Ziel: " + h.ziel.euro(kompakt: ja) + " Umsatz."));
        serviere (ja);
    }

    leer gibAuf() {
        falls (modus == "") { serviere; }
        Herausforderung h = herausforderung(modus);
        modus = "";
        neuBerechnen();
        melde(("🏳 " + h.name + " aufgegeben. Die Runde geht ohne Auflagen weiter."));
    }

    funghi zielFortschritt() {
        falls (modus == "") { serviere (0); }
        serviere (Mathe.min(1, umsatz / herausforderung(modus).ziel));
    }

    leer prüfeZiel() {
        falls (modus == "") { serviere; }
        Herausforderung h = herausforderung(modus);
        falls (umsatz < h.ziel) { serviere; }
        geschafft.hinzu(h.schlüssel);
        modus = "";
        neuBerechnen();
        melde(("🏅 Herausforderung „" + h.name + "“ geschafft! Belohnung für immer: " + h.belohnung));
    }

    // ── Ebene 4: Franchise ──
    // Filialen insgesamt = ⌊√(Sterne insgesamt ÷ 2,5)⌋: 100 Sterne → 6, 160 → 8, 250 → 10, 1.000 → 20 …
    // Gründen geht erst ab FRANCHISE_AB (100) Sternen in der laufenden Kette und nur, wenn es mindestens eine neue Filiale gibt.
    salami sterneKette() { serviere (sterneVergeben + neueSterne()); }
    salami filialenFür(salami s) { serviere (Mathe.boden(Mathe.wurzel(s / 2.5))); }
    salami neueFilialen() {
        falls (sterneKette() < FRANCHISE_AB) { serviere (0); }
        serviere (Mathe.max(0, filialenFür(sterneAllzeit + neueSterne()) - filialen));
    }
    // Sterne insgesamt, ab denen es die nächste Filiale gibt
    salami sterneFürFiliale(salami f) { serviere (Mathe.decke(f * f * 2.5)); }

    diavolo franchise() {
        falls (neueFilialen() <= 0) { serviere (nein); }
        salami n = neueFilialen();
        vergebeSterne();
        filialen += n; franchises++;
        sterne = 0; sterneVergeben = 0; umsatzKette = 0;
        talente = [];
        setzeRundeZurück();
        neuBerechnen();
        melde(("🏢 Die Kette ist gegründet! " + anz(n) + " neue Filialen – jetzt " + anz(filialen) + ", also +" + anz(filialen * PROZENT_JE_FILIALE)
            + " % auf alles. Sterne und Geheimrezepte fangen von vorn an, die Franchise-Zentrale ist freigeschaltet."));
        serviere (ja);
    }

    // Alles auf Anfang – auch Sterne, Filialen, Erfolge und Statistik.
    leer allesZurück() {
        talente = [];
        setzeRundeZurück();
        pizzenAllzeit = 0; umsatzAllzeit = 0; umsatzKlickAllzeit = 0; umsatzKette = 0; klicks = 0; sekunden = 0;
        sterne = 0; sterneVergeben = 0; sterneAllzeit = 0; neueröffnungen = 0; filialen = 0; franchises = 0;
        hawaiiBekehrt = 0; pünktlich = 0; sonderschichten = 0; perfekte = 0; kritikerBesuche = 0; regentage = 0;
        größterKauf = 0; offlineBoni = 0;
        minispielPause = 0; minispieleGespielt = 0; minispieleGewonnen = 0; minispielSiege = []; umsatzMiniAllzeit = 0;
        siegeJe = neu Speisekarte<margherita, salami>();
        erfolge = []; geschafft = [];
        neuBerechnen();
        nachricht = "Frischer Teig, leere Kasse – auf ein Neues!";
    }

    // ── Spielstand (für die Vorratskammer) ──
    Speisekarte<margherita, Vorrat> alsSpeisekarte() {
        Speisekarte<margherita, Vorrat> s = neu Speisekarte<margherita, Vorrat>();
        s.lege("version", 5).lege("zeit", Uhr.echt().inMs());
        s.lege("geld", geld).lege("pizzen", pizzen).lege("umsatz", umsatz).lege("umsatzKlick", umsatzKlick);
        s.lege("pizzenAllzeit", pizzenAllzeit).lege("umsatzAllzeit", umsatzAllzeit);
        s.lege("umsatzKlickAllzeit", umsatzKlickAllzeit).lege("umsatzKette", umsatzKette);
        s.lege("klicks", klicks).lege("sekunden", sekunden).lege("sterne", sterne).lege("neueröffnungen", neueröffnungen);
        s.lege("sterneVergeben", sterneVergeben).lege("sterneAllzeit", sterneAllzeit);
        s.lege("filialen", filialen).lege("franchises", franchises);
        s.lege("talente", talente).lege("geschafft", geschafft).lege("modus", modus);
        s.lege("hawaiiBekehrt", hawaiiBekehrt).lege("pünktlich", pünktlich).lege("sonderschichten", sonderschichten);
        s.lege("perfekte", perfekte).lege("seite", seite).lege("erfolge", erfolge);
        s.lege("minispielPause", minispielPause).lege("minispieleGespielt", minispieleGespielt);
        s.lege("minispieleGewonnen", minispieleGewonnen).lege("minispielSiege", minispielSiege).lege("siegeJe", siegeJe);
        s.lege("umsatzMini", umsatzMini).lege("umsatzMiniAllzeit", umsatzMiniAllzeit);
        s.lege("feinkost", feinkost);
        s.lege("briefe", briefe).lege("kritikerBesuche", kritikerBesuche).lege("regentage", regentage);
        s.lege("größterKauf", größterKauf).lege("offlineBoni", offlineBoni);
        Speisekarte<margherita, salami> stück = neu Speisekarte<margherita, salami>();
        für (Upgrade u : handwerk) { stück.lege(u.schlüssel, u.anzahl); }
        für (Upgrade u : betrieb) { stück.lege(u.schlüssel, u.anzahl); }
        s.lege("upgrades", stück);
        serviere (s);
    }

    // Ältere Spielstände (version 2 bis 4) kennen manche Felder nicht – hole(k, ersatz) liefert dann den Standardwert.
    leer ladeAus(Speisekarte<margherita, Vorrat> s) {
        geld = s.hole("geld", 0); pizzen = s.hole("pizzen", 0); umsatz = s.hole("umsatz", 0);
        umsatzKlick = s.hole("umsatzKlick", 0);
        pizzenAllzeit = s.hole("pizzenAllzeit", 0); umsatzAllzeit = s.hole("umsatzAllzeit", 0);
        umsatzKlickAllzeit = s.hole("umsatzKlickAllzeit", 0);
        umsatzKette = s.hole("umsatzKette", umsatzAllzeit);
        klicks = s.hole("klicks", 0); sekunden = s.hole("sekunden", 0);
        sterne = s.hole("sterne", 0); neueröffnungen = s.hole("neueröffnungen", 0);
        sterneVergeben = s.hole("sterneVergeben", sterne); sterneAllzeit = s.hole("sterneAllzeit", sterne);
        filialen = s.hole("filialen", 0); franchises = s.hole("franchises", 0);
        talente = s.hole("talente", []); geschafft = s.hole("geschafft", []);
        modus = s.hole("modus", "");
        hawaiiBekehrt = s.hole("hawaiiBekehrt", 0); pünktlich = s.hole("pünktlich", 0);
        sonderschichten = s.hole("sonderschichten", 0); perfekte = s.hole("perfekte", 0);
        erfolge = s.hole("erfolge", []);
        minispielPause = s.hole("minispielPause", 0); minispieleGespielt = s.hole("minispieleGespielt", 0);
        minispieleGewonnen = s.hole("minispieleGewonnen", 0); minispielSiege = s.hole("minispielSiege", []);
        siegeJe = s.hole("siegeJe", neu Speisekarte<margherita, salami>());
        umsatzMini = s.hole("umsatzMini", 0); umsatzMiniAllzeit = s.hole("umsatzMiniAllzeit", 0);
        briefe = s.hole("briefe", []);
        feinkost = s.hole("feinkost", []);
        kritikerBesuche = s.hole("kritikerBesuche", 0); regentage = s.hole("regentage", 0);
        größterKauf = s.hole("größterKauf", 0); offlineBoni = s.hole("offlineBoni", 0);
        Speisekarte<margherita, salami> stück = s.hole("upgrades", neu Speisekarte<margherita, salami>());
        für (Upgrade u : handwerk) { u.setzeAnzahl(stück.hole(u.schlüssel, 0)); }
        für (Upgrade u : betrieb) { u.setzeAnzahl(stück.hole(u.schlüssel, 0)); }
        rezept = ((Tomate, Mozzarella, Basilikum));
        seite = 0;
        salami ziel = Mathe.min(s.hole("seite", 0), SEITEN.länge());
        solange (seite < ziel) { seite++; rezept = rezept + SEITEN.stück(seite); }
        neuBerechnen();
        nachricht = "Willkommen zurück! Dein Imperium hat auf dich gewartet.";

        // Offline-Fortschritt: Der Betrieb backt weiter – mit halber Kraft (Familienbetrieb: drei Viertel), höchstens 30 Minuten lang.
        salami weg = Mathe.boden((Uhr.echt().inMs() - s.hole("zeit", Uhr.echt().inMs())) / 1000);
        salami gezählt = Mathe.min(weg, 30 * 60);
        minispielPause = Mathe.max(0, minispielPause - Mathe.max(0, weg));   // Nonnas Pause läuft auch offline ab
        diavolo familie = kennt("familienbetrieb");
        funghi nachts = proSekunde() * gezählt * (familie ? 0.75 : 0.5);
        falls (gezählt >= 60 && nachts > 0) {
            backe(nachts);
            offlineBoni++;
            melde(("🌙 Während du weg warst (" + (1min * Mathe.boden(weg / 60)) + (weg > gezählt ? " – gezählt werden höchstens 30min" : "")
                + "), hat dein Betrieb mit " + (familie ? "drei Vierteln" : "halber") + " Kraft " + pizzen(nachts) + " gebacken: +" + (nachts * preis()).euro(kompakt: ja) + "."));
        }
    }
}

// ─────────────────────────────── Minispiele ─────────────────────────────
// Kurz und freiwillig: Ein Sieg bringt so viele Pizzen, wie der Betrieb in ein
// paar Sekunden backt. Danach macht Nonna zwei Minuten Pause (für alle Spiele
// gemeinsam) – so bleibt der Betrieb das Herz des Imperiums.
klasse Minispiel {
    margherita schlüssel;
    margherita symbol;
    margherita name;
    margherita regel;
    salami belohnung;       // Sekunden Produktion
    Dauer schlag;           // so schnell schlägt die Uhr während des Spiels
    margherita art;         // Grundspiel ("teig", …) – bei der Meister-Variante das Spiel, das sie ersetzt
    diavolo meister = nein;

    Minispiel(margherita s, margherita sym, margherita n, salami b, Dauer d, margherita r) {
        schlüssel = s; symbol = sym; name = n; belohnung = b; schlag = d; regel = r; art = s;
    }

    // Meister-Variante: ersetzt das Grundspiel, sobald es dreimal gewonnen wurde.
    Minispiel ersetzt(margherita grund) { art = grund; meister = ja; serviere (dies); }
}

// Die Spielecke kennt keine Oberfläche: Sie rechnet, schreibt `status` und meldet
// Sieg oder Niederlage über das Spiel. Die Spieluhr ruft tick(n).
klasse Spielecke {
    Spiel s;
    salami PAUSE = 120;
    Blech<Minispiel> SPIELE = [
        neu Minispiel("teig", "🫓", "Teig fangen", 8, 150ms,
            "Luigi wirft den Teig in die Luft – fang ihn, wenn 🫓 über dem grünen Feld ▬▬▬ schwebt."),
        neu Minispiel("bestellung", "🧾", "Bestellung merken", 10, 500ms,
            "Ein Gast diktiert vier Beläge. Merk sie dir drei Sekunden lang und klick sie in der richtigen Reihenfolge nach."),
        neu Minispiel("ofen", "🌡", "Ofen halten", 10, 500ms,
            "Der Ofen kühlt ständig ab. Halte ihn 10 Sekunden zwischen 380 und 440 °C – mindestens 7 Sekunden müssen sitzen."),
        neu Minispiel("route", "🛵", "Lieferroute", 8, 500ms,
            "Drei Wege zum Kunden: Wähle binnen 10 Sekunden den schnellsten. Fahrzeit: 2 min je km, 1 min je Ampel, 4 min je Staustufe."),
        // Meister-Varianten (nach drei Siegen im Grundspiel)
        neu Minispiel("teig2", "🌀", "Pizzaiolo-Wurf", 12, 120ms,
            "Luigi wirft höher und schneller – das grüne Feld ▬▬ ist nur noch zwei Felder breit.").ersetzt("teig"),
        neu Minispiel("bestellung2", "👨‍👩‍👧‍👦", "Großfamilie", 13, 500ms,
            "Die ganze Familie bestellt: sechs Beläge, vier Sekunden zum Merken, zwanzig zum Nachklicken.").ersetzt("bestellung"),
        neu Minispiel("ofen2", "🌋", "Lavastein-Ofen", 13, 500ms,
            "Lavastein kühlt schneller ab: Halte 400 bis 430 °C – mindestens 7 von 10 Sekunden.").ersetzt("ofen"),
        neu Minispiel("route2", "🚦", "Rushhour", 12, 500ms,
            "Feierabendverkehr: Vier Wege, mehr Ampeln, mehr Stau – wähle binnen 10 Sekunden den schnellsten.").ersetzt("route")
    ];
    salami MEISTER_AB = 3;   // so viele Siege im Grundspiel, bis die Meister-Variante es ersetzt
    Blech<margherita> BELÄGE = ["🍅 Tomate", "🧀 Mozzarella", "🍄 Pilze", "🫒 Oliven", "🍕 Salami", "🌿 Basilikum"];
    Blech<margherita> STRASSEN = ["Via Roma", "Lungomare", "Corso Garibaldi", "Vicolo Stretto", "Ponte Vecchio", "Piazza Dante"];
    Blech<margherita> STAU = ["🟢 frei", "🟡 zäh", "🔴 Stau"];

    margherita läuft = "";      // Grundspiel des laufenden Spiels ("" = keins) – Meister-Varianten laufen unter dem Grundspiel
    Minispiel aktuell = karton; // das laufende Spiel (Grund- oder Meister-Variante)
    diavolo meister = nein;
    salami zielMin = 380;       // Ofen halten
    salami zielMax = 440;
    margherita status = "";
    salami ticks = 0;
    // Teig fangen: der Zeiger pendelt über 21 Felder, das Ziel ist 3 Felder breit
    salami zone = 0;
    // Bestellung merken
    Blech<margherita> folge = [];
    salami geraten = 0;
    diavolo zeigt = nein;
    // Ofen halten
    salami grad = 0;
    salami imZiel = 0;
    // Lieferroute (Fahrzeit in Zehntelminuten – ganzzahlig, damit Gleichstand exakt ist)
    Blech<margherita> wege = [];
    Blech<margherita> routen = [];
    Blech<salami> fahrzeit = [];

    Spielecke(Spiel sp) { s = sp; }

    Minispiel spielNamens(margherita k) {
        für (Minispiel m : SPIELE) { falls (m.schlüssel == k) { serviere (m); } }
        serviere (karton);
    }
    diavolo erlaubt() { serviere (s.modus != "fastenzeit"); }
    diavolo bereit() { serviere (läuft == "" && s.minispielPause <= 0 && erlaubt()); }
    Dauer intervall() { serviere (läuft == "" ? 500ms : aktuell.schlag); }

    // Welle: Ein Grundspiel weicht nach MEISTER_AB Siegen seiner Meister-Variante.
    diavolo sichtbar(Minispiel m) {
        salami siege = s.siegeJe.hole(m.art, 0);
        serviere (m.meister ? siege >= MEISTER_AB : siege < MEISTER_AB);
    }

    diavolo starte(margherita schlüssel) {
        falls (!bereit()) { serviere (nein); }
        Minispiel m = spielNamens(schlüssel);
        falls (m == karton || !sichtbar(m)) { serviere (nein); }
        aktuell = m;
        meister = m.meister;
        margherita k = m.art;
        läuft = k;
        ticks = 0;
        falls (k == "teig") {
            zone = Zufall.zahl(6, 15);
            status = "Klick auf „Fangen!“, wenn 🫓 über dem grünen Feld " + (meister ? "▬▬" : "▬▬▬") + " schwebt.";
        } sonst falls (k == "bestellung") {
            folge = [];
            für (salami i : [1 .. (meister ? 6 : 4)]) { folge.hinzu(Zufall.wähle(BELÄGE)); }
            geraten = 0;
            zeigt = ja;
            status = "Merk dir die Bestellung – gleich ist sie weg!";
        } sonst falls (k == "ofen") {
            grad = meister ? 415 : 410;
            imZiel = 0;
            zielMin = meister ? 400 : 380;
            zielMax = meister ? 430 : 440;
            status = "Ziel: " + zielMin + " bis " + zielMax + " °C. Holz nachlegen heizt um 25 °C, Klappe auf kühlt um 25 °C.";
        } sonst {
            Blech<margherita> namen = Zufall.mische(STRASSEN);
            wege = []; routen = []; fahrzeit = [];
            für (salami i : [1 .. (meister ? 4 : 3)]) {
                salami zehntel = Zufall.zahl(15, 60);   // 1,5 bis 6 km
                salami ampeln = Zufall.zahl(0, meister ? 9 : 6);
                salami stau = Zufall.zahl(0, 2);
                wege.hinzu(namen.stück(i));
                fahrzeit.hinzu(zehntel * 2 + ampeln * 10 + stau * 40);
                routen.hinzu(namen.stück(i) + ": " + (zehntel / 10).kompakt(1) + " km · " + ampeln + " 🚦 · " + STAU.stück(stau + 1));
            }
            status = "Fahrzeit: 2 min je km, 1 min je Ampel, 4 min je Staustufe (🟡 1, 🔴 2).";
        }
        serviere (ja);
    }

    // ── Teig fangen ──
    salami zeiger() {
        salami p = ticks % 40;
        serviere (p <= 20 ? p : 40 - p);
    }
    diavolo imZiel(salami i) { serviere (i >= zone && i <= zone + (meister ? 1 : 2)); }
    diavolo imFeld() { serviere (imZiel(zeiger())); }
    // Was auf Feld i (0…20) der Bahn zu sehen ist
    margherita feld(salami i) { serviere (i == zeiger() ? "🫓" : (imZiel(i) ? "▬" : "·")); }
    leer fange() {
        falls (läuft != "teig") { serviere; }
        falls (imFeld()) { gewinne("Gefangen! Luigi applaudiert, der Boden wird hauchdünn."); }
        sonst { verliere("Daneben – der Teig klebt an der Decke."); }
    }

    // ── Bestellung merken ──
    leer tippe(margherita b) {
        falls (läuft != "bestellung" || zeigt) { serviere; }
        falls (folge.stück(geraten + 1) != b) {
            verliere("Falsch – der Gast wollte " + folge.verbinde(", ") + ".");
            serviere;
        }
        geraten++;
        falls (geraten >= folge.länge()) { gewinne("Genau so bestellt! Der Gast ist begeistert."); }
        sonst { status = "Richtig! Noch " + (folge.länge() - geraten) + " Beläge."; }
    }
    margherita bestellungText() {
        falls (zeigt) { serviere (folge.verbinde(" → ")); }
        Blech<margherita> teile = [];
        für (salami i : [1 .. folge.länge()]) { teile.hinzu(i <= geraten ? folge.stück(i) : "❓"); }
        serviere (teile.verbinde(" → "));
    }

    // ── Ofen halten ──
    leer heize(salami d) {
        falls (läuft != "ofen") { serviere; }
        grad = Mathe.max(250, Mathe.min(485, grad + d));
    }
    diavolo ofenImZiel() { serviere (grad >= zielMin && grad <= zielMax); }

    // ── Lieferroute ──
    leer nimmRoute(salami i) {
        falls (läuft != "route") { serviere; }
        falls (i > fahrzeit.länge()) { serviere; }
        salami beste = fahrzeit.zusammenklappen((a, b) -> (Mathe.min(a, b)));
        margherita weg = wege.stück(i);
        falls (fahrzeit.stück(i) <= beste) {
            gewinne("Über " + weg + " in " + (fahrzeit.stück(i) / 10).kompakt(1) + " min – schneller geht's nicht!");
        } sonst {
            verliere("Über " + weg + " dauert es " + (fahrzeit.stück(i) / 10).kompakt(1) + " min, der schnellste Weg nur "
                + (beste / 10).kompakt(1) + " min.");
        }
    }

    // Die Spieluhr: n Schläge sind vergangen (n > 1, wenn der Renderer nachholt).
    leer tick(salami n) {
        falls (läuft == "") { serviere; }
        falls (!erlaubt()) {
            läuft = "";
            status = "";
            s.melde(("🎲 Fastenzeit – Nonna räumt die Spiele weg."));
            serviere;
        }
        falls (läuft == "teig") {
            ticks += n;
            falls (ticks >= 80) { verliere("Zu spät – der Teig ist auf dem Boden gelandet."); }
        } sonst falls (läuft == "bestellung") {
            ticks += n;
            falls (zeigt && ticks >= merkTicks()) {
                zeigt = nein;
                ticks = 0;
                status = "Jetzt du: Klick die Beläge in der richtigen Reihenfolge.";
            } sonst falls (!zeigt && ticks >= antwortTicks()) {
                verliere("Zu langsam – der Gast hat sich eine Calzone bestellt.");
            }
        } sonst falls (läuft == "ofen") {
            salami k = Mathe.min(n, 20 - ticks);
            solange (k > 0) {
                k--;
                ticks++;
                grad = Mathe.max(250, Mathe.min(485, grad + (meister ? Zufall.zahl(-20, 8) : Zufall.zahl(-16, 6))));
                falls (ofenImZiel() && ticks % 2 == 0) { imZiel++; }   // gezählt wird jede volle Sekunde
            }
            falls (ticks >= 20) {
                falls (imZiel >= 7) { gewinne("Sauber gehalten – " + imZiel + " von 10 Sekunden im Ziel."); }
                sonst { verliere("Nur " + imZiel + " von 10 Sekunden im Ziel – die Pizza ist ungleichmäßig."); }
            }
        } sonst {
            ticks += n;
            falls (ticks >= 20) { verliere("Zu lange überlegt – der Kunde hat abgesagt."); }
        }
    }

    salami merkTicks() { serviere (meister ? 8 : 6); }       // 4 bzw. 3 Sekunden
    salami antwortTicks() { serviere (meister ? 40 : 30); }  // 20 bzw. 15 Sekunden

    // Wert für den Balken (0…1)
    funghi balken() {
        falls (läuft == "teig") { serviere (zeiger() / 20); }
        falls (läuft == "bestellung") { serviere (zeigt ? 1 - ticks / merkTicks() : 1 - ticks / antwortTicks()); }
        falls (läuft == "ofen") { serviere ((grad - 250) / 235); }
        falls (läuft == "route") { serviere (1 - ticks / 20); }
        serviere (0);
    }

    leer gewinne(margherita text) {
        Minispiel m = aktuell;
        funghi n = s.minispielGewinn(m.belohnung);
        s.minispieleGewonnen++;
        falls (!s.minispielSiege.enthält(m.schlüssel)) { s.minispielSiege.hinzu(m.schlüssel); }
        salami siege = s.siegeJe.hole(m.art, 0) + 1;
        s.siegeJe.lege(m.art, siege);
        beende();
        margherita neu_ = "";
        falls (!m.meister && siege == MEISTER_AB) {
            Minispiel nächstes = SPIELE.filtere((x) -> (x.meister && x.art == m.art)).erstes();
            neu_ = " Nonna ist beeindruckt: Ab jetzt gibt es " + nächstes.symbol + " " + nächstes.name + "!";
        }
        s.melde((m.symbol + " " + m.name + ": " + text + " +" + Spiel.pizzen(n) + " (" + (n * s.preis()).euro(kompakt: ja) + ")." + neu_));
    }

    leer verliere(margherita text) {
        Minispiel m = aktuell;
        beende();
        s.melde((m.symbol + " " + m.name + ": " + text + " Diesmal kein Bonus."));
    }

    leer beende() {
        s.minispieleGespielt++;
        s.minispielPause = s.kennt("kartenspiel") ? 90 : PAUSE;
        läuft = "";
        status = "";
    }
}

// ═══════════════════════════════ Spielstart ═════════════════════════════
Spiel spiel = neu Spiel();
Spielecke ecke = neu Spielecke(spiel);

