// Steuerung: Der Pizzabote läuft mit den Pfeiltasten, springt mit der Leertaste,
// und jeder Mausklick legt ein Basilikumblatt dorthin, wo du klickst.
// Zeigt: taste (gehalten), gedrueckt (gerade gedrückt), klick, mausX/mausY, Bild spiegeln, Animation an/aus.
// Die Bilder sind PNG-Dateien im Ordner bilder/: Bildchen.laden lädt sie, eine Animation blättert durch vier Laufbilder.

Herd herd = neu Herd("Steuerung", breite: 640, hoehe: 360);
herd.bild(Bildchen.laden("bilder/landschaft.png"), 320, 180).setzeEbene(-10);   // Himmel, Wolken, Hügel, Wiese

// Der Bote: 80 × 100 Pixel je Bild, gezeichnet mit groesse 0.5 (40 × 50) – so bleibt er auch vergrößert scharf
Blech<Bildchen> schritte = [Bildchen.laden("bilder/bote-1.png"), Bildchen.laden("bilder/bote-2.png"),
                            Bildchen.laden("bilder/bote-3.png"), Bildchen.laden("bilder/bote-4.png")];
Teil bote = herd.bild(schritte.stück(1), 320, 296, groesse: 0.5);
Animation laufen = bote.mit(neu Animation(bilder: schritte, proSekunde: 10, laeuft: nein));
Bewegung sprung = bote.mit(neu Bewegung());

Teil blatt = herd.bild(Bildchen.laden("bilder/blatt.png"), -50, -50, groesse: 0.5);   // Vorlage für kopie()
Teil info = herd.text("Maus: –", 12, 10, groesse: 18, farbe: "ofen");
salami blaetter = 0;

herd.backe(() -> {
    diavolo links = herd.taste("Links");
    diavolo rechts = herd.taste("Rechts");
    falls (links) { bote.verschiebe(-4, 0); bote.bild().setzeSpiegeln(ja); }
    falls (rechts) { bote.verschiebe(4, 0); bote.bild().setzeSpiegeln(nein); }
    falls ((links || rechts) != laufen.laeuft()) { laufen.setzeLaeuft(links || rechts); }

    // Springen: Tempo nach oben, Schwerkraft zieht zurück; auf dem Boden anhalten
    falls (herd.gedrueckt("Leertaste") && bote.y() >= 296) { sprung.setzeTempoY(-420).setzeBeschleunigungY(1400); }
    falls (bote.y() > 296) { bote.setzeLage(bote.x(), 296); sprung.setzeTempoY(0).setzeBeschleunigungY(0); }

    falls (herd.klick()) {
        blatt.kopie().setzeLage(herd.mausX(), herd.mausY()).setzeDrehung(blaetter * 40);
        blaetter++;
        info.text().setzeInhalt(("Maus: " + herd.mausX() + ", " + herd.mausY() + " – " + blaetter + " Blätter"));
    }
});
Bote.sage(("Der Bote steht bei x = " + bote.x() + ", " + blaetter + " Basilikumblätter liegen herum."));
