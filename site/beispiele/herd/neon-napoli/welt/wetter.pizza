// Nacht, Regen, Dunst: Himmelszelt mit Smog über der Stadt, Stimmung (Belichtung, Bloom, Höhennebel, Vignette, Korn) und
// Regen; das Spiegelbild ist voll (alle Lichter, Schatten, Dampf und Regen in den Pfützen). Dazu der Bildschirmraum: Verdeckung
// dunkelt Ecken, Fugen und die Kanten unter Vordächern ab, die Bildraum-Spiegelung lässt nasse Fliesen, Wellblech, Rolltore und
// Stahl spiegeln, was im Bild zu sehen ist (auf der Straße bleibt das planare Spiegelbild). REGENSTAERKE ist der eine Regler:
// Stimmung.regen lässt Ringe in den Pfützen und Rinnsale an den nassen Wänden laufen,
// und die Funken mit `regen: ja` stoßen rate × regen Tropfen aus. Die Tropfen sind Striche (`streckung` = Belichtungszeit),
// leuchten im Licht der Neonschilder und Laternen (`licht`), fallen in einem Volumen um den Spieler (`volumen`: wer es verlässt,
// kommt auf der anderen Seite wieder herein – so wirken wenige tausend Tropfen wie ein Wolkenbruch). Mit `kollision: "welt"`
// treffen sie alle festen Fühler – Fahrbahn, Gehwege (15 cm höher), Vordächer, Dächer – und spritzen dort auf.
bestellt "zustand.pizza";

funghi REGENSTAERKE = 0.85;
funghi VERDECKUNG = 1.8;
funghi BILDSPIEGEL = 1;
Teil REGEN = baueWetter();

Teil baueWetter() {
    herd.sonne().licht().setzeStaerke(0);
    herd.umgebung("#4a3f78", staerke: 0.07);
    herd.raum(0, 0, 0).mit(neu Himmelszelt(oben: "#05050c", horizont: "#3a2350", boden: "#0b0910", sterne: 0));
    herd.raum(0, 0, 0).mit(neu Stimmung(belichtung: 1.9, bloom: 0.9, bloomSchwelle: 1.1, bloomWeite: 0.75, nebelDichte: 0.035,
                                        nebelHoehe: 0, nebelAbfall: 0.08, nebelFarbe: "#2b2142", saettigung: 1.08,
                                        vignette: 0.32, koernung: 0.12, spiegelung: 1, spiegelHoehe: 0, spiegelGuete: "voll", regen: REGENSTAERKE,
                                        verdeckung: VERDECKUNG, verdeckungWeite: 0.6, bildspiegel: BILDSPIEGEL));
    herd.kamera().kamera().setzeSicht(72).setzeFern(400);
    // Regen: zwei Sprüher 11 m über dem Spieler, je ein Quadrat von 2 × 9 m um ihn
    Teil r = herd.raum(0, 11, 0);
    für (salami i = 0; i < 2; i++) {
        Teil q = herd.raum(0, 0, 0).haenge(r);
        q.mit(neu Funken(rate: 4200, lebensdauer: 1.2, tempo: 11, richtungX: 0.06, richtungY: -1, streuung: 3, schwerkraft: 3,
                         groesse: 0.016, groesseEnde: 0.016, farbe: "#c8d2ffa0", farbeEnde: "#c8d2ffa0", mischung: "leuchtend",
                         streckung: 0.032, licht: 1, volumen: 9, kollision: "welt", spritzer: 3, regen: ja));
    }
    serviere ((r));
}

// Regen folgt dem Spieler (ein Stück voraus, damit vor der Kamera immer Tropfen fallen; die Tropfen bleiben in der Welt,
// das Volumen wandert mit)
leer wetterTakt(funghi x, funghi z, funghi blick) {
    funghi b = Mathe.bogen(blick);
    REGEN.setzeLage(x + Mathe.sin(b) * 2, 11, z - Mathe.cos(b) * 2);
}
