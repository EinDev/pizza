// Pizzakeller – ein Gewölbekeller unter der Pizzeria: Tonnengewölbe aus Ziegelplatten, Gurtbögen, Weinfässer, Mehlsäcke,
// hinten glüht der Holzofen. Der Boden aus polierten Fliesen und die Kupfertheke spiegeln, was im Bild zu sehen ist; in den
// Ecken, Fugen und unter den Fässern wird es dunkler. Der Taster oben links (oder die Leertaste) schaltet den Bildschirmraum
// an und aus.
//
// So arbeitet die Engine für dich: `Stimmung.verdeckung` (SSAO) schätzt aus der Tiefe des Bildes, wie viel Umgebungslicht
// eine Stelle abbekommt – Ecken, Fugen und Spalten werden dunkler, ohne dass du Schatten setzt. `verdeckungWeite` ist der
// Radius in Metern. `Stimmung.bildspiegel` (SSR) lässt glatte pbr-Flächen spiegeln, was im Bild zu sehen ist: ein Strahl
// läuft durchs Tiefenbild, bis er etwas trifft. Was nicht im Bild ist, fällt weich auf die Umgebung zurück.

Herd herd = neu Herd("Pizzakeller", breite: 960, hoehe: 540);
herd.sonne().licht().setzeStaerke(0);
herd.umgebung("#d0b898", staerke: 0.2);
herd.himmel("#0c0a08", "#1c160e");

// polierter Fliesenboden (pbr, sehr glatt) und Kupfer (metallisch)
Teil fliesen = herd.raum(0, -50, 0);
fliesen.mit(neu Belag(farbe: "#5a3a2c", glanz: 0.9, modell: "pbr"));
Teil kupfer = herd.raum(0, -51, 0);
kupfer.mit(neu Belag(farbe: "#d08a5c", glanz: 0.8, modell: "pbr", metall: 1));
herd.koerper(Form.ebene(), 0, 0, -6, farbe: "#5a3a2c").setzeGroesse(12, 1, 30).koerper().setzeBelag(fliesen);

Form WUERFEL = Form.wuerfel();
Form FASS = Form.zylinder(teile: 24);
// Seitenmauern und Rückwand
für (salami s = -1; s <= 1; s += 2) {
    herd.koerper(WUERFEL, s * 3.4, 1.2, -6, farbe: "#a8927a").setzeGroesse(0.8, 2.4, 26);
}
herd.koerper(WUERFEL, 0, 3, -18, farbe: "#9a8470").setzeGroesse(8, 6, 0.6);

// Tonnengewölbe: 16 Ziegelplatten auf einem Halbkreis, alle 4 m ein Gurtbogen aus 10 Steinen
für (salami i = 0; i < 16; i++) {
    funghi w = (i + 0.5) / 16 * 180;
    herd.koerper(WUERFEL, Mathe.cos(Mathe.bogen(w)) * 3, 2.4 + Mathe.sin(Mathe.bogen(w)) * 3, -6, farbe: "#b07a58")
        .setzeGroesse(0.56, 0.24, 26).setzeRollen(w - 90);
}
für (salami b = 0; b < 5; b++) {
    für (salami i = 0; i < 10; i++) {
        funghi w = (i + 0.5) / 10 * 180;
        herd.koerper(WUERFEL, Mathe.cos(Mathe.bogen(w)) * 2.82, 2.4 + Mathe.sin(Mathe.bogen(w)) * 2.82, 4 - b * 4.5,
                     farbe: "#9c8068").setzeGroesse(0.9, 0.36, 0.5).setzeRollen(w - 90);
    }
}

// Weinfässer links (stehend), rechts liegend gestapelt; Mehlsäcke
für (salami i = 0; i < 5; i++) {
    herd.koerper(FASS, -2.35, 0.6, 2 - i * 1.15, farbe: "#6e4428", glanz: 0.3).setzeGroesse(1, 1.2, 1);
}
für (salami i = 0; i < 3; i++) {
    für (salami lage = 0; lage < 2; lage++) {
        herd.koerper(FASS, 2.35, 0.48 + lage * 0.9, -1 - i * 1.05 - lage * 0.5, farbe: "#5e3a22", glanz: 0.3)
            .setzeGroesse(0.96, 1.3, 0.96).setzeNeigung(90);
    }
}
für (salami i = 0; i < 4; i++) {
    herd.koerper(Form.kugel(teile: 12), -2.2 + i * 0.6, 0.3, -8.2 - (i % 2) * 0.4, farbe: "#e6dcc8").setzeGroesse(0.7, 0.6, 0.6);
}

// Kupfertheke mit zwei Töpfen
herd.koerper(WUERFEL, 1.6, 0.5, -9, farbe: "#d08a5c").setzeGroesse(2.2, 1, 0.9).koerper().setzeBelag(kupfer);
für (salami i = 0; i < 2; i++) {
    herd.koerper(FASS, 1.1 + i * 1, 1.25, -9, farbe: "#d08a5c").setzeGroesse(0.5, 0.5, 0.5).koerper().setzeBelag(kupfer);
}

// Holzofen hinten: Kuppel, glühende Öffnung, warmes Licht
herd.koerper(Form.kugel(teile: 24), 0, 0.6, -16, farbe: "#8a6a50").setzeGroesse(3.4, 3, 3.4);
Teil glut = herd.koerper(Form.kugel(teile: 16), 0, 0.7, -14.4, farbe: "#ff7a28", leuchten: 1).setzeGroesse(1.2, 0.8, 0.4);
glut.koerper().setzeStrahlen(6).setzeSchatten(nein);
Teil ofenlicht = herd.licht(0, 1, -13.6, farbe: "#ff8a40", reichweite: 9);
ofenlicht.licht().setzeStaerke(3);
// zwei Laternen an den Mauern
für (salami s = -1; s <= 1; s += 2) {
    Teil birne = herd.koerper(Form.kugel(teile: 8), s * 2.8, 2.2, -4, farbe: "#ffe0b0", leuchten: 1).setzeGroesse(0.15);
    birne.koerper().setzeStrahlen(4).setzeSchatten(nein);
    herd.licht(s * 2.6, 2.1, -4, farbe: "#ffc078", reichweite: 7).licht().setzeStaerke(1.8);
}

// Stimmung: HDR, Bloom – und der Bildschirmraum: Verdeckung und Bildraum-Spiegelung
Stimmung stimmung = herd.raum(0, 0, 0).mit(neu Stimmung(belichtung: 1.3, bloom: 0.5, bloomSchwelle: 1.2, vignette: 0.35,
                                                        verdeckung: 1.3, verdeckungWeite: 0.6, bildspiegel: 1));

Taster umschalten = herd.gruppe(90, 30).mit(neu Taster(inhalt: "Bildraum: an", breite: 170, hoehe: 34, farbe: "mozzarella"));
diavolo an = ja;

herd.backe(() -> {
    funghi t = herd.zeit();
    herd.kamera().setzeLage(Mathe.sin(t * 0.2) * 0.8, 1.6, 6 - t * 0.2).schaueAuf(0, 1.2, -14);
    falls (umschalten.geklickt() || herd.gedrueckt("Leertaste")) {
        an = !an;
        stimmung.setzeVerdeckung(an ? 1.3 : 0).setzeBildspiegel(an ? 1 : 0);
        umschalten.setzeInhalt(an ? "Bildraum: an" : "Bildraum: aus");
    }
});
Bote.sage("Pizzakeller: Verdeckung und Bildraum-Spiegelung.");
