// HUD (2D über der 3D-Szene): Titel, Beläge, Uhr, Hinweis, Meldung mit Schlagschatten und Konfetti.
bestellt "welt/herd.pizza";

Teil anzeige;
Teil uhr;
Teil meldung;
Teil meldungSchatten;
Teil meldungText;
Blech<Partikel> funken = [];
salami meldungBis = 0;

leer baueHud() {
    herd.rechteck(150, 52, 260, 80, farbe: "#2f2a26b8", rundung: 16);
    herd.text("Teigball", 36, 20, groesse: 30, farbe: "senf");
    anzeige = herd.text("Beläge 0/8", 36, 58, groesse: 20, farbe: "mozzarella");
    uhr = herd.text("0 s", 264, 58, groesse: 20, farbe: "mozzarella", ausrichtung: "rechts");
    herd.rechteck(480, 520, 400, 30, farbe: "#2f2a2690", rundung: 15);
    herd.text("Pfeiltasten: rollen  ·  Leertaste: neue Runde", 480, 510, groesse: 16, farbe: "#fff6e0c0", ausrichtung: "mitte");
    meldung = herd.gruppe(480, 120);                  // Meldung mit Schlagschatten: zwei Texte an einer Gruppe
    meldungSchatten = herd.text("", 3, 3, groesse: 36, farbe: "#2f2a26a0", ausrichtung: "mitte").haenge(meldung);
    meldungText = herd.text("", 0, 0, groesse: 36, farbe: "mozzarella", ausrichtung: "mitte").haenge(meldung);
    Teil konfetti = herd.gruppe(160, -10);            // Konfetti in Grün-Weiß-Rot: eine Kanone als Vorlage …
    konfetti.mit(neu Partikel(rate: 90, lebensdauer: 3.5, tempo: 140, richtung: 75, streuung: 80,
        schwerkraft: 40, groesse: 11, groesseEnde: 5, farbe: "basilikum", farbeEnde: "#2e7d32", aktiv: nein));
    Teil konfetti2 = konfetti.kopie().setzeLage(800, -10); // … und zwei Kopien (kopie() kopiert alle Komponenten)
    konfetti2.partikel().setzeRichtung(105).setzeFarbe("tomate").setzeFarbeEnde("salami");
    Teil konfetti3 = konfetti.kopie().setzeLage(480, -10);
    konfetti3.partikel().setzeRichtung(90).setzeFarbe("weiss").setzeFarbeEnde("mozzarella");
    funken = [konfetti.partikel(), konfetti2.partikel(), konfetti3.partikel()];
}

leer melde(margherita text, salami takteLang) {
    meldungText.text().setzeInhalt(text);
    meldungSchatten.text().setzeInhalt(text);
    meldung.sichtbar(ja);
    meldungBis = herd.bildnummer() + takteLang;
}
