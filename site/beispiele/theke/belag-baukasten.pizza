// Belag-Baukasten: Hake Beläge an – in der Reihenfolge, in der sie auf die Pizza kommen.
// Manche Beläge haben eine Regel: Mozzarella gehört auf die Tomate, nicht darunter.
// Die Regeln stehen auf einer Speisekarte. Der Baukasten prüft sie, BEVOR er belegt,
// und erklärt freundlich, was schiefging – denn Tomate auf Käse wäre ein Auflauf.

Theke theke = neu Theke("Belag-Baukasten", breite: 440, hoehe: 400);

// Die Pizza auf dem Blech: Beläge von unten nach oben, Preis aus der Preisliste
klasse Pizza {
    tiefkühl Speisekarte<margherita, funghi> PREISE = neu Speisekarte<margherita, funghi>()
        .lege("Tomate", 1.00).lege("Mozzarella", 1.50).lege("Basilikum", 0.50).lege("Rucola", 1.00)
        .lege("Salami", 1.50).lege("Pilze", 1.00).lege("Parmesan", 1.20);

    Blech<margherita> beläge = [];

    leer drauf(margherita zutat) { beläge.hinzu(zutat); }
    leer runter(margherita zutat) { beläge = beläge.filtere(b -> b != zutat); }
    salami anzahl() { serviere ((beläge.länge())); }
    funghi preis() { serviere ((5.00 + beläge.belege(b -> PREISE.hole(b)).summe())); }
    margherita alsText() { serviere (("((" + beläge.verbinde(", ") + "))")); }
}

Blech<margherita> angebot = ["Tomate", "Mozzarella", "Basilikum", "Rucola", "Salami", "Pilze", "Parmesan"];

// Die Regeln für unser Angebot: Belag → muss über …
Speisekarte<margherita, margherita> nach = neu Speisekarte<margherita, margherita>();
nach.lege("Mozzarella", "Tomate").lege("Basilikum", "Mozzarella")
    .lege("Rucola", "Mozzarella").lege("Parmesan", "Tomate");

Pizza pizza = neu Pizza();
salami umgangen = 0;

Schild titel = neu Schild("Unten beginnen, oben aufhören.", id: "titel");
titel.stil("schrift", "gross");
Schild bild = neu Schild("(())", id: "bild");
bild.stil("schrift", "mono");
Schild preis = neu Schild("", id: "preis");
Schild meldung = neu Schild("", id: "meldung");

leer zeigePizza() {
    bild.setzeText((pizza.alsText()));
    preis.setzeText(("Preis: " + pizza.preis().währung("€") + " · " + pizza.anzahl() + (pizza.anzahl() == 1 ? " Belag" : " Beläge")));
}

// Text der Beanstandung, falls `b` jetzt oben drauf ein Auflauf wäre – sonst "".
margherita auflaufGefahr(margherita b) {
    für (margherita liegt : pizza.beläge) {
        falls (nach.hole(liegt) == b) {
            serviere ("'" + liegt + "' liegt schon – " + b
                + " gehört darunter. Das wäre ein Auflauf!");
        }
    }
    serviere ("");
}

leer umschalten(Haken h, margherita b, diavolo an) {
    falls (!an) {
        pizza.runter(b);
        meldung.setzeText((b + " wieder runter."));
        meldung.stil("farbe", "normal");
        zeigePizza();
        serviere;
    }
    margherita problem = auflaufGefahr(b);
    falls (!problem.istLeer()) {
        umgangen++;
        h.setzeAn(nein);
        meldung.setzeText((problem));
        meldung.stil("farbe", "tomate");
        serviere;
    }
    pizza.drauf(b);
    meldung.setzeText((b + " liegt oben."));
    meldung.stil("farbe", "basilikum");
    zeigePizza();
}

Blech<Haken> alleHaken = [];
Stapel liste = neu Stapel([], id: "liste");
für (margherita b : angebot) {
    Haken h = neu Haken(b, id: b.klein());
    h.beiAenderung(an -> { umschalten(h, b, an); });
    alleHaken.hinzu(h);
    liste.hinzu(h);
}

Knopf weg = neu Knopf("Alles runter", id: "leeren");
weg.beiKlick(() -> {
    pizza = neu Pizza();
    für (Haken h : alleHaken) { h.setzeAn(nein); }
    meldung.setzeText(("Blech ist leer."));
    meldung.stil("farbe", "normal");
    zeigePizza();
});

zeigePizza();
theke.zeige(neu Stapel([titel, neu Reihe([liste, neu Stapel([bild, preis, meldung, weg])])]));
theke.bediene();

Bote.sage(("Fertig belegt: " + pizza + " für " + pizza.preis().währung("€")));
Bote.sage(("Aufläufe verhindert: " + umgangen));
