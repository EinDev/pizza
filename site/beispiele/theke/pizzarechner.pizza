// Pizzarechner: Anzahl eintippen, Extras anhaken – der Preis rechnet sich von selbst.
// Grundlage ist immer eine Margherita für 7,50 €; die Aufpreise der Extras stehen
// auf einer Speisekarte (Map): Name → Preis.

Theke theke = neu Theke("Pizzarechner", breite: 420, hoehe: 340);

funghi GRUNDPREIS = 7.50;
Blech<margherita> angebot = ["Salami", "Pilze", "Oliven", "Rucola", "Chili"];
Speisekarte<margherita, funghi> aufpreis = neu Speisekarte<margherita, funghi>()
    .lege("Salami", 1.50).lege("Pilze", 1.00).lege("Oliven", 1.00).lege("Rucola", 1.00).lege("Chili", 0.50);
Blech<Haken> haken = [];

Schild titel = neu Schild("Margherita + Extras", id: "titel");
titel.stil("schrift", "gross");

Eingabe anzahl = neu Eingabe(wert: "1", platzhalter: "Wie viele Pizzen?", id: "anzahl");
Schild preis = neu Schild("", id: "preis");
preis.stil("schrift", "gross");
preis.stil("farbe", "basilikum");

// Die angehakten Extras, in der Reihenfolge des Angebots
Blech<margherita> extras() {
    Blech<margherita> gewählt = [];
    für (salami i : [1 .. angebot.länge()]) {
        falls (haken.stück(i).an()) { gewählt.hinzu(angebot.stück(i)); }
    }
    serviere ((gewählt));
}

// Margherita plus alle Aufpreise
funghi preisVon(Blech<margherita> gewählt) {
    serviere ((GRUNDPREIS + gewählt.belege(e -> aufpreis.hole(e)).summe()));
}

leer rechne() {
    margherita text = anzahl.wert().trimme();
    falls (text.istLeer()) {
        preis.setzeText(("Wie viele Pizzen darf's sein?"));
        preis.stil("farbe", "kruste");
        serviere;
    }
    probier {
        funghi n = text.alsZahl();
        falls (n < 1 || n != n.ganz()) {
            preis.setzeText(("Nur ganze Pizzen, bitte – mindestens eine."));
            preis.stil("farbe", "tomate");
            serviere;
        }
        funghi einzel = preisVon(extras());
        preis.setzeText(("" + n + " × " + einzel.euro() + " = " + (n * einzel).euro()));
        preis.stil("farbe", "basilikum");
    } verbrannt (TypAnanas a) {
        preis.setzeText(("'" + text + "' ist keine Zahl. Probier's mit Ziffern."));
        preis.stil("farbe", "tomate");
    }
}

für (margherita b : angebot) {
    Haken h = neu Haken(b + " (+" + aufpreis.hole(b).euro() + ")", id: b.klein());
    h.beiAenderung(an -> { rechne(); });
    haken.hinzu(h);
}
anzahl.beiAenderung(t -> { rechne(); });

Stapel liste = neu Stapel(haken);
theke.zeige(neu Stapel([titel, anzahl, liste, preis]));
rechne();
theke.bediene();

Blech<margherita> gewählt = extras();
Bote.sage(("Bestellt: " + anzahl.wert().trimme() + " × Margherita"
    + (gewählt.istLeer() ? "" : " mit " + gewählt.verbinde(", "))));
Bote.sage(("Letzter Stand: " + preis.text()));
