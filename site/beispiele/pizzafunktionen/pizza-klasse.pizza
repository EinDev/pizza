// Luigis Speisekarte: Pizzen sind Werte – aus einer eigenen Klasse.
// Die Beläge liegen in einem Blech, von unten nach oben; der Preis kommt aus der Preisliste.

klasse Pizza {
    tiefkühl funghi GRUNDPREIS = 5.00;      // der nackte Teig
    tiefkühl Speisekarte<margherita, funghi> PREISE = neu Speisekarte<margherita, funghi>()
        .lege("Tomate", 1.00).lege("Mozzarella", 1.50).lege("Basilikum", 0.50)
        .lege("Salami", 1.50).lege("Chili", 0.50);

    gebacken Blech<margherita> beläge;

    speisekarte Pizza(Blech<margherita> beläge) { dies.beläge = beläge.kopie(); }

    // mit() legt einen Belag oben drauf und liefert eine NEUE Pizza
    speisekarte Pizza mit(margherita zutat) { serviere ((neu Pizza(beläge.kopie().hinzu(zutat)))); }

    // ohne() nimmt einen Belag wieder runter (alle Exemplare davon)
    speisekarte Pizza ohne(margherita zutat) { serviere ((neu Pizza(beläge.filtere(b -> b != zutat)))); }

    speisekarte diavolo hat(margherita zutat) { serviere ((beläge.enthält(zutat))); }
    speisekarte salami anzahlBeläge() { serviere ((beläge.länge())); }
    speisekarte funghi preis() { serviere ((GRUNDPREIS + beläge.belege(b -> PREISE.hole(b)).summe())); }
    speisekarte tiefkühl funghi preisVon(margherita zutat) { serviere ((PREISE.hole(zutat))); }

    // Zwei Pizzen sind gleich, wenn die Beläge in gleicher Reihenfolge liegen
    speisekarte diavolo gleicht(Pizza andere) { serviere ((alsText() == andere.alsText())); }

    // alsText() bestimmt, wie eine Pizza ausgegeben wird
    speisekarte margherita alsText() { serviere (("((" + beläge.verbinde(", ") + "))")); }
}

Bote.sage(("=== Luigis Speisekarte ==="));

Pizza klassiker = neu Pizza(["Tomate", "Mozzarella", "Basilikum"]);
Bote.sage(("Margherita: " + klassiker));
Bote.sage(("Beläge: " + klassiker.beläge.verbinde(", ")));
Bote.sage(("Anzahl Beläge: " + klassiker.anzahlBeläge()));
Bote.sage(("Preis roh: " + klassiker.preis()));          // 5.00 Teig + 1.00 + 1.50 + 0.50
Bote.sage(("Preis schön: " + klassiker.preis().euro()));

// mit() legt oben drauf – der Klassiker selbst bleibt, wie er ist
Pizza diavola = klassiker.mit("Salami").mit("Chili");
Bote.sage(("Diavola: " + diavola + " für " + diavola.preis().euro()));

Pizza feurig = diavola.mit("Chili");
Bote.sage(("Extra feurig: " + feurig));

// ohne() nimmt alle Chilis wieder runter
Pizza fürOma = feurig.ohne("Chili");
Bote.sage(("Für Oma: " + fürOma + " für " + fürOma.preis().euro()));
Bote.sage(("Hat Salami? " + fürOma.hat("Salami")));
Bote.sage(("Hat Chili? " + fürOma.hat("Chili")));

// Der Klassiker selbst wurde nie verändert
Bote.sage(("Klassiker immer noch: " + klassiker));

// Die Preisliste ist tiefkühl (statisch) – sie gehört der Klasse, nicht der einzelnen Pizza
Bote.sage(("Extra-Salami kostet " + Pizza.preisVon("Salami").euro()));

// Die nackte Pizza: nur Teig
Pizza nackt = neu Pizza([]);
Bote.sage(("Nur Teig: " + nackt + " für " + nackt.preis().euro()));

// == vergleicht Objekte nach Identität – für Wertgleichheit schreiben wir gleicht()
Bote.sage(("Dieselbe Pizza? " + (fürOma == klassiker.mit("Salami"))));
Bote.sage(("Gleiche Pizzen? " + fürOma.gleicht(klassiker.mit("Salami"))));
