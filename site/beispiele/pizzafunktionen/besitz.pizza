// Bei Luigi gehört jede Pizza genau einem Tisch.
// Weitergeben geht mit schieb(): Danach ist der alte Karton leer.

klasse Pizza {
    margherita sorte;
    salami stücke = 8;

    Pizza(margherita sorte) { dies.sorte = sorte; }

    margherita alsText() { serviere ((sorte + " (" + stücke + " Stücke)")); }
}

Pizza tisch1 = neu Pizza("Salami");
Bote.sage(("Tisch 1 bekommt: " + tisch1));

// Der Kellner schiebt die Pizza zu Tisch 2 weiter
Pizza tisch2 = schieb(tisch1);
Bote.sage(("Tisch 2 hat jetzt: " + tisch2));
probier {
    Bote.sage(("Tisch 1 hat noch: " + tisch1));
} verbrannt (LeererKartonAnanas a) {
    Bote.sage(("Tisch 1 schaut in den Karton: " + a.nachricht()));
}

// Neuzuweisung ist erlaubt: Tisch 1 bekommt eine neue Pizza
tisch1 = neu Pizza("Funghi");
Bote.sage(("Tisch 1 tröstet sich mit: " + tisch1));

// Ohne schieb() zeigen zwei Namen auf DIESELBE Pizza:
// Wer an Tisch 3 isst, isst von der Pizza an Tisch 2.
Pizza tisch3 = tisch2;
tisch3.stücke -= 2;
Bote.sage(("Tisch 3 isst zwei Stücke. Tisch 2 hat: " + tisch2));
Bote.sage(("Dieselbe Pizza? " + (tisch2 == tisch3)));

// schieb() geht mit jeder Variable – auch mit einer Zahl
salami trinkgeld = 3;
salami kasse = schieb(trinkgeld);
probier {
    Bote.sage(("Trinkgeld noch auf dem Tisch? " + trinkgeld));
} verbrannt (LeererKartonAnanas a) {
    Bote.sage((a.nachricht()));
}
Bote.sage(("In der Kasse: " + kasse + " €"));
