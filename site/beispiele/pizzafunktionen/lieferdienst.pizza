// Luigis Lieferdienst – alles zusammen: eigene Pizza-Klasse, Ofen, schieb und Lieferungen.

klasse Pizza {
    margherita name;
    funghi preis;
    Pizza(margherita name, funghi preis) { dies.name = name; dies.preis = preis; }
    margherita alsText() { serviere ((name)); }
}

speisekarte klasse Lieferdienst {
    tiefkühl funghi kasse = 0;

    tiefkühl margherita liefere(margherita kunde, Pizza bestellung) {
        kasse += bestellung.preis;
        serviere ((kunde + " bekommt " + bestellung + " für " + bestellung.preis.euro()
            + " (Kasse: " + kasse.euro() + ")"));
    }

    speisekarte tiefkühl leer hauptgang(Blech<margherita> args) {
        Bote.sage(("=== Luigis Lieferdienst öffnet ==="));
        Blech<Pizza> bestellungen = [
            neu Pizza("Margherita", 8.00),
            neu Pizza("Diavolo", 9.00),
            neu Pizza("Tonno", 10.00)
        ];

        // Alle Bestellungen in den Ofen – klar im Budget
        funghi wert = ofen(temperatur: 400, zeit: 60s) {
            serviere ((bestellungen.belege(p -> p.preis).summe()));
        } roh (r) {
            serviere ((0));
        };
        Bote.sage(("Aus dem Ofen: " + bestellungen.länge() + " Pizzen im Wert von " + wert.euro()));

        // Die Personalpizza nimmt Luigi mit in die Pause – schieb() leert den Karton in der Küche
        Pizza personal = neu Pizza("Funghi", 8.50);
        Pizza pause = schieb(personal);
        probier {
            Bote.sage(("Personalpizza in der Küche: " + personal));
        } verbrannt (LeererKartonAnanas a) {
            Bote.sage(("Luigi macht Pause mit der " + pause + ". " + a.nachricht()));
        }

        // Herr Verdi wartet am Telefon – mit Trinkgeld geht's schneller
        Zustellung<margherita> verdi = bestelle(() -> (Lieferdienst.liefere("Herr Verdi", bestellungen.stück(2))))
            .trinkgeld(3)
            .warte(max: 10min);
        Bote.sage((verdi.oderGratis(("Herr Verdi isst gratis."))));

        // Der Rest fährt nach Küchenschluss – höchstes Trinkgeld zuerst
        bestelle(() -> (Lieferdienst.liefere("Frau Bianchi", bestellungen.stück(1))))
            .trinkgeld(1)
            .wennDa(text -> Bote.sage(("Fahrer meldet: " + text)));
        bestelle(() -> (Lieferdienst.liefere("Familie Rossi", bestellungen.stück(3))))
            .trinkgeld(4)
            .wennDa(text -> Bote.sage(("Fahrer meldet: " + text)));

        Bote.sage(("=== Küche zu, die Fahrer starten ==="));
    }
}
