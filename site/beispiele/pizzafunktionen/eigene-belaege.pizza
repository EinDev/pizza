// Luigis Feinkost-Ecke: Edle Beläge sind Decorators.
// Jede Schicht ist eine eigene Klasse, die eine Pizza umwickelt: Sie kennt die Pizza
// darunter, fragt sie nach Preis und Beschreibung – und legt ihren Teil obendrauf.

speisekarte rezeptur Pizza {
    funghi preis();
    margherita beschreibung();
}

// Der Boden: eine Margherita für 7,50 €
klasse Margherita erfüllt Pizza {
    speisekarte funghi preis() { serviere ((7.50)); }
    speisekarte margherita beschreibung() { serviere (("Margherita")); }
}

// Eine Schicht liegt auf einer anderen Pizza. Was sie kostet, sagt die Unterklasse.
rohling klasse Schicht erfüllt Pizza {
    familienrezept Pizza darunter;

    speisekarte Schicht(Pizza darunter) { dies.darunter = darunter; }

    speisekarte funghi preis() { serviere ((darunter.preis())); }
    speisekarte margherita beschreibung() { serviere ((darunter.beschreibung())); }
}

klasse Trüffel erbt Schicht {
    speisekarte Trüffel(Pizza p) { unten((p)); }

    @PizzaÜberschreibt
    speisekarte funghi preis() { serviere ((unten.preis() + 4.50)); }

    @PizzaÜberschreibt
    speisekarte margherita beschreibung() { serviere ((unten.beschreibung() + " mit Trüffel")); }
}

// Blattgold verdoppelt alles, was darunter liegt
klasse Blattgold erbt Schicht {
    speisekarte Blattgold(Pizza p) { unten((p)); }

    @PizzaÜberschreibt
    speisekarte funghi preis() { serviere ((unten.preis() * 2)); }

    @PizzaÜberschreibt
    speisekarte margherita beschreibung() { serviere ((unten.beschreibung() + " und Blattgold")); }
}

// Basilikum kostet 50 Cent und ist der Beschreibung keine Erwähnung wert
klasse Basilikum erbt Schicht {
    speisekarte Basilikum(Pizza p) { unten((p)); }

    @PizzaÜberschreibt
    speisekarte funghi preis() { serviere ((unten.preis() + 0.50)); }
}

Bote.sage(("=== Luigis Feinkost ==="));

Pizza einfach = neu Margherita();
Bote.sage(("Einfach: " + einfach.beschreibung() + ", " + einfach.preis().währung("€")));

Pizza edel = neu Trüffel(einfach);
Bote.sage(("Edel: " + edel.beschreibung() + ", " + edel.preis().währung("€")));

Pizza protzig = neu Blattgold(edel);
Bote.sage(("Protzig: " + protzig.beschreibung() + ", " + protzig.preis().währung("€")));

// Die Reihenfolge der Schichten entscheidet über den Preis!
Pizza basilikumOben = neu Basilikum(protzig);
Pizza goldOben = neu Blattgold(neu Basilikum(edel));
Bote.sage(("Basilikum oben: " + basilikumOben.preis().währung("€")));
Bote.sage(("Blattgold oben: " + goldOben.preis().währung("€")));
Bote.sage(("Luigi: Wer zuletzt vergoldet, verdient am meisten."));
