// Luigi hat eine Regel. Nur eine.

Bote.sage(("=== Freitagabend bei Luigi ==="));
Pizza tisch5 = ((Tomate, Mozzarella, Schinken));
Bote.sage(("Tisch 5: " + tisch5 + " – sehr gerne!"));
Bote.sage(("Tisch 6 möchte Tomate, Käse, Schinken und ... Ananas."));
Bote.sage(("Luigi wird blass."));

probier {
    Pizza tisch6 = ((Tomate, Käse, Schinken, Ananas));
    Bote.sage(("Tisch 6: " + tisch6));
} verbrannt (fehler) {
    Bote.sage(("Gerade noch abgefangen!"));   // Panik ist nicht fangbar ...
} rand {
    Bote.sage(("Luigi räumt auf."));          // ... und rand läuft auch nicht.
}

Bote.sage(("Diese Zeile erreicht niemand."));
