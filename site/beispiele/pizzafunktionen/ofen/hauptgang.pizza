// Luigis Holzofen: Jede Berechnung bekommt ein Zeitbudget.
// Budget in Schritten = Zeit in Millisekunden – mehr Zeit, mehr Budget.

Bote.sage(("=== Luigi heizt den Ofen ==="));

// 1) Kleine Arbeit, großzügiges Budget: läuft locker durch
salami teller = ofen(zeit: 60s) {
    salami summe = 0;
    für (salami tisch = 1; tisch <= 10; tisch++) {
        summe += tisch;
    }
    serviere ((summe));
};
Bote.sage(("Teller für alle Tische: " + teller));

// 2) Luigi zählt Pizzen und vergisst aufzuhören.
//    Der roh-Zweig rettet das letzte Zwischenergebnis.
salami gezählt = ofen(zeit: 1s) {
    salami pizzen = 0;
    solange (ja) {
        pizzen++;
        falls (pizzen == 10) {
            zwischenstand((pizzen));
        }
    }
    serviere ((pizzen));
} roh (r) {
    Bote.sage(("Noch roh! Der Ofen gibt auf."));
    serviere ((r.teilergebnis()));
};
Bote.sage(("Wenigstens sicher gezählt: " + gezählt));

// 3) Ohne roh-Zweig gibt es eine VerbranntAnanas
probier {
    ofen(zeit: 1s) {
        solange (ja) { }
    };
} verbrannt (VerbranntAnanas a) {
    Bote.sage(("Verbrannt: " + a.typ()));
}

// 4) Was im Ofen schiefgeht, fängt der verbrannt-Zweig
salami grad = 500;
margherita urteil = ofen(zeit: 10s) {
    falls (grad > 485) {
        wirf neu VerbranntAnanas("Zu heiß! Selbst Neapel hat Grenzen.");
    }
    serviere (("perfekt"));
} verbrannt (VerbranntAnanas a) {
    serviere (("Ofen sagt: " + a.nachricht()));
};
Bote.sage((urteil));

// 5) Kurzform: die Zeit geht auch ohne Namen
margherita neapel = ofen(10s) {
    serviere (("Zehn Sekunden reichen – neapolitanisch perfekt"));
};
Bote.sage((neapel));
