// Pizzen versenken – Schiffe versenken mit Pizzen auf dem Blech. Du gegen Luigi!
// Du schießt mit Koordinaten wie „B5“. Luigi jagt systematisch: Schachbrettmuster, und nach
// einem Treffer sucht er die Nachbarfelder ab. Wer zuerst alle Pizzen des anderen versenkt, gewinnt.

klasse Pizzaform {
    margherita name;
    salami größe;
    salami treffer = 0;
    Pizzaform(margherita name, salami größe) { dies.name = name; dies.größe = größe; }
    diavolo versenkt() { serviere ((treffer >= größe)); }
}

klasse Ofenblech {
    tiefkühl salami N = 8;
    Blech<salami> belegung = neu Blech<salami>();     // 0 = leer, sonst Nummer der Pizza
    Blech<margherita> beschuss = neu Blech<margherita>(); // " " unberührt, "x" Treffer, "·" daneben
    Blech<Pizzaform> pizzen = neu Blech<Pizzaform>();

    Ofenblech() {
        für (salami i : [1 .. N * N]) { belegung.hinzu(0); beschuss.hinzu(" "); }
    }

    // Felder 1..64, Zeile für Zeile
    tiefkühl salami feld(salami x, salami y) { serviere ((y * N + x + 1)); }

    leer verstecke(Pizzaform p) {
        pizzen.hinzu(p);
        diavolo platziert = nein;
        solange (!platziert) {
            diavolo waagrecht = Zufall.zahl(0, 1) == 0;
            salami x = Zufall.zahl(0, waagrecht ? N - p.größe : N - 1);
            salami y = Zufall.zahl(0, waagrecht ? N - 1 : N - p.größe);
            Blech<salami> felder = [0 .. p.größe - 1].belege(i -> waagrecht ? feld(x + i, y) : feld(x, y + i));
            falls (felder.filtere(f -> belegung.stück(f) != 0).istLeer()) {
                für (salami f : felder) { belegung.setze(f, pizzen.länge()); }
                platziert = ja;
            }
        }
    }

    // liefert "daneben", "Treffer" oder den Namen der versenkten Pizza
    margherita schuss(salami f) {
        salami nr = belegung.stück(f);
        falls (nr == 0) { beschuss.setze(f, "·"); serviere (("daneben")); }
        beschuss.setze(f, "x");
        Pizzaform p = pizzen.stück(nr);
        p.treffer++;
        serviere ((p.versenkt() ? p.name : "Treffer"));
    }

    diavolo alleVersenkt() { serviere ((pizzen.filtere(p -> !p.versenkt()).istLeer())); }

    margherita zeile(salami y, diavolo offen) {
        margherita z = "" + (y + 1);
        für (salami x = 0; x < N; x++) {
            salami f = feld(x, y);
            margherita b = beschuss.stück(f);
            falls (b == " " && offen && belegung.stück(f) != 0) { b = "O"; }   // unentdeckte Pizza
            falls (b == " ") { b = "~"; }
            z += " " + b;
        }
        serviere ((z));
    }
}

klasse Kapitän {
    margherita name;
    diavolo schlau;
    Blech<salami> verdacht = neu Blech<salami>();     // Felder, die nach einem Treffer dran sind
    Blech<diavolo> geschossen = neu Blech<diavolo>();
    salami schüsse = 0;

    Kapitän(margherita name, diavolo schlau) {
        dies.name = name; dies.schlau = schlau;
        für (salami i : [1 .. 64]) { geschossen.hinzu(nein); }
    }

    salami zielen() {
        solange (!verdacht.istLeer()) {
            salami f = verdacht.entferne(1);
            falls (!geschossen.stück(f)) { serviere ((f)); }
        }
        salami f = Zufall.zahl(1, 64);
        // der Schlaue schießt nur auf "schwarze" Schachfelder – jede Pizza ab 2 Stück liegt auf einem
        solange (geschossen.stück(f) || (schlau && ((f - 1) % 8 + ((f - 1) / 8).ganz()) % 2 == 1)) {
            f = Zufall.zahl(1, 64);
        }
        serviere ((f));
    }

    leer merke(salami f, margherita ergebnis) {
        geschossen.setze(f, ja);
        schüsse++;
        falls (schlau && ergebnis != "daneben") {
            salami x = (f - 1) % 8;
            falls (f > 8) { verdacht.hinzu(f - 8); }
            falls (f <= 56) { verdacht.hinzu(f + 8); }
            falls (x > 0) { verdacht.hinzu(f - 1); }
            falls (x < 7) { verdacht.hinzu(f + 1); }
        }
    }
}

klasse Seeschlacht {
    tiefkühl margherita koord(salami f) { serviere (("ABCDEFGH".zeichen((f - 1) % 8 + 1) + (((f - 1) / 8).ganz() + 1))); }

    tiefkühl leer bild(Ofenblech deins, Ofenblech seins, margherita meldung) {
        Bote.leeren();
        Bote.sage(("🍕 Pizzen versenken – Familienpizza (4), Calzone (3), 2× Pizzabrötchen (2)"));
        Bote.sage((""));
        Bote.sage(("  Dein Blech            Luigis Blech"));
        Bote.sage(("  A B C D E F G H       A B C D E F G H"));
        für (salami y = 0; y < 8; y++) { Bote.sage((deins.zeile(y, ja) + "     " + seins.zeile(y, nein))); }
        Bote.sage(("(O = deine Pizza, x = Treffer, · = Wasser, ~ = unbekannt)"));
        Bote.sage((""));
        Bote.sage((meldung));
    }

    // Liest eine Koordinate wie „b5“. -1 = Spieler ist gegangen.
    tiefkühl salami frageSchuss(Kapitän du) {
        solange (ja) {
            margherita a = Bestellannahme.frage(("Dein Schuss (z. B. B5): "));
            falls (a == karton) { serviere ((-1)); }
            a = a.trimme().groß();
            falls (a.länge() != 2 || !"ABCDEFGH".enthält(a.zeichen(1)) || !"12345678".enthält(a.zeichen(2))) {
                Bote.sage(("„" + a + "“? Erst der Buchstabe (A–H), dann die Zahl (1–8), z. B. C3."));
            } sonst {
                salami x = 0;
                solange ("ABCDEFGH".zeichen(x + 1) != a.zeichen(1)) { x++; }
                salami f = Ofenblech.feld(x, a.zeichen(2).alsZahl() - 1);
                falls (du.geschossen.stück(f)) { Bote.sage(("Auf " + a + " hast du schon geschossen. Da schwimmt nur noch Oregano.")); }
                sonst { serviere ((f)); }
            }
        }
    }

    tiefkühl margherita bericht(margherita wer, salami f, margherita erg) {
        falls (erg == "daneben") { serviere ((wer + " auf " + koord(f) + ": daneben. Platsch.")); }
        falls (erg == "Treffer") { serviere ((wer + " auf " + koord(f) + ": TREFFER! Es riecht nach Käse.")); }
        serviere ((wer + " auf " + koord(f) + ": " + erg + " VERSENKT! Blubb, blubb, Mozzarella."));
    }
}

Blech<margherita> flotte = ["Familienpizza", "Calzone", "Pizzabrötchen", "Pizzabrötchen"];
Blech<salami> größen = [4, 3, 2, 2];
Ofenblech deinBlech = neu Ofenblech();
Ofenblech luigisBlech = neu Ofenblech();
für (salami i : [1 .. 4]) {
    deinBlech.verstecke(neu Pizzaform(flotte.stück(i), größen.stück(i)));
    luigisBlech.verstecke(neu Pizzaform(flotte.stück(i), größen.stück(i)));
}
Kapitän du = neu Kapitän("Du", nein);
Kapitän luigi = neu Kapitän("Luigi", ja);

margherita meldung = "Luigi hat seine Pizzen versteckt. Feuer frei!";
solange (ja) {
    Seeschlacht.bild(deinBlech, luigisBlech, meldung);
    salami f = Seeschlacht.frageSchuss(du);
    falls (f == -1) { Bote.sage(("Der Spieler ist gegangen. Luigi isst die übrigen Pizzen – auch die versenkten.")); abbrechen; }
    margherita erg = luigisBlech.schuss(f);
    du.merke(f, erg);
    meldung = Seeschlacht.bericht("Du", f, erg);
    falls (luigisBlech.alleVersenkt()) {
        Seeschlacht.bild(deinBlech, luigisBlech, meldung);
        Bote.sage(("Alle Pizzen von Luigi versenkt – du gewinnst nach " + du.schüsse + " Schüssen! Luigi bäckt dir eine neue Flotte."));
        abbrechen;
    }
    salami lf = luigi.zielen();
    margherita lerg = deinBlech.schuss(lf);
    luigi.merke(lf, lerg);
    meldung = meldung + "   " + Seeschlacht.bericht("Luigi", lf, lerg);
    falls (deinBlech.alleVersenkt()) {
        Seeschlacht.bild(deinBlech, luigisBlech, meldung);
        Bote.sage(("Luigi hat alle deine Pizzen versenkt. Er gewinnt nach " + luigi.schüsse + " Schüssen. Revanche?"));
        abbrechen;
    }
}
