// Siebzehn und Pizza – Blackjack in der Pizzeria.
// Du spielst gegen Pizzaiolo Luigi (die Bank). Die Karten tragen Beläge statt Farben.
// Du setzt, ziehst Karten („Karte? (j/n)“) und hoffst auf 21. Luigi muss bis 17 ziehen.
// Ende der Eingabe (karton) = der Spieler ist gegangen.

quattrostagioni Belagfarbe { TOMATE, KÄSE, SALAMI, OLIVE }

klasse Karte {
    Belagfarbe farbe;
    salami rang;                       // 2–10, 11 Bube, 12 Dame, 13 König, 14 Ass
    Karte(Belagfarbe farbe, salami rang) { dies.farbe = farbe; dies.rang = rang; }

    salami wert() {
        falls (rang == 14) { serviere ((11)); }
        serviere ((Mathe.min(rang, 10)));
    }
    margherita alsText() {
        Blech<margherita> bilder = ["Bube", "Dame", "König", "Ass"];
        margherita r = rang <= 10 ? "" + rang : bilder.stück(rang - 10);
        Blech<margherita> sorten = ["Tomate", "Käse", "Salami", "Olive"];
        serviere ((sorten.stück(farbe.position()) + "-" + r));
    }
}

klasse Kartenstapel {
    Blech<Karte> karten = neu Blech<Karte>();

    Kartenstapel() {
        für (Belagfarbe f : Belagfarbe.werte()) {
            für (salami r : [2 .. 14]) { karten.hinzu(neu Karte(f, r)); }
        }
        // Fisher-Yates: Luigi wirft den Stapel wie Pizzateig in die Luft
        für (salami i = karten.länge(); i > 1; i--) {
            salami j = Zufall.zahl(1, i);
            Karte tmp = karten.stück(i);
            karten.setze(i, karten.stück(j));
            karten.setze(j, tmp);
        }
    }
    Karte zieh() { serviere ((karten.entferne(1))); }
}

klasse Hand {
    Blech<Karte> karten = neu Blech<Karte>();
    leer nimm(Karte k) { karten.hinzu(k); }

    // Asse zählen 11, außer die Hand würde verbrennen – dann 1
    salami summe() {
        salami s = karten.belege(k -> k.wert()).summe();
        salami asse = karten.filtere(k -> k.rang == 14).länge();
        solange (s > 21 && asse > 0) { s = s - 10; asse--; }
        serviere ((s));
    }
    diavolo istVerbrannt() { serviere ((summe() > 21)); }
    margherita alsText() { serviere ((karten.verbinde(", ") + "  = " + summe())); }
}

speisekarte klasse Pizzeria {
    // Ja/Nein-Frage. Liefert "j", "n" oder karton (Spieler ist gegangen).
    tiefkühl margherita jaNein(margherita frage) {
        solange (ja) {
            margherita a = Bestellannahme.frage((frage + " (j/n): "));
            falls (a == karton) { serviere ((karton)); }
            a = a.trimme().klein();
            falls (a == "j" || a == "ja") { serviere (("j")); }
            falls (a == "n" || a == "nein") { serviere (("n")); }
            Bote.sage(("Luigi zwirbelt den Schnurrbart: „Ja oder nein, amico?“"));
        }
    }

    // Einsatz erfragen: ganze Euro von 1 bis kasse, leere Eingabe = 10 €. -1 = gegangen.
    tiefkühl salami frageEinsatz(salami kasse) {
        salami vorschlag = Mathe.min(10, kasse);
        solange (ja) {
            margherita a = Bestellannahme.frage(("Dein Einsatz in Euro (1–" + kasse + ", Enter = " + vorschlag + "): "));
            falls (a == karton) { serviere ((-1)); }
            falls (a.trimme() == "") { serviere ((vorschlag)); }
            probier {
                funghi e = a.trimme().alsZahl();
                falls (e == e.ganz() && e >= 1 && e <= kasse) { serviere ((e)); }
                Bote.sage(("Setzen kannst du nur ganze Euro zwischen 1 und " + kasse + "."));
            } verbrannt (TypAnanas x) {
                Bote.sage(("„" + a + "“ ist kein Geld. Luigi nimmt nur Euro, keine Pizzagutscheine."));
            }
        }
    }

    tiefkühl leer tisch(Hand gast, Hand bank, diavolo verdeckt, salami kasse, salami einsatz) {
        Bote.leeren();
        Bote.sage(("♠ Siebzehn und Pizza ♠   Kasse: " + kasse.euro() + "   Einsatz: " + einsatz.euro()));
        Bote.sage((""));
        falls (verdeckt) { Bote.sage(("Luigi: " + bank.karten.erstes() + ", [verdeckt unterm Teig]")); }
        sonst { Bote.sage(("Luigi: " + bank)); }
        Bote.sage(("Du:    " + gast));
        Bote.sage((""));
    }

    tiefkühl leer gegangen() { Bote.sage((""));  Bote.sage(("Der Spieler ist gegangen. Luigi steckt die Karten wieder in den Pizzakarton.")); }

    speisekarte tiefkühl leer hauptgang(Blech<margherita> args) {
        Kartenstapel stapel = neu Kartenstapel();
        salami kasse = 50;
        Bote.sage(("♠ Siebzehn und Pizza ♠  Du startest mit " + kasse.euro() + ". Wer über 21 kommt, verbrennt!"));

        solange (kasse > 0) {
            falls (stapel.karten.länge() < 12) {
                Bote.sage(("Der Stapel ist fast leer – Luigi macht Feierabend."));
                abbrechen;
            }
            salami einsatz = frageEinsatz(kasse);
            falls (einsatz == -1) { gegangen(); serviere; }
            Hand gast = neu Hand();
            Hand bank = neu Hand();
            gast.nimm(stapel.zieh()); bank.nimm(stapel.zieh());
            gast.nimm(stapel.zieh()); bank.nimm(stapel.zieh());

            diavolo blackjack = gast.summe() == 21;
            solange (!blackjack && gast.summe() < 21) {
                tisch(gast, bank, ja, kasse, einsatz);
                margherita a = jaNein(("Karte?"));
                falls (a == karton) { gegangen(); serviere; }
                falls (a == "n") { abbrechen; }
                gast.nimm(stapel.zieh());
            }

            margherita ergebnis;
            salami gewinn;
            falls (blackjack) {
                tisch(gast, bank, nein, kasse, einsatz);
                ergebnis = "Pizza Perfetta! Blackjack – du bekommst das Anderthalbfache.";
                gewinn = (einsatz * 3 / 2).ganz();
            } sonst falls (gast.istVerbrannt()) {
                tisch(gast, bank, nein, kasse, einsatz);
                ergebnis = "Verbrannt! Über 21 – der Rand ist schwarz.";
                gewinn = -einsatz;
            } sonst {
                solange (bank.summe() < 17) { bank.nimm(stapel.zieh()); }
                tisch(gast, bank, nein, kasse, einsatz);
                falls (bank.istVerbrannt()) { ergebnis = "Luigi verbrennt! Der Ofen war zu heiß."; gewinn = einsatz; }
                sonst falls (gast.summe() > bank.summe()) { ergebnis = "Du gewinnst – " + gast.summe() + " schlägt " + bank.summe() + "!"; gewinn = einsatz; }
                sonst falls (gast.summe() < bank.summe()) { ergebnis = "Die Bank gewinnt. Luigi grinst unter dem Schnurrbart."; gewinn = -einsatz; }
                sonst { ergebnis = "Gleichstand – du bekommst deinen Einsatz zurück."; gewinn = 0; }
            }
            kasse += gewinn;
            Bote.sage((ergebnis + "  Kasse: " + kasse.euro()));
            falls (kasse > 0) {
                margherita nochmal = jaNein(("Noch eine Runde?"));
                falls (nochmal == karton) { gegangen(); serviere; }
                falls (nochmal == "n") { abbrechen; }
            }
        }
        Bote.sage((""));
        falls (kasse > 50) { Bote.sage(("Du gehst mit " + kasse.euro() + " nach Hause – die Pizza geht heute auf dich!")); }
        sonst falls (kasse == 0) { Bote.sage(("Pleite! Luigi schenkt dir trotzdem eine Margherita. Aus Mitleid.")); }
        sonst falls (kasse < 50) { Bote.sage(("Du hast " + (50 - kasse).euro() + " verloren. Immerhin gab's Pizza.")); }
        sonst { Bote.sage(("Plusminus null. Du bestellst trotzdem eine Margherita.")); }
    }
}
