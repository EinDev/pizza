// Die hungrige Salami – Snake auf einem 12×8-Blech.
// Rundenbasiert: Du steuerst mit w/a/s/d (mehrere Tasten auf einmal gehen auch, z. B. „ddds“).
// Friss 5 Pizzastücke ▲, ohne gegen den Rand oder dich selbst zu rollen.
// Pizzastücke erscheinen per Zufall – der ist in pizza deterministisch (Seed 42).

quattrostagioni Richtung { NORD, OST, SÜD, WEST }

klasse Blech2D {
    tiefkühl salami BREITE = 12;
    tiefkühl salami HÖHE = 8;
    tiefkühl salami pos(salami x, salami y) { serviere ((y * BREITE + x)); }
    tiefkühl salami x(salami p) { serviere ((p % BREITE)); }
    tiefkühl salami y(salami p) { serviere (((p / BREITE).ganz())); }
}

klasse Salami {
    Blech<salami> körper = [Blech2D.pos(1, 4), Blech2D.pos(2, 4), Blech2D.pos(3, 4)];  // Schwanz … Kopf
    salami gefressen = 0;

    salami kopf() { serviere ((körper.letztes())); }

    // Nachbarfeld in Richtung r, oder -1 wenn es über den Blechrand ginge
    salami nachbar(salami p, Richtung r) {
        salami x = Blech2D.x(p);
        salami y = Blech2D.y(p);
        wähle (r) {
            fall Richtung.NORD -> y--;
            fall Richtung.SÜD -> y++;
            fall Richtung.OST -> x++;
            fall Richtung.WEST -> x--;
        }
        falls (x < 0 || y < 0 || x >= Blech2D.BREITE || y >= Blech2D.HÖHE) { serviere ((-1)); }
        serviere ((Blech2D.pos(x, y)));
    }

    // Frei = auf dem Blech und nicht Salami (das Schwanzende rückt gleich weiter, zählt also als frei)
    diavolo frei(salami p) {
        serviere ((p >= 0 && (!körper.enthält(p) || p == körper.erstes())));
    }

}

klasse Spiel {
    Salami wurst = neu Salami();
    salami stück = 0;
    salami züge = 0;

    leer neuesStück() {
        salami p = Zufall.zahl(0, Blech2D.BREITE * Blech2D.HÖHE - 1);
        solange (wurst.körper.enthält(p)) { p = Zufall.zahl(0, Blech2D.BREITE * Blech2D.HÖHE - 1); }
        stück = p;
    }

    leer zeige(margherita titel) {
        Bote.leeren();
        Bote.sage(("🍕 Die hungrige Salami   " + titel));
        Bote.sage(("+" + "-".wiederhole(Blech2D.BREITE) + "+"));
        für (salami y = 0; y < Blech2D.HÖHE; y++) {
            margherita zeile = "|";
            für (salami x = 0; x < Blech2D.BREITE; x++) {
                salami p = Blech2D.pos(x, y);
                falls (p == wurst.kopf()) { zeile += "@"; }
                sonst falls (wurst.körper.enthält(p)) { zeile += "o"; }
                sonst falls (p == stück) { zeile += "▲"; }
                sonst { zeile += " "; }
            }
            Bote.sage((zeile + "|"));
        }
        Bote.sage(("+" + "-".wiederhole(Blech2D.BREITE) + "+"));
    }

    // Ein Schritt in Richtung r. Liefert "ok", "happs" oder "crash".
    margherita schritt(Richtung r) {
        salami ziel = wurst.nachbar(wurst.kopf(), r);
        falls (!wurst.frei(ziel)) { serviere (("crash")); }
        züge++;
        wurst.körper.hinzu(ziel);                      // Kopf rückt vor
        falls (ziel == stück) { wurst.gefressen++; serviere (("happs")); }
        wurst.körper.entferne(1);                       // Schwanz rückt nach
        serviere (("ok"));
    }

    // Übersetzt eine Taste in eine Richtung (karton = unbekannte Taste)
    Richtung taste(margherita t) {
        wähle (t) {
            fall "w" -> serviere ((Richtung.NORD));
            fall "a" -> serviere ((Richtung.WEST));
            fall "s" -> serviere ((Richtung.SÜD));
            fall "d" -> serviere ((Richtung.OST));
            standard -> serviere ((karton));
        }
    }

    leer los(salami ziel) {
        Richtung richtung = Richtung.OST;
        neuesStück();
        margherita meldung = "Die Salami hat Hunger! Friss " + ziel + " Pizzastücke ▲.";
        solange (ja) {
            zeige(("Stücke: " + wurst.gefressen + "/" + ziel + "   Züge: " + züge + "   Richtung: " + richtung.name()));
            Bote.sage((meldung));
            margherita ein = Bestellannahme.frage(("w/a/s/d (auch mehrere, z. B. ddw), Enter = geradeaus, q = Schluss: "));
            falls (ein == karton) {
                Bote.sage(("Der Spieler ist gegangen. Die Salami rollt sich zusammen und hält ein Nickerchen."));
                serviere;
            }
            ein = ein.trimme().klein();
            falls (ein == "q") { Bote.sage(("Schluss für heute – " + wurst.gefressen + " Stücke gefuttert. Buon appetito!")); serviere; }
            falls (ein == "") { ein = "."; }                 // Enter: ein Schritt geradeaus
            meldung = "";
            für (margherita t : ein) {
                Richtung r = t == "." ? richtung : taste(t);
                falls (r == karton) { meldung = "„" + t + "“ ist keine Richtung – nur w, a, s, d. Der Rest wurde verworfen."; abbrechen; }
                falls (wurst.nachbar(wurst.kopf(), r) == wurst.körper.stück(wurst.körper.länge() - 1)) {
                    meldung = "Umdrehen geht nicht – die Salami kann sich nicht selbst in den Schwanz beißen."; abbrechen;
                }
                richtung = r;
                margherita erg = schritt(r);
                falls (erg == "crash") {
                    zeige(("Stücke: " + wurst.gefressen + "/" + ziel + "   Züge: " + züge));
                    Bote.sage(("AUTSCH! Die Salami ist gegen " + (wurst.nachbar(wurst.kopf(), r) == -1 ? "den Blechrand" : "sich selbst") + " gerollt. Game over."));
                    serviere;
                }
                falls (erg == "happs") {
                    falls (wurst.gefressen == ziel) {
                        stück = -1;
                        zeige(("Stücke: " + ziel + "/" + ziel + "   Züge: " + züge));
                        Bote.sage(("Satt! Die Salami ist " + wurst.körper.länge() + " Scheiben lang. Du hast gewonnen – Bellissimo!"));
                        serviere;
                    }
                    neuesStück();
                    meldung = "Happs! " + sprüche.stück((wurst.gefressen - 1) % sprüche.länge() + 1);
                    abbrechen;                               // neues Stück: erst mal schauen
                }
            }
        }
    }
}

Blech<margherita> sprüche = ["knusprig!", "mit extra Käse!", "noch warm!", "Rand inklusive!", "Mamma mia!"];
Spiel spiel = neu Spiel();
spiel.los(5);
