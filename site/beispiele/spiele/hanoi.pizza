// Die Türme von Hanoi – mit Pizzakartons. Du trägst!
// Ein Stapel Kartons soll von der Theke zum Lieferroller.
// Regel: Nie ein großer Karton auf einen kleineren – sonst ist die Pizza darunter platt.
// Eingabe: „13“ trägt den obersten Karton von Turm 1 nach Turm 3. „löse“ lässt Luigi rekursiv
// zu Ende tragen – und zwar aus jeder beliebigen Stellung.

klasse Kartonturm {
    margherita name;
    Blech<salami> kartons = neu Blech<salami>();   // unten … oben, Zahl = Größe
    Kartonturm(margherita name) { dies.name = name; }
    salami oben() { serviere ((kartons.istLeer() ? 99 : kartons.letztes())); }
}

klasse Luigi {
    Blech<Kartonturm> türme;
    salami züge = 0;
    salami höhe;
    diavolo zeigen;

    Luigi(salami höhe, diavolo zeigen) {
        dies.höhe = höhe; dies.zeigen = zeigen;
        türme = [neu Kartonturm("1 Theke"), neu Kartonturm("2 Ablage"), neu Kartonturm("3 Roller")];
        für (salami g = höhe; g >= 1; g--) { türme.stück(1).kartons.hinzu(g); }
    }

    // Ein Karton der Größe g, mittig in einer Spalte der Breite b
    // (rechts aufgefüllt nur, wenn noch eine Spalte folgt – sonst blieben Leerzeichen am Zeilenende)
    margherita male(salami g, salami b, diavolo auffüllen) {
        margherita t = g == 0 ? "|" : "[" + "#".wiederhole(2 * g - 1) + "]";
        salami links = ((b - t.länge()) / 2).ganz();
        serviere ((" ".wiederhole(links) + t + (auffüllen ? " ".wiederhole(b - t.länge() - links) : "")));
    }

    leer zeige() {
        salami b = 2 * höhe + 3;
        für (salami ebene = höhe; ebene >= 1; ebene--) {
            margherita z = "";
            für (Kartonturm t : türme) {
                z += male(t.kartons.länge() >= ebene ? t.kartons.stück(ebene) : 0, b, t != türme.letztes());
            }
            Bote.sage((z));
        }
        Bote.sage(("^".wiederhole(3 * b)));
        Bote.sage((türme.belege(t -> {
            margherita n = t.name;
            salami r = ((b - n.länge()) / 2).ganz();
            serviere ((" ".wiederhole(r) + n + (t != türme.letztes() ? " ".wiederhole(b - n.länge() - r) : "")));
        }).verbinde("")));
    }

    // Trägt den obersten Karton. Regelverstoß → StreitAnanas (der Karton bleibt, wo er war).
    leer trage(salami von, salami nach) {
        Kartonturm a = türme.stück(von);
        Kartonturm z = türme.stück(nach);
        falls (a.kartons.istLeer()) { wirf neu StreitAnanas(("Bei " + a.name + " liegt gar kein Karton.")); }
        falls (a.oben() > z.oben()) {
            wirf neu StreitAnanas(("Karton " + a.oben() + " auf Karton " + z.oben() + "? Die Pizza darunter wäre platt!"));
        }
        z.kartons.hinzu(a.kartons.entferne(a.kartons.länge()));
        züge++;
        falls (zeigen) { Bote.sage(("Zug " + züge + ": Karton " + z.oben() + " von " + a.name + " nach " + z.name)); }
    }

    salami turmVon(salami nr) {
        für (salami t : [1 .. 3]) { falls (türme.stück(t).kartons.enthält(nr)) { serviere ((t)); } }
        serviere ((0));
    }

    // Rekursiv aus JEDER erlaubten Stellung: bringe die Kartons 1..n auf Turm 'ziel'.
    // Liegt Karton n schon dort, kümmern wir uns nur um die kleineren. Sonst: kleinere zur Seite,
    // Karton n ans Ziel, kleinere wieder obendrauf.
    leer bringe(salami n, salami ziel) {
        falls (n == 0) { serviere; }
        salami quelle = turmVon(n);
        falls (quelle == ziel) { bringe(n - 1, ziel); serviere; }
        bringe(n - 1, 6 - quelle - ziel);
        trage(quelle, ziel);
        bringe(n - 1, ziel);
    }

    diavolo fertig() { serviere ((türme.stück(3).kartons.länge() == höhe)); }
}

klasse Laden {
    tiefkühl leer gegangen() { Bote.sage((""));  Bote.sage(("Der Spieler ist gegangen. Die Kartons bleiben stehen – die Pizza wird kalt.")); }

    // Liest die Anzahl der Kartons (3–6). -1 = gegangen.
    tiefkühl salami frageHöhe() {
        solange (ja) {
            margherita a = Bestellannahme.frage(("Wie viele Pizzakartons? (3–6): "));
            falls (a == karton) { serviere ((-1)); }
            a = a.trimme();
            falls (a.länge() == 1 && "3456".enthält(a)) { serviere ((a.alsZahl())); }
            Bote.sage(("Luigis Roller trägt 3 bis 6 Kartons. Mehr passt nicht, weniger lohnt nicht."));
        }
    }
}

Bote.sage(("Die Türme von Hanoi – mit Pizzakartons."));
Bote.sage(("Bring alle Kartons von der Theke (1) zum Roller (3). Nie einen großen auf einen kleinen!"));
salami n = Laden.frageHöhe();
falls (n == -1) { Laden.gegangen(); }
sonst {
    Luigi luigi = neu Luigi(n, nein);
    salami optimum = 2;
    für (salami i : [2 .. n]) { optimum = optimum * 2; }
    optimum--;
    margherita meldung = "Los geht's! Bestes Ergebnis: " + optimum + " Züge.";
    diavolo gelöst = nein;
    solange (!luigi.fertig()) {
        Bote.leeren();
        luigi.zeige();
        Bote.sage((""));
        Bote.sage(("Züge: " + luigi.züge + "   " + meldung));
        margherita a = Bestellannahme.frage(("Dein Zug (z. B. 13) oder „löse“: "));
        falls (a == karton) { Laden.gegangen(); abbrechen; }
        a = a.trimme().klein().ersetze(" ", "").ersetze("-", "").ersetze(">", "");
        falls (a == "löse" || a == "loese") {
            Bote.leeren();
            Bote.sage(("Luigi seufzt und trägt den Rest selbst:"));
            luigi.zeigen = ja;
            luigi.bringe(n, 3);
            gelöst = ja;
            Bote.sage((""));
        } sonst falls (a.länge() == 2 && "123".enthält(a.zeichen(1)) && "123".enthält(a.zeichen(2)) && a.zeichen(1) != a.zeichen(2)) {
            probier {
                luigi.trage(a.zeichen(1).alsZahl(), a.zeichen(2).alsZahl());
                meldung = "Getragen.";
            } verbrannt (StreitAnanas s) {
                meldung = s.nachricht();
            }
        } sonst {
            meldung = "„" + a + "“ versteht Luigi nicht. Zwei Ziffern 1–3, z. B. 12.";
        }
    }
    falls (luigi.fertig()) {
        falls (!gelöst) { Bote.leeren(); }
        luigi.zeige();
        Bote.sage((""));
        falls (gelöst) { Bote.sage(("Geschafft – mit Luigis Hilfe, nach insgesamt " + luigi.züge + " Zügen.")); }
        sonst falls (luigi.züge == optimum) { Bote.sage(("Perfekt! " + optimum + " Züge – mehr Pizzaiolo geht nicht. (2 hoch " + n + " minus 1)")); }
        sonst { Bote.sage(("Geschafft in " + luigi.züge + " Zügen! Das Optimum wären " + optimum + " gewesen (2 hoch " + n + " minus 1).")); }
    }
}
