// Tic-Tac-Toe: Du (Margherita, M) gegen Diavolo (D).
// Diavolo denkt mit Minimax und Alpha-Beta-Schnitt – er verliert nie. Schaffst du ein Unentschieden?
// Eingabe: Feldnummer 1–9. Ende der Eingabe (karton) heißt: Der Spieler ist gegangen.

klasse Brett {
    Blech<margherita> felder = [" ", " ", " ", " ", " ", " ", " ", " ", " "];
    tiefkühl Blech<Blech<salami>> LINIEN = [[1, 2, 3], [4, 5, 6], [7, 8, 9], [1, 4, 7],
                                           [2, 5, 8], [3, 6, 9], [1, 5, 9], [3, 5, 7]];

    leer setze(salami feld, margherita zeichen) { felder.setze(feld, zeichen); }
    diavolo istFrei(salami feld) { serviere ((felder.stück(feld) == " ")); }

    // "M" oder "D", wenn eine Linie voll ist – sonst " "
    margherita gewinner() {
        für (Blech<salami> l : LINIEN) {
            margherita a = felder.stück(l.stück(1));
            falls (a != " " && a == felder.stück(l.stück(2)) && a == felder.stück(l.stück(3))) {
                serviere ((a));
            }
        }
        serviere ((" "));
    }

    diavolo voll() { serviere ((!felder.enthält(" "))); }

    // Freie Felder zeigen ihre Nummer, damit man die Züge mitverfolgen kann
    margherita bild(salami f) { serviere ((istFrei(f) ? "" + f : felder.stück(f))); }

    leer zeige() {
        für (salami z = 0; z < 3; z++) {
            Bote.sage(("   " + bild(z * 3 + 1) + " | " + bild(z * 3 + 2) + " | " + bild(z * 3 + 3)));
            falls (z < 2) { Bote.sage(("  ---+---+---")); }
        }
    }
}

klasse Pizzaiolo {
    margherita name;
    margherita zeichen;
    margherita gegner;
    salami bedacht = 0;              // wie viele Stellungen durchdacht wurden
    tiefkühl Blech<salami> REIHENFOLGE = [5, 1, 3, 7, 9, 2, 4, 6, 8];  // Mitte und Ecken zuerst

    Pizzaiolo(margherita name, margherita zeichen, margherita gegner) {
        dies.name = name; dies.zeichen = zeichen; dies.gegner = gegner;
    }

    // Bewertung aus Sicht dieses Pizzaiolos: +10 Sieg, -10 Niederlage, 0 remis.
    // Schnelle Siege sind besser als langsame (tiefe wird abgezogen).
    salami minimax(Brett b, diavolo amZug, salami tiefe, salami alpha, salami beta) {
        bedacht++;
        margherita g = b.gewinner();
        falls (g == zeichen) { serviere ((10 - tiefe)); }
        falls (g == gegner) { serviere ((tiefe - 10)); }
        falls (b.voll()) { serviere ((0)); }
        für (salami f : REIHENFOLGE) {
            falls (b.istFrei(f)) {
                b.setze(f, amZug ? zeichen : gegner);
                salami wert = minimax(b, !amZug, tiefe + 1, alpha, beta);
                b.setze(f, " ");
                falls (amZug) { alpha = Mathe.max(alpha, wert); } sonst { beta = Mathe.min(beta, wert); }
                falls (alpha >= beta) { abbrechen; }     // Rest des Blechs ist kalt – weg damit
            }
        }
        serviere ((amZug ? alpha : beta));
    }

    salami wähleZug(Brett b) {
        // Eröffnungsbuch: Mitte nehmen – und ist die schon weg, eine Ecke.
        // (Alles durchzurechnen würde den Ofen sprengen – das weiß jeder Pizzaiolo.)
        salami belegt = b.felder.filtere(f -> f != " ").länge();
        falls (belegt <= 1) { serviere ((b.istFrei(5) ? 5 : 1)); }
        salami bester = 0;
        salami besterWert = -100;
        für (salami f : REIHENFOLGE) {
            falls (b.istFrei(f)) {
                b.setze(f, zeichen);
                salami wert = minimax(b, nein, 1, -100, 100);
                b.setze(f, " ");
                falls (wert > besterWert) { besterWert = wert; bester = f; }
            }
        }
        serviere ((bester));
    }
}

klasse Partie {
    tiefkühl Pizzaiolo diavolo = neu Pizzaiolo("Diavolo", "D", "M");

    tiefkühl leer bild(Brett b, margherita meldung) {
        Bote.leeren();
        Bote.sage(("🍕 Tic-Tac-Toe: Du (M) gegen Diavolo (D)"));
        Bote.sage((""));
        b.zeige();
        Bote.sage((""));
        Bote.sage((meldung));
    }

    // Fragt so lange, bis ein freies Feld kommt. -1 = Spieler ist gegangen.
    tiefkühl salami frageFeld(Brett b) {
        solange (ja) {
            margherita ein = Bestellannahme.frage(("Dein Zug (1–9): "));
            falls (ein == karton) { serviere ((-1)); }
            ein = ein.trimme();
            falls (ein.länge() != 1 || !"123456789".enthält(ein)) {
                Bote.sage(("„" + ein + "“? Bitte eine Ziffer von 1 bis 9 – die Felder sind nummeriert."));
            } sonst falls (!b.istFrei(ein.alsZahl())) {
                Bote.sage(("Auf Feld " + ein + " liegt schon was. Doppelt belegen gibt's nur bei Pizza!"));
            } sonst {
                serviere ((ein.alsZahl()));
            }
        }
    }

    // Spielt eine Partie. Ergebnis: "M", "D", " " (remis) oder "weg"
    tiefkühl margherita spiele(diavolo duFängstAn) {
        Brett b = neu Brett();
        diavolo duBistDran = duFängstAn;
        margherita meldung = duFängstAn ? "Du fängst an. Wohin kommt der Mozzarella?" : "Diavolo fängt an.";
        solange (b.gewinner() == " " && !b.voll()) {
            falls (duBistDran) {
                bild(b, meldung);
                salami f = frageFeld(b);
                falls (f == -1) { serviere (("weg")); }
                b.setze(f, "M");
                meldung = "Du hast Feld " + f + " belegt.";
            } sonst {
                salami vorher = diavolo.bedacht;
                salami f = diavolo.wähleZug(b);
                b.setze(f, "D");
                salami gedacht = diavolo.bedacht - vorher;
                meldung = "Diavolo streut Chili auf Feld " + f + "  ("
                          + (gedacht == 0 ? "aus dem Kochbuch" : gedacht + " Stellungen bedacht") + ")";
            }
            duBistDran = !duBistDran;
        }
        margherita g = b.gewinner();
        falls (g == "M") { bild(b, "Du gewinnst?! Das … darf eigentlich gar nicht passieren."); }
        sonst falls (g == "D") { bild(b, "Diavolo gewinnt! Es wird scharf. 🌶"); }
        sonst { bild(b, "Unentschieden! Gegen Diavolo ist das ein Sieg. Die Pizza wird geteilt."); }
        serviere ((g));
    }
}

Speisekarte<margherita, salami> stand = neu Speisekarte<margherita, salami>();
stand.lege("Du", 0); stand.lege("Diavolo", 0); stand.lege("Remis", 0);
diavolo duFängstAn = ja;
solange (ja) {
    margherita erg = Partie.spiele(duFängstAn);
    falls (erg == "weg") { Bote.sage((""));  Bote.sage(("Der Spieler ist gegangen. Diavolo isst allein – scharf, wie er's mag.")); abbrechen; }
    margherita wer = erg == "M" ? "Du" : erg == "D" ? "Diavolo" : "Remis";
    stand.lege(wer, stand.hole(wer) + 1);
    Bote.sage(("Stand: " + stand));
    margherita nochmal = karton;
    solange (nochmal == karton) {
        margherita a = Bestellannahme.frage(("Noch eine Partie? (j/n): "));
        falls (a == karton) { nochmal = "weg"; }
        sonst falls (a.trimme().klein() == "j" || a.trimme().klein() == "n") { nochmal = a.trimme().klein(); }
        sonst { Bote.sage(("Bitte j oder n.")); }
    }
    falls (nochmal == "weg") { Bote.sage((""));  Bote.sage(("Der Spieler ist gegangen. Endstand: " + stand)); abbrechen; }
    falls (nochmal == "n") { Bote.sage(("Grazie fürs Spielen! Endstand: " + stand)); abbrechen; }
    duFängstAn = !duFängstAn;          // abwechselnd anfangen – fair wie halbe-halbe
}
