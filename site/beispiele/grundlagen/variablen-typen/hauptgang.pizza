// Die Grundzutaten jeder Variable – und eine eigene Klasse als Datentyp.

klasse Pizza {
    margherita sorte;
    Blech<margherita> beläge;
    funghi preis;

    Pizza(margherita sorte, Blech<margherita> beläge, funghi preis) {
        dies.sorte = sorte;
        dies.beläge = beläge;
        dies.preis = preis;
    }

    margherita alsText() {
        serviere ((sorte + " ((" + beläge.verbinde(", ") + ")) für " + preis.währung("€")));
    }
}

speisekarte klasse Typenkunde {
    speisekarte tiefkühl leer hauptgang(Blech<margherita> args) {
        salami stücke = 8;              // Ganzzahl
        funghi preis = 9.6;             // Kommazahl
        margherita sorte = "Funghi";    // Text
        diavolo scharf = nein;          // Wahrheitswert: ja / nein
        Dauer backzeit = 90s;           // Zeitdauer

        Bote.sage(("Sorte: " + sorte));
        Bote.sage(("Stücke: " + stücke));
        Bote.sage(("Preis roh: " + preis));
        Bote.sage(("Preis schön: " + preis.währung("€")));
        Bote.sage(("Scharf? " + scharf));
        Bote.sage(("Backzeit: " + backzeit));
        Bote.sage(("Doppelte Backzeit: " + backzeit * 2));

        // / ist exakte Division, % der Rest
        funghi proStück = preis / stücke;
        Bote.sage(("Pro Stück: " + proStück + " (also " + proStück.währung("€") + ")"));
        Bote.sage(("Halbe Pizza: " + stücke / 2 + " Stücke"));
        Bote.sage(("Bei 3 Gästen bleiben " + stücke % 3 + " Stücke übrig"));

        // salami ist streng: Nur ganze Zahlen kommen in den Karton.
        probier {
            salami halbeSalami = 7.5;
        } verbrannt (TypAnanas a) {
            Bote.sage(("TypAnanas: 7.5 passt nicht in eine salami-Variable."));
        }

        // Eigene Klassen sind auch Typen: Luigis Pizza hat Sorte, Beläge und Preis.
        Pizza klassiker = neu Pizza("Margherita", ["Tomate", "Mozzarella", "Basilikum"], 8.00);
        Bote.sage(("Klassiker: " + klassiker));          // nutzt alsText()
        Bote.sage(("Beläge: " + klassiker.beläge.verbinde(" + ")));
        Bote.sage(("Anzahl Beläge: " + klassiker.beläge.länge()));
        Bote.sage(("Mit Basilikum? " + klassiker.beläge.enthält("Basilikum")));

        // Auch eine Pizza-Variable ist streng: Ein Text ist keine Pizza.
        probier {
            Pizza falsch = "Calzone";
        } verbrannt (TypAnanas a) {
            Bote.sage(("TypAnanas: " + a.nachricht()));
        }
    }
}
