# Wird beim Containerstart per envsubst gerendert (nginx-Entrypoint,
# 20-envsubst-on-templates.sh) nach /tmp/pizza-env/teilen.conf
# und von nginx.conf auf http-Ebene eingebunden.
# Ersetzt werden nur die Variablen aus NGINX_ENVSUBST_FILTER (siehe Dockerfile);
# leere Standardwerte setzt /docker-entrypoint.d/05-pizza-env.envsh.

# DNS-Resolver des Containers (proxy_pass mit Variable -> nginx startet auch,
# wenn der interne Teilen-Dienst noch nicht läuft)
resolver ${NGINX_LOCAL_RESOLVERS} valid=30s ipv6=off;
resolver_timeout 5s;

# Interner Teilen-Dienst Durchreiche ohne abschließenden Slash,
# Standard aus compose.yaml: http://durchreiche:8291 (leer = Teilen aus)
map $host $teilen_upstream {
    default "${TEILEN_URL}";
}
