#!/bin/sh
# Wird vom nginx-Entrypoint vor 20-envsubst-on-templates.sh eingelesen (source).
# Sorgt dafür, dass alle Template-Variablen definiert sind (ggf. leer), damit
# envsubst die Platzhalter ersetzt statt sie wörtlich stehen zu lassen.
# Werte kommen ausschließlich zur Laufzeit aus der Umgebung.
HASTEBIN_URL="${HASTEBIN_URL:-}"
export HASTEBIN_URL="${HASTEBIN_URL%/}"
HASTEBIN_OEFFENTLICH="${HASTEBIN_OEFFENTLICH:-}"
export HASTEBIN_OEFFENTLICH="${HASTEBIN_OEFFENTLICH%/}"
export HASTEBIN_TOKEN="${HASTEBIN_TOKEN:-}"
