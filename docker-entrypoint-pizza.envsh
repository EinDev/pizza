#!/bin/sh
# Wird vom nginx-Entrypoint vor 20-envsubst-on-templates.sh eingelesen (source).
# Sorgt dafür, dass TEILEN_URL immer definiert ist (ggf. leer), damit envsubst
# den Platzhalter ersetzt statt ihn wörtlich stehen zu lassen.
# Der Wert kommt ausschließlich zur Laufzeit aus der Umgebung (compose.yaml).
# Die Aufbewahrung meldet der Teilen-Dienst selbst (/api/konfig).
TEILEN_URL="${TEILEN_URL:-}"
export TEILEN_URL="${TEILEN_URL%/}"
