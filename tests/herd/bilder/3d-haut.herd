#! bild 2 groesse 1280x720
# Referenzbild „Haut“ (H-K23b: Skinning, Abschnitte HAUT/GELENKE, Zug-Merkmal HAUT): die gehäutete Testfigur figur.glb
# (scripts/modelle-test.js, 60 Gelenke) in drei Posen – links in der Ruhelage (ohne Puppe), in der Mitte „Laufen“ bei 0,25 s,
# rechts „Winken“ bei 0,25 s (Puppe mit tempo 0) – mit Sonnenschatten auf einem nassen Plattenboden: Spiegelung (gespiegelter
# Durchgang), Verdeckung (Bildraum-Vorlauf) und Schatten müssen die Figuren genauso verformt zeigen wie das Bild selbst.
# HAUT=0 (Messung): dieselbe Szene ohne Puppen.
vorgabe HAUT 1
welt_neu 1280 720 "Haut"
welt_himmel "#3a4c78" "#d8c8b0"
welt_umgebung "#c0c8e0" 0.25
typ_nummer "Koerper" -> T_K
typ_nummer "Belag" -> T_B
typ_nummer "Licht" -> T_L
typ_nummer "Puppe" -> T_P
typ_nummer "Stimmung" -> T_S
feld_nummer T_K "form" -> K_FORM
feld_nummer T_K "belag" -> K_BELAG
feld_nummer T_B "bild" -> B_BILD
feld_nummer T_B "kachel" -> B_KACHEL
feld_nummer T_B "abbildung" -> B_ABB
feld_nummer T_B "modell" -> B_MODELL
feld_nummer T_B "nass" -> B_NASS
feld_nummer T_B "glanz" -> B_GLANZ
feld_nummer T_L "staerke" -> L_ST
feld_nummer T_L "farbe" -> L_F
feld_nummer T_P "folge" -> P_FOLGE
feld_nummer T_P "tempo" -> P_TEMPO
feld_nummer T_P "zeit" -> P_ZEIT
feld_nummer T_S "spiegelung" -> S_SP
feld_nummer T_S "verdeckung" -> S_V
feld_nummer T_S "verdeckungWeite" -> S_VW
form_grund 5 0 0 -> EBENE
teigling_muster 7 256 256 -> PLATTEN
modell_datei "herd/teigling/testmodelle/figur.glb" -> M

teil_lage 1 0 1.25 3.5
teil_schaue 1 0 0.85 0
komp_von 2 T_L -> SONNE
teil_lage 2 -0.8 1.0 0.9
setze_zahl SONNE L_ST 1.3
setze_text SONNE L_F "#fff0dc"

teil_neu 3 -> bt
komp_neu T_B -> b
setze_zahl b B_BILD PLATTEN
setze_zahl b B_KACHEL 1.5
setze_text b B_ABB "welt"
setze_text b B_MODELL "pbr"
setze_zahl b B_NASS 1
setze_zahl b B_GLANZ 0.85
komp_haenge b bt
teil_neu 3 -> boden
teil_groesse boden 30 1 30
komp_neu T_K -> k
setze_zahl k K_FORM EBENE
setze_zahl k K_BELAG bt
komp_haenge k boden

# links Ruhelage, Mitte Laufen, rechts Winken
modell_teil M -1.3 0 0 -> F0
modell_teil M 0 0 0 -> F1
modell_teil M 1.3 0 0 -> F2
teil_setze F1 4 -35
komp_neu T_P -> p
setze_text p P_FOLGE "Laufen"
setze_zahl p P_TEMPO 0
setze_zahl p P_ZEIT 0.25
wiederhole HAUT
  komp_haenge p F1
ende
komp_neu T_P -> p
setze_text p P_FOLGE "Winken"
setze_zahl p P_TEMPO 0
setze_zahl p P_ZEIT 0.25
wiederhole HAUT
  komp_haenge p F2
ende

komp_neu T_S -> s
setze_zahl s S_SP 0.5
setze_zahl s S_V 0.8
setze_zahl s S_VW 0.5
teil_neu 3 -> st
komp_haenge s st
takte 2
