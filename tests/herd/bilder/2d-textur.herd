#! bild 2 groesse 1280x720
# PD3-Referenzbild 2D: eigene Texturen (Teiglinge aus teigling_muster, Mipmaps wie der Vorbacker) als `Bild` – vergrößert
# pixelscharf (nächster Nachbar), verkleinert trilinear über die Mipmaps (Zonenplatte und Schachbrett ohne Moiré), gedreht,
# getönt, gespiegelt, durchsichtiger Rand ohne dunklen Saum, gemischt mit Atlas-Bildchen und Formen im selben INST2D-Strom.
# Spielfeld 640 × 360, gerendert in 1280 × 720 (2 Gerätepixel je Spielfeldpixel).
vorgabe TAKTE 2
welt_neu 640 360 "Texturen"
welt_hintergrund "#22303f"
typ_nummer "Bild" -> T_B
typ_nummer "Rechteck" -> T_R
feld_nummer T_B "bildchen" -> B_BILD
feld_nummer T_B "groesse" -> B_GR
feld_nummer T_B "farbe" -> B_F
feld_nummer T_B "spiegeln" -> B_SP
feld_nummer T_R "breite" -> R_B
feld_nummer T_R "hoehe" -> R_H
feld_nummer T_R "farbe" -> R_F
teigling_muster 2 128 128 -> PIZZA
teigling_muster 4 256 256 -> ZONE
teigling_muster 1 256 256 -> SCHACH
bildchen_neu ["tttttt", "twwwwt", "twkkwt", "twkkwt", "twwwwt", "tttttt"] [] -> ATLAS
# heller Streifen hinter der unteren Reihe (durchsichtige Ränder auf hellem Grund)
teil_neu 2 -> hs
teil_lage hs 320 300 0
komp_neu T_R -> r
setze_zahl r R_B 640
setze_zahl r R_H 120
setze_text r R_F "#e4d6b8"
komp_haenge r hs
# Pizza groß: 160 Spielfeldpixel = 2,5 Gerätepixel je Texel (nächster Nachbar, keine Unschärfe)
teil_neu 2 -> p
teil_lage p 90 95 0
komp_neu T_B -> b
setze_zahl b B_BILD PIZZA
setze_zahl b B_GR 1.25
komp_haenge b p
# Zonenplatte 1 : 1 (ein Texel je Gerätepixel), dann verkleinert auf ½, ¼ und 0,3 (Stufen 1, 2 und dazwischen)
teil_neu 2 -> z
teil_lage z 262 95 0
komp_neu T_B -> b
setze_zahl b B_BILD ZONE
setze_zahl b B_GR 0.5
komp_haenge b z
teil_neu 2 -> z
teil_lage z 383 55 0
komp_neu T_B -> b
setze_zahl b B_BILD ZONE
setze_zahl b B_GR 0.25
komp_haenge b z
teil_neu 2 -> z
teil_lage z 383 140 0
komp_neu T_B -> b
setze_zahl b B_BILD ZONE
setze_zahl b B_GR 0.125
komp_haenge b z
teil_neu 2 -> z
teil_lage z 478 95 0
komp_neu T_B -> b
setze_zahl b B_BILD ZONE
setze_zahl b B_GR 0.3
komp_haenge b z
# Schachbrett verkleinert (Stufe ≈ 1,3) und gedreht (30°)
teil_neu 2 -> s
teil_lage s 585 55 0
komp_neu T_B -> b
setze_zahl b B_BILD SCHACH
setze_zahl b B_GR 0.2
komp_haenge b s
teil_neu 2 -> s
teil_lage s 585 150 0
teil_setze s 4 30
komp_neu T_B -> b
setze_zahl b B_BILD SCHACH
setze_zahl b B_GR 0.25
komp_haenge b s
# untere Reihe: Pizza 1 : 1, dann immer kleiner (trilinear, kein Flimmern, Rand bleibt hell)
wiederhole 5 i
  teil_neu 2 -> q
  teil_lage q (50 + i * 62 - i * i * 6) 300 0
  komp_neu T_B -> b
  setze_zahl b B_BILD PIZZA
  setze_zahl b B_GR (0.5 / (1 + i * 0.7))
  komp_haenge b q
ende
# getönt und gedreht, gespiegelt, Atlas-Bildchen daneben (pixelscharf wie bisher)
teil_neu 2 -> q
teil_lage q 375 300 0
teil_setze q 4 20
komp_neu T_B -> b
setze_zahl b B_BILD PIZZA
setze_zahl b B_GR 0.6
setze_text b B_F "#9fd0ff"
komp_haenge b q
teil_neu 2 -> q
teil_lage q 480 300 0
komp_neu T_B -> b
setze_zahl b B_BILD PIZZA
setze_zahl b B_GR 0.6
setze_zahl b B_SP 1
komp_haenge b q
teil_neu 2 -> q
teil_lage q 585 300 0
komp_neu T_B -> b
setze_zahl b B_BILD ATLAS
setze_zahl b B_GR 12
komp_haenge b q
takte TAKTE
