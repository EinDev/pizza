#! bild 2 groesse 1280x720
# Referenzbild „Verdeckung“ (H-K24, Stimmung.verdeckung, Abschnitt BILDRAUM): ein Gewölbekeller – Tonnengewölbe aus Platten
# über zwei Seitenmauern, Gurtbögen, stehende und liegende Fässer, Kisten in der Ecke, eine Stufe vor der Rückwand; viel
# Umgebungslicht von oben, zwei schwache Laternen. Die Verdeckung (SSAO, halbe Größe, zweimal bilateral weichgezeichnet)
# dunkelt das Umgebungslicht in den Ecken, in den Fugen der Gewölbeplatten, unter den Fässern und hinter den Kisten ab; die
# Lampen selbst bleiben unberührt. VERDECKUNG = 0 zeichnet zum Vergleich ohne.
vorgabe VERDECKUNG 1.4
welt_neu 1280 720 "Verdeckung"
welt_himmel "#101014" "#1a1814"
welt_umgebung "#d8c8b0" 0.55
typ_nummer "Koerper" -> T_K
typ_nummer "Licht" -> T_L
typ_nummer "Stimmung" -> T_S
feld_nummer T_K "form" -> K_FORM
feld_nummer T_K "farbe" -> K_F
feld_nummer T_K "glanz" -> K_GLANZ
feld_nummer T_K "leuchten" -> K_LE
feld_nummer T_K "schatten" -> K_SCH
feld_nummer T_L "farbe" -> L_F
feld_nummer T_L "staerke" -> L_ST
feld_nummer T_L "reichweite" -> L_RW
feld_nummer T_S "belichtung" -> S_BEL
feld_nummer T_S "verdeckung" -> S_V
feld_nummer T_S "verdeckungWeite" -> S_VW
form_grund 1 0 0 -> WUERFEL
form_grund 2 16 0 -> KUGEL
form_grund 3 24 0 -> ZYLINDER
form_grund 5 0 0 -> EBENE

teil_lage 1 0.4 1.6 6.5
teil_schaue 1 -0.3 1.5 -4
komp_von 2 T_L -> SONNE
setze_zahl SONNE L_ST 0

# Boden, Seitenmauern, Rückwand mit Stufe
teil_neu 3 -> boden
teil_groesse boden 12 1 30
komp_neu T_K -> k
setze_zahl k K_FORM EBENE
setze_text k K_F "#9a8c78"
komp_haenge k boden
wiederhole 2 s
  teil_neu 3 -> m
  teil_lage m ((s * 2 - 1) * 3.4) 1.2 -2
  teil_groesse m 0.8 2.4 22
  komp_neu T_K -> k
  setze_zahl k K_FORM WUERFEL
  setze_text k K_F "#b4a48c"
  komp_haenge k m
ende
teil_neu 3 -> rueck
teil_lage rueck 0 3 -9
teil_groesse rueck 8 6 0.6
komp_neu T_K -> k
setze_zahl k K_FORM WUERFEL
setze_text k K_F "#a89880"
komp_haenge k rueck
teil_neu 3 -> stufe
teil_lage stufe 0 0.2 -8.2
teil_groesse stufe 6 0.4 1.2
komp_neu T_K -> k
setze_zahl k K_FORM WUERFEL
setze_text k K_F "#a0927c"
komp_haenge k stufe

