# Fässer: links stehend in einer Reihe, rechts liegend zu zweit gestapelt
wiederhole 4 i
  teil_neu 3 -> f
  teil_lage f -2.35 0.6 (1.5 - i * 1.15)
  teil_groesse f 1 1.2 1
  komp_neu T_K -> k
  setze_zahl k K_FORM ZYLINDER
  setze_text k K_F "#7a5232"
  setze_zahl k K_GLANZ 0.25
  komp_haenge k f
ende
wiederhole 3 i
  wiederhole 2 lage
    teil_neu 3 -> f
    teil_lage f (2.4 - lage * 0.05) (0.48 + lage * 0.9) (0.6 - i * 1.05 - lage * 0.5)
    teil_setze f 5 90
    teil_groesse f 0.96 1.3 0.96
    komp_neu T_K -> k
    setze_zahl k K_FORM ZYLINDER
    setze_text k K_F "#6e4a2e"
    setze_zahl k K_GLANZ 0.25
    komp_haenge k f
  ende
ende
# Kisten in der Ecke vor der Stufe
wiederhole 3 i
  teil_neu 3 -> kiste
  teil_lage kiste (-1.9 + i * 0.95) (0.35 + (i % 2) * 0.1) (-6.9 + (i % 2) * 0.4)
  teil_groesse kiste 0.8 (0.7 + (i % 2) * 0.2) 0.8
  komp_neu T_K -> k
  setze_zahl k K_FORM WUERFEL
  setze_text k K_F "#8c6a44"
  komp_haenge k kiste
ende

# zwei schwache Laternen (Birnen ohne Schatten)
wiederhole 2 j
  teil_neu 3 -> l
  teil_lage l ((j * 2 - 1) * 2.4) 2.3 (-1 - j * 4)
  komp_neu T_L -> li
  setze_text li L_F "#ffc078"
  setze_zahl li L_ST 0.8
  setze_zahl li L_RW 6
  komp_haenge li l
  komp_neu T_K -> k
  setze_zahl k K_FORM KUGEL
  setze_text k K_F "#ffe0b0"
  setze_zahl k K_LE 1
  setze_zahl k K_SCH 0
  komp_haenge k l
  teil_groesse l 0.14 0.14 0.14
ende

teil_neu 3 -> st
komp_neu T_S -> s
setze_zahl s S_BEL 1.1
setze_zahl s S_V VERDECKUNG
setze_zahl s S_VW 0.6
komp_haenge s st
takte 2
