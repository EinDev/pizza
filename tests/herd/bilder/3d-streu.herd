#! bild 40 groesse 1280x720
# Referenzbild „Streu und Wind“ (H-K27: Streu-Ressource STREU, sichtbare Zellen STREU3D, Abschnitt WIND, Belag.wiegen in
# ZUSATZ3D.merkmale Bits 2–7): ein Hügel (Gelaende 33 × 33) mit 12 000 Grashalmen (eigene Form, wiegen 1), 600 Blumen
# (Kegel mit Kugel, wiegen 0.6) nur in den hellen Streifen der Dichte-Karte und 150 Steinen (flache Kugeln, ohne wiegen, werfen
# Schatten), dazu ein Bäumchen als Koerper mit wiegen 0.08; Wind von links mit Böen, Bild 40. Die Halme hinten sind ausgedünnt
# (sichtweite 34), steile Hänge (über 30°) bleiben kahl. WIND=0: dieselbe Szene ohne Wind.
vorgabe WIND 1
vorgabe HALME 12000
welt_neu 1280 720 "Streu"
welt_himmel "#7fb8e8" "#fdf1d6"
welt_nebel "#fdf1d6" 30 60
welt_umgebung "#fff6e0" 0.45
typ_nummer "Koerper" -> T_K
typ_nummer "Belag" -> T_B
typ_nummer "Licht" -> T_L
typ_nummer "Gelaende" -> T_G
typ_nummer "Streu" -> T_S
typ_nummer "Wind" -> T_W
feld_nummer T_K "form" -> K_FORM
feld_nummer T_K "belag" -> K_BELAG
feld_nummer T_B "farbe" -> B_F
feld_nummer T_B "glanz" -> B_GLANZ
feld_nummer T_B "wiegen" -> B_WIEGEN
feld_nummer T_L "staerke" -> L_ST
feld_nummer T_G "hoehen" -> G_H
feld_nummer T_G "spalten" -> G_SP
feld_nummer T_G "zeilen" -> G_ZE
feld_nummer T_G "weite" -> G_W
feld_nummer T_G "farbe" -> G_F
feld_nummer T_S "form" -> S_FORM
feld_nummer T_S "belag" -> S_BELAG
feld_nummer T_S "anzahl" -> S_N
feld_nummer T_S "breite" -> S_B
feld_nummer T_S "tiefe" -> S_T
feld_nummer T_S "gelaende" -> S_G
feld_nummer T_S "hang" -> S_HANG
feld_nummer T_S "groesse" -> S_GR
feld_nummer T_S "groesseStreuung" -> S_GS
feld_nummer T_S "dichte" -> S_D
feld_nummer T_S "sichtweite" -> S_SW
feld_nummer T_S "schatten" -> S_SCH
feld_nummer T_S "saat" -> S_SAAT
feld_nummer T_W "staerke" -> W_ST
feld_nummer T_W "richtungX" -> W_X
feld_nummer T_W "richtungZ" -> W_Z
feld_nummer T_W "boeen" -> W_B

teil_lage 1 -2 4.2 15
teil_schaue 1 1 1.2 0
komp_von 2 T_L -> SONNE
teil_lage 2 -0.6 1 0.35
setze_zahl SONNE L_ST 1.2

form_grund 4 12 0 -> KEGEL
form_grund 2 16 0 -> KUGEL
form_grund 3 8 0 -> ZYLINDER
# Grashalm: 1 hoch, unten 0.08 breit, oben spitz und leicht nach vorn gebogen
form_eigene [-0.04, 0, 0, 0.04, 0, 0, -0.03, 0.5, 0.02, 0.03, 0.5, 0.02, 0, 1, 0.08] [0, 1, 3, 0, 3, 2, 2, 3, 4] 0 -> HALM

# Hügel: Wellen, rechts ein steiler Rücken
teil_neu 3 -> land
komp_neu T_G -> g
setze_zahl g G_SP 33
setze_zahl g G_ZE 33
setze_zahl g G_W 1
setze_text g G_F "#6a8f3a"
setze_zahlen g G_H [-0.56, -0.54, -0.48, -0.37, -0.22, -0.07, 0.09, 0.22, 0.32, 0.37, 0.37, 0.31, 0.19, 0.02, -0.2, -0.44, -0.69, -0.93, -1.14, -1.32, -1.43, -1.48, -1.46, -1.36, -1.2, -0.85, -0.23, 0.66, 1.8, 3.17, 4.43, 4.65, 4.81, -0.68, -0.66, -0.59, -0.47, -0.31, -0.14, 0.03, 0.18, 0.3, 0.36, 0.37, 0.31, 0.19, 0.02, -0.2, -0.44, -0.7, -0.95, -1.17, -1.34, -1.45, -1.5, -1.47, -1.36, -1.18, -0.83, -0.18, 0.73, 1.89, 3.27, 4.55, 4.77, 4.94, -0.76, -0.75, -0.67, -0.55, -0.39, -0.21, -0.04, 0.12, 0.24, 0.31, 0.33, 0.28, 0.17, 0, -0.21, -0.45, -0.7, -0.94, -1.16, -1.32, -1.43, -1.47, -1.43, -1.32, -1.13, -0.77, -0.12, 0.8, 1.96, 3.35, 4.63, 4.86, 5.03, -0.81, -0.8, -0.73, -0.61, -0.45, -0.28, -0.11, 0.04, 0.16, 0.23, 0.25, 0.21, 0.11, -0.04, -0.24, -0.46, -0.69, -0.92, -1.11, -1.27, -1.36, -1.39, -1.35, -1.23, -1.04, -0.68, -0.04, 0.87, 2.03, 3.41, 4.68, 4.91, 5.07, -0.81, -0.81, -0.75, -0.64, -0.51, -0.35, -0.2, -0.06, 0.05, 0.12, 0.14, 0.11, 0.02, -0.11, -0.28, -0.47, -0.68, -0.87, -1.04, -1.17, -1.25, -1.26, -1.21, -1.1, -0.92, -0.57, 0.06, 0.95, 2.09, 3.45, 4.71, 4.91, 5.07, -0.78, -0.78, -0.74, -0.66, -0.55, -0.42, -0.29, -0.17, -0.08, -0.02, 0, -0.02, -0.09, -0.2, -0.33, -0.49, -0.65, -0.81, -0.94, -1.04, -1.1, -1.1, -1.04, -0.92, -0.76, -0.43, 0.18, 1.04, 2.14, 3.48, 4.7, 4.89, 5.02, -0.71, -0.73, -0.71, -0.66, -0.58, -0.48, -0.39, -0.3, -0.23, -0.18, -0.16, -0.18, -0.22, -0.3, -0.4, -0.51, -0.62, -0.73, -0.82, -0.88, -0.91, -0.89, -0.82, -0.72, -0.57, -0.27, 0.3, 1.12, 2.19, 3.48, 4.67, 4.83, 4.94, -0.62, -0.65, -0.65, -0.63, -0.59, -0.54, -0.49, -0.43, -0.39, -0.36, -0.34, -0.35, -0.37, -0.41, -0.46, -0.52, -0.59, -0.64, -0.68, -0.7, -0.69, -0.65, -0.58, -0.48, -0.36, -0.09, 0.44, 1.21, 2.22, 3.47, 4.62, 4.74, 4.84, -0.5, -0.55, -0.58, -0.6, -0.6, -0.6, -0.59, -0.57, -0.55, -0.54, -0.53, -0.53, -0.53, -0.53, -0.53, -0.54, -0.54, -0.53, -0.52, -0.49, -0.45, -0.39, -0.32, -0.23, -0.13, 0.1, 0.58, 1.3, 2.25, 3.45, 4.55, 4.63, 4.7, -0.37, -0.44, -0.5, -0.55, -0.