25, 1.17, 1.04, 0.87, 0.68, 0.47, 0.28, 0.11, -0.02, -0.11, -0.14, -0.12, -0.05, 0.18, 0.68, 1.43, 2.43, 3.64, 4.75, 4.81, 4.81, -1.07, -0.91, -0.68, -0.41, -0.11, 0.21, 0.52, 0.8, 1.04, 1.23, 1.35, 1.39, 1.36, 1.27, 1.11, 0.92, 0.69, 0.46, 0.24, 0.04, -0.11, -0.21, -0.25, -0.23, -0.16, 0.08, 0.59, 1.36, 2.37, 3.61, 4.73, 4.8, 4.81, -1.03, -0.86, -0.63, -0.35, -0.04, 0.28, 0.6, 0.89, 1.13, 1.32, 1.43, 1.47, 1.43, 1.32, 1.16, 0.94, 0.7, 0.45, 0.21, 0, -0.17, -0.28, -0.33, -0.31, -0.24, 0, 0.52, 1.29, 2.31, 3.55, 4.67, 4.75, 4.76, -0.94, -0.77, -0.55, -0.27, 0.03, 0.35, 0.66, 0.95, 1.18, 1.36, 1.47, 1.5, 1.45, 1.34, 1.17, 0.95, 0.7, 0.44, 0.2, -0.02, -0.19, -0.31, -0.37, -0.36, -0.3, -0.06, 0.45, 1.22, 2.23, 3.47, 4.59, 4.66, 4.68, -0.81, -0.65, -0.43, -0.17, 0.12, 0.42, 0.71, 0.97, 1.2, 1.36, 1.46, 1.48, 1.43, 1.32, 1.14, 0.93, 0.69, 0.44, 0.2, -0.02, -0.19, -0.31, -0.37, -0.37, -0.32, -0.1, 0.39, 1.15, 2.14, 3.37, 4.48, 4.54, 4.56]
komp_haenge g land

# Beläge
teil_neu 3 -> b_gras
komp_neu T_B -> b
setze_text b B_F "#5f9e3c"
setze_zahl b B_GLANZ 0.15
setze_zahl b B_WIEGEN 1
komp_haenge b b_gras
teil_neu 3 -> b_blume
komp_neu T_B -> b
setze_text b B_F "#f2b33d"
setze_zahl b B_GLANZ 0.3
setze_zahl b B_WIEGEN 0.6
komp_haenge b b_blume
teil_neu 3 -> b_stein
komp_neu T_B -> b
setze_text b B_F "#8a8580"
setze_zahl b B_GLANZ 0.2
komp_haenge b b_stein
teil_neu 3 -> b_laub
komp_neu T_B -> b
setze_text b B_F "#3e7e31"
setze_zahl b B_GLANZ 0.2
setze_zahl b B_WIEGEN 0.08
komp_haenge b b_laub

# Dichte: helle Streifen quer (Blumen nur dort)
bildchen_neu ["wwssssww", "wwssssww", "wwssssww", "wwssssww"] [] -> STREIFEN

# Streu: Gras, Blumen, Steine – alle auf dem Hügel
teil_neu 3 -> wiese
komp_neu T_S -> s
setze_zahl s S_FORM HALM
setze_zahl s S_BELAG b_gras
setze_zahl s S_N HALME
setze_zahl s S_B 30
setze_zahl s S_T 30
setze_zahl s S_G land
setze_zahl s S_HANG 30
setze_zahl s S_GR 0.45
setze_zahl s S_GS 0.4
setze_zahl s S_SW 34
komp_haenge s wiese
teil_neu 3 -> blumen
komp_neu T_S -> s
setze_zahl s S_FORM KUGEL
setze_zahl s S_BELAG b_blume
setze_zahl s S_N 1200
setze_zahl s S_B 30
setze_zahl s S_T 30
setze_zahl s S_G land
setze_zahl s S_GR 0.12
setze_zahl s S_D STREIFEN
setze_zahl s S_SAAT 7
komp_haenge s blumen
teil_neu 3 -> steine
komp_neu T_S -> s
setze_zahl s S_FORM KUGEL
setze_zahl s S_BELAG b_stein
setze_zahl s S_N 150
setze_zahl s S_B 24
setze_zahl s S_T 24
setze_zahl s S_G land
setze_zahl s S_HANG 90
setze_zahl s S_GR 0.35
setze_zahl s S_GS 0.6
setze_zahl s S_SCH 1
setze_zahl s S_SAAT 3
komp_haenge s steine

# Bäumchen (Koerper mit wiegen): Stamm starr, Krone wiegt
teil_neu 3 -> stamm
teil_lage stamm 3 1.6 2
teil_groesse stamm 0.25 2.4 0.25
komp_neu T_K -> k
setze_zahl k K_FORM ZYLINDER
setze_zahl k K_BELAG b_stein
komp_haenge k stamm
teil_neu 3 -> krone
teil_lage krone 3 2.6 2
teil_groesse krone 1.8 2.6 1.8
komp_neu T_K -> k
setze_zahl k K_FORM KEGEL
setze_zahl k K_BELAG b_laub
komp_haenge k krone

# Wind von links, mit Böen
teil_neu 3 -> luft
komp_neu T_W -> wind
setze_zahl wind W_ST (2.5 * WIND)
setze_zahl wind W_X 1
setze_zahl wind W_Z 0.3
setze_zahl wind W_B 0.6
komp_haenge wind luft
takte 40
