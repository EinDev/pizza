#! bild 2 groesse 1280x720
# Referenzbild „Material“ (Belag: relief, kachel, abbildung, modell pbr, metall, nass; Abschnitt ZUSATZ3D): ein nasser
# Plattenboden (Muster 7, in Weltmaß gekachelt, Kachel 2,5 m) mit Noppen-Relief (Muster 6) und Pfützen, darin farbige
# Punktlichter tief über dem Boden und ein Spot – flache Blickrichtung, damit Glanz und Pfützen zu sehen sind; eine Wand
# (uv-Abbildung, 4 × 2 Kacheln, Metall 0.8), eine Kugel mit Relief (uv, ohne Kachelung), ein klassischer Würfel zum Vergleich.
# Ohne Stimmung (LDR-Pfad); Sonne schwach. Prüft: Kachel-Sampler (wiederholend, trilinear, anisotrop), Relief-Normale in
# Welt- und uv-Abbildung, GGX-Glanzpunkte, Pfützen, Umgebungsglanz, Zusatzstrom parallel zu INST3D.
welt_neu 1280 720 "Material"
welt_himmel "#101426" "#3a3050"
welt_umgebung "#8090c0" 0.18
typ_nummer "Koerper" -> T_K
typ_nummer "Belag" -> T_B
typ_nummer "Licht" -> T_L
feld_nummer T_K "form" -> K_FORM
feld_nummer T_K "farbe" -> K_F
feld_nummer T_K "glanz" -> K_GLANZ
feld_nummer T_K "belag" -> K_BELAG
feld_nummer T_K "leuchten" -> K_LE
feld_nummer T_K "schatten" -> K_SCH
feld_nummer T_B "farbe" -> B_F
feld_nummer T_B "glanz" -> B_GLANZ
feld_nummer T_B "bild" -> B_BILD
feld_nummer T_B "relief" -> B_RELIEF
feld_nummer T_B "kachel" -> B_KACHEL
feld_nummer T_B "abbildung" -> B_ABB
feld_nummer T_B "modell" -> B_MODELL
feld_nummer T_B "metall" -> B_METALL
feld_nummer T_B "nass" -> B_NASS
feld_nummer T_L "farbe" -> L_F
feld_nummer T_L "staerke" -> L_ST
feld_nummer T_L "reichweite" -> L_RW
feld_nummer T_L "kegel" -> L_KEGEL
form_grund 1 0 0 -> WUERFEL
form_grund 2 32 0 -> KUGEL
form_grund 5 0 0 -> EBENE
teigling_muster 7 256 256 -> PLATTEN
teigling_muster 6 256 256 -> NOPPEN

teil_lage 1 0 1.3 9
teil_schaue 1 0 0.4 -4
komp_von 2 T_L -> SONNE
teil_lage 2 -0.4 0.5 -1
setze_zahl SONNE L_ST 0.25

# Beläge: Boden (welt, nass), Wand (uv, metallisch, blau), Kugel (uv, ohne Kachel), Würfel klassisch
teil_neu 3 -> b_boden
komp_neu T_B -> b
setze_zahl b B_BILD PLATTEN
setze_zahl b B_RELIEF NOPPEN
setze_zahl b B_KACHEL 2.5
setze_text b B_ABB "welt"
setze_text b B_MODELL "pbr"
setze_zahl b B_GLANZ 0.55
setze_zahl b B_NASS 0.7
komp_haenge b b_boden
teil_neu 3 -> b_wand
komp_neu T_B -> b
setze_text b B_F "#9ab4ff"
setze_zahl b B_BILD PLATTEN
setze_zahl b B_RELIEF NOPPEN
setze_zahl b B_KACHEL 4
setze_text b B_MODELL "pbr"
setze_zahl b B_METALL 0.8
setze_zahl b B_GLANZ 0.6
komp_haenge b b_wand
teil_neu 3 -> b_kugel
komp_neu T_B -> b
setze_text b B_F "#ffd0a0"
setze_zahl b B_RELIEF NOPPEN
setze_text b B_MODELL "pbr"
setze_zahl b B_GLANZ 0.7
komp_haenge b b_kugel

teil_neu 3 -> boden
teil_groesse boden 40 1 40
komp_neu T_K -> k
setze_zahl k K_FORM EBENE
setze_zahl k K_BELAG b_boden
komp_haenge k boden
teil_neu 3 -> wand
teil_lage wand 0 2 -6
teil_groesse wand 12 4 0.4
komp_neu T_K -> k
setze_zahl k K_FORM WUERFEL
setze_zahl k K_BELAG b_wand
komp_haenge k wand
teil_neu 3 -> kugel
teil_lage kugel -2.2 0.7 -1.5
teil_groesse kugel 1.4 1.4 1.4
komp_neu T_K -> k
setze_zahl k K_FORM KUGEL
setze_zahl k K_BELAG b_kugel
komp_haenge k kugel
teil_neu 3 -> w
teil_lage w 2.4 0.5 -1.8
komp_neu T_K -> k
setze_zahl k K_FORM WUERFEL
setze_text k K_F "#d07040"
setze_zahl k K_GLANZ 0.6
komp_haenge k w

# Lichter: drei farbige knapp über dem Boden, ein Spot von oben auf die Mitte
wiederhole 3 i
  teil_neu 3 -> l
  teil_lage l ((i - 1) * 3.2) 0.6 (-3.2 + i * 0.4)
  komp_neu T_L -> li
  setze_zahl li L_F (4281063167 * boden(1 / (1 + i * i)) + 585564159 * boden(1 / (1 + (i - 1) * (i - 1))) + 4291967743 * boden(1 / (1 + (i - 2) * (i - 2))))
  setze_zahl li L_ST 3
  setze_zahl li L_RW 6
  komp_haenge li l
  komp_neu T_K -> k
  setze_zahl k K_FORM KUGEL
  setze_zahl k K_F (4281063167 * boden(1 / (1 + i * i)) + 585564159 * boden(1 / (1 + (i - 1) * (i - 1))) + 4291967743 * boden(1 / (1 + (i - 2) * (i - 2))))
  setze_zahl k K_LE 1
  setze_zahl k K_SCH 0
  komp_haenge k l
  teil_groesse l 0.15 0.15 0.15
ende
teil_neu 3 -> sp
teil_lage sp 0.5 6 0
teil_schaue sp 0.5 0 -1
komp_neu T_L -> li
setze_text li L_F "#fff2dc"
setze_zahl li L_ST 6
setze_zahl li L_RW 10
setze_zahl li L_KEGEL 28
komp_haenge li sp
takte 2
