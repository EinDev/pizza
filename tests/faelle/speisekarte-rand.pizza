Speisekarte<margherita, salami> k = neu Speisekarte<margherita, salami>();
Bote.sage((k));
Bote.sage((k.istLeer() + " " + k.länge()));
Bote.sage((k.hole("x")));
Bote.sage((k.entferne("x")));
k.lege("b", 2).lege("a", 1);
k.lege("b", 20);
Bote.sage((k));
Bote.sage((k.entferne("b") + " " + k));
Speisekarte<salami, margherita> z = neu Speisekarte<salami, margherita>();
z.lege(1, "eins").lege(2, "zwei");
Bote.sage((z.hole(1) + z.hat(2) + z.hat(3)));
quattrostagioni Belag { Salami, Tomate, Käse, Pilze }
Speisekarte<Belag, salami> bel = neu Speisekarte<Belag, salami>();
bel.lege(Belag.Salami, 3);
Bote.sage((bel.hole(Belag.Salami) + " " + bel.hat("Salami")));
für (margherita s : k) { Bote.sage((s)); }
Bote.sage((k.schlüssel().länge()));
Bote.sage((k.alsText()));
Speisekarte<margherita, Blech<salami>> v = neu Speisekarte<margherita, Blech<salami>>();
v.lege("x", [1, 2]);
v.hole("x").hinzu(3);
Bote.sage((v));
probier { k.gibts(); } verbrannt (LaufzeitAnanas a) { Bote.sage((a.nachricht())); }
