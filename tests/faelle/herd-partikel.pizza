// Herd §18.6: Partikel – Teilchen leben im Kern (eigener Zufall, deterministisch über saat)
Herd herd = neu Herd("Funken", breite: 160, hoehe: 120);
herd.hintergrund("ofen");
Teil quelle = herd.gruppe(80, 100);
Partikel p = quelle.mit(neu Partikel(rate: 600, lebensdauer: 0.5, tempo: 120, richtung: 270, streuung: 40, schwerkraft: 200, saat: 7));
herd.backe(() -> { falls (herd.bildnummer() == 20) { p.setzeAktiv(nein); } });
Bote.sage((p + " " + p.aktiv() + " " + p.farbe() + " " + p.farbeEnde() + " " + p.saat()));
