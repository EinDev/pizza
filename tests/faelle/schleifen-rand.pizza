für (salami a = 0, b = 10; a < b; a += 3, b -= 3) { Bote.sage((a + "/" + b)); }
für (salami x = 0; x < 5; x++) { falls (x % 2 == 0) { weiter; } Bote.sage(("ungerade " + x)); }
salami k = 0;
solange (k < 10) { k++; falls (k < 8) { weiter; } Bote.sage((k)); }
für (salami a : [1, 2, 3]) { für (salami b : [1, 2, 3]) { falls (b == 2) { abbrechen; } Bote.sage((a * 10 + b)); } }
salami tief() { für (salami q : [1, 2]) { solange (ja) { serviere ((q * 7)); } } serviere ((0)); }
Bote.sage((tief()));
