// SPEC §18.4: Komponenten generisch – Getter/Setter (verkettbar), hole/setze, lose Werte, mit/ohne, teil(), Textformen
Herd herd = neu Herd("Generisch", breite: 200, hoehe: 100);
Kreis lose = neu Kreis(radius: 7, farbe: "#ABC");
Bote.sage((lose + " " + lose.radius() + " " + lose.farbe() + " " + lose.umriss() + " " + lose.teil()));
lose.setzeRadius(9).setzeUmriss(1.5).setze("farbe", "salami");
Bote.sage((lose.hole("radius") + " " + lose.hole("umriss") + " " + lose.hole("farbe")));
Text schrift = neu Text("Hallo", 20, "wasser", "mitte");
Bote.sage((schrift.inhalt() + " " + schrift.groesse() + " " + schrift.farbe() + " " + schrift.ausrichtung()));
schrift.setzeInhalt(42);
Bote.sage((schrift.inhalt() + " " + schrift.hole("inhalt")));
Teil t = herd.gruppe(50, 50);
Bote.sage((t.kreis() + " " + t.text()));
Kreis k = t.mit(lose);
Bote.sage((k == lose) + " " + lose + " " + (lose.teil() == t) + " " + (t.kreis() == lose));
t.mit(schrift);
Bewegung b = t.mit(neu Bewegung(tempoX: 30, daempfung: 0.5));
herd.backe(() -> { b.setze("beschleunigungY", 10); });
Bote.sage((b.tempoX().runden(4) + " " + b.tempoY().runden(4) + " " + t.x().runden(4)));
Bewegung weg = t.ohne("Bewegung");
Bote.sage((weg + " " + (weg == b) + " " + t.bewegung() + " " + t.ohne("Bewegung") + " " + weg.tempoX().runden(4)));
t.ohne(lose);
Bote.sage((lose + " " + t.kreis()));
Teil zweites = herd.gruppe();
zweites.mit(weg);
Bote.sage((weg + " " + zweites.bewegung().daempfung()));
Koerper koerper = neu Koerper(form: Form.kugel(teile: 8), glanz: 1, schatten: nein);
Bote.sage((koerper + " " + koerper.form() + " " + koerper.glanz() + " " + koerper.schatten() + " " + koerper.bild()));
Licht licht = neu Licht();
licht.setzeArt("sonne");
Bote.sage((licht.art() + " " + licht.hole("staerke") + " " + Herd.farbe(255, 128.4, -3) + " " + Herd.farbe(1, 2, 300, a: 0.5)));
Bote.sage((Form.ring(dicke: 0.5, teile: 6) + " " + Form.ebene() + " " + Form.zylinder() + " " + Form.kegel(teile: 3) + " " + Form.wuerfel().id()));
Form eigene = neu Form([0, 0, 0, 1, 0, 0, 0, 1, 0], [0, 1, 2], glatt: ja);
Bote.sage((eigene + " " + eigene.id()));
Kamera kam = herd.kamera().kamera();
kam.setzeSicht(75).setzeFern(100);
Bote.sage((kam + " " + kam.sicht() + " " + herd.sonne().licht().schatten()));
