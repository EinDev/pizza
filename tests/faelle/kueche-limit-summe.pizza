// Küchenbrigade D7: Kein Stück überschreitet sein Limit, aber die Summe → P0002 am brigade-Aufruf
salami arbeit(salami n) {
    salami s = 0;
    für (salami i = 0; i < n; i++) { s += i; }
    serviere ((s));
}
Bote.sage(("los"));
Blech<salami> r = [50, 50, 50, 50].brigade(n -> { Bote.sage(("Koch " + n)); serviere ((arbeit(n))); });
Bote.sage(("nie"));
