// SPEC §18.1: Herd-Aufrufe in Stücken einer brigade → KüchenAnanas (wie die Theke)
Herd herd = neu Herd("Küche", breite: 64, hoehe: 64);
probier { [1, 2].brigade(x -> herd.bildnummer()); } verbrannt (KüchenAnanas a) { Bote.sage((a.nachricht())); }
probier { [1, 2].brigade(x -> neu Bewegung()); } verbrannt (KüchenAnanas a) { Bote.sage((a.nachricht())); }
probier { [1, 2].brigade(x -> Form.wuerfel()); } verbrannt (KüchenAnanas a) { Bote.sage((a.nachricht())); }
Teil t = herd.gruppe();
probier { Blech<Teil> b = [1].brigade(x -> t); } verbrannt (KüchenAnanas a) { Bote.sage((a.nachricht())); }
