// Theke v4 (K-113) Stile zeilen/mindestbreite und K-111 Mathe.log/log10/log2/exp/E im Wasm == Interpreter
Theke t = neu Theke("v4");
Schild s = neu Schild("Ein langer Text, der stehen bleiben soll").stil("zeilen", 2).stil("mindestbreite", 120.5);
Knopf k = neu Knopf("Kaufen").stil("mindestbreite", 0).stil("zeilen", 1);
probier { s.stil("zeilen", 0); } verbrannt (TypAnanas e) { Bote.sage((e.nachricht())); }
probier { s.stil("zeilen", 1.5); } verbrannt (TypAnanas e) { Bote.sage((e.nachricht())); }
probier { s.stil("zeilen", "2"); } verbrannt (TypAnanas e) { Bote.sage((e.nachricht())); }
probier { s.stil("mindestbreite", -1); } verbrannt (TypAnanas e) { Bote.sage((e.nachricht())); }
probier { s.stil("mindestbreite", "breit"); } verbrannt (TypAnanas e) { Bote.sage((e.nachricht())); }
probier { s.stil("minbreite", 1); } verbrannt (LaufzeitAnanas e) { Bote.sage((e.nachricht())); }
probier { s.stil("farbe", "lila"); } verbrannt (LaufzeitAnanas e) { Bote.sage((e.nachricht())); }
Stapel wurzel = neu Stapel([s, k]);
t.zeige(wurzel);
s.stil("zeilen", 3).stil("breite", 200);
k.stil("mindestbreite", karton).stil("zeilen", karton);
t.bediene();

Bote.sage(("E " + Mathe.E + " " + (Mathe.E == Mathe.exp(1))));
Blech<funghi> xs = [0, -0.0, 1, 2, 10, 0.5, 100, 1000, 0.001, 123.456, Mathe.potenz(2, 1000), Mathe.potenz(2, -1000), Mathe.potenz(2, -1074), 709.78, 710, -745, -746, 1.0000000000000002, 0.9999999999999999, -1, 3, 0 - Mathe.potenz(2, 1000), Mathe.wurzel(-1)];
für (funghi x : xs) {
    Bote.sage((x + ": log=" + Mathe.log(x) + " log10=" + Mathe.log10(x) + " log2=" + Mathe.log2(x) + " exp=" + Mathe.exp(x)));
}
Bote.sage(("max-kauf: " + Mathe.boden(Mathe.log(1 + 5000 * (1.15 - 1) / 100) / Mathe.log(1.15))));
Bote.sage(("log(1000)/log(10) = " + Mathe.log(1000) / Mathe.log(10) + ", log10(1000) = " + Mathe.log10(1000)));
probier { Mathe.log("x"); } verbrannt (TypAnanas e) { Bote.sage((e.nachricht())); }
probier { Mathe.log10(karton); } verbrannt (TypAnanas e) { Bote.sage((e.nachricht())); }
probier { Mathe.log2(ja); } verbrannt (TypAnanas e) { Bote.sage((e.nachricht())); }
probier { Mathe.exp(); } verbrannt (TypAnanas e) { Bote.sage((e.nachricht())); }
probier { Mathe.log(10, 2); } verbrannt (Ananas e) { Bote.sage((e.nachricht())); }
Bote.sage(("fertig"));
