salami summe = 0;
salami r = ofen(zeit: 50ms) {
    für (salami i = 1; i < 1000; i++) {
        summe += i;
        zwischenstand((summe));
        falls (i % 10 == 0) { Bote.sage(("bei"), (i)); }
    }
    serviere ((summe));
} roh (x) {
    Bote.sage(("roh"), (x.teilergebnis()), (x.verbrauchteZeit()));
    serviere ((-1));
};
Bote.sage((r), (summe), (Uhr.jetzt()));
salami t = ofen(zeit: 30ms) {
    salami a = ofen(zeit: 1s) { solange (ja) { } } roh (q) { serviere ((1)); };
    serviere ((a));
} roh (y) { serviere ((2)); } verbrannt (VerbranntAnanas v) { serviere ((3)); };
Bote.sage((t));
salami u = ofen(0ms) { serviere (1); } verbrannt (VerbranntAnanas v) { Bote.sage((v.nachricht())); serviere ((9)); };
Bote.sage((u));
probier { ofen(zeit: 10ms) { solange (ja) { } }; } verbrannt (VerbranntAnanas v) { Bote.sage((v.nachricht())); }
Bote.sage((ofen(20ms, 400) { Uhr.vorspulen(1s); serviere (1); } roh (z) { serviere ((z.verbrauchteZeit())); }));
