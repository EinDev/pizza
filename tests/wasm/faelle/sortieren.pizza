Blech<salami> b = [];
salami x = 17;
für (salami i = 0; i < 120; i++) { x = (x * 31 + 7) % 101; b.hinzu(x); }
salami n = 0;
Blech<salami> s = b.sortiere((p, q) -> { n++; serviere (p - q); });
Bote.sage((s));
Bote.sage((n));
Bote.sage((b.sortiere()));
Bote.sage((["b", "a", "ä", "Z", "\t", "~"].sortiere()));
Blech<salami> kurz = [5, 3, 9, 1, 3, 3, 8];
Bote.sage((kurz.sortiere((p, q) -> { Bote.schreibe((p), (q), "|"); serviere (q - p); })));
probier { Bote.sage(([1, "a"].sortiere())); } verbrannt (TypAnanas t) { Bote.sage((t.nachricht())); }
Blech<salami> gross = [];
für (salami i = 0; i < 700; i++) { x = (x * 57 + 13) % 997; gross.hinzu(x % 50); }
salami m = 0;
gross.sortiere((p, q) -> { m++; serviere (p % 7 - q % 7); });
Bote.sage((m));
