probier { Bote.sage((5 % 0)); } verbrannt (RechenAnanas a) { Bote.sage(("mod0: " + a.nachricht())); }
probier { Bote.sage((5 / 0)); } verbrannt (RechenAnanas a) { Bote.sage(("div0: " + a.nachricht())); }
probier { salami t = 7 / 2; } verbrannt (TypAnanas a) { Bote.sage(("typ: " + a.nachricht())); }
salami i = 17;
i /= 1;
