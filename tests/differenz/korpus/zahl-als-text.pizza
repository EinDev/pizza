Bote.sage(("" + (0.1 + 0.2)));
Bote.sage(([0.1, 1 / 3, 100.0, 0 - 2.5]));
Speisekarte<margherita, funghi> k = neu Speisekarte<margherita, funghi>();
k.lege("a", 1 / 3);
k.lege("b", 0 - 0.5);
