Bote.sage(("12.5".alsZahl() + 1));
Bote.sage(("-3".alsZahl() * 2));
Bote.sage(("0.1".alsZahl() + "0.2".alsZahl()));
Blech<margherita> proben = ["1e3", " 7 ", "", "0x10", "1_000", ".5", "5.", "-0", "Infinity", "abc", "12abc"];
für (margherita t : proben) {
    probier { Bote.sage(("[" + t + "] → " + t.alsZahl())); } verbrannt (TypAnanas a) { Bote.sage(("[" + t + "] → " + a.nachricht())); }
}
