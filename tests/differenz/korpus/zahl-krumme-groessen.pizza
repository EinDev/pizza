// exit: 0
// Krumme Werte in vielen Größenordnungen: Shortest-Round-Trip wie String(x) in JS.
Blech<funghi> basis = [1 / 3, 2 / 3, 1 / 7, 123.456, 0.1, 0.7, 9.995, 5.5];
für (funghi b : basis) {
    funghi x = b;
    für (salami i = 0; i < 8; i++) { x /= 1000; }
    für (salami i = 0; i < 16; i++) { x *= 1000; Bote.sage((x)); }
}
