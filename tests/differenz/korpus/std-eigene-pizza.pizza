quattrostagioni Belag { Tomate, Mozzarella, Basilikum, Salami }
klasse Pizza {
    Blech<Belag> beläge;
    Pizza(Blech<Belag> b) { beläge = b; }
    funghi preis() { serviere ((5 + beläge.länge() * 1.5)); }
    diavolo hat(Belag b) { serviere ((beläge.enthält(b))); }
    salami anzahlBeläge() { serviere ((beläge.länge())); }
    Pizza mit(Belag b) { Blech<Belag> n = beläge.kopie(); n.hinzu(b); serviere ((neu Pizza(n))); }
    Pizza ohne(Belag b) { serviere ((neu Pizza(beläge.filtere(x -> x != b)))); }
    margherita alsText() { serviere (("((" + beläge.verbinde(", ") + "))")); }
}
Pizza p = neu Pizza([Belag.Tomate, Belag.Mozzarella, Belag.Basilikum]);
Bote.sage((p + " " + p.preis() + " " + p.anzahlBeläge()));
Bote.sage((p.beläge));
Bote.sage((p.hat(Belag.Tomate) + " " + p.hat(Belag.Salami)));
Pizza q = p.mit(Belag.Salami).mit(Belag.Salami);
Bote.sage((q));
Bote.sage((q.ohne(Belag.Salami)));
Bote.sage((q.preis().währung("€")));
Bote.sage((p.alsText()));
Bote.sage((neu Pizza([])));
Bote.sage((neu Pizza([]).preis()));
Bote.sage((Belag.Salami + " " + Belag.Salami.position()));
Bote.sage((p == p));
Bote.sage((p == neu Pizza([Belag.Tomate, Belag.Mozzarella, Belag.Basilikum])));
Pizza r = p;
Bote.sage((r == p));
für (Belag b : p.beläge) { Bote.sage((b)); }
Speisekarte<Belag, salami> preise = neu Speisekarte<Belag, salami>();
preise.lege(Belag.Salami, 2);
Bote.sage((preise.hole(Belag.Salami) + " " + preise.hat(Belag.Tomate) + " " + preise.hat("Salami")));
Pizza nix = karton;
probier { nix.preis(); } verbrannt (LeererKartonAnanas a) { Bote.sage((a)); }
probier { Pizza falsch = 5; } verbrannt (TypAnanas a) { Bote.sage((a)); }
