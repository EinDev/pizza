// exit: 0
// währung("€") an .005-Grenzen (binär nicht exakt darstellbar).
Blech<funghi> werte = [0, 0.005, 0.015, 0.025, 0.035, 0.045, 0.055, 0.065, 0.075, 0.085, 0.095, 0.105, 0.115, 0.125, 0.135, 1.005, 1.015, 1.025, 1.035, 1.045, 1.055, 1.065, 1.075, 1.085, 1.095, 2.675, 8.345, 10.005, 100.005, 1000.005, 1234567.005, 0.004999, 0.0049999999, 0.995, 9.995, 99.995, 999.995, 123456789.995, 1 / 3, 2 / 3];
für (funghi w : werte) { Bote.sage((w + " = " + w.währung("€"))); }
für (funghi w : werte) { Bote.sage(("-" + w + " = " + (0 - w).währung("€"))); }
Bote.sage((8.währung("€")));
Bote.sage((1000000.währung("€")));
Bote.sage(((5 + 1 + 1.5 + 0.5).währung("€")));
